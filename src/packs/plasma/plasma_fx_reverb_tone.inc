void reverbTone(int type, double lo, double hi, float* db) {
  auto at = [](const double* g, int n, double x, int& i, double& f) {
    i = 0;
    while (i < n - 2 && x > g[i + 1]) ++i;
    f = std::clamp((x - g[i]) / (g[i + 1] - g[i]), 0.0, 1.0);
  };
  type = std::clamp(type, 0, 4);
  int ia, ib;
  double fa, fb;
  at(kRvA, 9, lo, ia, fa);
  at(kRvB, 10, hi, ib, fb);
  for (int k = 0; k < 10; ++k)
    db[k] = static_cast<float>(kRvBase[type][k] + kRvLo[type][ia][k] * (1 - fa) + kRvLo[type][ia + 1][k] * fa + kRvHi[type][ib][k] * (1 - fb) +
                               kRvHi[type][ib + 1][k] * fb);
}
