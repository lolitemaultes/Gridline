# Installs Gridline with the official setup program (Inno Setup, silent).
# Template: packaging/render.py fills in the version and checksum.
$ErrorActionPreference = 'Stop'
$packageArgs = @{
  packageName    = $env:ChocolateyPackageName
  fileType       = 'exe'
  url64bit       = 'https://github.com/lolitemaultes/Gridline/releases/download/v@VERSION@/Gridline-@VERSION@-windows-x64-setup.exe'
  checksum64     = '@SHA256:windows-x64-setup.exe@'
  checksumType64 = 'sha256'
  silentArgs     = '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-'
  validExitCodes = @(0)
  softwareName   = 'Gridline*'
}
Install-ChocolateyPackage @packageArgs
