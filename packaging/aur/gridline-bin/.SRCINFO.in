pkgbase = gridline-bin
	pkgdesc = Pattern-based music workstation (official release build)
	pkgver = @PKGVER@
	pkgrel = 1
	url = https://github.com/lolitemaultes/Gridline
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = alsa-lib
	depends = curl
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = jack
	depends = libgl
	depends = libx11
	depends = sdl2
	optdepends = xdg-utils: open links and folders from Gridline
	provides = gridline
	conflicts = gridline
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/lolitemaultes/Gridline/releases/download/v@VERSION@/Gridline-@VERSION@-linux-x86_64.tar.gz
	sha256sums_x86_64 = @SHA256:linux-x86_64.tar.gz@
	source_aarch64 = https://github.com/lolitemaultes/Gridline/releases/download/v@VERSION@/Gridline-@VERSION@-linux-aarch64.tar.gz
	sha256sums_aarch64 = @SHA256:linux-aarch64.tar.gz@

pkgname = gridline-bin
