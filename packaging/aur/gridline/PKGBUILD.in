# Maintainer: lolitemaultes <188165912+lolitemaultes@users.noreply.github.com>
# Gridline built from the release's source archive (Gridline-<version>-source.tar.gz).
# Template: packaging/render.py fills in the version and checksum.
pkgname=gridline
_ver=@VERSION@
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Pattern-based music workstation"
arch=('x86_64' 'aarch64')
url="https://github.com/lolitemaultes/Gridline"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'curl' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'jack' 'libgl' 'libx11' 'sdl2')
makedepends=('cmake' 'ninja')
optdepends=('yt-dlp: Import from URL'
            'ffmpeg: Import from URL'
            'xdg-utils: open links and folders from Gridline')
provides=('gridline')
conflicts=('gridline-bin')
source=("https://github.com/lolitemaultes/Gridline/releases/download/v${_ver}/Gridline-${_ver}-source.tar.gz")
sha256sums=('@SHA256:source.tar.gz@')

build() {
  # The release archive carries the commit (cmake/build-id.txt), so this build has the same
  # build id as the official packages (live collaboration compares it).
  cmake -S "Gridline-${_ver}" -B build -G Ninja -Wno-dev \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGRIDLINE_DEV_ASSETS=OFF \
    -DGRIDLINE_GUI_TESTS=OFF \
    -DGRIDLINE_INSTALL_PLUGINS=ON
  cmake --build build --target gridline gridline-app gridline_vst3 gridline_clap gridline_suite_gridline gridline_suite_mini
}

check() {
  build/gridline --version
}

package() {
  # GPL-3.0-or-later is a common licence (/usr/share/licenses/spdx): no copy needed.
  DESTDIR="${pkgdir}" cmake --install build
}
