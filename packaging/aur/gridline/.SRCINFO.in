	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = jack
	depends = libgl
	depends = libx11
	depends = sdl2
	optdepends = yt-dlp: Import from URL
	optdepends = ffmpeg: Import from URL
	optdepends = xdg-utils: open links and folders from Gridline
	provides = gridline
	conflicts = gridline-bin
	source = https://github.com/lolitemaultes/Gridline/releases/download/v@VERSION@/Gridline-@VERSION@-source.tar.gz
