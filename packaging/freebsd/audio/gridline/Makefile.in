PORTNAME=	gridline
DISTVERSION=	@VERSION@
CATEGORIES=	audio
MASTER_SITES=	https://github.com/lolitemaultes/Gridline/releases/download/v${DISTVERSION}/
DISTNAME=	Gridline-${DISTVERSION}-source

MAINTAINER=	@MAINTAINER@
COMMENT=	Pattern-based music workstation
WWW=		https://github.com/lolitemaultes/Gridline

LICENSE=	GPLv3+
LICENSE_FILE=	${WRKSRC}/LICENSE

LIB_DEPENDS=	libsndio.so:audio/sndio
RUN_DEPENDS=	curl:ftp/curl

USES=		cmake compiler:c++17-lang gl pkgconfig sdl xorg
USE_GL=		gl
USE_SDL=	sdl2
USE_XORG=	x11

CMAKE_ARGS=	-DGRIDLINE_DEV_ASSETS=OFF -DGRIDLINE_GUI_TESTS=OFF \
		-DGRIDLINE_INSTALL_PLUGINS=ON
# The programs and the plugins; the test programs are not built.
ALL_TARGET=	gridline gridline-app gridline_vst3 gridline_clap \
		gridline_suite_gridline gridline_suite_mini

WRKSRC=		${WRKDIR}/Gridline-${DISTVERSION}

PORTDATA=	*

OPTIONS_DEFINE=		IMPORTURL
OPTIONS_DEFAULT=	IMPORTURL
IMPORTURL_DESC=		Import from URL (yt-dlp and FFmpeg)
IMPORTURL_RUN_DEPENDS=	ffmpeg:multimedia/ffmpeg \
			yt-dlp:www/yt-dlp

# The VST3 and CLAP bundles (Gridline and the Gridline Suite) are folders of many files.
post-install:
	@cd ${STAGEDIR}${PREFIX} && ${FIND} lib/vst3 lib/clap \( -type f -o -type l \) | ${SORT} >> ${TMPPLIST}

.include <bsd.port.mk>
