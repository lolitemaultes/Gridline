# Q-13: embeds assets/icons/ui/*.svg into a C++ source (gl::icons::embeddedSvgs).
# Run as: cmake -DICON_DIR=<dir> -DOUT=<file.cpp> -P EmbedIcons.cmake
file(GLOB svgs "${ICON_DIR}/*.svg")
list(SORT svgs)
set(body "")
set(count 0)
foreach(f ${svgs})
  get_filename_component(stem "${f}" NAME_WE)
  file(READ "${f}" text)
  string(FIND "${text}" ")SVG\"" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${f}: contains the raw-string delimiter")
  endif()
  string(APPEND body "    {\"${stem}\", R\"SVG(${text})SVG\"},\n")
  math(EXPR count "${count} + 1")
endforeach()
set(src "// Generated from assets/icons/ui/*.svg by cmake/EmbedIcons.cmake: do not edit.\n#include \"IconAtlas.h\"\n\nnamespace gl::icons {\nnamespace {\nconst SvgSource kSvgs[] = {\n${body}};\n}  // namespace\nconst SvgSource* embeddedSvgs(int* count) {\n  if (count) *count = ${count};\n  return kSvgs;\n}\n}  // namespace gl::icons\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
