# J-130: embeds assets/wordmarks/*.svg into a C++ source (gl::icons::wordmark::embedded).
# <id>.svg is the wordmark of plugin type gl.<id>; _<name>.svg is the logo <name> (suite, suite-mini).
# Run as: cmake -DWORDMARK_DIR=<dir> -DOUT=<file.cpp> -P EmbedWordmarks.cmake
file(GLOB svgs "${WORDMARK_DIR}/*.svg")
list(SORT svgs)
set(body "")
set(count 0)
foreach(f ${svgs})
  get_filename_component(name "${f}" NAME)
  string(REGEX REPLACE "\\.svg$" "" stem "${name}")
  if(stem MATCHES "^_")
    string(SUBSTRING "${stem}" 1 -1 key)
  else()
    set(key "gl.${stem}")
  endif()
  file(READ "${f}" text)
  string(FIND "${text}" ")SVG\"" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${f}: contains the raw-string delimiter")
  endif()
  string(LENGTH "${text}" len)
  if(len GREATER 16000)
    message(FATAL_ERROR "${f}: ${len} bytes, longer than one MSVC string literal (16000)")
  endif()
  string(APPEND body "    {\"${key}\", R\"SVG(${text})SVG\"},\n")
  math(EXPR count "${count} + 1")
endforeach()
set(src "// Generated from assets/wordmarks/*.svg by cmake/EmbedWordmarks.cmake: do not edit.\n#include \"Wordmark.h\"\n\nnamespace gl::icons::wordmark {\nnamespace {\nconst Source kSvgs[] = {\n${body}};\n}  // namespace\nconst Source* embedded(int* count) {\n  if (count) *count = ${count};\n  return kSvgs;\n}\n}  // namespace gl::icons::wordmark\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
