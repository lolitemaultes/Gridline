# K-14: embeds the application icon PNGs (assets/icons/gridline-app-<size>.png, tools/make_app_icon.py)
# into a C++ source (gl::appicon::embeddedPngs), so every window gets the icon even without the
# assets folder or a desktop entry.
# Run as: cmake -DICON_DIR=<dir> -DSIZES=<s1;s2;...> -DOUT=<file.cpp> -P EmbedAppIcon.cmake
set(arrays "")
set(table "")
string(REPLACE "," ";" SIZES "${SIZES}")
foreach(sz ${SIZES})
  set(f "${ICON_DIR}/gridline-app-${sz}.png")
  if(NOT EXISTS "${f}")
    message(FATAL_ERROR "${f} is missing (tools/make_app_icon.py)")
  endif()
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,)(0x..,))" "\\1\n    " hex "${hex}")
  string(APPEND arrays "const unsigned char kPng${sz}[${bytes}] = {\n    ${hex}};\n")
  string(APPEND table "    {${sz}, kPng${sz}, ${bytes}},\n")
endforeach()
set(src "// Generated from assets/icons/gridline-app-*.png by cmake/EmbedAppIcon.cmake: do not edit.\n#include \"AppIconImage.h\"\n\nnamespace gl::appicon {\nnamespace {\n${arrays}const EmbeddedPng kTable[] = {\n${table}};\n}  // namespace\nconst EmbeddedPng* embeddedPngs(int* count) {\n  if (count) *count = static_cast<int>(sizeof(kTable) / sizeof(kTable[0]));\n  return kTable;\n}\n}  // namespace gl::appicon\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
