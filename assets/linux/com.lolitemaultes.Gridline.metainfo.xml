<?xml version="1.0" encoding="UTF-8"?>
<!-- Gridline for software centres (GNOME Software, KDE Discover, Flathub) and AppImage tools:
     AppStream metadata, installed to share/metainfo. Every published release gets a <release>
     entry here (release.yml checks it and validates the file with appstreamcli; docs/releasing.md).
     The id is also the Flatpak application id (packaging/flatpak); it replaced
     org.gridline.Gridline in 0.7.2. -->
<component type="desktop-application">
  <id>com.lolitemaultes.Gridline</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Gridline</name>
  <summary>Pattern-based music workstation</summary>
  <developer id="com.lolitemaultes">
    <name>Gridline</name>
  </developer>

  <description>
    <p>
      Gridline is a free, open source music workstation built around patterns. Sketch beats in the
      channel rack, write melodies and chords in the piano roll, arrange patterns, audio and
      automation in the playlist and mix everything on a full mixer.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>Channel rack, step sequencer and piano roll with chord and scale tools</li>
      <li>Playlist for patterns, audio clips and automation, with time stretching</li>
      <li>Mixer with inserts, sends, routing and a built-in effects collection</li>
      <li>Built-in instruments, from samplers and drum machines to the Plasma wavetable synth</li>
      <li>Hosts VST3, CLAP, VST2 and LV2 plugins, and runs as a VST3 and CLAP plugin itself</li>
      <li>Opens and saves FL Studio projects</li>
      <li>Live collaboration: make music together over the network</li>
    </ul>
  </description>

  <replaces>
    <id>org.gridline.Gridline</id>
  </replaces>

  <launchable type="desktop-id">gridline.desktop</launchable>
  <!-- No stock icon element: the desktop entry names the icon (Icon=), and appstream-util
       rejects a stock icon that is not one of the freedesktop names. -->
  <provides>
    <binary>gridline-app</binary>
    <binary>gridline</binary>
    <mediatype>application/x-gridline-project</mediatype>
  </provides>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Midi</category>
    <category>Sequencer</category>
  </categories>
  <keywords>
    <keyword>DAW</keyword>
    <keyword>music</keyword>
    <keyword>sequencer</keyword>
    <keyword>beat</keyword>
    <keyword>piano roll</keyword>
    <keyword>synthesizer</keyword>
  </keywords>

  <url type="homepage">https://github.com/lolitemaultes/Gridline</url>
  <url type="bugtracker">https://github.com/lolitemaultes/Gridline/issues</url>
  <url type="vcs-browser">https://github.com/lolitemaultes/Gridline</url>
  <url type="help">https://github.com/lolitemaultes/Gridline/tree/main/docs</url>

  <branding>
    <color type="primary" scheme_preference="light">#f2f2f2</color>
    <color type="primary" scheme_preference="dark">#0b0b0b</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>The workspace: channel rack, playlist and mixer</caption>
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/lolitemaultes/Gridline/main/docs/images/workspace.png</image>
    </screenshot>
    <screenshot>
      <caption>Piano roll</caption>
      <image type="source" width="1600" height="1506">https://raw.githubusercontent.com/lolitemaultes/Gridline/main/docs/images/piano-roll.png</image>
    </screenshot>
    <screenshot>
      <caption>Plasma, the wavetable synth</caption>
      <image type="source" width="1600" height="997">https://raw.githubusercontent.com/lolitemaultes/Gridline/main/docs/images/plasma.png</image>
    </screenshot>
    <screenshot>
      <caption>Built-in effects</caption>
      <image type="source" width="1760" height="763">https://raw.githubusercontent.com/lolitemaultes/Gridline/main/docs/images/editors.png</image>
    </screenshot>
    <screenshot>
      <caption>Making music together</caption>
      <image type="source" width="1600" height="662">https://raw.githubusercontent.com/lolitemaultes/Gridline/main/docs/images/collaboration.png</image>
    </screenshot>
  </screenshots>

  <!-- Online: the update check asks GitHub's API (social-info mild); a collaborator can see the
       contact email someone chose to share with them (social-contacts intense, off by default). -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <releases>
    <release version="0.7.6" date="2026-11-14">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.6</url>
      <description>
        <p>A Stage view in the mixer that places tracks on a stage, with rooms that each have their own stage and space; Chater, a glitch and sparkle effect; stepped, linear and smooth automation drawing; OSC control; a new Open and Save dialog; dependable Import from URL; mixer and playlist tracks reordered by dragging; a redone Plasma Patch view with larger text; Linux window and keyboard fixes; and crash fixes.</p>
      </description>
    </release>
    <release version="0.7.5" date="2026-11-12">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.5</url>
      <description>
        <p>A redesigned Plasma with a Patch view, meter changes across the song, themes down to black with a white text option, MPE on the built-in instruments, slides on every instrument, SFZ instruments, split and layered instruments, swing presets and grooves, freeze and hibernate, drum kit import, Voltage In and native Wayland.</p>
      </description>
    </release>
    <release version="0.7.4" date="2026-11-08">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.4</url>
      <description>
        <p>Chromebook and Debian support, tracker modules that open as projects with the new Tracker Sampler, window layouts with a new layout chooser, projects that open with a double click, clips that loop only when asked, M4A and AAC samples and a keyboard layout setting.</p>
      </description>
    </release>
    <release version="0.7.3" date="2026-11-06">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.3</url>
      <description>
        <p>Crash reports and project recovery, smoother playback of large projects, clips and notes that keep their offset when dragged, Track Receipt share calculation and tap tempo.</p>
      </description>
    </release>
    <release version="0.7.2" date="2026-11-03">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.2</url>
      <description>
        <p>Pitch bend on piano roll notes, Junction wired by hand, a full round for Crest, file organising in the browser, a pinned Loupe, favourite plugins and ASIO on Windows.</p>
      </description>
    </release>
    <release version="0.7.1" date="2026-11-01">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.1</url>
    </release>
    <release version="0.7.0" date="2026-10-31">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.7.0</url>
    </release>
    <release version="0.6.1" date="2026-10-24">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.6.1</url>
    </release>
    <release version="0.6.0" date="2026-10-22">
      <url type="details">https://github.com/lolitemaultes/Gridline/releases/tag/v0.6.0</url>
    </release>
  </releases>
</component>
