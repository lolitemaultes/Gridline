# Gridline - 0.7.8: the audio clip editor's spectrum, made for the screen's pixels. Runs the app hidden
# (isolated config, fixed frame time, SDL's dummy audio driver) on a copy of the test song with a sampler
# channel playing an audio clip (clip 70) and, with the spectrum shown, checks in each layout (the Studio
# window, Smooth's audio editor, the Clips clip band, the Tracker's Advanced Sample editor) and in Studio
# at two pixels per point:
#   1. the view gets an image of its own: one row per pixel of the spectrum's height and at least one
#      column per pixel where the clip plays (no texel drawn wider than a screen pixel: stretch <= 1);
#   2. zoomed in, a new image for the frames in view, as sharp (stretch <= 1, a shorter stretch of the
#      sample than before);
#   3. idle frames make nothing: no image started, no texture written, the runs of pixels not worked
#      out again, while nothing changes (the counts stay the same over 60 frames).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k078_clipspectrum_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)
set(chanJson "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
set(clipJson "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 7, \"start\": 0, \"length\": 1536, \"pattern\": 0, \"gain\": 1.0}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${chanJson}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clipJson}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# spec(<p> <n>): the n-th "clipeditor spec" line into <p>_cur _from _to _cols _rows _pw _ph _qw _qh _sx _sy _made _uploads _builds
function(spec p n)
  string(REGEX MATCHALL "clipeditor spec frame [^\n]*" lines "${out}")
  list(LENGTH lines count)
  if(NOT n LESS count)
    message(FATAL_ERROR "FAIL: ${p}: no clipeditor spec #${n} (${count})\nOutput:\n${out}")
  endif()
  list(GET lines ${n} l)
  string(REGEX MATCH "stretch ([0-9.]+) ([0-9.]+) made ([0-9]+ [0-9]+) uploads ([0-9]+ [0-9]+) runs [0-9]+ builds ([0-9]+)" m2 "${l}")
  set(${p}_sx ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${p}_sy ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${p}_made "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${p}_uploads "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${p}_builds ${CMAKE_MATCH_5} PARENT_SCOPE)
  # (CMake keeps nine groups: the rest in a second match)
  string(REGEX MATCH "current ([01]) view ([0-9]+) ([0-9]+) cols ([0-9]+) rows ([0-9]+) pixels ([0-9]+) ([0-9]+) points ([0-9]+) ([0-9]+)" m "${l}")
  if(m STREQUAL "" OR m2 STREQUAL "")
    message(FATAL_ERROR "FAIL: ${p}: cannot read: ${l}")
  endif()
  set(${p}_cur ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${p}_from ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${p}_to ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${p}_cols ${CMAKE_MATCH_4} PARENT_SCOPE)
  set(${p}_rows ${CMAKE_MATCH_5} PARENT_SCOPE)
  set(${p}_pw ${CMAKE_MATCH_6} PARENT_SCOPE)
  set(${p}_ph ${CMAKE_MATCH_7} PARENT_SCOPE)
  set(${p}_qw ${CMAKE_MATCH_8} PARENT_SCOPE)
  set(${p}_qh ${CMAKE_MATCH_9} PARENT_SCOPE)
endfunction()

foreach(run studio logic live tracker studio2x)
  set(layout ${run})
  set(scale 1)
  set(size 1440x900)
  if(run STREQUAL "studio2x")
    set(layout studio)
    set(scale 2)
    set(size 2880x1800)
  endif()
  set(cfg "${OUT}/cfg_${run}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.clipWindowView\": \"advanced\", \"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\", \"keys.profile\": \"${layout}\", \"ui.menuStyle\": \"${layout}\", \"tracker.sampleView\": \"advanced\"}}\n")
  if(layout STREQUAL "live")
    set(open "6 clipeditor open 70\n10 clipeditor host clips\n")
  elseif(layout STREQUAL "tracker")
    set(open "6 clipeditor dbl 70\n10 clipeditor tab 10\n")  # (the Advanced Sample editor's Waveform page)
  else()
    set(open "6 clipeditor dbl 70\n")
  endif()
  set(s "${open}14 clipeditor spectrum 1\n16 waitfor clip-spectrogram 30\n30 clipeditor spec\n90 clipeditor spec\n92 forget clip-spectrogram\n94 clipeditor zoom 6\n")
  string(APPEND s "96 waitfor clip-spectrogram 30\n120 clipeditor spec\n180 clipeditor spec\n182 quit discard\n")
  file(WRITE "${OUT}/${run}.txt" "${s}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size ${size} --ui-scale ${scale} --frames 200
                          --dev-input "${OUT}/${run}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
  file(WRITE "${OUT}/${run}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${run}: gridline-app failed (${rc}): ${err}")
  endif()
  check("${run}: the spectrum's images were made" NOT out MATCHES "waitfor clip-spectrogram: timed out")
  spec(a 0)
  math(EXPR qh "${a_qh} * ${scale}")
  math(EXPR dh "${a_ph} - ${qh}")
  check("${run}: the view has its own image (${a_cur})" a_cur EQUAL 1)
  check("${run}: one row per pixel of the spectrum's height (${a_rows} for ${a_ph} pixels, ${a_qh} points at ${scale}x)" a_rows EQUAL a_ph AND dh LESS_EQUAL 2 AND dh GREATER_EQUAL -2 AND a_sy LESS_EQUAL 1.0)
  check("${run}: at least one column per screen pixel (${a_cols} columns, ${a_pw} pixels wide, stretch ${a_sx})" a_sx LESS_EQUAL 1.0 AND a_sx GREATER 0.3)
  spec(b 1)
  check("${run}: idle, nothing made again (made ${a_made} -> ${b_made}, uploads ${a_uploads} -> ${b_uploads}, runs ${a_builds} -> ${b_builds})"
        a_made STREQUAL b_made AND a_uploads STREQUAL b_uploads AND a_builds EQUAL b_builds)
  spec(c 2)
  math(EXPR spanA "${a_to} - ${a_from}")
  math(EXPR spanC "${c_to} - ${c_from}")
  check("${run}: zoomed in, a new image for a shorter stretch (${spanA} -> ${spanC} frames), as sharp (stretch ${c_sx})"
        c_cur EQUAL 1 AND spanC LESS spanA AND c_sx LESS_EQUAL 1.0 AND c_rows EQUAL c_ph)
  spec(d 3)
  check("${run}: zoomed in and idle, nothing made again" c_made STREQUAL d_made AND c_uploads STREQUAL d_uploads AND c_builds EQUAL d_builds)
endforeach()
