# Gridline - K-247: the LFO board in the real app (hidden, isolated config and HOME, SDL's dummy audio).
#   1. in each of the four layouts Alt+F9 opens the board in its home (Studio: beside the mixer, compact
#      in the narrow column; Clips: the mixer band; Smooth: the lower pane; Tracker: the LFO page), the
#      cards or rows lie inside the window, Alt+F9 again closes it (the Tracker: the page stays, as its page keys do);
#   2. Studio's Pop out gives the full board: cards several across;
#   3. dragging LFO 1's handle onto LFO 2's Depth knob links them (one undo step); Alt-drag on that
#      knob changes the amount, not the depth;
#   4. the target settings and add-target popovers open over the board.
# Screenshots: <OUT>/<tag>.ppm.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k247_lfoboard_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/home" "${OUT}/cfg/gridline")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{HOME} "${OUT}/home")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{GRIDLINE_CACHE_DIR} "${OUT}/cache")
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true}}\n")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(run tag frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${ARGN}
                          --frames ${frames} --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  file(WRITE "${OUT}/${tag}.out" "${out}")
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
# report(<p> <n>): the n-th "[lfo] frame" report into <p>_open _compact _cols _x0 _y0 _x1 _y1 _undo _targets _text.
function(report p n)
  string(REGEX MATCHALL "\\[lfo\\] frame [^\n]*(\n\\[lfo\\] +(card|chip)[^\n]*)*" reps "${out}")
  list(LENGTH reps count)
  if(NOT n LESS count)
    message(FATAL_ERROR "FAIL: ${p}: only ${count} lfo reports\n${out}")
  endif()
  list(GET reps ${n} r)
  # (CMake keeps nine groups a match: two matches)
  string(REGEX MATCH "lfos ([0-9]+) targets ([0-9]+) open ([01]) detail ([01]) compact ([01]) cols ([0-9]+)" m "${r}")
  set(${p}_lfos "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${p}_targets "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${p}_open "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${p}_compact "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${p}_cols "${CMAKE_MATCH_6}" PARENT_SCOPE)
  string(REGEX MATCH "win ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+) undo ([0-9]+)" m "${r}")
  set(${p}_x0 "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${p}_y0 "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${p}_x1 "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${p}_y1 "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${p}_undo "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${p}_text "${r}" PARENT_SCOPE)
endfunction()
# card(<p> <text> <k>): the k-th card line of a report: rect, handle, depth knob.
function(card p text k)
  string(REGEX MATCHALL "\\[lfo\\] card [^\n]*" cards "${text}")
  list(GET cards ${k} c)
  string(REGEX MATCH "rect ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+) handle ([-0-9]+) ([-0-9]+)" m "${c}")
  set(${p}_x0 "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${p}_y0 "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${p}_x1 "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${p}_y1 "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${p}_hx "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${p}_hy "${CMAKE_MATCH_6}" PARENT_SCOPE)
  string(REGEX MATCH "add ([-0-9]+) ([-0-9]+) depth ([-0-9]+) ([-0-9]+)" m "${c}")
  set(${p}_ax "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${p}_ay "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${p}_dx "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${p}_dy "${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()

# Three LFOs, two targets: LFO 1 moves the Kick's pan, LFO 2 the Clap's volume (owner 20 and 21, index 1 / 0).
set(setup "2 lfo new\n2 lfo new\n2 lfo new\n3 lfo link 1 20 1 0.4\n3 lfo link 2 21 0 0.3\n")

# ---- 1. every layout: Alt+F9 opens the board in its home, again closes it
foreach(lay studio live logic tracker)
  run(open_${lay} 60 "${setup}6 mod alt 1\n6 key f9\n7 mod alt 0\n40 lfo\n44 mod alt 1\n44 key f9\n45 mod alt 0\n54 lfo\n58 quit discard\n" --layout ${lay})
  report(r 0)
  check("${lay}: three LFOs, two targets" r_lfos EQUAL 3 AND r_targets EQUAL 2)
  check("${lay}: Alt+F9 opens the board" r_open EQUAL 1)
  math(EXPR w "${r_x1} - ${r_x0}")
  math(EXPR h "${r_y1} - ${r_y0}")
  check("${lay}: the board window is drawn (${w} x ${h})" w GREATER 200 AND h GREATER 120)
  string(REGEX MATCHALL "\\[lfo\\] card [^\n]*" cards "${r_text}")
  list(LENGTH cards nc)
  check("${lay}: a card or row for each LFO (${nc})" nc EQUAL 3)
  set(inside 1)
  foreach(k 0 1 2)
    card(c "${r_text}" ${k})
    if(c_x0 LESS r_x0 OR c_x1 GREATER r_x1)
      set(inside 0)
    endif()
  endforeach()
  check("${lay}: the cards lie across the window" inside EQUAL 1)
  if(lay STREQUAL "studio")
    check("studio: beside the mixer in the narrow column, the compact list" r_compact EQUAL 1)
  endif()
  report(q 1)
  if(lay STREQUAL "tracker")
    check("tracker: the key shows the LFO page again, as every page key does" q_open EQUAL 1)
  else()
    check("${lay}: Alt+F9 again closes it" q_open EQUAL 0)
  endif()
endforeach()

# ---- 2. Studio: Pop out gives the full board, cards several across
run(popout 50 "${setup}4 lfo open\n12 lfo popout\n40 lfo\n48 quit discard\n")
report(p 0)
check("pop out: the cards in ${p_cols} columns" p_compact EQUAL 0 AND p_cols GREATER 2)

# ---- 3. drag LFO 1's handle onto LFO 2's Depth knob; Alt-drag the amount
run(dragmap 40 "${setup}4 lfo open\n12 lfo popout\n30 lfo\n38 quit discard\n")
report(d 0)
card(c1 "${d_text}" 0)
card(c2 "${d_text}" 1)
math(EXPR ay "${c2_dy} - 30")
run(drag 120
    "${setup}4 lfo open\n12 lfo popout\n30 lfo\n32 move ${c1_hx} ${c1_hy}\n34 down 0\n36 move ${c1_dx} ${c1_dy}\n38 move ${c2_dx} ${c2_dy}\n40 move ${c2_dx} ${c2_dy}\n42 up 0\n50 lfo\n60 move ${c2_dx} ${c2_dy}\n62 mod alt 1\n64 down 0\n66 move ${c2_dx} ${ay}\n68 move ${c2_dx} ${ay}\n70 up 0\n72 mod alt 0\n80 lfo\n118 quit discard\n")
report(b 0)
report(a 1)
report(z 2)
check("the drop links LFO 1 to LFO 2's depth (targets ${b_targets} -> ${a_targets})" a_targets EQUAL 3)
math(EXPR steps "${a_undo} - ${b_undo}")
check("the drop is one undo step (${steps})" steps EQUAL 1)
string(REGEX MATCH "chip LFO 2[^\n]*Depth[^\n]*amount ([-0-9.]+)" m "${z_text}")
set(amt "${CMAKE_MATCH_1}")
# (30 px up at 0.005 a pixel: 0.25 + 0.15)
check("Alt-drag up raises the amount from 0.250 (${amt})" amt STREQUAL "0.400")

# ---- 3b. Pick on screen: LFO 1 waits for a knob; clicking LFO 3's depth knob links it
card(c3 "${d_text}" 2)
run(pick 70 "${setup}4 lfo open\n12 lfo popout\n30 lfo pick 1\n34 move ${c3_dx} ${c3_dy}\n38 down 0\n40 up 0\n50 lfo\n68 quit discard\n")
report(p 0)
check("Pick on screen links the clicked knob (targets ${p_targets})" p_targets EQUAL 3)
string(REGEX MATCH "chip LFO 3 · Depth[^\n]*amount ([-0-9.]+)" m "${p_text}")
check("at 25 percent around the knob (${CMAKE_MATCH_1})" CMAKE_MATCH_1 STREQUAL "0.250")

# ---- 4. the popovers over the board
run(pop_settings 40 "${setup}4 lfo open\n12 lfo popout\n20 lfo settings 1 20 1\n36 quit discard\n")
run(pop_add 40 "${setup}4 lfo open\n12 lfo popout\n20 lfo addtarget 1\n36 quit discard\n")
message(STATUS "screenshots in ${OUT}")
