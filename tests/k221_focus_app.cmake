# Gridline - a press anywhere on a window brings it to the front and gives it the keyboard, in the
# real app (hidden, off-screen, isolated config). Three floating windows overlap: the channel rack,
# a channel's plugin window and an effect's plugin window.
#   1. a first run reports where each window is;
#   2. presses inside each window's content (away from its title bar, on a spot no other window
#      covers), with the left, right and middle buttons in turn, each bring that window to the
#      front and focus it (the "zorder" dump after each press);
#   3. a drag from outside (the browser's plugin drag) dropped on the channel rack while it lies
#      under the plugin windows still lands: the row's instrument is replaced;
#   4. GRIDLINE_NO_RAISE_ON_PRESS=1 (the behaviour before) leaves a right / middle press's window
#      behind, so the check above is a real one.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k221_focus_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/song.gridline.json" "${demo}")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{SDL_AUDIODRIVER} "dummy")  # never the real speakers
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_PLUGIN_WINDOW_SIZE} "1")

function(run tag frames script)
  file(REMOVE_RECURSE "${OUT}/${tag}")
  file(MAKE_DIRECTORY "${OUT}/${tag}/cfg" "${OUT}/${tag}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/${tag}/cfg")
  set(ENV{HOME} "${OUT}/${tag}/home")
  file(WRITE "${OUT}/${tag}/in.txt" "${prefix}${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1920x1080
                          --rack steps16,w700,h400 --plugin gl.eq --chan 1 --frames ${frames} --dev-input "${OUT}/${tag}/in.txt"
                          --screenshot "${OUT}/${tag}/shot.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}/out.txt" "${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}):\n${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

# Reads the "windows" dump in `out`: names, X_/Y_/W_/H_<name> of every floating window.
macro(parse_windows)
  string(REGEX MATCHALL "  window \"[^\"]*\" pos [-0-9.]+,[-0-9.]+ size [0-9.]+x[0-9.]+" wins "${out}")
  set(names "")
  foreach(w ${wins})
    string(REGEX MATCH "\"([^\"]*)\" pos ([-0-9]+)[.0-9]*,([-0-9]+)[.0-9]* size ([0-9]+)[.0-9]*x([0-9]+)" _ "${w}")
    set(n "${CMAKE_MATCH_1}")
    set(m2 ${CMAKE_MATCH_2})
    set(m3 ${CMAKE_MATCH_3})
    set(m4 ${CMAKE_MATCH_4})
    set(m5 ${CMAKE_MATCH_5})
    if(NOT n MATCHES "^#" AND NOT n STREQUAL "")
      string(MAKE_C_IDENTIFIER "${n}" key)
      list(APPEND names "${n}")
      set(X_${key} ${m2})
      set(Y_${key} ${m3})
      set(W_${key} ${m4})
      set(H_${key} ${m5})
    endif()
  endforeach()
endmacro()

# ---- 1. where the windows are. They open over each other; the two plugin windows are first
# dragged by their title bars to the left and the right so each window shows a part of its own.
set(prefix "")
run(geo0 30 "20 windows\n")
parse_windows()
list(LENGTH names count)
if(count LESS 3)
  message(FATAL_ERROR "FAIL: fewer than three floating windows (${names}):\n${out}")
endif()
set(f 4)
foreach(pair "fxeditor|1900" "channelsettings|80")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 n)
  list(GET pair 1 tx)
  string(MAKE_C_IDENTIFIER "${n}" k)
  math(EXPR gx "${X_${k}} + 60")
  math(EXPR gy "${Y_${k}} + 10")
  if(tx GREATER 1000)
    math(EXPR dx "${tx} - ${X_${k}} - ${W_${k}}")
  else()
    math(EXPR dx "${tx} - ${X_${k}}")
  endif()
  math(EXPR f1 "${f} + 1")
  math(EXPR f2 "${f} + 2")
  math(EXPR f3 "${f} + 3")
  math(EXPR f4 "${f} + 4")
  math(EXPR f5 "${f} + 5")
  math(EXPR mx1 "${gx} + ${dx} / 3")
  math(EXPR mx2 "${gx} + ${dx} * 2 / 3")
  math(EXPR mx3 "${gx} + ${dx}")
  string(APPEND prefix "${f} move ${gx} ${gy}\n${f1} down 0\n${f2} move ${mx1} ${gy}\n${f3} move ${mx2} ${gy}\n${f4} move ${mx3} ${gy}\n${f5} up 0\n")
  math(EXPR f "${f} + 7")
endforeach()
run(geo 40 "30 windows\n31 zorder\n")
parse_windows()
message(STATUS "floating windows: ${names}")

string(REGEX MATCH "zorder frame 31: front-last \\[([^]]*)\\]" _ "${out}")
string(REPLACE " | " ";" order "${CMAKE_MATCH_1}")
set(order0 "${order}")
message(STATUS "back to front: ${order}")

# A spot in window <n>'s content (below its title bar) that no window in front of it (in `order`,
# back to front) covers.
function(spot var n)
  list(FIND order "${n}" at)
  set(above "")
  list(LENGTH order len)
  math(EXPR first "${at} + 1")
  if(first LESS len)
    math(EXPR last "${len} - 1")
    foreach(i RANGE ${first} ${last})
      list(GET order ${i} o)
      list(APPEND above "${o}")
    endforeach()
  endif()
  string(MAKE_C_IDENTIFIER "${n}" k)
  foreach(fy 50 70 30 85 40 60 75 90 95 10 5)
    foreach(fx 50 30 70 15 85 40 60 92 8)
      math(EXPR px "${X_${k}} + ${W_${k}} * ${fx} / 100")
      math(EXPR py "${Y_${k}} + 40 + (${H_${k}} - 48) * ${fy} / 100")
      set(free 1)
      foreach(o ${above})
        string(MAKE_C_IDENTIFIER "${o}" ok)
        math(EXPR x1 "${X_${ok}} + ${W_${ok}} + 4")
        math(EXPR y1 "${Y_${ok}} + ${H_${ok}} + 4")
        math(EXPR x0 "${X_${ok}} - 4")
        math(EXPR y0 "${Y_${ok}} - 4")
        if(px GREATER x0 AND px LESS x1 AND py GREATER y0 AND py LESS y1)
          set(free 0)
        endif()
      endforeach()
      if(free AND px GREATER 0 AND px LESS 1440 AND py GREATER 60 AND py LESS 870)
        set(${var} "${px} ${py}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  message(FATAL_ERROR "FAIL: no uncovered spot in \"${n}\"")
endfunction()

# ---- 2. presses with each button, cycling through the windows, each one ending in front
set(script "")
set(f 30)
set(expect "")
foreach(round 0 1 2)
  foreach(n ${names})
    spot(xy "${n}")
    math(EXPR f1 "${f} + 1")
    math(EXPR f2 "${f} + 3")
    math(EXPR f3 "${f} + 6")
    string(APPEND script "${f} move ${xy}\n${f1} down ${round}\n${f2} up ${round}\n${f3} zorder\n")
    list(APPEND expect "${f3}|${n}|${round}")
    list(REMOVE_ITEM order "${n}")
    list(APPEND order "${n}")
    math(EXPR f "${f} + 10")
  endforeach()
endforeach()
math(EXPR frames "${f} + 10")

function(check_presses tag want_ok)
  run(${tag} ${frames} "${script}")
  set(bad 0)
  foreach(e ${expect})
    string(REPLACE "|" ";" e "${e}")
    list(GET e 0 fr)
    list(GET e 1 n)
    list(GET e 2 b)
    string(REGEX MATCH "zorder frame ${fr}: front-last \\[([^]]*)\\] focused \"[^\"]*\" focused-root \"([^\"]*)\"" _ "${out}")
    set(order "${CMAKE_MATCH_1}")
    set(froot "${CMAKE_MATCH_2}")
    string(REGEX REPLACE ".* \\| " "" front "${order}")
    if(front STREQUAL n AND froot STREQUAL n)
      if(want_ok)
        message(STATUS "ok - button ${b} press in \"${n}\": in front and focused")
      endif()
    else()
      math(EXPR bad "${bad} + 1")
      if(want_ok)
        message(FATAL_ERROR "FAIL: button ${b} press in \"${n}\" (frame ${fr}): front \"${front}\", focused \"${froot}\" ([${order}])")
      endif()
    endif()
  endforeach()
  set(bad ${bad} PARENT_SCOPE)
endfunction()

check_presses(presses 1)

# ---- 4. before: right and middle presses did not raise their window
set(ENV{GRIDLINE_NO_RAISE_ON_PRESS} "1")
check_presses(before 0)
unset(ENV{GRIDLINE_NO_RAISE_ON_PRESS})
if(bad EQUAL 0)
  message(FATAL_ERROR "FAIL: without the rule every press raised its window too (the check proves nothing)")
endif()
message(STATUS "ok - without the rule ${bad} presses left their window behind")

# ---- 3. a drop on the channel rack while it lies under the plugin windows
run(rackgeo 40 "30 rack\n")
string(REGEX MATCH "geom originX ([0-9]+)[.0-9]* row0Y ([0-9]+)[.0-9]* viewX0 [-0-9.]+ graphY [-0-9.]+ rowPitch ([0-9]+)" _ "${out}")
set(ox "${CMAKE_MATCH_1}")
set(oy "${CMAKE_MATCH_2}")
if(ox STREQUAL "")
  message(FATAL_ERROR "FAIL: no rack geometry:\n${out}")
endif()
math(EXPR dx "${ox} + 160")
# The rack goes behind: a press in each plugin window, then the drag onto the rack's first row.
set(order "${order0}")
set(pre "")
set(f 30)
foreach(n ${names})
  if(n STREQUAL "Channel rack")
    continue()
  endif()
  spot(xy "${n}")
  math(EXPR f1 "${f} + 1")
  math(EXPR f2 "${f} + 3")
  string(APPEND pre "${f} move ${xy}\n${f1} down 0\n${f2} up 0\n")
  list(REMOVE_ITEM order "${n}")
  list(APPEND order "${n}")
  math(EXPR f "${f} + 8")
endforeach()
math(EXPR g0 "${f} + 1")
math(EXPR g1 "${f} + 3")
math(EXPR g2 "${f} + 5")
math(EXPR g3 "${f} + 7")
math(EXPR g4 "${f} + 12")
math(EXPR g5 "${f} + 20")
run(drop ${g5} "${pre}${f} zorder\n${f} channels\n${g0} dragenter ${dx} ${oy} plugin:gl.synth\n${g1} dragmove ${dx} ${oy}\n${g2} dragmove ${dx} ${oy}\n${g3} drop\n${g4} channels\n${g4} zorder\n")
string(REGEX MATCH "zorder frame ${f}: front-last \\[([^]]*)\\]" _ "${out}")
if(CMAKE_MATCH_1 MATCHES "\\| Channel rack \\|" OR CMAKE_MATCH_1 MATCHES "\\| Channel rack$")
  message(FATAL_ERROR "FAIL: the rack was not under a plugin window before the drop: [${CMAKE_MATCH_1}]")
endif()
string(REGEX MATCH "channels frame ${f}:[^\n]*\n(  channel [^\n]*\n)*" before "${out}")
string(REGEX MATCH "channels frame ${g4}:[^\n]*\n(  channel [^\n]*\n)*" after "${out}")
string(REGEX MATCHALL "type gl.synth" s0 "${before}")
string(REGEX MATCHALL "type gl.synth" s1 "${after}")
list(LENGTH s0 n0)
list(LENGTH s1 n1)
if(NOT n1 GREATER n0)
  message(FATAL_ERROR "FAIL: the drop on the lower rack did not land:\n${before}\n${after}")
endif()
message(STATUS "ok - a drag dropped on the rack under the plugin windows replaced a row's instrument")
