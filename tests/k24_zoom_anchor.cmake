# Gridline: K-24, the playlist zoom anchored at the pointer on both axes (hidden, isolated configs,
# 1440x900, the playlist shown, a fixed 16 ms frame time, the drawn geometry of every frame from
# "plgeom" and, for the piano roll, "lane"), on a copy of the demo song (34 tracks, most of them
# automation lanes):
#   1. Alt+wheel (vertical zoom) glides and keeps the track under the pointer and the point inside it
#      under the pointer (within 1 px) at every frame, zooming in and out, at the top, the middle and
#      the bottom of the song; where an edge cannot move (zooming out at the top / bottom) the view
#      stays pinned to that edge instead; the same with mixed track heights and a folded group;
#   2. dragging an end of the vertical / horizontal scroller zooms that axis, the opposite end
#      staying put (within 1 px);
#   3. Ctrl+wheel keeps the tick under the pointer (scrolled view) and, over the track headers, the
#      grid's left edge;
#   4. the piano roll's Alt+wheel keeps the key row under the pointer;
#   5. the vertical zoom is remembered (settings, ui.playlistTrackHeight) for the next start.
#   cmake -DAPP=<gridline-app> -DDEMO=<Gridline.gridline.json> -DSONG=<test_song.gridline.json> -DOUT=<dir> -P k24_zoom_anchor.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_REDUCED_MOTION} "0")  # the glides do not depend on the machine's accessibility setting
file(READ "${DEMO}" demo)  # copies: the fixtures are never opened (or saved over) in place
file(WRITE "${OUT}/demo.gridline.json" "${demo}")
configure_file("${SONG}" "${OUT}/song.gridline.json" COPYONLY)
# Mixed heights and a folded group: Fills twice as tall, Sub + Reese half, Rain folds Droplets and Dust + Hiss.
set(mixed "${demo}")
string(JSON mixed SET "${mixed}" tracks 1 height 2)
string(JSON mixed SET "${mixed}" tracks 3 height 0.5)
string(JSON mixed SET "${mixed}" tracks 9 groupSize 2)
string(JSON mixed SET "${mixed}" tracks 9 folded true)
string(JSON mixed SET "${mixed}" tracks 12 height 1.5)
file(WRITE "${OUT}/mixed.gridline.json" "${mixed}")
if(APPLE)
  set(ctrl super)  # Ctrl for ImGui (macOS swaps Cmd and Ctrl)
else()
  set(ctrl ctrl)
endif()

# run(<tag> <project> <frames> <script> [cfg tag]): output in ${out}; the config folder is
# cfg_<cfg tag or tag> (kept when it already exists: a second start on the same settings).
function(run tag project frames script)
  set(cfg "${tag}")
  if(ARGC GREATER 4)
    set(cfg "${ARGV4}")
  endif()
  file(MAKE_DIRECTORY "${OUT}/cfg_${cfg}/gridline")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${cfg}")
  set(ENV{HOME} "${OUT}/cfg_${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "${script}${frames} quit discard\n")  # (--frames alone ends a run only with a screenshot)
  set(view --show playlist)
  if(project STREQUAL "song")
    set(view --edit 0 6 --hide rack)
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/${project}.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${view}
                          --frames 400 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n(output in ${OUT})")
endfunction()
function(check msg)
  if(NOT (${ARGN}))
    fail("${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
# "-12.3456" -> -12346 (thousandths, rounded towards zero after three digits)
function(milli var v)
  string(REGEX MATCH "^(-?)([0-9]*)\\.?([0-9]*)$" _ "${v}")
  set(sign "${CMAKE_MATCH_1}")
  set(i "${CMAKE_MATCH_2}")
  set(f "${CMAKE_MATCH_3}000")
  string(SUBSTRING "${f}" 0 3 f)
  if(i STREQUAL "")
    set(i 0)
  endif()
  math(EXPR r "${i} * 1000 + 1${f} - 1000")
  if(sign STREQUAL "-")
    math(EXPR r "0 - ${r}")
  endif()
  set(${var} ${r} PARENT_SCOPE)
endfunction()
function(absdiff var a b)
  math(EXPR d "${a} - ${b}")
  if(d LESS 0)
    math(EXPR d "0 - ${d}")
  endif()
  set(${var} ${d} PARENT_SCOPE)
endfunction()

# The playlist at <frame> (thousandths of a px): g_x0 g_ppt (millionths) g_sy g_th g_gx0 g_gy0 g_gy1
# g_vt0 g_vt1 g_vx g_ht0 g_ht1 g_hy, and the dump of that frame in g_dump.
function(geo frame)
  string(REGEX MATCH "plgeom frame ${frame}: valid 1 x0 ([-0-9.]+) pxPerTick ([0-9.]+)[^\n]*\n(  [^\n]*\n)*" d "${out}")
  if(d STREQUAL "")
    fail("no playlist geometry at frame ${frame}")
  endif()
  string(REGEX MATCH "x0 ([-0-9.]+) pxPerTick ([0-9]+)\\.([0-9]+)" _ "${d}")
  set(m1 "${CMAKE_MATCH_1}")
  set(m2 "${CMAKE_MATCH_2}")
  set(m3 "${CMAKE_MATCH_3}")
  milli(x0 "${m1}")
  string(REGEX REPLACE "^0+" "" pf "${m3}")
  if(pf STREQUAL "")
    set(pf 0)
  endif()
  math(EXPR ppt "${m2} * 1000000 + ${pf}")
  string(REGEX MATCH "view scrollY ([-0-9.]+) trackHeight ([0-9.]+) grid ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) vthumb ([-0-9.]+) ([-0-9.]+) x ([-0-9.]+) hthumb ([-0-9.]+) ([-0-9.]+) y ([-0-9.]+)"
         _ "${d}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no view line at frame ${frame}")
  endif()
  set(names sy th gx0 gy0 gy1 vt0 vt1 vx ht0)
  set(k 1)
  foreach(n IN LISTS names)
    milli(v "${CMAKE_MATCH_${k}}")
    set(g_${n} ${v} PARENT_SCOPE)
    math(EXPR k "${k} + 1")
  endforeach()
  string(REGEX MATCH "hthumb [-0-9.]+ ([-0-9.]+) y ([-0-9.]+)" _ "${d}")  # (CMake keeps nine groups)
  milli(v "${CMAKE_MATCH_1}")
  set(g_ht1 ${v} PARENT_SCOPE)
  milli(v "${CMAKE_MATCH_2}")
  set(g_hy ${v} PARENT_SCOPE)
  set(g_x0 ${x0} PARENT_SCOPE)
  set(g_ppt ${ppt} PARENT_SCOPE)
  set(g_dump "${d}" PARENT_SCOPE)
endfunction()
# Track <i> in g_dump: t_top t_h (thousandths).
function(trk i)
  string(REGEX MATCH "  track ${i} top ([-0-9.]+) h ([0-9.]+) " _ "${g_dump}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no track ${i}")
  endif()
  milli(a "${CMAKE_MATCH_1}")
  milli(b "${CMAKE_MATCH_2}")
  set(t_top ${a} PARENT_SCOPE)
  set(t_h ${b} PARENT_SCOPE)
endfunction()
# The track under screen y <py> (thousandths) in g_dump -> t_under (-1: none).
function(under py)
  set(r -1)
  foreach(i RANGE 0 33)
    string(REGEX MATCH "  track ${i} top ([-0-9.]+) h ([0-9.]+) " _ "${g_dump}")
    if(NOT CMAKE_MATCH_1 STREQUAL "")
      milli(a "${CMAKE_MATCH_1}")
      milli(b "${CMAKE_MATCH_2}")
      math(EXPR e "${a} + ${b}")
      if(b GREATER 0 AND NOT py LESS a AND py LESS e)
        set(r ${i})
      endif()
    endif()
  endforeach()
  set(t_under ${r} PARENT_SCOPE)
endfunction()

# ---- the layout ----
run(geo demo 12 "2 typing off\n10 plgeom\n")
geo(10)
math(EXPR px "900")
math(EXPR py "(${g_gy0} + ${g_gy1}) / 2000")  # the middle of the grid, whole px
set(gy0 ${g_gy0})
set(gy1 ${g_gy1})
check("the demo is taller than the view (${g_vt0} .. ${g_vt1} of ${gy0} .. ${gy1})" g_vt1 LESS gy1)

# One Alt+wheel notch (<dir> 1 / -1) at frame 62 after <pre> (scrolling to the place), plgeom on frames 60..90.
function(altwheel tag project dir pre)
  set(sc "2 typing off\n4 move ${px} ${py}\n${pre}60 mod alt 1\n62 wheel ${dir}\n86 mod alt 0\n")
  foreach(f RANGE 60 90)
    string(APPEND sc "${f} plgeom\n")
  endforeach()
  run(${tag} ${project} 92 "${sc}")
  set(out "${out}" PARENT_SCOPE)
endfunction()

# The point under the pointer at frame 60 stays under it at frames 61..90 (worst drift, thousandths of
# a px -> a_worst; frames in between -> a_between; the final track height -> a_th; the start's -> a_th0).
function(anchored)
  geo(60)
  math(EXPR p "${py} * 1000")
  under(${p})
  if(t_under LESS 0)
    fail("nothing under the pointer")
  endif()
  set(k ${t_under})
  trk(${k})
  math(EXPR off0 "${p} - ${t_top}")
  set(h0 ${t_h})
  set(th0 ${g_th})
  geo(90)
  set(th1 ${g_th})
  set(worst 0)
  set(n 0)
  foreach(f RANGE 61 90)
    geo(${f})
    if(NOT g_th EQUAL th0 AND NOT g_th EQUAL th1)
      math(EXPR n "${n} + 1")
    endif()
    trk(${k})
    math(EXPR want "${t_top} + ${off0} * ${t_h} / ${h0}")
    absdiff(d ${want} ${p})
    if(d GREATER worst)
      set(worst ${d})
    endif()
  endforeach()
  set(a_worst ${worst} PARENT_SCOPE)
  set(a_between ${n} PARENT_SCOPE)
  set(a_th ${th1} PARENT_SCOPE)
  set(a_th0 ${th0} PARENT_SCOPE)
  set(a_track ${k} PARENT_SCOPE)
endfunction()

set(mid "6 wheel -8\n")      # eight tracks down
set(bottom "6 wheel -60\n")  # past the end: the last track at the bottom
foreach(place top mid bottom)
  set(pre "")
  if(place STREQUAL "mid")
    set(pre "${mid}")
  elseif(place STREQUAL "bottom")
    set(pre "${bottom}")
  endif()
  # zoom in: anchored everywhere
  altwheel(${place}_in demo 1 "${pre}")
  anchored()
  check("${place}, Alt+wheel up: the tracks grow (${a_th0} -> ${a_th})" a_th GREATER a_th0)
  check("${place}, Alt+wheel up: it glides (${a_between} frames in between)" a_between GREATER_EQUAL 4)
  check("${place}, Alt+wheel up: track ${a_track} and the point in it stay under the pointer (worst ${a_worst} / 1000 px)" a_worst LESS_EQUAL 1000)
  # zoom out
  altwheel(${place}_out demo -1 "${pre}")
  anchored()
  check("${place}, Alt+wheel down: the tracks shrink (${a_th0} -> ${a_th})" a_th LESS a_th0)
  if(place STREQUAL "mid")
    check("mid, Alt+wheel down: track ${a_track} and the point in it stay under the pointer (worst ${a_worst} / 1000 px)" a_worst LESS_EQUAL 1000)
  elseif(place STREQUAL "top")
    set(ok 1)
    foreach(f RANGE 60 90)
      geo(${f})
      trk(0)
      if(NOT g_sy EQUAL 0 OR NOT t_top EQUAL gy0)
        set(ok 0)
      endif()
    endforeach()
    check("top, Alt+wheel down: the view stays pinned to the top at every frame" ok EQUAL 1)
  else()
    set(ok 1)
    set(worstEnd 0)
    foreach(f RANGE 60 90)
      geo(${f})
      trk(33)
      math(EXPR e "${t_top} + ${t_h}")
      absdiff(d ${e} ${gy1})
      if(d GREATER worstEnd)
        set(worstEnd ${d})
      endif()
    endforeach()
    check("bottom, Alt+wheel down: the last track stays at the view's bottom at every frame (worst ${worstEnd} / 1000 px)" worstEnd LESS_EQUAL 1000)
  endif()
endforeach()

# Mixed heights and a folded group, in the middle (the pointer on a tall track, then on a short one).
altwheel(mixed_in mixed 1 "${mid}")
anchored()
check("mixed heights, Alt+wheel up: track ${a_track} stays under the pointer (worst ${a_worst} / 1000 px)" a_worst LESS_EQUAL 1000 AND a_th GREATER a_th0)
altwheel(mixed_out mixed -1 "${mid}")
anchored()
check("mixed heights, Alt+wheel down: track ${a_track} stays under the pointer (worst ${a_worst} / 1000 px)" a_worst LESS_EQUAL 1000 AND a_th LESS a_th0)
geo(90)
trk(10)
check("mixed heights: the folded group's tracks take no room" t_h EQUAL 0)
# Two quick notches compose (the second lands mid-glide).
set(sc "2 typing off\n4 move ${px} ${py}\n${mid}60 mod alt 1\n62 wheel 1\n64 wheel 1\n86 mod alt 0\n")
foreach(f RANGE 60 90)
  string(APPEND sc "${f} plgeom\n")
endforeach()
run(twice demo 92 "${sc}")
anchored()
check("two quick notches: still anchored (worst ${a_worst} / 1000 px)" a_worst LESS_EQUAL 1000)
math(EXPR want "${a_th0} * 121 / 100")
absdiff(d ${a_th} ${want})
check("two quick notches: 1.1 x 1.1 the height (${a_th} vs ${want})" d LESS_EQUAL 20)

# ---- 2. the scrollers' ends ----
# Drag (<x0> <y0>) by (<dx> <dy>) in four steps from frame 62, plgeom at 60 and 90.
function(enddrag tag pre x0 y0 dx dy)
  set(sc "2 typing off\n4 move 900 ${py}\n${pre}58 move ${x0} ${y0}\n60 plgeom\n62 down 0\n")
  foreach(s 1 2 3 4)
    math(EXPR x "${x0} + ${dx} * ${s} / 4")
    math(EXPR y "${y0} + ${dy} * ${s} / 4")
    math(EXPR f "62 + ${s} * 3")
    string(APPEND sc "${f} move ${x} ${y}\n")
  endforeach()
  string(APPEND sc "80 up 0\n90 plgeom\n")
  run(${tag} demo 92 "${sc}")
  set(out "${out}" PARENT_SCOPE)
endfunction()
run(bars demo 62 "2 typing off\n4 move 900 ${py}\n${mid}20 mod shift 1\n22 wheel -6\n24 mod shift 0\n60 plgeom\n")
geo(60)
math(EXPR vx "${g_vx} / 1000")
math(EXPR hy "${g_hy} / 1000")
math(EXPR vtop "${g_vt0} / 1000 + 2")
math(EXPR vbot "${g_vt1} / 1000 - 2")
math(EXPR hl "${g_ht0} / 1000 + 2")
math(EXPR hr "${g_ht1} / 1000 - 2")
set(hpre "${mid}20 mod shift 1\n22 wheel -6\n24 mod shift 0\n")

enddrag(vbot "${mid}" ${vx} ${vbot} 0 40)
geo(60)
set(a0 ${g_vt0})
set(th0 ${g_th})
geo(90)
absdiff(d ${g_vt0} ${a0})
check("vertical scroller, bottom end dragged down: the tracks shrink (${th0} -> ${g_th})" g_th LESS th0)
check("vertical scroller, bottom end dragged down: the top end stays put (${a0} -> ${g_vt0})" d LESS_EQUAL 1000)

enddrag(vtop "${mid}" ${vx} ${vtop} 0 -30)
geo(60)
set(a1 ${g_vt1})
set(th0 ${g_th})
geo(90)
absdiff(d ${g_vt1} ${a1})
check("vertical scroller, top end dragged up: the tracks shrink (${th0} -> ${g_th})" g_th LESS th0)
check("vertical scroller, top end dragged up: the bottom end stays put (${a1} -> ${g_vt1})" d LESS_EQUAL 1000)

enddrag(vbotin "${mid}" ${vx} ${vbot} 0 -60)
geo(60)
set(a0 ${g_vt0})
set(th0 ${g_th})
geo(90)
absdiff(d ${g_vt0} ${a0})
check("vertical scroller, bottom end dragged up: the tracks grow (${th0} -> ${g_th})" g_th GREATER th0)
check("vertical scroller, bottom end dragged up: the top end stays put (${a0} -> ${g_vt0})" d LESS_EQUAL 1000)

enddrag(hright "${hpre}" ${hr} ${hy} -60 0)
geo(60)
set(a0 ${g_ht0})
set(p0 ${g_ppt})
geo(90)
absdiff(d ${g_ht0} ${a0})
check("horizontal scroller, right end dragged left: zoomed in (${p0} -> ${g_ppt})" g_ppt GREATER p0)
check("horizontal scroller, right end dragged left: the left end stays put (${a0} -> ${g_ht0})" d LESS_EQUAL 1000)

enddrag(hleft "${hpre}" ${hl} ${hy} -40 0)
geo(60)
set(a1 ${g_ht1})
set(p0 ${g_ppt})
geo(90)
absdiff(d ${g_ht1} ${a1})
check("horizontal scroller, left end dragged left: zoomed out (${p0} -> ${g_ppt})" g_ppt LESS p0)
check("horizontal scroller, left end dragged left: the right end stays put (${a1} -> ${g_ht1})" d LESS_EQUAL 1000)

# ---- 3. Ctrl+wheel ----
function(ctrlwheel tag mx)
  set(sc "2 typing off\n4 move 900 ${py}\n${hpre}40 move ${mx} ${py}\n50 mod ${ctrl} 1\n52 wheel 1\n80 mod ${ctrl} 0\n")
  foreach(f RANGE 50 82)
    string(APPEND sc "${f} plgeom\n")
  endforeach()
  run(${tag} demo 84 "${sc}")
  set(out "${out}" PARENT_SCOPE)
endfunction()
# The screen x <ax> (whole px) keeps its tick through frames 50..82 -> c_worst (thousandths of a px), c_p0 c_p1.
function(ctrlcheck ax)
  geo(50)
  math(EXPR off0 "${ax} * 1000 - ${g_x0}")
  set(p0 ${g_ppt})
  set(worst 0)
  foreach(f RANGE 51 82)
    geo(${f})
    math(EXPR want "${off0} * ${g_ppt} / ${p0}")
    math(EXPR got "${ax} * 1000 - ${g_x0}")
    absdiff(d ${got} ${want})
    if(d GREATER worst)
      set(worst ${d})
    endif()
  endforeach()
  set(c_worst ${worst} PARENT_SCOPE)
  set(c_p0 ${p0} PARENT_SCOPE)
  set(c_p1 ${g_ppt} PARENT_SCOPE)
endfunction()
ctrlwheel(ctrl_grid 1000)
ctrlcheck(1000)
check("Ctrl+wheel in a scrolled view zooms in (${c_p0} -> ${c_p1})" c_p1 GREATER c_p0)
check("Ctrl+wheel: the tick under the pointer stays put at every frame (worst ${c_worst} / 1000 px)" c_worst LESS_EQUAL 1000)
ctrlwheel(ctrl_head 260)
geo(50)
math(EXPR gx "${g_gx0} / 1000")
ctrlcheck(${gx})
check("Ctrl+wheel over the track headers zooms in (${c_p0} -> ${c_p1})" c_p1 GREATER c_p0)
check("Ctrl+wheel over the track headers: the grid's left edge keeps its tick (worst ${c_worst} / 1000 px)" c_worst LESS_EQUAL 1000)

# ---- 4. the piano roll's Alt+wheel ----
function(lane frame)
  string(REGEX MATCH "lane frame ${frame}: x0 [-0-9.]+ pxPerTick [0-9.]+ yTop ([-0-9.]+) [^\n]* pitchY0 ([-0-9.]+) rowH ([0-9.]+)" _ "${out}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no piano roll geometry at frame ${frame}")
  endif()
  milli(a "${CMAKE_MATCH_1}")
  milli(b "${CMAKE_MATCH_2}")
  milli(c "${CMAKE_MATCH_3}")
  set(l_top ${a} PARENT_SCOPE)
  set(l_py0 ${b} PARENT_SCOPE)
  set(l_rh ${c} PARENT_SCOPE)
endfunction()
run(pgeo song 30 "2 typing off\n28 lane\n")
lane(28)
math(EXPR ppy "(${l_top} / 1000 + 200) / 2")
foreach(dir 1 -1)
  set(sc "2 typing off\n20 move 700 ${ppy}\n30 mod alt 1\n32 wheel ${dir}\n56 mod alt 0\n")
  foreach(f RANGE 30 60)
    string(APPEND sc "${f} lane\n")
  endforeach()
  run(piano_${dir} song 70 "${sc}")
  lane(30)
  math(EXPR c0 "${ppy} * 1000 - ${l_py0}")  # the pointer's content y
  set(r0 ${l_rh})
  set(worst 0)
  foreach(f RANGE 31 60)
    lane(${f})
    math(EXPR want "${l_py0} + ${c0} * ${l_rh} / ${r0}")
    math(EXPR p "${ppy} * 1000")
    absdiff(d ${want} ${p})
    if(d GREATER worst)
      set(worst ${d})
    endif()
  endforeach()
  check("piano roll, Alt+wheel ${dir}: the rows change (${r0} -> ${l_rh})" NOT l_rh EQUAL r0)
  check("piano roll, Alt+wheel ${dir}: the key row and the point in it stay under the pointer (worst ${worst} / 1000 px)" worst LESS_EQUAL 1000)
endforeach()

# ---- 5. remembered ----
run(save demo 80 "2 typing off\n4 move ${px} ${py}\n10 mod alt 1\n12 wheel 1\n14 wheel 1\n16 wheel 1\n18 mod alt 0\n50 plgeom\n")
geo(50)
set(saved ${g_th})
file(READ "${OUT}/cfg_save/gridline/settings.json" sj)
string(REGEX MATCH "\"ui.playlistTrackHeight\": *([0-9.]+)" _ "${sj}")
set(sv "${CMAKE_MATCH_1}0")
milli(sv "${sv}")
absdiff(d ${sv} ${saved})
check("the vertical zoom is written to the settings (${sv} / 1000 px)" d LESS_EQUAL 1)
run(restore demo 14 "2 typing off\n10 plgeom\n" save)
geo(10)
absdiff(d ${g_th} ${saved})
check("the next start opens at the same vertical zoom (${saved} -> ${g_th})" d LESS_EQUAL 1 AND saved GREATER 46000)
