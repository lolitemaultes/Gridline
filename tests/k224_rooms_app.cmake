# K-270: the rooms column's tab, its slide, its width and the slim rail (all this computer's settings).
# The slide is checked at a fixed frame time with motion allowed, so it takes the same frames everywhere.
set(ENV{GRIDLINE_REDUCED_MOTION} "0")
set(WELCOME "\"ui.stage.welcomed\": true")
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}, \"ui.stage.roomsList\": 0}}")
