run(hslide 1440x900 50 "${DEMO}8 ${TC}\n10 down 0\n11 up 0\n13 stage\n40 stage\n42 shot ${SHOTS}/k270-handle-open.ppm\n" ${SHOW} --fixed-dt 16)
rdump(hslide 0)
check("a click on the tab slides it out: part way after two frames (${r_anim}, width ${r_width})" r_rail EQUAL 1 AND r_anim MATCHES "^0\\.[0-9]*[1-9]" AND r_width GREATER 10 AND r_width LESS 264)
rdump(hslide 1)
check("... then open at its width, the tab on its wall (${r_anim}, width ${r_width}, tab ${r_tabx})" r_anim STREQUAL "1.00" AND r_width EQUAL 264 AND r_tabx GREATER 264)
set(TO "move ${r_tabx} ${r_taby}")
math(EXPR WX "${r_tabx} - 9")   # the wall's width handle, above the tab
math(EXPR WY "${r_taby} - 140")
run(hclose 1440x900 50 "${DEMO}8 ${TO}\n9 ${TO}\n10 shot ${SHOTS}/k270-handle-open-hover.ppm\n12 down 0\n13 up 0\n40 stage\n" ${SHOW} --fixed-dt 16)
rdump(hclose 0)
check("a click on the open tab slides it closed (${r_rail} ${r_anim}, width ${r_width})" r_rail EQUAL 0 AND r_anim STREQUAL "0.00" AND r_width EQUAL 10)
run(hkey 1440x900 40 "${DEMO}6 focus Mixer\n10 key backslash\n24 stage\n26 key backslash\n38 stage\n" ${SHOW} --fixed-dt 16)
rdump(hkey 0)
check("the backslash key opens it (${r_rail})" r_rail EQUAL 1)
rdump(hkey 1)
check("... and closes it (${r_rail})" r_rail EQUAL 0)
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}, \"ui.stage.roomsList\": 0, \"ui.animations\": false}}")
run(hnomo 1440x900 30 "${DEMO}8 ${TC}\n10 down 0\n11 up 0\n13 stage\n" ${SHOW} --fixed-dt 16)
rdump(hnomo 0)
check("with interface animations off it opens at once (${r_anim})" r_anim STREQUAL "1.00")

# The width: drag the wall out (held at its most), in past the snap (the slim rail), out again (the rows'
# least), and a double-click puts it back.
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}}}")
math(EXPR W1 "${WX} + 400")
math(EXPR W2 "${WX} + 96 - 290")   # from the widest (360) to 70: under the snap
run(hwide 1440x900 70 "${DEMO}8 move ${WX} ${WY}\n10 down 0\n12 move ${W1} ${WY}\n14 move ${W1} ${WY}\n16 up 0\n20 stage\n" ${SHOW})
rdump(hwide 0)
check("dragged far out, it stops at its widest (${r_width})" r_width EQUAL 360 AND r_slim EQUAL 0)
math(EXPR WXW "${WX} + 96")
run(hslim 1440x900 40 "${DEMO}8 move ${WXW} ${WY}\n10 down 0\n12 move ${W2} ${WY}\n14 move ${W2} ${WY}\n16 up 0\n20 stage\n22 shot ${SHOTS}/k270-handle-rail.ppm\n" ${SHOW})
rdump(hslim 0)
check("dragged in past the snap: the slim rail (${r_width} ${r_slim})" r_width EQUAL 56 AND r_slim EQUAL 1)
check("the rail still has a place for each room (${r_x00} ${r_y00} ${r_y01})" r_x10 GREATER r_x00 AND r_y01 GREATER r_y10)
math(EXPR SX "(${r_x01} + ${r_x11}) / 2")
math(EXPR SY "(${r_y01} + ${r_y11}) / 2")
math(EXPR SW "${WX} - 208")  # the slim wall
math(EXPR SW2 "${SW} + 100")
run(hrailph 1440x900 30 "${DEMO}8 move ${SX} ${SY}\n12 move ${SX} ${SY}\n14 stage\n" ${SHOW})
rdump(hrailph 0)
check("the rail shows a room's headphones under the pointer (${r_px1} ${r_py1})" r_px1 GREATER 0)
run(hrail 1440x900 50 "${DEMO}8 move ${SX} ${SY}\n10 move ${r_px1} ${r_py1}\n12 move ${r_px1} ${r_py1}\n14 down 0\n15 up 0\n18 stage\n20 move ${SX} ${SY}\n22 move ${SX} ${SY}\n24 down 1\n25 up 1\n28 move ${SX} ${SY}\n30 shot ${SHOTS}/k270-handle-rail-menu.ppm\n32 stage\n" ${SHOW})
rdump(hrail 0)
check("the rail's headphones solo the room (${r_solo1})" r_solo1 EQUAL 1 AND r_listen EQUAL 1)
rdump(hrail 1)
check("right-click in the rail: the room's menu (${r_menu})" r_menu EQUAL 1)
run(hback 1440x900 40 "${DEMO}8 move ${SW} ${WY}\n10 down 0\n12 move ${SW2} ${WY}\n14 move ${SW2} ${WY}\n16 up 0\n20 stage\n" ${SHOW})
rdump(hback 0)
check("dragged out again: the rows at their least (${r_width} ${r_slim})" r_width EQUAL 240 AND r_slim EQUAL 0)
math(EXPR WM "${WX} - 24")  # the wall at 240
run(hreset 1440x900 40 "${DEMO}8 move ${WM} ${WY}\n10 down 0\n11 up 0\n12 down 0\n13 up 0\n20 stage\n" ${SHOW})
rdump(hreset 0)
check("a double-click on the wall puts it back (${r_width})" r_width EQUAL 264)

# Widths at 1920 and 1280 (shots), and a mixer with no room for the rows: the slim rail.
foreach(sz 1920x1080 1280x800)
  foreach(w 240 360)
    run(hw${sz}${w} ${sz} 16 "${DEMO}8 stage rooms width ${w}\n12 shot ${SHOTS}/k270-handle-${sz}-${w}.ppm\n14 stage\n" ${SHOW})
    rdump(hw${sz}${w} 0)
    check("${sz}: width ${w} (${r_width})" r_width EQUAL w)
  endforeach()
  run(hr${sz} ${sz} 16 "${DEMO}8 stage rooms width 56\n12 shot ${SHOTS}/k270-handle-${sz}-rail.ppm\n14 stage\n" ${SHOW})
  run(hc${sz} ${sz} 16 "${DEMO}8 stage rooms close\n12 shot ${SHOTS}/k270-handle-${sz}-closed.ppm\n14 stage\n" ${SHOW})
  file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}}}")
endforeach()
run(hsmall 640x560 16 "${DEMO}8 stage rooms width 360\n14 stage\n" ${SHOW})
rdump(hsmall 0)
check("a small mixer keeps the stage its room: the slim rail (${r_width} ${r_slim})" r_width EQUAL 56 AND r_slim EQUAL 1)
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}}}")

# K-270: on a short stage the front-row group sits inside the floor, nothing covers the listener and no
# tray covers another track's tile or name (the stage is laid out smaller when it must be); 1920x1080
# is left as it was (scale 1).
function(clear_listener tag)
  string(REGEX MATCH "listener ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+) scale ([0-9.]+) front ([-0-9]+)" _ "${${tag}_out}")
  set(lx0 ${CMAKE_MATCH_1})
  set(ly0 ${CMAKE_MATCH_2})
  set(lx1 ${CMAKE_MATCH_3})
  set(ly1 ${CMAKE_MATCH_4})
  set(sc ${CMAKE_MATCH_5})
  set(front ${CMAKE_MATCH_6})
  set(hits "")
  string(REGEX MATCHALL "token [0-9]+ x [-0-9.]+ y [-0-9.]+ side [-0-9.]+" toks "${${tag}_out}")
  foreach(t IN LISTS toks)
    string(REGEX MATCH "token ([0-9]+) x ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* side ([0-9]+)" _ "${t}")
    math(EXPR h "${CMAKE_MATCH_4} / 2")
    math(EXPR x0 "${CMAKE_MATCH_2} - ${h}")
    math(EXPR x1 "${CMAKE_MATCH_2} + ${h}")
    math(EXPR y0 "${CMAKE_MATCH_3} - ${h}")
    math(EXPR y1 "${CMAKE_MATCH_3} + ${h}")
    if(x1 GREATER lx0 AND x0 LESS lx1 AND y1 GREATER ly0 AND y0 LESS ly1)
      list(APPEND hits "token ${CMAKE_MATCH_1}")
    endif()
  endforeach()
  string(REGEX MATCHALL "group [0-9]+ count [0-9]+ box [-0-9.]+ [-0-9.]+ [-0-9.]+ [-0-9.]+" grs "${${tag}_out}")
  set(below "")
  set(covers "")
  foreach(gr IN LISTS grs)
    string(REGEX MATCH "group ([0-9]+) count [0-9]+ box ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)" _ "${gr}")
    if(CMAKE_MATCH_4 GREATER lx0 AND CMAKE_MATCH_2 LESS lx1 AND CMAKE_MATCH_5 GREATER ly0 AND CMAKE_MATCH_3 LESS ly1)
      list(APPEND hits "group ${CMAKE_MATCH_1}")
    endif()
    set(gk ${CMAKE_MATCH_1})
    set(bx0 ${CMAKE_MATCH_2})
    set(by0 ${CMAKE_MATCH_3})
    set(bx1 ${CMAKE_MATCH_4})
    set(by1 ${CMAKE_MATCH_5})
    math(EXPR edge "${front} + 6")
    if(by1 GREATER edge)
      list(APPEND below "group ${gk}")
    endif()
    # No other track's tile or its name under the tray (its own members sit in its cells).
    foreach(t IN LISTS toks)
      string(REGEX MATCH "token ([0-9]+) x ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* side ([0-9]+)" _ "${t}")
      set(ti ${CMAKE_MATCH_1})
      set(tx ${CMAKE_MATCH_2})
      set(ty ${CMAKE_MATCH_3})
      math(EXPR h "${CMAKE_MATCH_4} / 2")
      if(tx GREATER bx0 AND tx LESS bx1 AND ty GREATER by0 AND ty LESS by1)
        continue()  # a member, in its cell
      endif()
      set(hw ${h})
      if(hw LESS 35)
        set(hw 35)  # the name under it
      endif()
      math(EXPR x0 "${tx} - ${hw}")
      math(EXPR x1 "${tx} + ${hw}")
      math(EXPR y0 "${ty} - ${h}")
      math(EXPR y1 "${ty} + ${h} + 14")
      if(x1 GREATER bx0 AND x0 LESS bx1 AND y1 GREATER by0 AND y0 LESS by1)
        list(APPEND covers "group ${gk} over token ${ti}")
      endif()
    endforeach()
  endforeach()
  set(l_covers "${covers}" PARENT_SCOPE)
  set(l_hits "${hits}" PARENT_SCOPE)
  set(l_below "${below}" PARENT_SCOPE)
  set(l_scale "${sc}" PARENT_SCOPE)
endfunction()
foreach(sz 1440x900 1280x800 1920x1080)
  foreach(w 264 56 close)
    if(w STREQUAL "close")
      set(cmd "8 stage rooms close\n")
    else()
      set(cmd "8 stage rooms width ${w}\n")
    endif()
    run(lis${sz}${w} ${sz} 16 "${DEMO}${cmd}14 stage\n" ${SHOW})
    clear_listener(lis${sz}${w})
    set(clear 0)
    if("${l_hits}" STREQUAL "" AND "${l_below}" STREQUAL "" AND "${l_covers}" STREQUAL "")
      set(clear 1)
    endif()
    check("${sz}, column ${w}: no tile or tray over the listener (${l_hits}), every tray inside the floor (${l_below}), no tray over another tile or name (${l_covers}), scale ${l_scale}" clear)
    if(sz STREQUAL "1920x1080")
      check("1920x1080: the stage keeps its size (scale ${l_scale})" l_scale STREQUAL "1.00")
    endif()
    file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {${WELCOME}}}")
  endforeach()
endforeach()
