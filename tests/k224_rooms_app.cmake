rdump(hclosed 0)
check("closed: a thin edge with the tab on it (${r_rail} width ${r_width}, tab ${r_tabx} ${r_taby})" r_rail EQUAL 0 AND r_width EQUAL 10 AND r_tabx GREATER 0 AND r_anim STREQUAL "0.00")
set(TC "move ${r_tabx} ${r_taby}")
run(hhover 1440x900 16 "${DEMO}8 ${TC}\n12 ${TC}\n13 shot ${SHOTS}/k270-handle-hover.ppm\n14 stage\n" ${SHOW})
