# Gridline: Stage rooms in the real app (hidden, isolated config, scripted input, 1440x900, the mixer
# window in its Stage view). Every run starts with "stage demorooms": 14 named, placed tracks in three
# rooms (Opening, Glass Coast, Night Drive). Places come from a first run's "stage" report:
#   1. the rooms list is shown beside the stage, the shown room's tracks only on the stage;
#   2. a box dragged on the empty floor selects the tracks it touches while it is held (live), and
#      keeps them on release; Shift adds; Esc puts the selection back;
#   3. the selection dragged onto another room in the list: the room lights up while over it, the drop
#      moves every selected track there, as one undo step; undo brings them back;
#   4. vice versa: from that room back to the first, one undo step;
#   5. the Mix view with its room filter on, wide and thin: only the shown room's strips, and Shift-click
#      range selects never pick the hidden tracks between them.
#   K-270: the rooms column in every project, each room's headphones, deleting rooms, and the column's
#      tab (slide out and back, the \ key, at once with animations off), its width (dragged, held between
#      its least and most, a slim rail under the snap, double-click back) and the slim rail's rooms.
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> [-DSHOTS=<dir>] -P k224_rooms_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
file(MAKE_DIRECTORY "${OUT}/home")
set(ENV{HOME} "${OUT}/home")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
if(NOT SHOTS)  # "shot" takes a path without spaces
  set(SHOTS "/tmp/k224_rooms_shots")
endif()

function(run tag size frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size ${size} --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${o}")
  endif()
  set(${tag}_out "${o}" PARENT_SCOPE)
endfunction()

# rdump(<tag> <n>): the n-th (0-based) "stage" report. s_undo s_sel s_shown, per token index i: s_x<i>
# s_y<i> s_side<i> s_pan<i> s_depth<i>; r_count r_shown r_drop r_band r_rail; per room k: r_tracks<k>
# (a list of mixer indexes) r_x0<k> r_y0<k> r_x1<k> r_y1<k> (its row in the list).
function(rdump tag n)
  string(REPLACE ";" "," text "${${tag}_out}")
  string(REPLACE "[" "(" text "${text}")
  string(REPLACE "]" ")" text "${text}")
  string(REPLACE "stage frame " ";stage frame " all "${text}")
  list(LENGTH all count)
  math(EXPR k "${n} + 1")  # the first item is what came before the first report
  if(count LESS_EQUAL k)
    message(FATAL_ERROR "FAIL (${tag}): no stage report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${k} d)
  string(REGEX MATCH "undo ([0-9]+) sel ([-0-9,]+) focus [-0-9]+ shown ([0-9]+)" _ "${d}")
  set(s_undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(s_sel "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(s_shown "${CMAKE_MATCH_3}" PARENT_SCOPE)
  string(REGEX MATCHALL "token [0-9]+ [^\n]*" toks "${d}")
  set(ids "")
  foreach(p IN LISTS toks)
    string(REGEX MATCH "token ([0-9]+) x ([-0-9.]+) y ([-0-9.]+) side ([-0-9.]+) pan ([-0-9.]+) depth ([-0-9.]+)" _ "${p}")
    set(i "${CMAKE_MATCH_1}")
    list(APPEND ids ${i})
    set(vals "${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6}")
    set(f 0)
    foreach(name x y side pan depth)
      list(GET vals ${f} v)
      if(NOT name STREQUAL "pan" AND NOT name STREQUAL "depth")
        string(REGEX REPLACE "\\..*" "" v "${v}")  # pixels: whole numbers
      endif()
      set(s_${name}${i} "${v}" PARENT_SCOPE)
      math(EXPR f "${f} + 1")
    endforeach()
  endforeach()
  set(s_ids "${ids}" PARENT_SCOPE)
  string(REGEX MATCH "rooms ([0-9]+) shown ([0-9]+) listen ([0-9]+) drop ([-0-9]+) band ([01]) rail ([01])" _ "${d}")
  set(r_count "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(r_shown "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(r_listen "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(r_drop "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(r_band "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(r_rail "${CMAKE_MATCH_6}" PARENT_SCOPE)
  string(REGEX MATCH "rail [01] menu ([-0-9]+)" _ "${d}")
  set(r_menu "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "slim ([01]) width ([0-9]+) tab ([-0-9]+) ([-0-9]+) anim ([0-9.]+)" _ "${d}")
  set(r_slim "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(r_width "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(r_tabx "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(r_taby "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(r_anim "${CMAKE_MATCH_5}" PARENT_SCOPE)
  string(REGEX MATCHALL "  room [0-9]+ \\([^)]*\\) tracks [^\n]*" rms "${d}")
  foreach(p IN LISTS rms)
    string(REGEX MATCH "room ([0-9]+) \\([^)]*\\) tracks ([-0-9,]+) space [-0-9]+ row ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+) solo ([01]) used ([0-9]+)" _ "${p}")
    set(k "${CMAKE_MATCH_1}")
    string(REPLACE "," ";" tl "${CMAKE_MATCH_2}")
    set(r_tracks${k} "${tl}" PARENT_SCOPE)
    set(r_x0${k} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(r_y0${k} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(r_x1${k} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    set(r_y1${k} "${CMAKE_MATCH_6}" PARENT_SCOPE)
    set(r_solo${k} "${CMAKE_MATCH_7}" PARENT_SCOPE)
    set(r_used${k} "${CMAKE_MATCH_8}" PARENT_SCOPE)
    string(REGEX MATCH "phones ([-0-9]+) ([-0-9]+)" _ "${p}")  # (CMake keeps nine groups)
    set(r_px${k} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(r_py${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  endforeach()
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# in(<var> <item> <list...>): 1 when the item is in the list.
function(in var item)
  string(REPLACE "," ";" items "${ARGN}")
  list(FIND items "${item}" at)
  if(at GREATER -1)
    set(${var} 1 PARENT_SCOPE)
  else()
    set(${var} 0 PARENT_SCOPE)
  endif()
endfunction()

file(MAKE_DIRECTORY "${OUT}/cfg/gridline")
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true}}")
set(SHOW --show mixer --show stage)
set(DEMO "4 stage demorooms\n")

# ---- 1. the layout ----
run(layout 1440x900 16 "${DEMO}12 shot ${SHOTS}/k224-rooms-list.ppm\n14 stage\n" ${SHOW})
rdump(layout 0)
check("three rooms, the list beside the stage, the first room shown (${r_count} ${r_rail} ${r_shown})" r_count EQUAL 3 AND r_rail EQUAL 1 AND r_shown EQUAL 0)
check("the stage shows the first room's tracks only (${s_ids})" s_shown EQUAL 8)
set(U0 "${s_undo}")
# Keys (5) and Lead (7): to the left, at two distances; a box from beyond Keys to just past Lead.
math(EXPR bx0 "${s_x5} - ${s_side5}")
math(EXPR by0 "${s_y5} - ${s_side5}")
math(EXPR bx1 "${s_x7} + 6")
math(EXPR by1 "${s_y7} + 6")
math(EXPR bxm "(${bx0} + ${bx1}) / 2")
math(EXPR bym "(${by0} + ${by1}) / 2")
set(KX "${s_x5}")
set(KY "${s_y5}")
math(EXPR row1x "(${r_x01} + ${r_x11}) / 2")
math(EXPR row1y "(${r_y01} + ${r_y11}) / 2")
math(EXPR row0x "(${r_x00} + ${r_x10}) / 2")
math(EXPR row0y "(${r_y00} + ${r_y10}) / 2")
check("the rooms list has a row for each room (${row1x} ${row1y})" r_x11 GREATER r_x01 AND r_y11 GREATER r_y01)

# ---- 2. the box ----
run(band 1440x900 60 "${DEMO}10 move ${bx0} ${by0}\n12 down 0\n14 move ${bxm} ${bym}\n16 move ${bx1} ${by1}\n18 move ${bx1} ${by1}\n19 shot ${SHOTS}/k224-box-select.ppm\n20 stage\n22 up 0\n26 stage\n30 move ${bx0} ${by0}\n32 down 0\n34 move ${bx1} ${by1}\n36 move ${bx1} ${by1}\n38 key escape\n40 up 0\n44 stage\n" ${SHOW})
rdump(band 0)
in(k "5" ${s_sel})
in(l "7" ${s_sel})
check("while the box is held it is drawn and selects what it touches (sel ${s_sel}, band ${r_band})" r_band EQUAL 1 AND k AND l)
rdump(band 1)
in(k "5" ${s_sel})
in(l "7" ${s_sel})
check("on release the box's tracks stay selected (${s_sel})" k AND l AND s_undo EQUAL U0)
set(SEL "${s_sel}")
rdump(band 2)
check("Esc while dragging a box puts the selection back (${s_sel} was ${SEL})" s_sel STREQUAL SEL)

# ---- 3. the group onto another room, and undo ----
math(EXPR midX "(${KX} + ${row1x}) / 2")
set(BOX "10 move ${bx0} ${by0}\n12 down 0\n14 move ${bxm} ${bym}\n16 move ${bx1} ${by1}\n18 up 0\n")
run(group 1440x900 70 "${DEMO}${BOX}24 move ${KX} ${KY}\n26 down 0\n28 move ${midX} ${KY}\n30 move ${row1x} ${row1y}\n32 move ${row1x} ${row1y}\n33 shot ${SHOTS}/k224-group-drop.ppm\n34 stage\n36 up 0\n42 stage\n46 undo\n50 stage\n" ${SHOW})
rdump(group 0)
check("dragging the selection over a room lights that room (${r_drop})" r_drop EQUAL 1)
rdump(group 1)
in(k "5" ${r_tracks1})
in(l "7" ${r_tracks1})
in(k0 "5" ${r_tracks0})
check("the drop moves every selected track to that room (${r_tracks1})" k AND l AND NOT k0)
math(EXPR U1 "${U0} + 1")
check("as one undo step (${s_undo} after ${U0})" s_undo EQUAL U1)
check("the moved tracks left this stage (${s_shown})" s_shown EQUAL 6)
rdump(group 2)
in(k "5" ${r_tracks0})
in(l "7" ${r_tracks0})
check("undo brings them back (${r_tracks0})" k AND l AND s_undo EQUAL U0)

# ---- 4. vice versa: from Glass Coast back to Opening ----
run(layout2 1440x900 20 "${DEMO}8 stage roommove 1 5,7\n10 stage roomshow 1\n16 stage\n" ${SHOW})
rdump(layout2 0)
check("in the second room now (${r_shown}: ${s_ids})" r_shown EQUAL 1 AND s_shown EQUAL 6)
set(U2 "${s_undo}")
set(KX "${s_x5}")
set(KY "${s_y5}")
math(EXPR midX "(${KX} + ${row0x}) / 2")
run(back 1440x900 60 "${DEMO}8 stage roommove 1 5,7\n10 stage roomshow 1\n14 stage select 5,7\n20 move ${KX} ${KY}\n22 down 0\n24 move ${midX} ${KY}\n26 move ${row0x} ${row0y}\n28 move ${row0x} ${row0y}\n30 stage\n32 up 0\n38 stage\n" ${SHOW})
rdump(back 0)
check("over the first room it lights (${r_drop})" r_drop EQUAL 0)
rdump(back 1)
in(k "5" ${r_tracks0})
in(l "7" ${r_tracks0})
math(EXPR U3 "${U2} + 1")
check("vice versa: the group goes back to the first room, one undo step (${r_tracks0}, ${s_undo})" k AND l AND s_undo EQUAL U3)

# ---- 4b. reordering rooms keeps the room shown shown (the room menu's Move up / down) ----
run(order 1440x900 30 "${DEMO}8 stage roomorder 2 0\n12 stage\n14 stage roomorder 1 2\n18 stage\n20 stage roomorder 0 1\n24 stage\n" ${SHOW})
rdump(order 0)
check("the first room shown, another room moved above it: it stays shown (${r_shown}, ${s_shown} tracks)" r_shown EQUAL 1 AND s_shown EQUAL 8)
rdump(order 1)
check("the room shown moved down: it stays shown (${r_shown})" r_shown EQUAL 2)
rdump(order 2)
check("a move above it leaves it shown (${r_shown})" r_shown EQUAL 2)

# ---- 5. the Mix view's room filter, wide and thin: only the shown room's strips (and the master) ----
# Snare (2) joins Glass Coast first, so a hidden run of tracks (3..8) sits between it and the room's
# others in the mixer's order: Shift-click from Snare to Choir (9) must select only shown strips.
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true, \"ui.mix.roomFilter\": 1}}")
# mdump(<tag> <n>): the n-th "mixer" report: m_strips (mixer indexes drawn), m_sel; per strip i: m_x<i> m_y<i> (on its header).
function(mdump tag n)
  string(REPLACE ";" "," text "${${tag}_out}")
  string(REPLACE "mixer frame " ";mixer frame " all "${text}")
  math(EXPR k "${n} + 1")
  list(LENGTH all count)
  if(count LESS_EQUAL k)
    message(FATAL_ERROR "FAIL (${tag}): no mixer report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${k} d)
  string(REGEX MATCH "sel ([-0-9,]+) focus" _ "${d}")
  set(m_sel "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "  strips ([0-9,]*)" _ "${d}")
  set(m_strips "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCHALL "srect [0-9]+ [-0-9]+ [-0-9]+ [-0-9]+ [-0-9]+" rs "${d}")
  foreach(p IN LISTS rs)
    string(REGEX MATCH "srect ([0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+)" _ "${p}")
    math(EXPR cx "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
    math(EXPR cy "${CMAKE_MATCH_3} + 6")
    set(m_x${CMAKE_MATCH_1} "${cx}" PARENT_SCOPE)
    set(m_y${CMAKE_MATCH_1} "${cy}" PARENT_SCOPE)
  endforeach()
endfunction()

set(PREP "${DEMO}8 stage roommove 1 2\n10 stage roomshow 1\n")
foreach(lay wide thin)
  if(lay STREQUAL "wide")
    set(sz 1440x900)
  else()
    set(sz 400x900)
  endif()
  run(f${lay} ${sz} 24 "${PREP}14 shot ${SHOTS}/k224-mix-filter-${lay}.ppm\n16 stage\n20 mixer\n" --show mixer)
  rdump(f${lay} 0)
  mdump(f${lay} 0)
  check("${lay}: the second room is shown (${r_shown})" r_shown EQUAL 1)
  set(want 0 ${r_tracks1})
  string(REGEX MATCH "  room 1 [^\n]* space ([-0-9]+)" _ "${f${lay}_out}")
  if(CMAKE_MATCH_1 GREATER 0)
    list(APPEND want ${CMAKE_MATCH_1})
  endif()
  string(REPLACE "," ";" got "${m_strips}")
  list(SORT want COMPARE NATURAL)
  list(REMOVE_DUPLICATES want)
  list(SORT got COMPARE NATURAL)
  list(REMOVE_DUPLICATES got)
  check("${lay}: the filtered mixer shows the master and the shown room's strips only (${got} vs ${want})" got STREQUAL want)
  in(sn "2" ${m_strips})
  in(ch "9" ${m_strips})
  check("${lay}: Snare and Choir both show (${m_strips})" sn AND ch)
  run(s${lay} ${sz} 40 "${PREP}16 move ${m_x2} ${m_y2}\n18 down 0\n19 up 0\n22 mod shift 1\n24 move ${m_x9} ${m_y9}\n26 down 0\n27 up 0\n29 mod shift 0\n32 mixer\n" --show mixer)
  mdump(s${lay} 0)
  string(REPLACE "," ";" sel "${m_sel}")
  list(SORT sel COMPARE NATURAL)
  list(JOIN sel "," sel)
  check("${lay}: Shift-click from Snare to Choir selects only shown strips (${m_sel})" sel STREQUAL "2,9")
endforeach()

