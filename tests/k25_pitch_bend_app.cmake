# Gridline: K-25, the piano roll's pitch bend tool, driven by scripted input in the real app.
# Runs the app hidden (isolated config and HOME, fixed frame time) on a copy of the test song,
# editing pattern 0 ("Beat") on channel 6 ("Chords", no notes in that pattern):
#   1. four notes on C5; the N key turns the pitch bend tool on; a drag up two rows from the
#      middle of the third note adds one point (+2 semitones) to that note only, one undo step;
#   2. pixels: the bent line shows over the grid with the tool on, and back on the pencil (P) it
#      is still drawn, dimmer (never hidden): brightness at the line's ramp, tool on > pencil >
#      the empty grid beside it.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k25_pitch_bend_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)  # a copy: never the fixture itself

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --edit 0 6 --hide rack
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

# Four notes (C5, one beat each at 0, 96, 192, 288) made before the view centres on them.
set(make "2 mknotes 4 96 96\n3 typing off\n")
run(geo "${make}14 lane\n15 notes\n17 quit discard\n")
if(NOT geo_out MATCHES "lane frame [0-9]+: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([-0-9.]+) [^\n]* pitchY0 ([-0-9.]+) rowH ([0-9.]+)")
  message(FATAL_ERROR "FAIL: no piano roll geometry\n${geo_out}")
endif()
set(x0 ${CMAKE_MATCH_1})
set(ppt ${CMAKE_MATCH_2})
set(py0 ${CMAKE_MATCH_4})
set(rowH ${CMAKE_MATCH_5})
if(NOT geo_out MATCHES "notes frame [0-9]+: 4 notes")
  message(FATAL_ERROR "FAIL: the four notes were not made\n${geo_out}")
endif()
foreach(v x0 py0 rowH)
  string(REGEX REPLACE "\\..*" "" ${v} "${${v}}")
endforeach()
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)$" _p "${ppt}")
set(pptInt ${CMAKE_MATCH_1})
string(REGEX REPLACE "^0+" "" pptFrac "${CMAKE_MATCH_2}")
if(pptFrac STREQUAL "")
  set(pptFrac 0)
endif()
function(xat tick out)
  math(EXPR v "${x0} + ${tick} * ${pptInt} + ${tick} * ${pptFrac} / 1000000")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
# C5's row centre, the keyboard (to focus the piano roll), the drag on the third note.
math(EXPR cy "${py0} + (127 - 60) * ${rowH} + ${rowH} / 2")
math(EXPR keyX "${x0} - 20")
xat(240 xd)
math(EXPR y1 "${cy} - ${rowH}")
math(EXPR y2 "${cy} - 2 * ${rowH}")
set(bendDrag "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n18 key n\n20 move ${xd} ${cy}\n21 down 0\n23 move ${xd} ${y1}\n25 move ${xd} ${y2}\n27 up 0\n29 notes\n30 dump\n")

# 1. Toggle the tool and drag a point up two semitones on the third note.
run(drag "${bendDrag}31 quit discard\n")
if(NOT drag_out MATCHES "notes frame [0-9]+: 4 notes[^\n]*\n  note 0 [^\n]* bend 0\n  note 1 [^\n]* bend 0\n  note 2 [^\n]* bend 1 ([0-9.]+):([-0-9.]+):0\n  note 3 [^\n]* bend 0")
  message(FATAL_ERROR "FAIL: the drag should add one point to the third note only\n${drag_out}")
endif()
set(pt ${CMAKE_MATCH_1})
set(semis ${CMAKE_MATCH_2})
if(NOT semis STREQUAL "2.00")
  message(FATAL_ERROR "FAIL: two rows up should be +2 semitones (snapped), got ${semis}\n${drag_out}")
endif()
if(pt LESS 24 OR pt GREATER 72)
  message(FATAL_ERROR "FAIL: the point should sit where the drag started (about 48 ticks into the note), got ${pt}\n${drag_out}")
endif()
if(NOT drag_out MATCHES "dump frame [0-9]+: [0-9]+ clips, [0-9]+ selected, undo ([0-9]+)")
  message(FATAL_ERROR "FAIL: no undo position\n${drag_out}")
endif()
message(STATUS "ok - the bend tool (N) adds a +${semis} st point at tick ${pt} of the third note; undo position ${CMAKE_MATCH_1}")

# 2. Pixels: a shot with the tool on, then back on the pencil (P).
run(pix "${bendDrag}32 shot \"${OUT}/on.ppm\"\n34 key p\n38 shot \"${OUT}/off.ppm\"\n40 notes\n42 quit discard\n")
if(NOT pix_out MATCHES "note 2 [^\n]* bend 1 ")
  message(FATAL_ERROR "FAIL: switching back to the pencil should keep the bend\n${pix_out}")
endif()
foreach(f on off)
  if(NOT EXISTS "${OUT}/${f}.ppm")
    message(FATAL_ERROR "FAIL: no ${f}.ppm shot")
  endif()
endforeach()
# Brightest pixel (R+G+B) in a 5x5 box around (x, y) of a binary PPM.
function(bright file x y out)
  file(READ "${file}" head LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" hdr "${head}")
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${hdr}" hl)
  set(best 0)
  foreach(dy -2 -1 0 1 2)
    foreach(dx -2 -1 0 1 2)
      math(EXPR off "${hl} + ((${y} + ${dy}) * ${w} + ${x} + ${dx}) * 3")
      file(READ "${file}" px OFFSET ${off} LIMIT 3 HEX)
      string(SUBSTRING "${px}" 0 2 r)
      string(SUBSTRING "${px}" 2 2 g)
      string(SUBSTRING "${px}" 4 2 b)
      math(EXPR s "0x${r} + 0x${g} + 0x${b}")
      if(s GREATER best)
        set(best ${s})
      endif()
    endforeach()
  endforeach()
  set(${out} ${best} PARENT_SCOPE)
endfunction()
# The ramp's middle: half way from the note's start (tick 192, C5's centre) to the point, one row
# up (over the grid, above the note); the empty grid: the same row past the last note (tick 420).
string(REGEX REPLACE "\\..*" "" ptInt "${pt}")
math(EXPR tMid "192 + ${ptInt} / 2")
xat(${tMid} xm)
xat(420 xe)
bright("${OUT}/on.ppm" ${xm} ${y1} on)
bright("${OUT}/off.ppm" ${xm} ${y1} off)
bright("${OUT}/off.ppm" ${xe} ${y1} bg)
message(STATUS "line brightness: tool on ${on}, pencil ${off}, empty grid ${bg}")
math(EXPR onMin "${off} + 40")
math(EXPR offMin "${bg} + 60")
if(on LESS onMin)
  message(FATAL_ERROR "FAIL: with the tool on the line should be brighter than dimmed (${on} vs ${off})")
endif()
if(off LESS offMin)
  message(FATAL_ERROR "FAIL: back on the pencil the line should still be drawn (${off} vs grid ${bg})")
endif()
message(STATUS "ok - the line is lit with the tool, dimmed but drawn on the pencil")
