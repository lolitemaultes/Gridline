run(mkeys 1600x1300 mixer
    "4 move ${hx} ${hy}\n6 down 0\n7 up 0\n10 key delete\n14 mixer\n16 mod alt 1\n17 key left\n18 mod alt 0\n24 mixer\n30 quit discard\n")
mixAt(14)
want("mixer: Delete with a middle track selected keeps the tracks" "${m_n}" "${n0}")
