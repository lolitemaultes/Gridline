# ---- 2. mixer: Move left from the menu; Alt+Left and Delete on the selected middle track
run(mleft 1600x1300 mixer "4 move ${hx} ${hy}\n6 down 1\n7 up 1\n12 move ${lx} ${ly}\n14 down 0\n15 up 0\n16 move 700 120\n24 mixer\n30 quit discard\n")
mixAt(24)
