# Gridline: deleting things in the middle of a list from their right-click menus, in the real app (hidden,
# isolated config and HOME, fixed frame time). The menus are drawn while the views loop over the song's
# lists; an edit that removes an item there must not leave the view drawing from the old list.
#   1. mixer: insert 3 (fed by insert 2, sending to insert 4 and the master, a channel routed to it)
#      deleted from its track menu: one track fewer, no send or channel points at it, the app keeps
#      drawing; undo brings the track, its sends and the channel's routing back;
#   2. mixer: Move left from the menu and Alt+Left on the selected middle track move it; Delete with a
#      middle track selected leaves the tracks as they are (no key deletes a mixer track);
#   2b. mixer: several selected tracks deleted from the menu at once (two adjacent, three apart, all
#      but the master), each one undo step;
#   3. channel rack: a middle channel deleted from its menu and with Alt+Delete;
#   4. playlist: a middle track deleted from its track menu;
#   5. playlist picker: a pattern no clip uses deleted from its menu.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k156_delete_middle_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
# Insert 2 (Clap, id 4) feeds insert 3 (Hat, id 5) and the master; insert 3 sends to insert 4 (Open hat, id 6)
# and the master. The Hat channel plays into insert 3 already. A fifth pattern no clip uses.
string(JSON demo SET "${demo}" mixer 2 sends "[{\"level\": 1, \"to\": 5}, {\"level\": 1, \"to\": 2}]")
string(JSON demo SET "${demo}" mixer 3 sends "[{\"level\": 1, \"to\": 6}, {\"level\": 1, \"to\": 2}]")
string(JSON np LENGTH "${demo}" patterns)
string(JSON spare GET "${demo}" patterns 1)
string(JSON spare SET "${spare}" id 900)
string(JSON spare SET "${spare}" name "\"Spare\"")
string(JSON demo SET "${demo}" patterns ${np} "${spare}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag size show script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  set(extra)
  if(show)
    set(extra --show ${show})
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size ${size} ${extra}
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
# The dump block that starts with <head> (its first line and the indented lines after it).
function(dumpBlock head)
  string(FIND "${out}" "${head}" pos)
  if(pos LESS 0)
    message(FATAL_ERROR "FAIL: no '${head}' dump\n${out}")
  endif()
  string(SUBSTRING "${out}" ${pos} -1 rest)
  string(REGEX MATCH "^[^\n]*\n(  [^\n]*\n)*" b "${rest}")
  set(blk "${b}" PARENT_SCOPE)
endfunction()
# The "mixer" dump of <frame>: m_n (tracks), m_undo, m_<id>_sends ("4 2"), m_<id>_index, mch_<name> (its
# mixer track id), and the rects as mx_<name>_x/_y (centres).
function(mixAt frame)
  dumpBlock("mixer frame ${frame}:")
  if(NOT blk MATCHES "^mixer frame [0-9]+:[^\n]* undo ([0-9]+)")
    message(FATAL_ERROR "FAIL: no undo in mixer dump ${frame}\n${blk}")
  endif()
  set(m_undo ${CMAKE_MATCH_1} PARENT_SCOPE)
  string(REGEX MATCHALL "\n  track [0-9]+ volume" ts "${blk}")
  list(LENGTH ts n)
  set(m_n ${n} PARENT_SCOPE)
  string(REGEX MATCHALL "  mtrack [^\n]*" ms "${blk}")
  foreach(m IN LISTS ms)
    if(m MATCHES "  mtrack ([0-9]+) id ([0-9]+) name \\[[^]]*\\] sends ?(.*)$")
      set(m_${CMAKE_MATCH_2}_index ${CMAKE_MATCH_1} PARENT_SCOPE)
      set(m_${CMAKE_MATCH_2}_sends "${CMAKE_MATCH_3}" PARENT_SCOPE)
    endif()
  endforeach()
  string(REGEX MATCHALL "  mchannel [^\n]*" cs "${blk}")
  foreach(c IN LISTS cs)
    if(c MATCHES "  mchannel \\[([^]]*)\\] mixer ([0-9]+)")
      set(to ${CMAKE_MATCH_2})
      string(REGEX REPLACE "[^A-Za-z0-9]" "_" nm "${CMAKE_MATCH_1}")
      set(mch_${nm} ${to} PARENT_SCOPE)
    endif()
  endforeach()
  string(REGEX MATCHALL "  rect [^\n]*" rs "${blk}")
  foreach(r IN LISTS rs)
    if(r MATCHES "  rect (.+) ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*$")
      set(m1 "${CMAKE_MATCH_1}")
      math(EXPR cx "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
      math(EXPR cy "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_5}) / 2")
      string(REGEX REPLACE "[^A-Za-z0-9]" "_" nm "${m1}")
      set(mx_${nm}_x ${cx} PARENT_SCOPE)
      set(mx_${nm}_y ${cy} PARENT_SCOPE)
    endif()
  endforeach()
endfunction()
function(need var what)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "FAIL: ${what} was not drawn\n${out}")
  endif()
endfunction()

# ---- 1. mixer: delete insert 3 from its track menu (a tall window: the whole track menu fits)
run(mgeo 1600x1300 mixer "6 mixer\n10 quit discard\n")
mixAt(6)
set(n0 ${m_n})
want("mixer: insert 3 is the Hat track" "${m_5_index}" "3")
want("mixer: insert 2 feeds insert 3" "${m_4_sends}" "5 2")
want("mixer: insert 3 sends to insert 4 and the master" "${m_5_sends}" "6 2")
want("mixer: the Hat channel plays into insert 3" "${mch_Hat}" "5")
need(mx_strip_3_x "the strip of insert 3")
foreach(k RANGE 1 16)
  need(mx_strip_${k}_x "the strip of insert ${k}")
  set(sx_${k} ${mx_strip_${k}_x})
  set(sy_${k} ${mx_strip_${k}_y})
endforeach()
set(hx ${mx_strip_3_x})
set(hy ${mx_strip_3_y})
run(mmenu 1600x1300 mixer "4 move ${hx} ${hy}\n6 down 1\n7 up 1\n12 mixer\n16 quit discard\n")
mixAt(12)
need(mx_mixmenu_delete_x "the track menu's Delete")
need(mx_mixmenu_moveleft_x "the track menu's Move left")
set(dx ${mx_mixmenu_delete_x})
set(dy ${mx_mixmenu_delete_y})
set(lx ${mx_mixmenu_moveleft_x})
set(ly ${mx_mixmenu_moveleft_y})
run(mdel 1600x1300 mixer
    "4 move ${hx} ${hy}\n6 down 1\n7 up 1\n10 mixer\n12 move ${dx} ${dy}\n14 down 0\n15 up 0\n16 move 700 120\n24 mixer\n26 undo\n32 mixer\n40 quit discard\n")
mixAt(10)
set(u0 ${m_undo})
unset(m_5_index)
mixAt(24)
math(EXPR n1 "${n0} - 1")
want("mixer: Delete removes the middle track" "${m_n}" "${n1}")
if(DEFINED m_5_index)
  message(FATAL_ERROR "FAIL: insert 3 is still there\n${blk}")
endif()
message(STATUS "ok - mixer: the deleted track is gone")
want("mixer: insert 2 no longer sends to it" "${m_4_sends}" "2")
if(mch_Hat STREQUAL "5")
  message(FATAL_ERROR "FAIL: the Hat channel still plays into the deleted track\n${blk}")
endif()
message(STATUS "ok - mixer: the channel routed to it plays elsewhere")
math(EXPR u1 "${u0} + 1")
want("mixer: Delete is one undo step" "${m_undo}" "${u1}")
unset(m_5_index)
mixAt(32)
want("mixer: undo brings the track back" "${m_n}" "${n0}")
want("mixer: at its place" "${m_5_index}" "3")
want("mixer: undo brings the send into it back" "${m_4_sends}" "5 2")
want("mixer: undo brings its own sends back" "${m_5_sends}" "6 2")
want("mixer: undo brings the channel's routing back" "${mch_Hat}" "5")

# ---- 1b. the same in the default layout (the mixer docked under the rack, its inspector beside the strips)
run(dgeo 1600x1300 "" "6 mixer\n10 quit discard\n")
mixAt(6)
need(mx_strip_3_x "the docked strip of insert 3")
set(dhx ${mx_strip_3_x})
set(dhy ${mx_strip_3_y})
foreach(k 2 3 4 6)
  need(mx_strip_${k}_x "the docked strip of insert ${k}")
  set(dsx_${k} ${mx_strip_${k}_x})
  set(dsy_${k} ${mx_strip_${k}_y})
endforeach()
run(dmenu 1600x1300 "" "4 move ${dhx} ${dhy}\n6 down 1\n7 up 1\n12 mixer\n16 quit discard\n")
mixAt(12)
need(mx_mixmenu_delete_x "the docked track menu's Delete")
run(ddel 1600x1300 ""
    "4 move ${dhx} ${dhy}\n6 down 1\n7 up 1\n12 move ${mx_mixmenu_delete_x} ${mx_mixmenu_delete_y}\n14 down 0\n15 up 0\n16 move 700 120\n24 mixer\n30 quit discard\n")
