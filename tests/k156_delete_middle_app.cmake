# ---- 2b. several selected tracks deleted at once. multiDel(<tag> <clicks>): <clicks> select the tracks and
# right-click one of them (frames 4..20); the menu's Delete is read from a first run and clicked in a second.
function(multiDel tag clicks show)
  run(${tag}g 1600x1300 "${show}" "${clicks}22 mixer\n28 quit discard\n")
  unset(mx_mixmenu_delete_x)
  mixAt(22)
  need(mx_mixmenu_delete_x "the track menu's Delete (${tag})")
  run(${tag} 1600x1300 "${show}"
      "${clicks}22 mixer\n24 move ${mx_mixmenu_delete_x} ${mx_mixmenu_delete_y}\n26 down 0\n27 up 0\n28 move 700 1250\n36 mixer\n38 undo\n44 mixer\n50 quit discard\n")
  set(out "${out}" PARENT_SCOPE)
endfunction()
# The add-to-selection key: Cmd on macOS (there Ctrl + click is a right click), Ctrl elsewhere.
if(CMAKE_HOST_APPLE)
  set(addmod super)
else()
  set(addmod ctrl)
endif()
function(sel3 a b c)  # click a, add b and c to the selection, right-click c
  set(clicks "4 move ${sx_${a}} ${sy_${a}}\n5 down 0\n6 up 0\n8 move ${sx_${b}} ${sy_${b}}\n9 mod ${addmod} 1\n10 down 0\n11 up 0\n12 mod ${addmod} 0\n")
  if(NOT c STREQUAL "")
    string(APPEND clicks "13 move ${sx_${c}} ${sy_${c}}\n14 mod ${addmod} 1\n15 down 0\n16 up 0\n17 mod ${addmod} 0\n")
  else()
    set(c ${b})
  endif()
  string(APPEND clicks "18 move ${sx_${c}} ${sy_${c}}\n19 down 1\n20 up 1\n")
  set(clicks "${clicks}" PARENT_SCOPE)
endfunction()
# id_at_<k>: the track id at place k (from a fresh mixer dump)
run(mgeo2 1600x1300 mixer "6 mixer\n10 quit discard\n")
mixAt(6)
foreach(k RANGE 0 16)
  foreach(id RANGE 2 18)
    if(DEFINED m_${id}_index AND m_${id}_index EQUAL k)
      set(id_at_${k} ${id})
    endif()
  endforeach()
endforeach()
function(checkMulti what frame0 frame1 frame2 n expectGone)
  mixAt(${frame0})
  set(u0 ${m_undo})
  foreach(id RANGE 2 18)
    unset(m_${id}_index)
  endforeach()
  mixAt(${frame1})
  math(EXPR want_n "${n0} - ${n}")
  want("${what}: the tracks are deleted" "${m_n}" "${want_n}")
  foreach(id IN LISTS expectGone)
    if(DEFINED m_${id}_index)
      message(FATAL_ERROR "FAIL: ${what}: track ${id} is still there\n${blk}")
    endif()
  endforeach()
  math(EXPR u1 "${u0} + 1")
  want("${what}: in one undo step" "${m_undo}" "${u1}")
  mixAt(${frame2})
  want("${what}: undo brings them all back" "${m_n}" "${n0}")
  foreach(id IN LISTS expectGone)
    if(NOT DEFINED m_${id}_index)
      message(FATAL_ERROR "FAIL: ${what}: undo did not bring track ${id} back\n${blk}")
    endif()
  endforeach()
endfunction()
sel3(3 4 "")
multiDel(mm2 "${clicks}" mixer)
checkMulti("mixer: two adjacent selected tracks" 22 36 44 2 "${id_at_3};${id_at_4}")
sel3(2 4 6)
multiDel(mm3 "${clicks}" mixer)
checkMulti("mixer: three selected tracks apart" 22 36 44 3 "${id_at_2};${id_at_4};${id_at_6}")
set(clicks "4 move ${sx_1} ${sy_1}\n5 down 0\n6 up 0\n8 move ${sx_16} ${sy_16}\n9 mod shift 1\n10 down 0\n11 up 0\n12 mod shift 0\n18 move ${sx_8} ${sy_8}\n19 down 1\n20 up 1\n")
multiDel(mmall "${clicks}" mixer)
set(all)
foreach(k RANGE 1 16)
  list(APPEND all ${id_at_${k}})
endforeach()
math(EXPR nall "${n0} - 1")
checkMulti("mixer: every track but the master" 22 36 44 ${nall} "${all}")
# The same in the default layout (the mixer docked, its inspector beside the strips).
foreach(k 2 3 4 6)
  set(sx_${k} ${dsx_${k}})
  set(sy_${k} ${dsy_${k}})
endforeach()
sel3(3 4 "")
multiDel(dm2 "${clicks}" "")
checkMulti("docked mixer: two adjacent selected tracks" 22 36 44 2 "${id_at_3};${id_at_4}")
sel3(2 4 6)
multiDel(dm3 "${clicks}" "")
checkMulti("docked mixer: three selected tracks apart" 22 36 44 3 "${id_at_2};${id_at_4};${id_at_6}")

# ---- 3. channel rack: a middle channel from its menu, and with Alt+Delete
# rowAt(<frame> <index> <part>) -> row_x row_y (the centre of that part of the row); chans(<frame>) -> n_chans, k_undo.
function(rowAt frame idx part)
  dumpBlock("rack frame ${frame}:")
  if(NOT blk MATCHES "\n  rowgeom ${idx} [^\n]* ${part} ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*")
    message(FATAL_ERROR "FAIL: no ${part} for row ${idx} at frame ${frame}\n${blk}")
  endif()
  math(EXPR x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
  set(row_x ${x} PARENT_SCOPE)
  set(row_y ${y} PARENT_SCOPE)
endfunction()
function(chans frame)
  dumpBlock("rack frame ${frame}:")
  string(REGEX MATCHALL "\n  channel [0-9]+ volume" cs "${blk}")
  list(LENGTH cs n)
  set(n_chans ${n} PARENT_SCOPE)
  if(blk MATCHES "^rack frame [0-9]+:[^\n]* undo ([0-9]+)")
    set(k_undo ${CMAKE_MATCH_1} PARENT_SCOPE)
  endif()
  set(rk_del_x "" PARENT_SCOPE)
  if(blk MATCHES "\n  rect chmenu delete ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*")
    math(EXPR x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
    math(EXPR y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
    set(rk_del_x ${x} PARENT_SCOPE)
    set(rk_del_y ${y} PARENT_SCOPE)
  endif()
endfunction()
run(rgeo 1600x1300 "" "6 rack\n10 quit discard\n")
rowAt(6 3 name)
set(cx ${row_x})
set(cy ${row_y})
rowAt(6 3 lamp)
set(lampx ${row_x})
set(lampy ${row_y})
chans(6)
set(c0 ${n_chans})
run(rmenu 1600x1300 "" "4 move ${cx} ${cy}\n6 down 1\n7 up 1\n12 rack\n16 quit discard\n")
chans(12)
if(rk_del_x STREQUAL "")
  message(FATAL_ERROR "FAIL: the channel menu has no Delete\n${blk}")
endif()
run(rdel 1600x1300 "" "4 move ${cx} ${cy}\n6 down 1\n7 up 1\n10 rack\n12 move ${rk_del_x} ${rk_del_y}\n14 down 0\n15 up 0\n16 move 700 120\n24 rack\n26 undo\n32 rack\n40 quit discard\n")
chans(10)
set(u0 ${k_undo})
chans(24)
math(EXPR c1 "${c0} - 1")
want("rack: Delete from the menu removes the middle channel" "${n_chans}" "${c1}")
math(EXPR u1 "${u0} + 1")
want("rack: ... in one undo step" "${k_undo}" "${u1}")
chans(32)
want("rack: undo brings it back" "${n_chans}" "${c0}")
run(rkey 1600x1300 "" "4 move ${lampx} ${lampy}\n6 down 0\n7 up 0\n10 mod alt 1\n11 key delete\n12 mod alt 0\n20 rack\n26 quit discard\n")
chans(20)
want("rack: Alt+Delete removes the selected middle channel" "${n_chans}" "${c1}")

# ---- 4. playlist: a middle track from its track menu
function(plAt frame)
  dumpBlock("plgeom frame ${frame}:")
  if(NOT blk MATCHES "\n  view scrollY [-0-9.]+ trackHeight [0-9.]+ grid ([-0-9]+)[.0-9]* ")
    message(FATAL_ERROR "FAIL: no grid in plgeom ${frame}\n${blk}")
  endif()
  set(gx0 ${CMAKE_MATCH_1} PARENT_SCOPE)
  string(REGEX MATCHALL "\n  track [0-9]+ top [^\n]*" ts "${blk}")
  list(LENGTH ts n)
  set(pl_n ${n} PARENT_SCOPE)
  if(blk MATCHES "\n  track 3 top ([-0-9]+)[.0-9]* h ([0-9]+)[.0-9]* [^\n]* name \"([^\"]*)\"")
    math(EXPR y "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} / 2")
    set(t3y ${y} PARENT_SCOPE)
    set(t3name "${CMAKE_MATCH_3}" PARENT_SCOPE)
  endif()
  if(blk MATCHES "\n  track 4 top [^\n]* name \"([^\"]*)\"")
    set(t4name "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endif()
  if(blk MATCHES "\n  plus [-0-9.]+ [-0-9.]+ droptrack -?[0-9]+ patterns ([0-9]+) current [0-9]+ undo ([0-9]+)")
    set(pl_patterns ${CMAKE_MATCH_1} PARENT_SCOPE)
    set(pl_undo ${CMAKE_MATCH_2} PARENT_SCOPE)
  endif()
endfunction()
# The playlist's tracks are named here so that a deleted middle track shows by its name moving up.
string(JSON nt LENGTH "${demo}" tracks)
math(EXPR last "${nt} - 1")
foreach(k RANGE 0 ${last})
  string(JSON demo SET "${demo}" tracks ${k} name "\"Lane ${k}\"")
endforeach()
file(WRITE "${OUT}/song.gridline.json" "${demo}")
run(pgeo 1600x1300 playlist "6 plgeom\n10 quit discard\n")
plAt(6)
set(p0 ${pl_n})
want("playlist: track 3 is Lane 3" "${t3name}" "Lane 3")
math(EXPR px "${gx0} - 60")
set(py ${t3y})
run(pmenu 1600x1300 playlist "4 move ${px} ${py}\n6 down 1\n7 up 1\n12 mixer\n16 quit discard\n")
mixAt(12)
need(mx_trmenu_delete_x "the playlist track menu's Delete track")
run(pdel 1600x1300 playlist "4 move ${px} ${py}\n6 down 1\n7 up 1\n10 plgeom\n12 move ${mx_trmenu_delete_x} ${mx_trmenu_delete_y}\n14 down 0\n15 up 0\n16 move 700 120\n24 plgeom\n26 undo\n32 plgeom\n40 quit discard\n")
plAt(10)
set(u0 ${pl_undo})
plAt(24)
want("playlist: Delete track moves the next track up" "${t3name}" "Lane 4")
math(EXPR u1 "${u0} + 1")
want("playlist: ... in one undo step" "${pl_undo}" "${u1}")
plAt(32)
want("playlist: undo brings the track back" "${t3name}" "Lane 3")

# ---- 5. playlist picker: the unused pattern from its menu
function(pickAt frame id)
  dumpBlock("plgeom frame ${frame}:")
  set(row_x "" PARENT_SCOPE)
  if(blk MATCHES "\n  row ${id} x ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]*")
    set(row_x ${CMAKE_MATCH_1} PARENT_SCOPE)
    set(row_y ${CMAKE_MATCH_2} PARENT_SCOPE)
  endif()
endfunction()
run(kgeo 1600x1300 playlist "6 plgeom\n10 quit discard\n")
pickAt(6 900)
if(row_x STREQUAL "")
  message(FATAL_ERROR "FAIL: the picker shows no row for the spare pattern\n${blk}")
endif()
set(sx ${row_x})
set(sy ${row_y})
plAt(6)
set(pp0 ${pl_patterns})
run(kmenu 1600x1300 playlist "4 move ${sx} ${sy}\n6 down 1\n7 up 1\n12 mixer\n16 quit discard\n")
mixAt(12)
need(mx_patmenu_delete_x "the pattern menu's Delete")
run(kdel 1600x1300 playlist "4 move ${sx} ${sy}\n6 down 1\n7 up 1\n12 move ${mx_patmenu_delete_x} ${mx_patmenu_delete_y}\n14 down 0\n15 up 0\n16 move 700 120\n24 plgeom\n30 quit discard\n")
plAt(24)
math(EXPR pp1 "${pp0} - 1")
want("picker: Delete removes the unused pattern" "${pl_patterns}" "${pp1}")
pickAt(24 900)
want("picker: its row is gone" "${row_x}" "")
