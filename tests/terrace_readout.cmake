# Gridline - Terrace shows its lane readout ("16 steps = 1 bar", on the lane's ruler) on every
# lane (user 2026-11-21), not only on lanes changed from the default: the default sound and every
# factory sound, with 3 bands and with 4 (hidden, off-screen, isolated config).
# The editor's "terrace" report ends with "readouts <n>": the lanes drawn with a readout that frame.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P terrace_readout.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg" "${OUT}/home")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/home")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{SDL_AUDIODRIVER} "dummy")

set(presets 31)
set(script "5 toasts clear\n10 terrace\n")
set(f 14)
math(EXPR last "${presets} - 1")
foreach(k RANGE 0 ${last})
  math(EXPR g "${f} + 4")
  string(APPEND script "${f} terrace preset ${k}\n${g} terrace\n")
  math(EXPR f "${f} + 8")
endforeach()
math(EXPR q "${f} + 4")
math(EXPR frames "${q} + 10")
string(APPEND script "${q} quit discard\n")
file(WRITE "${OUT}/script.txt" "${script}")
execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --plugin gl.terrace --size 1600x1000 --frames ${frames}
                        --dev-input "${OUT}/script.txt"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "gridline-app failed (${rc}): ${err}")
endif()

string(REGEX MATCHALL "terrace frame [0-9]+: [^\n]*" reports "${out}")
list(LENGTH reports n)
math(EXPR want "${presets} + 1")
if(n LESS want)
  message(FATAL_ERROR "FAIL: ${n} Terrace reports printed, wanted ${want}. Output:\n${out}")
endif()
set(three 0)
set(four 0)
foreach(line IN LISTS reports)
  if(NOT line MATCHES "bands ([34]) .* readouts ([0-9]+)$")
    message(FATAL_ERROR "FAIL: no bands / readouts in '${line}'")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "FAIL: ${CMAKE_MATCH_1} bands but ${CMAKE_MATCH_2} lane readouts: '${line}'")
  endif()
  if(CMAKE_MATCH_1 EQUAL 3)
    math(EXPR three "${three} + 1")
  else()
    math(EXPR four "${four} + 1")
  endif()
endforeach()
if(three EQUAL 0 OR four EQUAL 0)
  message(FATAL_ERROR "FAIL: wanted sounds with 3 bands and with 4 (3: ${three}, 4: ${four})")
endif()
message(STATUS "ok - every lane shows its readout: ${n} sounds (${three} with 3 bands, ${four} with 4)")
