# Gridline: the Open / Save dialog's path bar sizes each part for the text drawn in it. The current
# folder's part is drawn in bold, the others in the regular weight; each part's button is measured in
# the font its label is drawn in, so the whole label shows inside its own part (no ellipsis, nothing
# cut off) and the parts do not overlap. Checked at 100 %, 150 % and 200 % interface scale against
# the glyphs the bar's draw list holds (the app's "filedialog crumbs" report reads them back), in a
# folder whose names are wide in bold. Runs the app hidden (isolated config and HOME).
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P k280_path_bar_app.cmake
cmake_minimum_required(VERSION 3.18)
file(REMOVE_RECURSE "${OUT}")
set(H "${OUT}/home")
set(D "${H}/Music/Mixdowns WWW/Masters MMWW Bold")
file(MAKE_DIRECTORY "${OUT}/cfg" "${D}")
file(WRITE "${D}/take.wav" "")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${H}")
set(ENV{USERPROFILE} "${H}")
set(ENV{XDG_CONFIG_HOME} "${OUT}/cfg")
set(ENV{XDG_CACHE_HOME} "${OUT}/cache")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")

function(field line regex out)  # the numbers a regex captures (up to 4) as a list
  if(NOT "${line}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL: no match for ${regex} in: ${line}")
  endif()
  set(${out} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()
function(cents v out)  # a report's "%.2f" number in hundredths of a pixel (CMake compares integers only)
  string(REGEX REPLACE "^(-?)([0-9]+)\\.([0-9][0-9])$" "\\1\\2\\3" c "${v}")
  math(EXPR c "${c}")
  set(${out} ${c} PARENT_SCOPE)
endfunction()

foreach(v "1440x900;1" "1920x1200;1.5" "2880x1800;2")
  list(GET v 0 size)
  list(GET v 1 scale)
  string(REPLACE "." "_" tag "x${scale}")
  file(WRITE "${OUT}/${tag}.txt" "2 loadhold off
3 filedialog open \"${D}\"
4 waitfor \"filedialog:${D}\" 60
8 filedialog crumbs
10 filedialog state
")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --size ${size} --ui-scale ${scale} --frames 14
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL (${tag}): gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  string(REGEX MATCH "crumbs frame [^\n]*\n([^\n]*\n)*crumbs end" rep "${out}")
  if(rep STREQUAL "")
    message(FATAL_ERROR "FAIL (${tag}): no path bar report\n${out}")
  endif()
  string(REGEX MATCHALL "  part [^\n]*" parts "${rep}")
  string(REGEX MATCHALL "  run [^\n]*" runs "${rep}")
  list(LENGTH parts np)
  if(np LESS 3)
    message(FATAL_ERROR "FAIL (${tag}): ${np} path bar parts shown, want the last three folders at least\n${rep}")
  endif()
  list(GET parts -1 lastPart)
  if(NOT lastPart MATCHES "^  part \"Masters MMWW Bold\" bold ")
    message(FATAL_ERROR "FAIL (${tag}): the current folder is not the last part, in bold: ${lastPart}\n${rep}")
  endif()
  set(prevX1 "-")
  set(prevX1c -100000000)
  foreach(p ${parts})
    field("${p}" "^  part \"([^\"]*)\" (bold|regular) box ([-0-9.]+) [-0-9.]+ ([-0-9.]+)" f)
    list(GET f 0 label)
    list(GET f 1 weight)
    list(GET f 2 bx0)
    list(GET f 3 bx1)
    field("${p}" " text ([-0-9.]+)$" t)
    list(GET t 0 tw)
    foreach(n bx0 bx1 tw)
      cents(${${n}} ${n}c)
    endforeach()
    if(bx0c LESS prevX1c)
      message(FATAL_ERROR "FAIL (${tag}): the part \"${label}\" starts at ${bx0}, before the part left of it ends (${prevX1})\n${rep}")
    endif()
    set(prevX1 ${bx1})
    set(prevX1c ${bx1c})
    math(EXPR boxW "${bx1c} - ${bx0c}")
    if(boxW LESS twc)
      message(FATAL_ERROR "FAIL (${tag}): the part \"${label}\" (${weight}) is ${boxW}/100 px wide, its label ${tw} px in the font it is drawn in\n${rep}")
    endif()
    # the label drawn in it: the whole text (no ellipsis), every glyph inside the part, none cut off
    string(REPLACE " " "" want "${label}")
    set(found 0)
    foreach(r ${runs})
      field("${r}" "^  run \"([^\"]*)\" ink ([-0-9.]+) [-0-9.]+ ([-0-9.]+) [-0-9.]+ pen [-0-9.]+ [-0-9.]+ clipped ([01])" rf)
      list(GET rf 0 s)
      list(GET rf 1 ix0)
      list(GET rf 2 ix1)
      list(GET rf 3 clip)
      cents(${ix0} ix0c)
      cents(${ix1} ix1c)
      if(ix0c GREATER_EQUAL bx0c AND ix1c LESS_EQUAL bx1c)
        if(NOT s STREQUAL want)
          message(FATAL_ERROR "FAIL (${tag}): the part \"${label}\" (${weight}, ${boxW}/100 px for a ${tw} px label) shows \"${s}\": the label does not fit its part\n${rep}")
        endif()
        if(clip EQUAL 1)
          message(FATAL_ERROR "FAIL (${tag}): the label \"${label}\" is cut off\n${rep}")
        endif()
        set(found 1)
      elseif(s STREQUAL want)
        message(FATAL_ERROR "FAIL (${tag}): the label \"${label}\" is drawn at ${ix0} to ${ix1}, outside its part (${bx0} to ${bx1})\n${rep}")
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "FAIL (${tag}): no text drawn in the part \"${label}\"\n${rep}")
    endif()
  endforeach()
  message(STATUS "ok - ${tag} (${size}): ${np} path bar parts, each label whole inside its own part (the current folder's in bold)")
endforeach()
