# Gridline: knob drag checks in the real app (hidden, isolated config and HOME, fixed frame time),
# shared by the knob tests. The app's dev report ("knobs") lists every knob and plugin editor control of
# the last frame (item id, window, id, name, value, normalized value and default, centre); "atknob <item>
# [dx dy]" puts the pointer on one. Include it after setting APP, OUT and SONG (the project to open).
#
#   knob_run(<tag> <script> [app args...])           runs the app on SONG; output in ${tag}_out
#   knob_collect(<out> <frame> <window regex> <prefix>)
#       the knobs of that dump in matching windows: ${prefix}_items (item ids), and per item
#       ${prefix}_<item>_kind / _norm / _def / _value / _id / _name / _win
#   knob_sweep(<tag> <setup script> <first frame> <window regex> [app args...])
#       drags every knob of the matching windows, one after the other, and checks each one:
#         1. a slow drag (1 px a frame, 40 px, away from the nearer end) moves it by what the pointer
#            travelled (0.005 of the range a pixel, choices 0.01), to the nearest step where it has steps;
#         2. after the release it stays there;
#         3. a fine drag (Shift, 1 px a frame, 30 px) on a continuous knob moves it a little, the same way;
#         4. a double-click puts it back on its default.
#       Every check that fails is listed, then the test stops with a FATAL_ERROR naming them.
#       KNOB_SKIP: a list of "<window>/<id>" knobs to leave alone (for example one that closes the window).
cmake_minimum_required(VERSION 3.16)

function(knob_run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  # (--no-draw: the checks read the knob reports, not pixels; a software OpenGL spends most of a frame drawing,
  # which made a long sweep run out of time on a slow runner)
  execute_process(COMMAND "${APP}" "${SONG}" --hidden --no-ui-sounds --no-draw --fixed-dt 16 --size 1440x900 ${ARGN} --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

# The "knobs" dump printed at <frame>.
function(knob_block out frame var)
  string(FIND "${out}" "knobs frame ${frame} " at)
  if(at LESS 0)
    message(FATAL_ERROR "FAIL: no knob report at frame ${frame}")
  endif()
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(FIND "${rest}" "knobs end" e)
  string(SUBSTRING "${rest}" 0 ${e} block)
  set(${var} "${block}" PARENT_SCOPE)
endfunction()

function(knob_collect out frame winre prefix)
  knob_block("${out}" ${frame} block)
  string(REGEX MATCH "undo ([0-9]+)" _ "${block}")
  set(${prefix}_undo ${CMAKE_MATCH_1} PARENT_SCOPE)
  string(REPLACE ";" "," block "${block}")
  string(REPLACE "\n" ";" lines "${block}")
  set(items "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^  knob [0-9]+ ([a-z]+) item ([0-9a-f]+) win \"([^\"]*)\" id \"([^\"]*)\" name \"([^\"]*)\" value ([^ ]+) norm ([-0-9.]+) def ([-0-9.]+) step ([-0-9.]+) at ")
      set(kind ${CMAKE_MATCH_1})
      set(item ${CMAKE_MATCH_2})
      set(win "${CMAKE_MATCH_3}")
      set(id "${CMAKE_MATCH_4}")
      set(name "${CMAKE_MATCH_5}")
      set(value ${CMAKE_MATCH_6})
      set(norm ${CMAKE_MATCH_7})
      set(def ${CMAKE_MATCH_8})
      set(step ${CMAKE_MATCH_9})
      if(win MATCHES "${winre}" AND NOT item IN_LIST items)
        list(APPEND items ${item})
        set(${prefix}_${item}_kind ${kind} PARENT_SCOPE)
        set(${prefix}_${item}_win "${win}" PARENT_SCOPE)
        set(${prefix}_${item}_id "${id}" PARENT_SCOPE)
        set(${prefix}_${item}_name "${name}" PARENT_SCOPE)
        set(${prefix}_${item}_value ${value} PARENT_SCOPE)
        set(${prefix}_${item}_norm ${norm} PARENT_SCOPE)
        set(${prefix}_${item}_def ${def} PARENT_SCOPE)
        set(${prefix}_${item}_step ${step} PARENT_SCOPE)
      endif()
    endif()
  endforeach()
  set(${prefix}_items "${items}" PARENT_SCOPE)
endfunction()

# |a - b| <= tol, on decimal strings (cmake has no floats: millionths as integers).
function(knob_micro x var)
  if(NOT x MATCHES "^(-?)([0-9]*)\\.?([0-9]*)$")
    set(${var} 0 PARENT_SCOPE)
    return()
  endif()
  set(sign "${CMAKE_MATCH_1}")
  set(int "${CMAKE_MATCH_2}")
  set(frac "${CMAKE_MATCH_3}000000")
  string(SUBSTRING "${frac}" 0 6 frac)
  if(int STREQUAL "")
    set(int 0)
  endif()
  string(REGEX MATCH "[1-9][0-9]*$" frac "${frac}")  # (no leading zeros: math() would not take them)
  if(frac STREQUAL "")
    set(frac 0)
  endif()
  math(EXPR v "${int} * 1000000 + ${frac}")
  if(sign STREQUAL "-")
    math(EXPR v "0 - ${v}")
  endif()
  set(${var} ${v} PARENT_SCOPE)
endfunction()

function(knob_sweep tag setup first winre)
  set(args ${ARGN})
  # 1. Which knobs there are, and where they start.
  knob_run(${tag}_list "${setup}${first} knobs\n${first}9 quit discard\n" ${args})
  knob_collect("${${tag}_list_out}" ${first} "${winre}" K)
  list(LENGTH K_items count)
  if(count EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: no knobs in windows matching \"${winre}\"\n${${tag}_list_out}")
  endif()
  # 2. One run drags them all; the report after each step tells what it did.
  set(s "${setup}")
  set(f ${first})
  set(plan "")
  foreach(item IN LISTS K_items)
    set(key "${K_${item}_win}/${K_${item}_id}")
    if(key IN_LIST KNOB_SKIP)
      continue()
    endif()
    knob_micro(${K_${item}_norm} n0)
    if(n0 GREATER 500000)
      set(dir 1)   # pointer moves down: the value goes down
    else()
      set(dir -1)  # up: the value goes up
    endif()
    math(EXPR f0 "${f} + 2")
    string(APPEND s "${f} knobs\n${f0} atknob ${item}\n")
    math(EXPR f "${f0} + 2")
    string(APPEND s "${f} down 0\n")
    foreach(i RANGE 1 40)
      math(EXPR f "${f} + 1")
      math(EXPR dy "${i} * ${dir}")
      string(APPEND s "${f} atknob ${item} 0 ${dy}\n")
    endforeach()
    math(EXPR f "${f} + 4")  # held still a few frames: every control has taken the last move
    set(fDrag ${f})
    string(APPEND s "${f} knobs\n")
    math(EXPR f "${f} + 1")
    string(APPEND s "${f} up 0\n")
    math(EXPR f "${f} + 6")
    set(fStay ${f})
    string(APPEND s "${f} knobs\n")
    set(fFine 0)
    if(K_${item}_kind STREQUAL "knob")
      math(EXPR f "${f} + 2")
      string(APPEND s "${f} atknob ${item}\n${f} mod shift 1\n")
      math(EXPR f "${f} + 2")
      string(APPEND s "${f} down 0\n")
      foreach(i RANGE 1 30)
        math(EXPR f "${f} + 1")
        math(EXPR dy "${i} * ${dir}")
        string(APPEND s "${f} atknob ${item} 0 ${dy}\n")
      endforeach()
      math(EXPR f "${f} + 2")
      string(APPEND s "${f} up 0\n${f} mod shift 0\n")
      math(EXPR f "${f} + 3")
      set(fFine ${f})
      string(APPEND s "${f} knobs\n")
    endif()
    # Double-click: back to the default.
    math(EXPR f "${f} + 2")
    string(APPEND s "${f} atknob ${item}\n")
    math(EXPR f "${f} + 2")
    string(APPEND s "${f} down 0\n")
    math(EXPR f "${f} + 1")
    string(APPEND s "${f} up 0\n")
    math(EXPR f "${f} + 1")
    string(APPEND s "${f} down 0\n")
    math(EXPR f "${f} + 1")
    string(APPEND s "${f} up 0\n")
    math(EXPR f "${f} + 4")
    set(fReset ${f})
    string(APPEND s "${f} knobs\n")
    # A double-click at the default opens the type-in: close it so the next knob gets its press.
    math(EXPR f "${f} + 2")
    string(APPEND s "${f} closepopups\n")
    math(EXPR f "${f} + 4")
    list(APPEND plan "${item}:${dir}:${fDrag}:${fStay}:${fFine}:${fReset}")
  endforeach()
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} quit discard\n")
  knob_run(${tag}_drag "${s}" ${args})
  set(out "${${tag}_drag_out}")
  set(fails "")
  set(passed 0)
  foreach(p IN LISTS plan)
    string(REPLACE ":" ";" p "${p}")
    list(GET p 0 item)
    list(GET p 1 dir)
    list(GET p 2 fDrag)
    list(GET p 3 fStay)
    list(GET p 4 fFine)
    list(GET p 5 fReset)
    set(what "${tag}: ${K_${item}_win} knob ${K_${item}_id} \"${K_${item}_name}\" (${K_${item}_kind})")
    knob_collect("${out}" ${fDrag} "." D)
    knob_collect("${out}" ${fStay} "." S)
    if(NOT DEFINED D_${item}_norm OR NOT DEFINED S_${item}_norm)
      list(APPEND fails "${what}: gone from the report after the drag")
      continue()
    endif()
    # The drag starts from the value the knob had just before it (an earlier knob may have moved it).
    math(EXPR fBefore "${fDrag} - 48")
    knob_collect("${out}" ${fBefore} "." B)
    knob_micro(${B_${item}_norm} n0)
    knob_micro(${D_${item}_norm} n1)
    knob_micro(${S_${item}_norm} n2)
    set(kind ${K_${item}_kind})
    if(kind STREQUAL "choice")
      set(per 10000)
    else()
      set(per 5000)
    endif()
    math(EXPR want "${n0} - ${dir} * 40 * ${per}")
    if(want GREATER 1000000)
      set(want 1000000)
    elseif(want LESS 0)
      set(want 0)
    endif()
    math(EXPR moved "${n1} - ${n0}")
    math(EXPR err "${n1} - ${want}")
    if(err LESS 0)
      math(EXPR err "0 - ${err}")
    endif()
    # Steps: the nearest one to where the pointer went, so at most half a step off.
    knob_micro(${K_${item}_step} stepm)
    math(EXPR tol "3000 + ${stepm} / 2")
    if(kind STREQUAL "param")
      # Plugin editor controls set their own speed: the value must follow the pointer's way.
      if((dir EQUAL -1 AND moved LESS_EQUAL 0) OR (dir EQUAL 1 AND moved GREATER_EQUAL 0))
        list(APPEND fails "${what}: a slow 40 px drag did not move it (${B_${item}_value} -> ${D_${item}_value})")
      endif()
    elseif(err GREATER tol)
      list(APPEND fails "${what}: a slow 40 px drag moved it from ${B_${item}_norm} to ${D_${item}_norm} of the range, want about ${want} millionths (value ${B_${item}_value} -> ${D_${item}_value})")
    endif()
    if(NOT n2 EQUAL n1)
      list(APPEND fails "${what}: after the release it went from ${D_${item}_norm} to ${S_${item}_norm}")
    endif()
    if(fFine GREATER 0)
      knob_collect("${out}" ${fFine} "." F)
      knob_micro(${F_${item}_norm} n3)
      math(EXPR fmoved "${n3} - ${n2}")
      math(EXPR fwant "0 - ${dir} * 30 * 800")
      math(EXPR ferr "${fmoved} - ${fwant}")
      if(ferr LESS 0)
        math(EXPR ferr "0 - ${ferr}")
      endif()
      if(n2 GREATER 60000 AND n2 LESS 940000 AND ferr GREATER 3000)
        list(APPEND fails "${what}: a fine 30 px drag moved it by ${fmoved} millionths of the range, want about ${fwant}")
      endif()
    endif()
    knob_collect("${out}" ${fReset} "." R)
    knob_micro(${R_${item}_norm} n4)
    knob_micro(${R_${item}_def} nd)
    math(EXPR rerr "${n4} - ${nd}")
    if(rerr LESS 0)
      math(EXPR rerr "0 - ${rerr}")
    endif()
    if(rerr GREATER 1000)
      list(APPEND fails "${what}: a double-click left it at ${R_${item}_norm} of the range, not on its default ${R_${item}_def}")
    endif()
    math(EXPR passed "${passed} + 1")
  endforeach()
  list(LENGTH plan planned)
  list(LENGTH fails nfail)
  foreach(x IN LISTS fails)
    message(STATUS "FAIL - ${x}")
  endforeach()
  message(STATUS "${tag}: ${planned} knobs dragged, ${nfail} failed checks")
  set(KNOB_FAILS ${KNOB_FAILS} ${fails} PARENT_SCOPE)
  set(KNOB_COUNT_${tag} ${planned} PARENT_SCOPE)
endfunction()
