# Gridline - K-276: the gaps between playlist clips that touch in time all look the same, in the real app
# (hidden, isolated config and HOME, 1440x900, the playlist shown, a fixed 16 ms frame time). A copy of the
# test song gets an empty pattern ("Blank": nothing drawn on its body) and two rows of touching Blank clips:
#   track 0: lengths on the grid (bars, beats, steps);
#   track 1: lengths off the grid (odd tick counts), so its edges fall between grid lines.
# Runs at 100 %, 125 % and 150 % interface scale (125 % and 150 %: edges that a whole logical pixel does not
# put on a device pixel) and two zooms. For every touching pair (both clips at least 8 px wide):
#   1. geometry: the gap between the drawn boxes (plgeom, in device pixels) is one value per run;
#   2. pixels: a body row read across the gap and the rims beside it is the same for every pair (within 4 of
#      1020 per pixel): no bar line in one gap and none in the next, no edge blurred by its own amount.
# K-112b: -DLAYOUT=logic runs the same checks in the Tracks layout (its regions use the same helper).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DLAYOUT=logic] -P k276_clip_gaps_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
set(pat "{\"bars\": 8, \"color\": 9474192, \"id\": 61, \"name\": \"Blank\", \"notes\": {}, \"steps\": {}, \"stepsPerBar\": 16, \"loop\": false}, ")
set(lens0 384 96 192 48 384 96 96 384 192 96 384 384 192 192)
set(lens1 100 77 150 211 60 333 91 55 129 71 203 147 111 300)
set(clips "")
set(id 100)
foreach(tr 0 1)
  set(t 0)
  foreach(len ${lens${tr}})
    string(APPEND clips "{\"id\": ${id}, \"track\": ${tr}, \"start\": ${t}, \"length\": ${len}, \"pattern\": 61}, ")
    math(EXPR id "${id} + 1")
    math(EXPR t "${t} + ${len}")
  endforeach()
endforeach()
string(REGEX REPLACE ", $" "" clips "${clips}")
string(REPLACE "\"patterns\": [" "\"patterns\": [${pat}" demo "${demo}")
string(REGEX REPLACE "\"playlist\": \\[[^]]*\\]" "\"playlist\": [${clips}]" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 1000" demo "${demo}")
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}")
endfunction()

# "123.4" (plgeom's one decimal) -> device pixels at <fh> hundredths of a device pixel per logical pixel.
function(dev var v fh)
  string(REPLACE "." "" tenths "${v}")
  math(EXPR d "(${tenths} * ${fh} + 500) / 1000")
  set(${var} ${d} PARENT_SCOPE)
endfunction()

# Lightness (r + 2g + b) of the image pixels [x0, x1) of row y.
function(rowlum ppm y x0 x1)
  file(READ "${ppm}" hdr LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" h "${hdr}")
  if(h STREQUAL "")
    fail("${ppm}: not a P6 image")
  endif()
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${h}" off)
  math(EXPR o "${off} + (${y} * ${w} + ${x0}) * 3")
  math(EXPR bytes "(${x1} - ${x0}) * 3")
  file(READ "${ppm}" hex OFFSET ${o} LIMIT ${bytes} HEX)
  string(REGEX MATCHALL "......" pix "${hex}")
  set(ls "")
  foreach(p ${pix})
    string(SUBSTRING "${p}" 0 2 r)
    string(SUBSTRING "${p}" 2 2 g)
    string(SUBSTRING "${p}" 4 2 b)
    math(EXPR l "0x${r} + 2 * 0x${g} + 0x${b}")
    list(APPEND ls ${l})
  endforeach()
  set(lums "${ls}" PARENT_SCOPE)
endfunction()

# run <tag> <ui scale in hundredths> <zoom>
function(run tag fh zoom)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "14 plgeom\n")
  set(layoutArgs "")
  if(LAYOUT)  # K-112b: a chosen layout (the isolated config says it was chosen, so no chooser shows)
    file(MAKE_DIRECTORY "${cfg}/gridline")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layoutPreset\": \"${LAYOUT}\"}}\n")
    set(layoutArgs --layout ${LAYOUT})
  endif()
  math(EXPR ui_i "${fh} / 100")
  math(EXPR ui_f "${fh} % 100")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --show playlist --zoom ${zoom} --ui-scale ${ui_i}.${ui_f} ${layoutArgs} --dev-input "${OUT}/${tag}.txt" --frames 18
                          --screenshot "${OUT}/${tag}.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    fail("${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  string(REGEX MATCH "grid ([0-9.]+) [0-9.]+ [0-9.]+" _ "${out}")
  dev(gx0 "${CMAKE_MATCH_1}" ${fh})
  math(EXPR lim "1440 * ${fh} / 100 - 30")
  math(EXPR win "(${fh} + 50) / 100")  # the rim each side of the gap (1 px, whole device px)
  set(id 100)
  foreach(tr 0 1)
    set(gaps "")
    set(looks "")
    set(pairs 0)
    set(prev "")
    foreach(len ${lens${tr}})
      string(REGEX MATCH "\n  clip ${id} x ([0-9.]+) ([0-9.]+) y ([0-9.]+) ([0-9.]+)" _ "${out}")
      if(CMAKE_MATCH_1 STREQUAL "")
        set(cur "")
      else()
        dev(x0 "${CMAKE_MATCH_1}" ${fh})
        dev(x1 "${CMAKE_MATCH_2}" ${fh})
        dev(y0 "${CMAKE_MATCH_3}" ${fh})
        dev(y1 "${CMAKE_MATCH_4}" ${fh})
        set(cur "${x0};${x1};${y0};${y1}")
      endif()
      if(NOT prev STREQUAL "" AND NOT cur STREQUAL "")
        list(GET prev 0 a0)
        list(GET prev 1 a1)
        list(GET cur 0 b0)
        list(GET cur 1 b1)
        list(GET cur 2 by0)
        list(GET cur 3 by1)
        math(EXPR wa "${a1} - ${a0}")
        math(EXPR wb "${b1} - ${b0}")
        math(EXPR minw "8 * ${fh} / 100")
        math(EXPR lo "${a1} - ${win}")
        math(EXPR hi "${b0} + ${win}")
        if(wa GREATER_EQUAL minw AND wb GREATER_EQUAL minw AND lo GREATER gx0 AND hi LESS lim)
          math(EXPR g "${b0} - ${a1}")
          list(APPEND gaps ${g})
          math(EXPR y "(${by0} + 3 * ${by1}) / 4")
          rowlum("${OUT}/${tag}.ppm" ${y} ${lo} ${hi})
          set(found 0)
          foreach(k ${looks})
            set(diff 0)
            foreach(i RANGE 0 64)
              list(LENGTH lums n)
              if(i GREATER_EQUAL n)
                break()
              endif()
              list(GET lums ${i} p)
              list(GET look_${k} ${i} q)
              math(EXPR d "${p} - ${q}")
              if(d GREATER 4 OR d LESS -4)
                set(diff 1)
              endif()
            endforeach()
            if(diff EQUAL 0)
              set(found 1)
            endif()
          endforeach()
          if(NOT found)
            list(LENGTH looks k)
            list(APPEND looks ${k})
            set(look_${k} "${lums}")
          endif()
          math(EXPR pairs "${pairs} + 1")
        endif()
      endif()
      set(prev "${cur}")
      math(EXPR id "${id} + 1")
    endforeach()
    list(REMOVE_DUPLICATES gaps)
    list(LENGTH gaps ng)
    list(LENGTH looks nl)
    if(pairs LESS 4)
      fail("${tag} track ${tr}: only ${pairs} touching pairs measured")
    endif()
    if(NOT ng EQUAL 1)
      fail("${tag} track ${tr}: the gaps between touching clips differ: {${gaps}} device px over ${pairs} pairs")
    endif()
    message(STATUS "ok - ${tag} track ${tr}: ${pairs} touching pairs, one gap (${gaps} device px)")
    if(NOT nl EQUAL 1)
      fail("${tag} track ${tr}: the gaps look different (${nl} looks over ${pairs} pairs: a line or a blur in some of them)")
    endif()
    message(STATUS "ok - ${tag} track ${tr}: every gap looks the same")
  endforeach()
endfunction()

run(s100 100 1)
run(s100z 100 0.73)
run(s125 125 1)
run(s125z 125 0.73)
run(s150 150 1.37)
message(STATUS "k276_clip_gaps_app: all checks passed")
