# Gridline: the typing keyboard keeps its octave over a long session, in the real app (hidden, isolated
# config and HOME, SDL's dummy audio driver). A seeded random session of real SDL key events: thousands
# of notes, chords and held keys, the octave keys held with key repeat, copies of a key-down (the same
# key reported down twice), keys reported again as the focus comes back to a Gridline window, the focus
# leaving the app, modifier keys, window switches and the keyboard layout switched mid-session.
# The octave may only move on a fresh press of an octave key ([ ] or keypad - +), one step per press;
# the keypad keys only change the octave (not the pattern too).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DSEED=n] [-DEVENTS=n] -P typing_octave_session_app.cmake
cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED SEED)
  set(SEED 175)
endif()
if(NOT DEFINED EVENTS)
  set(EVENTS 4000)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/cfg")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")

# A small linear congruential generator, so every run makes the same session.
set(rng ${SEED})
macro(roll n out)
  math(EXPR rng "(${rng} * 1103515245 + 12345) % 2147483648")
  math(EXPR ${out} "(${rng} / 65536) % ${n}")
endmacro()

# The note keys by their US position, and what each layout types there (ASCII stand-ins where a layout
# types a letter outside ASCII; what a key types never changes the note it plays).
set(us      "zsxdcvgbhnjmq2w3er5t6y7u/")
set(qwertz  "ysxdcvgbhnjmq2w3er5t6z7u-")
set(azerty  "wsxdcvgbhnjxaxzxerxtxyxu!")
set(dvorak  "zoqejkixdbhmx2,3.p5y6f7gz")
set(colemak "zrxscvdbhknmq2w3fp5g6j7l/")
set(layouts standard qwertz azerty dvorak colemak)
set(layoutTables us qwertz azerty dvorak colemak)
string(LENGTH "${us}" nKeys)
# What the octave and velocity positions type on each layout ([ ] - =).
set(ctl_standard "[]-=")
set(ctl_qwertz   "{+_'")
set(ctl_azerty   "^$)=")
set(ctl_dvorak   "/=[]")
set(ctl_colemak  "[]-=")

set(script "")
set(f 4)
set(octave 4)
set(layout 0)
set(held "")       # note keys held: their US position characters
set(shows 0)
set(want "")
macro(at frame line)
  string(APPEND script "${frame} ${line}\n")
endmacro()
macro(show)
  at(${f} "typing show")
  list(APPEND want ${octave})
  math(EXPR shows "${shows} + 1")
endmacro()
macro(keyname pos out)  # pos: index into the US table -> "<typed>@<US key>"
  list(GET layoutTables ${layout} tbl)
  string(SUBSTRING "${${tbl}}" ${pos} 1 typed)
  string(SUBSTRING "${us}" ${pos} 1 usk)
  set(${out} "${typed}@${usk}")
endmacro()
macro(ctlname idx out)  # idx 0..3: [ ] - =
  list(GET layouts ${layout} lid)
  string(SUBSTRING "${ctl_${lid}}" ${idx} 1 typed)
  string(SUBSTRING "[]-=" ${idx} 1 usk)
  set(${out} "${typed}@${usk}")
endmacro()
macro(step dir)  # one octave press: a step unless the octave is at its end already
  math(EXPR next "${octave} + (${dir})")
  if(next GREATER_EQUAL 0 AND next LESS_EQUAL 9)
    set(octave ${next})
    math(EXPR octaveSteps "${octaveSteps} + 1")
  endif()
endmacro()
macro(releaseHeld)
  foreach(k IN LISTS held)
    string(FIND "${us}" "${k}" p)
    keyname(${p} kn)
    at(${f} "sdlkey ${kn} up")
  endforeach()
  set(held "")
endmacro()

at(${f} "typing on")
math(EXPR f "${f} + 2")
show()
set(octavePresses 0)
set(octaveSteps 0)
set(noteEvents 0)
foreach(i RANGE 1 ${EVENTS})
  math(EXPR f "${f} + 1")
  roll(100 r)
  if(r LESS 46)  # a note: tapped, or held for a while
    roll(${nKeys} p)
    string(SUBSTRING "${us}" ${p} 1 usk)
    list(FIND held "${usk}" already)
    if(already EQUAL -1)
      keyname(${p} kn)
      roll(4 shift)
      if(shift EQUAL 0)
        at(${f} "sdlkey ${kn} down shift")
      else()
        at(${f} "sdlkey ${kn} down")
      endif()
      math(EXPR noteEvents "${noteEvents} + 1")
      roll(3 keep)
      if(keep EQUAL 0)
        list(APPEND held "${usk}")
      else()
        math(EXPR f "${f} + 1")
        at(${f} "sdlkey ${kn} up")
      endif()
    endif()
  elseif(r LESS 56)  # a chord: three keys down together, up together
    set(chord "")
    foreach(c RANGE 1 3)
      roll(${nKeys} p)
      string(SUBSTRING "${us}" ${p} 1 usk)
      list(FIND held "${usk}" a)
      list(FIND chord "${p}" b)
      if(a EQUAL -1 AND b EQUAL -1)
        list(APPEND chord ${p})
        keyname(${p} kn)
        at(${f} "sdlkey ${kn} down")
        math(EXPR noteEvents "${noteEvents} + 1")
      endif()
    endforeach()
    math(EXPR f "${f} + 2")
    foreach(p IN LISTS chord)
      keyname(${p} kn)
      at(${f} "sdlkey ${kn} up")
    endforeach()
  elseif(r LESS 60)  # held notes end
    releaseHeld()
  elseif(r LESS 70)  # an octave key: held with key repeat, sometimes its key-down reported twice
    roll(2 up)
    roll(3 kp)
    if(kp EQUAL 0)
      if(up)
        set(kn "#87")
      else()
        set(kn "#86")
      endif()
    else()
      ctlname(${up} kn)
    endif()
    at(${f} "sdlkey ${kn} down")
    if(up)
      step(1)
    else()
      step(-1)
    endif()
    math(EXPR octavePresses "${octavePresses} + 1")
    roll(5 reps)
    foreach(x RANGE ${reps})
      if(x GREATER 0)
        math(EXPR f "${f} + 1")
        at(${f} "sdlkey ${kn} down repeat")
      endif()
    endforeach()
    roll(3 copy)
    if(copy EQUAL 0)
      at(${f} "sdlkey ${kn} down")  # the same key-down again, without the repeat mark
    endif()
    roll(4 refocus)
    if(refocus EQUAL 0)  # the focus moves and comes back while it is held: it is reported down again
      math(EXPR f "${f} + 1")
      at(${f} "sdlkey ${kn} up")
      at(${f} "focusmove main")
      at(${f} "sdlkey ${kn} down")
      math(EXPR f "${f} + 2")  # (see the held notes below)
    endif()
    math(EXPR f "${f} + 1")
    at(${f} "sdlkey ${kn} up")
  elseif(r LESS 73)  # velocity keys (on layouts where they type [ or ], too)
    roll(2 v)
    math(EXPR v "${v} + 2")
    ctlname(${v} kn)
    at(${f} "sdlkey ${kn} down")
    math(EXPR f "${f} + 1")
    at(${f} "sdlkey ${kn} up")
  elseif(r LESS 77)  # notes held while the focus moves to a Gridline window and back
    if(held)
      foreach(k IN LISTS held)
        string(FIND "${us}" "${k}" p)
        keyname(${p} kn)
        at(${f} "sdlkey ${kn} up")
      endforeach()
      at(${f} "focusmove main")
      foreach(k IN LISTS held)
        string(FIND "${us}" "${k}" p)
        keyname(${p} kn)
        at(${f} "sdlkey ${kn} down")
      endforeach()
      # The interface sees a key reported again as the focus moves as pressed in the next frame (its
      # input queue spreads an up and a down of one key over two frames): a Ctrl pressed in that frame
      # would make a Ctrl chord of it (Ctrl+S: a save). People do not press Ctrl within a frame of a
      # focus change, so the session leaves those frames alone.
      math(EXPR f "${f} + 2")
    endif()
  elseif(r LESS 79)  # the focus leaves Gridline: nothing comes back for the held keys
    at(${f} "focuslost")
    set(held "")
    math(EXPR f "${f} + 1")
    at(${f} "focusmove main")
  elseif(r LESS 84)  # modifier keys, and an octave key with Ctrl held: no step
    at(${f} "sdlkey #224 down ctrl")
    math(EXPR f "${f} + 1")
    at(${f} "sdlkey [@[ down ctrl")
    at(${f} "sdlkey [@[ up ctrl")
    math(EXPR f "${f} + 1")
    at(${f} "sdlkey #224 up")
    at(${f} "sdlkey #225 down shift")
    math(EXPR f "${f} + 1")
    at(${f} "sdlkey #225 up")
  elseif(r LESS 90)  # another window takes the keyboard focus inside Gridline
    roll(4 w)
    set(names "Piano roll" "Playlist" "Channel rack" "Mixer")
    list(GET names ${w} wn)
    at(${f} "focus \"${wn}\"")
  elseif(r LESS 93)  # the keyboard layout changes
    releaseHeld()
    roll(5 layout)
    list(GET layouts ${layout} lid)
    at(${f} "typing layout ${lid}")
  endif()
  roll(12 s)
  if(s EQUAL 0)
    math(EXPR f "${f} + 1")
    show()
  endif()
endforeach()
math(EXPR f "${f} + 2")
releaseHeld()
math(EXPR f "${f} + 2")
show()
at(${f} "typing octave")
math(EXPR f "${f} + 2")
at(${f} "quit discard")
file(WRITE "${OUT}/input.txt" "${script}")
math(EXPR frames "${f} + 20")

# The session plays a copy: a key that ran a command (a save, an edit) shows as a changed copy.
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)
file(MD5 "${OUT}/song.gridline.json" songBefore)
execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --edit 0 6
                        --dev-input "${OUT}/input.txt" --frames ${frames}
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900)
file(WRITE "${OUT}/app.log" "${out}\n${err}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "gridline-app failed (${rc}): ${err}")
endif()
file(MD5 "${OUT}/song.gridline.json" songAfter)
if(NOT songAfter STREQUAL songBefore)
  configure_file("${DEMO}" "${OUT}/song.before.gridline.json" COPYONLY)
  file(TIMESTAMP "${OUT}/song.gridline.json" when "%H:%M:%S")
  message(FATAL_ERROR "FAIL: the project file changed during the session (written at ${when}; a typed key ran a command "
                      "that saved it; compare ${OUT}/song.gridline.json with song.before.gridline.json)")
endif()
string(REGEX MATCHALL "typing notes[^\n]*" lines "${out}")
set(got "")
foreach(l IN LISTS lines)
  string(REGEX REPLACE ".* octave ([0-9]+) .*" "\\1" o "${l}")
  list(APPEND got ${o})
endforeach()
list(LENGTH got nGot)
set(bad 0)
set(firstBad "")
if(NOT nGot EQUAL shows)
  set(bad 1)
  set(firstBad "${nGot} reports for ${shows} checks")
else()
  math(EXPR last "${shows} - 1")
  foreach(k RANGE ${last})
    list(GET got ${k} g)
    list(GET want ${k} w)
    if(NOT g EQUAL w)
      math(EXPR bad "${bad} + 1")
      if(firstBad STREQUAL "")
        set(firstBad "check ${k}: octave ${g}, wanted ${w}")
      endif()
    endif()
  endforeach()
endif()
string(REGEX MATCH "typing octave [0-9]+ steps ([0-9]+) pattern ([0-9-]+) notes ([0-9]+)" fin "${out}")
set(steps "${CMAKE_MATCH_1}")
set(pattern "${CMAKE_MATCH_2}")
set(notesLeft "${CMAKE_MATCH_3}")
message(STATUS "session: ${EVENTS} events, ${noteEvents} note presses, ${octavePresses} octave presses, ${shows} checks, "
               "${bad} off; steps ${steps}, pattern ${pattern}, notes still held ${notesLeft}")
if(bad)
  message(FATAL_ERROR "FAIL: the octave drifted (${bad} of ${shows} checks off; first: ${firstBad})")
endif()
if(NOT fin)
  message(FATAL_ERROR "FAIL: no final report")
endif()
if(NOT steps EQUAL octaveSteps)
  message(FATAL_ERROR "FAIL: ${steps} octave steps for ${octaveSteps} octave presses that could step")
endif()
if(NOT pattern EQUAL 0)
  message(FATAL_ERROR "FAIL: the keypad octave keys also switched the pattern (now ${pattern})")
endif()
if(NOT notesLeft EQUAL 0)
  message(FATAL_ERROR "FAIL: ${notesLeft} notes still held after every key went up")
endif()
message(STATUS "ok - the octave only moved on octave presses, one step each")
