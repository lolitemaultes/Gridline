# Gridline - K-42: a zipped project on a web drive, in the real app (hidden, isolated config and HOME;
# a local folder is made to count as a drive with GRIDLINE_DEV_REMOTE_PATHS):
#   1. opened with every chunk slowed down: frames keep coming while the bytes move, Esc cancels and
#      the open project is back, and nothing is left behind;
#   2. opened to the end: its sample is found, it comes from the cache, not one file lands on the
#      drive, the archive is the recent entry and Save has no file of its own to write to;
#   3. opened again: from the copy, no reading;
#   4. the archive gone (an offline drive): the last copy opens with a note;
#   5. a recent project on a drive that has gone: the app starts, the entry stays, and opening it
#      shows why in the loading window;
#   6. an archive with two projects asks which, and opens the one chosen.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DSOUNDS=<assets/sounds> -DOUT=<dir> -P k42_web_drive_app.cmake
cmake_minimum_required(VERSION 3.18)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg" "${OUT}/drive/Music" "${OUT}/build")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/cfg")
set(ENV{XDG_CACHE_HOME} "${OUT}/cache")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_DEV_REMOTE_PATHS} "${OUT}/drive")

# The project: one sampler on a sound beside it, referred to by name.
file(GLOB wavs "${SOUNDS}/classic/*.wav")
list(GET wavs 0 wav)
configure_file("${wav}" "${OUT}/build/near.wav" COPYONLY)
# (padding, so the slowed reads take a few chunks)
set(pad "")
foreach(i RANGE 1 400)
  string(RANDOM LENGTH 2000 ALPHABET "0123456789abcdefghijklmnopqrstuvwxyz" line)
  string(APPEND pad "${line}")
endforeach()
file(WRITE "${OUT}/build/padding.txt" "${pad}")
file(READ "${DEMO}" demo)
string(REPLACE "\"channels\": [" "\"channels\": [{\"id\": 9001, \"name\": \"Near\", \"mixerTrack\": 3, \"gain\": 0.7, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"near.wav\"}}, " song "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 9002" song "${song}")
file(WRITE "${OUT}/build/Song.gridline.json" "${song}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/drive/Music/Song.zip" --format=zip Song.gridline.json near.wav padding.txt WORKING_DIRECTORY "${OUT}/build" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not make the archive")
endif()
file(MAKE_DIRECTORY "${OUT}/build2")
file(WRITE "${OUT}/build2/One.gridline.json" "${demo}")
file(WRITE "${OUT}/build2/Two.gridline.json" "${demo}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/drive/Music/Pack.zip" --format=zip One.gridline.json Two.gridline.json WORKING_DIRECTORY "${OUT}/build2")
configure_file("${DEMO}" "${OUT}/demo.gridline.json" COPYONLY)
file(GLOB_RECURSE driveBefore RELATIVE "${OUT}/drive" "${OUT}/drive/*")

function(run tag script slowMs)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  set(ENV{GRIDLINE_DEV_SLOW_READ_MS} "${slowMs}")
  execute_process(COMMAND "${APP}" "${OUT}/demo.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1280x800 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()
function(must tag regex what)
  if(NOT "${${tag}_out}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${${tag}_out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
function(mustnot tag regex what)
  if("${${tag}_out}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${${tag}_out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
function(driveUntouched what)
  file(GLOB_RECURSE now RELATIVE "${OUT}/drive" "${OUT}/drive/*")
  if(NOT now STREQUAL driveBefore)
    message(FATAL_ERROR "FAIL: something landed on the drive (${what}): ${now}")
  endif()
endfunction()

set(zip "${OUT}/drive/Music/Song.zip")

# 1. Slow reads: the window, frames, bytes moving; Esc returns to the open project.
run(cancel "2 loadhold off\n3 dialogopen \"${zip}\"\n30 loadstate\n60 loadstate\n62 key escape\n66 loadstate\n70 quit discard\n" 1500)
must(cancel "loadstate frame 30: phase reading" "frames keep coming while the archive reads")
must(cancel "loadstate frame 60: phase reading[^\n]*\n  bytes [0-9]+/[1-9][0-9]*" "with the bytes on the bar")
must(cancel "loadstate frame 66: phase idle" "Esc cancels at once")
driveUntouched("a cancelled open")
file(GLOB leftovers "${OUT}/cache/gridline/unpacked/*")
set(waited 0)
while(leftovers AND waited LESS 50)  # (the reader stops at its next chunk)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
  file(GLOB leftovers "${OUT}/cache/gridline/unpacked/*")
  math(EXPR waited "${waited} + 1")
endwhile()
foreach(left ${leftovers})
  # (On a slow machine the unpack can finish just before Esc: a whole copy from a drive stays on purpose.)
  if(left MATCHES "\\.part-|\\.removing-" OR NOT EXISTS "${left}/Song.gridline.json")
    message(FATAL_ERROR "FAIL: a cancelled open left ${left}")
  endif()
  file(REMOVE_RECURSE "${left}")
endforeach()
message(STATUS "ok - a cancelled open leaves nothing half done")

# 2. To the end.
run(open "2 loadhold off\n3 toasts clear\n4 dialogopen \"${zip}\"\n6 waitfor project-loaded 60\n8 loadstate\n10 channels\n12 quit discard\n" 0)
must(open "waitfor project-loaded: reached" "the archive opens")
must(open "channel [^\n]*Near" "the project in it is what opened")
mustnot(open "Sample not found|Could not read sample" "its sample is found")
driveUntouched("an open")
file(GLOB copies "${OUT}/cache/gridline/unpacked/Song-*")
list(LENGTH copies n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL: expected one copy in the cache, found: ${copies}")
endif()
if(NOT EXISTS "${copies}/near.wav")
  message(FATAL_ERROR "FAIL: the bundled sample is not in the cache")
endif()
message(STATUS "ok - unpacked in the cache, nothing on the drive")
file(READ "${OUT}/cfg/gridline/recent.txt" recent)
if(NOT recent MATCHES "drive/Music/Song.zip")
  message(FATAL_ERROR "FAIL: the archive is not the recent entry: ${recent}")
endif()
message(STATUS "ok - the archive itself is the recent entry")

# 3. Again: the copy (a mark left in it survives: it was not unpacked anew).
file(WRITE "${copies}/mark.txt" "here")
run(again "2 loadhold off\n3 open \"${zip}\"\n6 waitfor project-loaded 60\n8 loadstate\n12 quit discard\n" 0)
must(again "waitfor project-loaded: reached" "the second open works")
file(GLOB copies2 "${OUT}/cache/gridline/unpacked/Song-*")
if(NOT copies2 STREQUAL copies OR NOT EXISTS "${copies}/mark.txt")
  message(FATAL_ERROR "FAIL: the second open unpacked again: ${copies2}")
endif()
message(STATUS "ok - the second open uses the copy")

# 4. Offline: the archive gone; the last copy opens with a note.
file(RENAME "${zip}" "${OUT}/Song.zip.away")
run(offline "2 loadhold off\n3 open \"${zip}\"\n6 waitfor project-loaded 60\n8 loadstate\n12 quit discard\n" 0)
must(offline "waitfor project-loaded: reached" "offline: the last copy opens")
must(offline "drive cannot be reached" "with a note")
file(RENAME "${OUT}/Song.zip.away" "${zip}")

# 5. A recent project on a drive that has gone, at startup and when opened.
set(gone "${OUT}/drive/Gone Away/Old.flp")
file(WRITE "${OUT}/cfg/gridline/recent.txt" "${gone}\n${zip}\n")
run(recent "2 loadhold off\n6 open \"${gone}\"\n8 waitfor project-load-failed 30\n12 loadstate\n14 key escape\n20 quit discard\n" 0)
must(recent "loadstate frame 12: phase failed" "a project on a missing drive fails in the window, not in a freeze")
must(recent "connected and online" "and says what to check")
file(READ "${OUT}/cfg/gridline/recent.txt" recent)
if(NOT recent MATCHES "Gone Away/Old.flp")
  message(FATAL_ERROR "FAIL: the entry of a missing drive was dropped: ${recent}")
endif()
message(STATUS "ok - the recent entry of a missing drive stays")

# 6. Two projects: the question, then the chosen one.
run(pack "2 loadhold off\n3 open \"${OUT}/drive/Music/Pack.zip\"\n40 loadstate\n42 loadchoose 1\n44 waitfor project-loaded 30\n46 quit discard\n" 0)
must(pack "loadstate frame 40: phase reading[^\n]*\n  bytes [0-9]+/[0-9]+ overall [0-9.]+ stalled 0 choices 2" "an archive with two projects asks")
must(pack "waitfor project-loaded: reached" "the chosen project opens")
file(READ "${OUT}/cfg/gridline/recent.txt" recent)
if(NOT recent MATCHES "Pack.zip")
  message(FATAL_ERROR "FAIL: the archive is not in the recent list: ${recent}")
endif()
driveUntouched("the end")
