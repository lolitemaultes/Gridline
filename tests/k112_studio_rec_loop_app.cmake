# Gridline - K-112c (checkpoint 52, N51-01): in Studio, song mode, the Record button armed with no
# armed track keeps the song looping at its end, as with Record off (Clips' Arrangement Record turns
# the song wrap off only in Clips). Real app, hidden, isolated config, fixed frame time.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P k112_studio_rec_loop_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")

function(run tag rec)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"studio\"}}\n")
  set(in "5 toasts clear\n10 playmode song\n")
  if(rec)
    string(APPEND in "15 sdlat rec\n16 sdldown 0\n17 sdlup 0\n")
  endif()
  string(APPEND in "20 recording\n25 key space\n")
  foreach(f RANGE 100 1900 60)
    string(APPEND in "${f} transport\n")
  endforeach()
  string(APPEND in "1950 key space\n1970 quit discard\n")
  file(WRITE "${cfg}/input.txt" "${in}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  # A new project (its song is one bar long, so it wraps within the run).
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --layout studio --layout-dev
                          --dev-input "${cfg}/input.txt" --frames 1980
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc})")
  endif()
  set(${tag}_log "${out}" PARENT_SCOPE)
endfunction()

# Did the position wrap (a later position below an earlier one while playing)?
function(wraps log outvar)
  string(REGEX MATCHALL "transport frame [0-9]+: pos [0-9]+ playing 1" ps "${log}")
  set(prev -1)
  set(w 0)
  foreach(p ${ps})
    string(REGEX MATCH "pos ([0-9]+)" m "${p}")
    if(prev GREATER CMAKE_MATCH_1)
      set(w 1)
    endif()
    set(prev "${CMAKE_MATCH_1}")
  endforeach()
  list(LENGTH ps n)
  if(n LESS 5)
    message(FATAL_ERROR "FAIL: too few transport reports while playing (${n})\n${log}")
  endif()
  set(${outvar} ${w} PARENT_SCOPE)
endfunction()

run(off 0)
wraps("${off_log}" offWraps)
if(NOT offWraps)
  message(FATAL_ERROR "FAIL: the song should loop at its end with Record off (the test song is too long?)\n${off_log}")
endif()
run(on 1)
if(NOT on_log MATCHES "recording frame 20: armed 1")
  message(FATAL_ERROR "FAIL: the Record button should be armed at frame 20\n${on_log}")
endif()
wraps("${on_log}" onWraps)
if(NOT onWraps)
  message(FATAL_ERROR "FAIL: Record armed with no armed track must keep the song loop in Studio (N51-01)\n${on_log}")
endif()
message(STATUS "PASS: Studio keeps the song loop with Record armed and no armed track")
