# Gridline - K-248: the warp marker lanes of the sampler, Kerf and Loupe in the real app (hidden, isolated config).
# On a loop loaded into a sampler channel (its Audio clip window's Sample tab), a Kerf channel and Loupe, each in turn:
#   1. a click on the Warp button turns warp mode on (the button takes its own click, over the wave);
#   2. a click in the marker lane adds a marker, a drag moves it, a right-click removes it;
#   3. each of those is one undo step: undo after undo brings back the markers as they were before
#      each gesture, in reverse order (the sampler and Kerf: the project's undo; Loupe: its own);
#   4. Kerf: the clicks in the warp lane never select the region under them (a click above the lane does).
#   cmake -DAPP=<gridline-app> -DTESTBIN=<gridline_test_seltmann> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k078_warp_lanes_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${TESTBIN}" writeloop "${OUT}/Break 96.wav" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT EXISTS "${OUT}/Break 96.wav")
  message(FATAL_ERROR "FAIL: could not write the synthetic loop (${rc})")
endif()
set(wav "${OUT}/Break 96.wav")
file(READ "${DEMO}" demo)
set(smpJson "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Loop\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${wav}\", \"params\": []}}, ")
set(kerfJson "{\"color\": 5219296, \"gain\": 0.8, \"id\": 61, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Chops\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.slicer\", \"data\": \"${wav}\", \"params\": []}}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${smpJson}${kerfJson}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag args frames script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"studio\", \"keys.profile\": \"studio\", \"ui.menuStyle\": \"studio\", \"playlist.warpSnapTransients\": false}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  set(ENV{GRIDLINE_KERF_TRACE} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${args} --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 200)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# The rect of the last "warpwave <kind> <id> frame <f>" line printed at frame <frame>: <out>_x0 .. <out>_y1, <out>_cx, <out>_cy.
function(rectOf text kind id frame out)
  string(REGEX MATCH "warpwave ${kind} ${id} tag t${frame} rect ([0-9-]+) ([0-9-]+) ([0-9-]+) ([0-9-]+)" m "${text}")
  if(NOT m)
    message(FATAL_ERROR "FAIL: no warpwave ${kind} ${id} at frame ${frame}\n${text}")
  endif()
  set(${out}_x0 ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${out}_y0 ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${out}_x1 ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${out}_y1 ${CMAKE_MATCH_4} PARENT_SCOPE)
  math(EXPR cx "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR cy "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
  set(${out}_cx ${cx} PARENT_SCOPE)
  set(${out}_cy ${cy} PARENT_SCOPE)
endfunction()

# The markers of lane <id> printed at <frame> ("N at w,w,..."; "none" when the lane was not drawn).
function(markersAt text id frame out)
  string(REGEX MATCH "warpwave lane ${id} tag t${frame} rect [0-9-]+ [0-9-]+ [0-9-]+ [0-9-]+ active [01] markers ([0-9]+) at ([^ \n]*)" m "${text}")
  if(m)
    set(${out} "${CMAKE_MATCH_1} at ${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${out} "none" PARENT_SCOPE)
  endif()
endfunction()

# Kerf's selected region at the last trace line printed before "warpwave t<frame>".
function(kerfSel text frame out)
  string(FIND "${text}" "tag t${frame} " at)
  if(at LESS 0)
    set(at -1)
  endif()
  if(at GREATER 0)
    string(SUBSTRING "${text}" 0 ${at} text)
  endif()
  string(REGEX MATCHALL "kerf-ui:[^\n]* sel=[0-9]+ " lines "${text}")
  list(LENGTH lines n)
  if(n EQUAL 0)
    set(${out} "-" PARENT_SCOPE)
    return()
  endif()
  math(EXPR i "${n} - 1")
  list(GET lines ${i} l)
  string(REGEX MATCH " sel=([0-9]+) " _ "${l}")
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

# One editor: <tag>, app args, the button and lane ids, the open script (frames before 10), undo and redo commands.
function(lanes tag args button lane openScript undoCmd)
  # Probe 1: where the Warp button is.
  run(${tag}_p1 "${args}" 30 "${openScript}20 warpwave t20\n24 quit discard\n")
  set(last_out "${${tag}_p1_out}")
  rectOf("${${tag}_p1_out}" button "${button}" 20 b)
  # Probe 2: the button clicked: warp mode on and the lane drawn.
  run(${tag}_p2 "${args}" 40 "${openScript}20 move ${b_cx} ${b_cy}\n22 down 0\n24 up 0\n30 warpwave t30\n34 quit discard\n")
  set(last_out "${${tag}_p2_out}")
  rectOf("${${tag}_p2_out}" button "${button}" 30 b2)
  check("${tag}: a click on the Warp button turns warp mode on" "${${tag}_p2_out}" MATCHES "warpwave button ${button} tag t30 rect [0-9 -]+ on 1")
  rectOf("${${tag}_p2_out}" lane "${lane}" 30 l)
  markersAt("${${tag}_p2_out}" "${lane}" 30 m0)
  check("${tag}: the lane starts without markers (${m0})" m0 MATCHES "^0 at")
  # The gestures: add at 40 %, drag it to 55 %, remove it with a right-click; then three undo steps and two redo steps.
  math(EXPR y "${l_y1} - 4")
  math(EXPR xa "${l_x0} + (${l_x1} - ${l_x0}) * 40 / 100")
  math(EXPR xa2 "${xa} + 4")
  math(EXPR xb "${l_x0} + (${l_x1} - ${l_x0}) * 55 / 100")
  math(EXPR ya "${l_y0} - 30")  # above the lane (Kerf: on the regions)
  # (gestures 30 frames apart: never taken for a double-click)
  set(script "${openScript}20 move ${b_cx} ${b_cy}\n22 down 0\n24 up 0\n30 warpwave t30\n")
  string(APPEND script "60 move ${xa} ${y}\n62 down 0\n64 up 0\n70 warpwave t70\n")
  string(APPEND script "100 move ${xa} ${y}\n102 down 0\n104 move ${xa2} ${y}\n106 move ${xb} ${y}\n108 move ${xb} ${y}\n110 up 0\n116 warpwave t116\n")
  # Probe 3: where the moved marker is drawn now (the lane's scale can follow the warped length).
  run(${tag}_p3 "${args}" 130 "${script}120 quit discard\n")
  string(REGEX MATCH "warpwave lane ${lane} tag t116 rect [^\n]* x ([0-9,-]+)" m "${${tag}_p3_out}")
  string(REPLACE "," ";" xsList "${CMAKE_MATCH_1}")
  list(GET xsList -1 xm)
  if(xm STREQUAL "-" OR xm STREQUAL "")
    set(xm ${xb})
  endif()
  string(APPEND script "140 move ${xm} ${y}\n142 down 1\n144 up 1\n150 warpwave t150\n")
  if(undoCmd)
    set(U "${undoCmd} undo")
    set(R "${undoCmd} redo")
  else()
    set(U "undo")
    set(R "redo")
  endif()
  string(APPEND script "154 ${U}\n158 warpwave t158\n162 ${U}\n166 warpwave t166\n170 ${U}\n174 warpwave t174\n")
  string(APPEND script "178 ${R}\n182 warpwave t182\n186 ${R}\n190 warpwave t190\n")
  string(APPEND script "220 move ${xb} ${ya}\n222 down 0\n224 up 0\n230 warpwave t230\n236 quit discard\n")
  run(${tag} "${args}" 250 "${script}")
  set(o "${${tag}_out}")
  set(last_out "${o}")
  markersAt("${o}" "${lane}" 30 s0)
  markersAt("${o}" "${lane}" 70 sAdd)
  markersAt("${o}" "${lane}" 116 sMove)
  markersAt("${o}" "${lane}" 150 sDel)
  markersAt("${o}" "${lane}" 158 u1)
  markersAt("${o}" "${lane}" 166 u2)
  markersAt("${o}" "${lane}" 174 u3)
  markersAt("${o}" "${lane}" 182 r1)
  markersAt("${o}" "${lane}" 190 r2)
  message(STATUS "${tag}: start [${s0}] add [${sAdd}] move [${sMove}] remove [${sDel}] undo [${u1}] [${u2}] [${u3}] redo [${r1}] [${r2}]")
  check("${tag}: a click in the lane adds a marker (${sAdd})" sAdd MATCHES "^[1-9]" AND NOT sAdd STREQUAL s0)
  check("${tag}: a drag moves it (${sMove})" NOT sMove STREQUAL sAdd AND NOT sMove STREQUAL "none")
  check("${tag}: a right-click removes it (${sDel})" NOT sDel STREQUAL sMove AND NOT sDel STREQUAL "none")
  check("${tag}: one undo takes the removal back (${u1})" u1 STREQUAL sMove)
  check("${tag}: the next undo takes the move back (${u2})" u2 STREQUAL sAdd)
  check("${tag}: the next undo takes the add back (${u3})" u3 STREQUAL s0)
  check("${tag}: redo brings the add again (${r1})" r1 STREQUAL sAdd)
  check("${tag}: and the move (${r2})" r2 STREQUAL sMove)
  set(${tag}_main_out "${o}" PARENT_SCOPE)
endfunction()

# ---- the sampler (its settings: the Audio clip window, whose Sample tab holds the sample's warp well)
lanes(sampler "--chan;0" "##warpbtn" "##warpedit" "4 clipeditor tab 2\n" "")

# ---- Kerf (its channel window): and the lane's clicks never select a region
lanes(kerf "--chan;1" "##warpbtn" "##warpedit" "" "")
set(o "${kerf_main_out}")
set(last_out "${o}")
kerfSel("${o}" 30 selStart)
kerfSel("${o}" 190 selLane)
kerfSel("${o}" 230 selAbove)
check("Kerf: the clicks in the warp lane left the selected region alone (${selStart} -> ${selLane})" NOT selStart STREQUAL "-" AND selLane STREQUAL selStart)
check("Kerf: a click above the lane selects the region there (${selLane} -> ${selAbove})" NOT selAbove STREQUAL selLane)

# ---- Loupe (on the loop's file): its own undo
lanes(loupe "" "##loupewarp" "##loupewarpedit" "4 loupe file \"${wav}\"\n" "loupe")
