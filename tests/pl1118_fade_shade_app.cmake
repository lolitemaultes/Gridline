# Gridline - PL-1118: the shade over the part of an audio clip a fade removes is one smooth fill, in the
# real app (hidden, isolated config and HOME, 1440x900, the playlist shown, a fixed 16 ms frame time). It
# was one anti-aliased quad per curve segment: their soft edges overlapped, doubling the alpha along every
# seam (a grid of vertical stripes across the fade). A copy of the test song gets a sample channel and
# one long audio clip with a long fade-in and fade-out (quiet, so its waveform keeps clear of the body's
# top). At 1x and 2x (a HiDPI framebuffer: --scale) and two zooms, a body row near the top is read across the
# shaded part of each fade: neighbouring pixels may differ by at most a few levels (no seam), and the
# shade really is there (the row is darker / lighter than the body past the fade).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DLAYOUT=logic|live] -P pl1118_fade_shade_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
# The clip: four bars, a fade-in and a fade-out of 1.6 s each, at a tenth of its level.
set(t0 0)
if(LAYOUT STREQUAL "live")  # Clips: the arrangement starts after the live area
  set(t0 768)
endif()
set(clip "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 3, \"start\": ${t0}, \"length\": 1536, \"pattern\": 0, \"fadeIn\": 1.6, \"fadeOut\": 1.6, \"fadeInManual\": true, \"fadeOutManual\": true, \"gain\": 0.1}")
string(REPLACE "\"channels\": [" "\"channels\": [${chan}" demo "${demo}")
string(REGEX REPLACE "\"playlist\": \\[[^]]*\\]" "\"playlist\": [${clip}]" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
if(LAYOUT STREQUAL "live")
  string(REPLACE "\"playlist\": [" "\"live\": {\"areaEnd\": 768, \"view\": \"arrangement\"}, \"playlist\": [" demo "${demo}")
endif()
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL (${LAYOUT}): ${msg}")
endfunction()

# "123.4" (plgeom's one decimal) -> device pixels at <fh> hundredths of a device pixel per logical pixel.
function(dev var v fh)
  string(REPLACE "." "" tenths "${v}")
  math(EXPR d "(${tenths} * ${fh} + 500) / 1000")
  set(${var} ${d} PARENT_SCOPE)
endfunction()

# Lightness (r + 2g + b) of the image pixels [x0, x1) of row y.
function(rowlum ppm y x0 x1)
  file(READ "${ppm}" hdr LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" h "${hdr}")
  if(h STREQUAL "")
    fail("${ppm}: not a P6 image")
  endif()
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${h}" off)
  math(EXPR o "${off} + (${y} * ${w} + ${x0}) * 3")
  math(EXPR bytes "(${x1} - ${x0}) * 3")
  file(READ "${ppm}" hex OFFSET ${o} LIMIT ${bytes} HEX)
  string(REGEX MATCHALL "......" pix "${hex}")
  set(ls "")
  foreach(p ${pix})
    string(SUBSTRING "${p}" 0 2 r)
    string(SUBSTRING "${p}" 2 2 g)
    string(SUBSTRING "${p}" 4 2 b)
    math(EXPR l "0x${r} + 2 * 0x${g} + 0x${b}")
    list(APPEND ls ${l})
  endforeach()
  set(lums "${ls}" PARENT_SCOPE)
endfunction()

# smooth <what> <lums>: no step between neighbours larger than 6 of 1020 (a seam doubled the shade's
# alpha over a pixel or two: steps of 15 and more); fails otherwise.
function(smooth what)
  set(prev "")
  set(i 0)
  foreach(l ${ARGN})
    if(NOT prev STREQUAL "")
      math(EXPR d "${l} - ${prev}")
      if(d LESS 0)
        math(EXPR d "-${d}")
      endif()
      if(d GREATER 6)
        fail("${what}: a step of ${d} at pixel ${i} of the row (a seam in the fade's shade): ${ARGN}")
      endif()
    endif()
    set(prev ${l})
    math(EXPR i "${i} + 1")
  endforeach()
endfunction()

# run <tag> <ui scale in hundredths> <zoom>
function(run tag fh zoom)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "14 plgeom\n")
  set(layoutArgs "")
  if(LAYOUT)
    file(MAKE_DIRECTORY "${cfg}/gridline")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layoutPreset\": \"${LAYOUT}\"}}\n")
    set(layoutArgs --layout ${LAYOUT})
  endif()
  math(EXPR ui_i "${fh} / 100")
  math(EXPR ui_f "${fh} % 100")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --show playlist --zoom ${zoom} --scale ${ui_i}.${ui_f} ${layoutArgs} --dev-input "${OUT}/${tag}.txt" --frames 18
                          --screenshot "${OUT}/${tag}.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    fail("${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  string(REGEX MATCH "\n  clip 70 x ([0-9.]+) ([0-9.]+) y ([0-9.]+) ([0-9.]+) head ([0-9.]+)" _ "${out}")
  if("${CMAKE_MATCH_1}" STREQUAL "")
    fail("${tag}: clip 70 is not drawn")
  endif()
  dev(x0 "${CMAKE_MATCH_1}" ${fh})
  dev(x1 "${CMAKE_MATCH_2}" ${fh})
  dev(y0 "${CMAKE_MATCH_3}" ${fh})
  dev(y1 "${CMAKE_MATCH_4}" ${fh})
  dev(hd "${CMAKE_MATCH_5}" ${fh})
  math(EXPR lim "1440 * ${fh} / 100 - 4")
  if(x1 GREATER lim)
    fail("${tag}: clip 70 runs off the window (${x0}..${x1})")
  endif()
  # The fades' spans: 1.6 s of the clip's 4 bars (at the song's tempo), measured from the drawn box.
  string(REGEX MATCH "\"tempo\": *([0-9.]+)" _ "${demo}")
  set(bpm "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "\\..*" "" bpm "${bpm}")
  math(EXPR w "${x1} - ${x0}")
  math(EXPR fw "${w} * ${bpm} / 600")  # 1.6 s / (16 beats * 60 / bpm s)
  if(fw LESS 30)
    fail("${tag}: the fades are too short to read (${fw} px)")
  endif()
  # A row a quarter of the way down the body (under the title strip, above the quiet waveform): the
  # fade curve crosses it a quarter of the way into each fade, so the shade runs from there to the
  # clip's edge. Read the middle of that run (clear of the curve and the clip's rim).
  math(EXPR yr "${y0} + ${hd} + (${y1} - ${y0} - ${hd}) / 4")
  math(EXPR ia "${x0} + ${fw} / 20 + 2")
  math(EXPR ib "${x0} + ${fw} / 5")
  math(EXPR oa "${x1} - ${fw} / 5")
  math(EXPR ob "${x1} - ${fw} / 20 - 2")
  rowlum("${OUT}/${tag}.ppm" ${yr} ${ia} ${ib})
  set(inRow ${lums})
  smooth("${tag}: fade-in shade, row ${yr}, x ${ia}..${ib}" ${lums})
  rowlum("${OUT}/${tag}.ppm" ${yr} ${oa} ${ob})
  set(outRow ${lums})
  smooth("${tag}: fade-out shade, row ${yr}, x ${oa}..${ob}" ${lums})
  # The shade is there: the body between the fades on that row differs from the shaded part.
  math(EXPR ma "(${x0} + ${x1}) / 2 - 4")
  math(EXPR mb "(${x0} + ${x1}) / 2 + 4")
  rowlum("${OUT}/${tag}.ppm" ${yr} ${ma} ${mb})
  list(GET lums 0 body)
  list(GET outRow 0 shaded)
  math(EXPR d "${body} - ${shaded}")
  if(d LESS 0)
    math(EXPR d "-${d}")
  endif()
  if(d LESS 12)
    fail("${tag}: no shade over the fade-out (body ${body}, shaded ${shaded})")
  endif()
  message(STATUS "ok - ${LAYOUT} ${tag}: fade shades smooth (body ${body}, shade ${shaded}, ${fw} px fades)")
endfunction()

set(zlo 1.5)
set(zhi 2.4)
if(LAYOUT STREQUAL "live")  # (zoomed further in, Clips' view keeps its centre, past the clip)
  set(zlo 1.0)
  set(zhi 1.5)
endif()
run(zlo_s100 100 ${zlo})
run(zlo_s200 200 ${zlo})
run(zhi_s100 100 ${zhi})
run(zhi_s200 200 ${zhi})
message(STATUS "pl1118_fade_shade_app (${LAYOUT}): all checks passed")
