# Gridline: every knob of the piano roll tools (Quantize, Chop, Strum, Arpeggiate, Flam, Articulate,
# Randomize, Note LFO, Scale levels, Limit, Riff, Properties, the two step tools) and of one window of each
# other kind (channel settings, channel envelope, mixer, automation LFO tool, a plugin editor, the channel rack
# and the top bar) is
# dragged in the real app, one knob after the other, through the dev input hooks (knob_drag_lib.cmake):
# a slow drag moves it by what the pointer travelled, it stays after the release, a fine drag moves it a
# little, a double-click puts it back on its default.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DONLY=<case,case...>] -P knob_drag_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)
set(SONG "${OUT}/song.gridline.json")
if(DEFINED ONLY)
  string(REPLACE "," ";" ONLY "${ONLY}")  # (a comma list from the test registration)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/knob_drag_lib.cmake")

set(KNOB_FAILS "")
set(total 0)
macro(sweep name)
  if(NOT DEFINED ONLY OR "${name}" IN_LIST ONLY)
    knob_sweep(${name} ${ARGN})
    math(EXPR total "${total} + ${KNOB_COUNT_${name}}")
  endif()
endmacro()

# Piano roll tools on pattern 0, channel 6, with eight notes to work on (the tool opens at frame 3).
set(notes "2 mknotes 8 96 48x2\n")
foreach(tool quantize chop strum arp flam articulate randomize lfo levels limit riff props)
  sweep(${tool} "${notes}" 12 "^j11tool$" --edit 0 6 --hide rack --tool ${tool})
endforeach()
# The step tools on the same channel.
foreach(tool fill randsteps)
  sweep(${tool} "# no setup\n" 12 "^j11tool$" --edit 0 6 --tool ${tool})
endforeach()
# Channel settings (misc page), the channel envelope page, the mixer, the automation clip LFO tool, a
# plugin editor.
sweep(chanmisc "# no setup\n" 12 "^channelsettings$" --show chanmisc)
sweep(chanenv "# no setup\n" 12 "^channelsettings$" --show chanenv)
sweep(mixer "# no setup\n" 12 "^Mixer$" --show mixer)
sweep(autolfo "# no setup\n" 12 "^autolfo$" --show autolfo)
sweep(plugin "# no setup\n" 12 "^channelsettings$" --plugin gl.synth)
# The channel rack and the top bar (song swing, channel volume and pan, master volume and pitch).
sweep(rack "# no setup\n" 12 "^Channel rack$|^##topbar$")

# The wheel, a typed value and undo, on knobs that keep whole numbers.
function(item_of prefix id var)
  foreach(item IN LISTS ${prefix}_items)
    if("${${prefix}_${item}_id}" STREQUAL "${id}" OR "${${prefix}_${item}_name}" STREQUAL "${id}")
      set(${var} ${item} PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "FAIL: no knob ${id}")
endfunction()
function(value_at out frame item var)
  knob_collect("${out}" ${frame} "." V)
  set(${var} ${V_${item}_value} PARENT_SCOPE)
  set(${var}_undo ${V_undo} PARENT_SCOPE)
endfunction()
macro(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    list(APPEND KNOB_FAILS "${what}: want ${expect}, got ${got}")
    message(STATUS "FAIL - ${what}: want ${expect}, got ${got}")
  else()
    message(STATUS "ok - ${what}")
  endif()
endmacro()
if(NOT DEFINED ONLY OR "extra" IN_LIST ONLY)
  # Randomize "Range" (1..4 octaves, starts at 1): a wheel notch is one step, four quarter notches
  # (a trackpad) are one step, Alt+click types a value.
  set(rargs --edit 0 6 --hide rack --tool randomize)
  knob_run(wl "12 knobs\n14 quit discard\n" ${rargs})
  knob_collect("${wl_out}" 12 "^j11tool$" W)
  item_of(W "##rrng" rng)
  set(s "14 atknob ${rng}\n16 knobs\n18 wheel 1\n22 knobs\n24 wheel 0.25\n25 wheel 0.25\n26 wheel 0.25\n27 wheel 0.25\n30 knobs\n")
  string(APPEND s "32 mod alt 1\n33 down 0\n34 up 0\n35 mod alt 0\n38 text 4\n40 key enter\n44 knobs\n46 wheel -1\n50 knobs\n52 quit discard\n")
  knob_run(wheel "${s}" ${rargs})
  value_at("${wheel_out}" 16 ${rng} v0)
  value_at("${wheel_out}" 22 ${rng} v1)
  value_at("${wheel_out}" 30 ${rng} v2)
  value_at("${wheel_out}" 44 ${rng} v3)
  value_at("${wheel_out}" 50 ${rng} v4)
  want("Randomize Range starts at 1" "${v0}" "1")
  want("one wheel notch moves Range one step" "${v1}" "2")
  want("four quarter notches move Range one step" "${v2}" "3")
  want("a typed 4 sets Range to 4" "${v3}" "4")
  want("a notch down moves Range back one step" "${v4}" "3")
  # Channel settings: each drag of a knob that edits the project is one undo step.
  knob_run(ul "12 knobs\n14 quit discard\n" --show chanmisc)
  knob_collect("${ul_out}" 12 "^channelsettings$" U)
  item_of(U "Voices" voices)
  item_of(U "Feedback" fb)
  set(s "")
  set(f 14)
  foreach(item ${voices} ${fb})
    string(APPEND s "${f} knobs\n")
    math(EXPR f "${f} + 2")
    string(APPEND s "${f} atknob ${item}\n")
    math(EXPR f "${f} + 2")
    string(APPEND s "${f} down 0\n")
    foreach(i RANGE 1 30)
      math(EXPR f "${f} + 1")
      string(APPEND s "${f} atknob ${item} 0 -${i}\n")
    endforeach()
    math(EXPR f "${f} + 3")
    string(APPEND s "${f} up 0\n")
    math(EXPR f "${f} + 4")
  endforeach()
  string(APPEND s "${f} knobs\n")
  math(EXPR fq "${f} + 2")
  string(APPEND s "${fq} quit discard\n")
  knob_run(undo "${s}" --show chanmisc)
  value_at("${undo_out}" 14 ${voices} u0)
  value_at("${undo_out}" ${f} ${voices} u2)
  value_at("${undo_out}" ${f} ${fb} fb2)
  math(EXPR steps "${u2_undo} - ${u0_undo}")
  want("two knob drags in channel settings are two undo steps" "${steps}" "2")
  # (the first press also brings the window to the front: the drag may start a pixel late)
  if(u2 STREQUAL "9")
    set(u2 10)
  endif()
  want("a slow 30 px drag takes Voices from 0 to about 10, a whole number" "${u2}" "10")
  want("a slow 30 px drag takes Feedback from 0.5 to 0.65" "${fb2}" "0.65")
endif()

list(LENGTH KNOB_FAILS n)
if(n GREATER 0)
  message(FATAL_ERROR "FAIL: ${n} knob checks failed (of ${total} knobs):\n${KNOB_FAILS}")
endif()
message(STATUS "ok - ${total} knobs drag, stay, fine-drag and reset")
