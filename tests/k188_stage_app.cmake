# Gridline: the Stage in the real app (hidden, isolated config, scripted input, 1440x900, the mixer
# window in its Stage view with --show mixer --show stage). Places come from a first run's "stage" report, so the
# checks follow the layout:
#   1. an untouched project: every track at the default spot, together in one group (a tray);
#   2. dragging a member out of the tray moves only that track, as one undo step; undo puts it back;
#   3. dropping it back onto the tray joins the group (the exact spot again);
#   4. a near miss next to another track never leaves the two overlapping;
#   5. Esc during a drag puts the track back;
#   6. keys: Tab picks a track, the arrows move it, 0 resets it, M mutes it;
#   7. a click on the floor selects nothing; the Stage draws while playing.
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> -P k188_stage_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(run tag size frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size ${size} --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${o}")
  endif()
  set(${tag}_out "${o}" PARENT_SCOPE)
endfunction()

# sdump(<tag> <n>): the n-th (0-based) "stage" report: s_open s_undo s_sel s_focus s_shown s_groups
# s_preview s_panel, s_ids (mixer indexes) and per index i: s_x<i> s_y<i> s_side<i> s_pan<i>
# s_depth<i> s_vol<i> s_sep<i> s_muted<i> s_group<i>; per group k: s_gx0<k> s_gy0<k> s_gx1<k> s_gy1<k>
# s_rx<k> s_ry<k> s_gcount<k>.
function(sdump tag n)
  string(REGEX MATCHALL "stage frame [0-9]+: [^\n]*\n(  (token|group) [^\n]*\n)*" all "${${tag}_out}")
  list(LENGTH all count)
  if(count LESS_EQUAL n)
    message(FATAL_ERROR "FAIL (${tag}): no stage report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${n} d)
  string(REGEX MATCH "open ([01]) undo ([0-9]+) sel ([-0-9,]+) focus ([-0-9]+) shown ([0-9]+) groups ([0-9]+) preview ([0-9]+) stage [-0-9. ]+ panel ([-0-9.]+)" _ "${d}")
  set(s_open "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(s_undo "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(s_sel "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(s_focus "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(s_shown "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(s_groups "${CMAKE_MATCH_6}" PARENT_SCOPE)
  set(s_preview "${CMAKE_MATCH_7}" PARENT_SCOPE)
  set(s_panel "${CMAKE_MATCH_8}" PARENT_SCOPE)
  string(REGEX MATCHALL "token [0-9]+ [^\n]*" toks "${d}")
  set(ids "")
  foreach(p IN LISTS toks)
    # CMake keeps nine groups: the flags come from a second match.
    string(REGEX MATCH "muted ([01]) solo [01] group ([-0-9]+)" _ "${p}")
    set(mu "${CMAKE_MATCH_1}")
    set(gr "${CMAKE_MATCH_2}")
    string(REGEX MATCH "token ([0-9]+) x ([-0-9.]+) y ([-0-9.]+) side ([-0-9.]+) pan ([-0-9.]+) depth ([-0-9.]+) volume ([-0-9.]+) sep ([-0-9.]+)" _ "${p}")
    set(i "${CMAKE_MATCH_1}")
    list(APPEND ids ${i})
    set(s_x${i} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_y${i} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_side${i} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(s_pan${i} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    set(s_depth${i} "${CMAKE_MATCH_6}" PARENT_SCOPE)
    set(s_vol${i} "${CMAKE_MATCH_7}" PARENT_SCOPE)
    set(s_sep${i} "${CMAKE_MATCH_8}" PARENT_SCOPE)
    set(s_muted${i} "${mu}" PARENT_SCOPE)
    set(s_group${i} "${gr}" PARENT_SCOPE)
  endforeach()
  set(s_ids "${ids}" PARENT_SCOPE)
  string(REGEX MATCHALL "group [0-9]+ count [^\n]*" grs "${d}")
  foreach(p IN LISTS grs)
    string(REGEX MATCH "group ([0-9]+) count ([0-9]+) box ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ring ([-0-9.]+) ([-0-9.]+)" _ "${p}")
    set(k "${CMAKE_MATCH_1}")
    set(s_gcount${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_gx0${k} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_gy0${k} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(s_gx1${k} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    set(s_gy1${k} "${CMAKE_MATCH_6}" PARENT_SCOPE)
    set(s_rx${k} "${CMAKE_MATCH_7}" PARENT_SCOPE)
    set(s_ry${k} "${CMAKE_MATCH_8}" PARENT_SCOPE)
  endforeach()
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# int(<var> <value>): a float position as a whole pixel.
macro(int var value)
  string(REGEX REPLACE "\\..*" "" ${var} "${value}")
endmacro()

# The first-run card is answered (it would sit over the stage).
file(MAKE_DIRECTORY "${OUT}/cfg/gridline")
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true}}")

# ---- 1. the layout: everyone at the default spot, in one tray ----
run(layout 1440x900 16 "12 stage\n" --show mixer --show stage)
sdump(layout 0)
check("the Stage is open in the mixer window with tracks on it (${s_shown})" s_open EQUAL 1 AND s_shown GREATER 2)
set(all0 1)
foreach(i IN LISTS s_ids)
  if(NOT s_pan${i} EQUAL 0 OR NOT s_depth${i} EQUAL 0 OR NOT s_group${i} EQUAL 0)
    set(all0 0)
  endif()
endforeach()
check("an untouched project: every track at the default spot, all in one group (${s_groups} groups)" all0 AND s_groups EQUAL 1)
list(GET s_ids 0 first)
list(GET s_ids 1 second)
int(AX "${s_x${first}}")
int(AY "${s_y${first}}")
int(BX "${s_x${second}}")
int(BY "${s_y${second}}")
int(TX0 "${s_gx00}")
int(TY0 "${s_gy00}")
int(TX1 "${s_gx10}")
int(RY "${s_ry0}")
int(PANEL "${s_panel}")

# ---- 2. drag a member out of the tray; undo ----
math(EXPR outY "${TY0} - 150")
math(EXPR midY "${TY0} - 60")
run(dragout 1440x900 48 "8 move ${AX} ${AY}\n10 down 0\n12 move ${AX} ${midY}\n14 move ${AX} ${outY}\n16 up 0\n22 stage\n26 undo\n30 stage\n" --show mixer --show stage)
sdump(dragout 0)
set(t "${first}")
check("a drag out of the tray moves that track back (depth ${s_depth${t}})" s_depth${t} GREATER 0.2 AND s_group${t} EQUAL -1)
int(OX "${s_x${t}}")  # where it stands now (the token sits on its spot, under the pointer's drop)
int(OY "${s_y${t}}")
set(others 1)
foreach(i IN LISTS s_ids)
  if(NOT i EQUAL t AND (NOT s_pan${i} EQUAL 0 OR NOT s_depth${i} EQUAL 0))
    set(others 0)
  endif()
endforeach()
check("... and only that track" others)
check("the drag is one undo step (${s_undo})" s_undo EQUAL 1)
sdump(dragout 1)
check("undo puts it back in the group (${s_depth${t}})" s_depth${t} EQUAL 0 AND s_group${t} EQUAL 0 AND s_undo EQUAL 0)

# ---- 3. out, then back onto the tray: it joins ----
math(EXPR trayX "(${TX0} + ${TX1}) / 2")
math(EXPR trayY "${TY0} + 20")
run(join 1440x900 64 "8 move ${AX} ${AY}\n10 down 0\n12 move ${AX} ${midY}\n14 move ${AX} ${outY}\n16 up 0\n22 stage\n26 move ${OX} ${OY}\n28 down 0\n30 move ${OX} ${midY}\n32 move ${trayX} ${trayY}\n34 move ${trayX} ${trayY}\n36 up 0\n42 stage\n" --show mixer --show stage)
sdump(join 0)
check("out of the group first (${s_depth${t}})" s_depth${t} GREATER 0.2)
sdump(join 1)
check("dropped onto the tray it joins the group: the exact spot (${s_pan${t}} ${s_depth${t}}, group ${s_group${t}})" s_pan${t} EQUAL 0 AND s_depth${t} EQUAL 0 AND s_group${t} EQUAL 0 AND s_undo EQUAL 2)

# ---- 4. a near miss never leaves an overlap ----
# Two tracks out to the left and right at one distance, then the second dropped just beside the first.
math(EXPR lX "${AX} - 100")  # still on the floor at that depth (the rooms panel narrows the stage)
math(EXPR rX "${AX} + 260")
run(miss 1440x900 80 "8 move ${AX} ${AY}\n10 down 0\n12 move ${AX} ${midY}\n14 move ${lX} ${outY}\n16 up 0\n22 stage\n" --show mixer --show stage)
sdump(miss 0)
int(LX "${s_x${first}}")
int(LY "${s_y${first}}")
int(SIDE "${s_side${first}}")
int(BX "${s_x${second}}")
int(BY "${s_y${second}}")
math(EXPR nearX "${LX} + ${SIDE} * 8 / 10")
math(EXPR BY2 "${BY} + 12")  # pressed away from the first press: not a double-click
run(miss2 1440x900 80 "8 move ${AX} ${AY}\n10 down 0\n12 move ${AX} ${midY}\n14 move ${lX} ${outY}\n16 up 0\n20 move ${BX} ${BY2}\n22 down 0\n24 move ${BX} ${midY}\n26 move ${nearX} ${LY}\n28 move ${nearX} ${LY}\n30 up 0\n40 stage\n" --show mixer --show stage)
sdump(miss2 0)
int(X1 "${s_x${first}}")
int(X2 "${s_x${second}}")
int(Y1 "${s_y${first}}")
int(Y2 "${s_y${second}}")
math(EXPR gapX "${X2} - ${X1}")
if(gapX LESS 0)
  math(EXPR gapX "0 - ${gapX}")
endif()
math(EXPR gapY "${Y2} - ${Y1}")
if(gapY LESS 0)
  math(EXPR gapY "0 - ${gapY}")
endif()
int(S2 "${s_side${second}}")
set(apart 0)
if(gapX GREATER_EQUAL S2 OR gapY GREATER_EQUAL S2 OR (s_pan${first} EQUAL s_pan${second} AND s_depth${first} EQUAL s_depth${second}))
  set(apart 1)
endif()
check("a near miss is eased to a free place, never resting on the other token (dx ${gapX} dy ${gapY}, side ${S2})" apart AND s_undo EQUAL 2)
check("... and it did not join (pans ${s_pan${first}} ${s_pan${second}})" NOT s_pan${first} EQUAL s_pan${second} OR NOT s_depth${first} EQUAL s_depth${second})

# ---- 5. Esc during a drag puts it back ----
run(esc 1440x900 40 "6 focus Mixer\n8 move ${AX} ${AY}\n10 down 0\n12 move ${AX} ${midY}\n14 move ${AX} ${outY}\n16 key escape\n18 up 0\n24 stage\n" --show mixer --show stage)
sdump(esc 0)
check("Esc during a drag puts the track back (${s_depth${t}})" s_depth${t} EQUAL 0 AND s_pan${t} EQUAL 0)

# ---- 6. keys ----
run(keys 1440x900 60 "6 focus Mixer\n8 move ${AX} ${AY}\n10 down 0\n11 up 0\n14 key right\n16 key up\n22 stage\n24 key 0\n28 stage\n30 key m\n34 stage\n36 key tab\n40 stage\n" --show mixer --show stage)
sdump(keys 0)
set(t "${s_focus}")
check("Right and Up: a little right, one row back (${s_pan${t}} ${s_depth${t}})" s_pan${t} GREATER 0.03 AND s_pan${t} LESS 0.07 AND s_depth${t} EQUAL 0.25)
sdump(keys 1)
check("0 puts the track back (${s_pan${t}} ${s_depth${t}})" s_pan${t} EQUAL 0 AND s_depth${t} EQUAL 0)
sdump(keys 2)
check("M mutes it" s_muted${t} EQUAL 1)
sdump(keys 3)
check("Tab moves to another track (${t} to ${s_focus})" NOT s_focus EQUAL t)

# ---- 7. a click on the floor selects nothing; playing ----
math(EXPR fy "${TY0} - 40")
math(EXPR fx "${TX0} - 60")
run(floor 1440x900 40 "8 move ${AX} ${AY}\n10 down 0\n11 up 0\n16 stage\n20 move ${fx} ${fy}\n22 down 0\n23 up 0\n28 stage\n" --show mixer --show stage)
sdump(floor 1)
check("a click on the floor selects nothing (${s_sel}, focus ${s_focus})" s_focus EQUAL 0 AND s_undo EQUAL 0)
run(both 1440x900 40 "20 stage\n30 stage\n" --show mixer --show stage --play)
sdump(both 1)
check("the Stage draws while playing" s_open EQUAL 1)

# ---- 8. layout audit: scale 1 and 2 in the default, pitch-black and light themes ----
# The placed band (a preset) with one track selected: no text of the mixer window may overlap other
# text or be cut by its clip.
foreach(theme default black light)
  if(theme STREQUAL "black")
    set(extra ", \"theme.brightness\": -1")
  elseif(theme STREQUAL "light")
    set(extra ", \"theme.mode\": \"light\"")
  else()
    set(extra "")
  endif()
  file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true${extra}}}")
  foreach(scale 1 2)
    if(scale EQUAL 2)
      set(size 2880x1800)
    else()
      set(size 1440x900)
    endif()
    set(tsv "${OUT}/audit_${theme}_${scale}.tsv")
    run(audit_${theme}_${scale} ${size} 24 "6 stage preview preset 0\n8 stage apply\n12 stage select 2\n" --show mixer --show stage --ui-scale ${scale} --align-audit "${tsv}")
    file(STRINGS "${tsv}" rows)
    set(bad "")
    foreach(r IN LISTS rows)
      if(r MATCHES "^Mixer[^\t]*\t(overlap|clip)\t")
        string(APPEND bad "\n  ${r}")
      endif()
    endforeach()
    string(LENGTH "${bad}" nbad)
    check("layout audit, ${theme} theme at scale ${scale}: no overlapping or cut text in the Stage${bad}" nbad EQUAL 0)
  endforeach()
endforeach()
# The mixer docked as a narrow side column: the panel keeps its identity and buttons, nothing overlaps.
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true}}")
foreach(sel "12 stage select 2\n" "12 stage none\n" "12 stage select 2,3\n" "12 stage preview sound\n")
  string(MAKE_C_IDENTIFIER "${sel}" nid)
  set(tsv "${OUT}/audit_narrow_${nid}.tsv")
  run(audit_narrow_${nid} 1440x900 24 "6 stage preview preset 0\n8 stage apply\n${sel}" --show stage --align-audit "${tsv}")
  file(STRINGS "${tsv}" rows)
  set(bad "")
  foreach(r IN LISTS rows)
    if(r MATCHES "^Mixer[^\t]*\t(overlap|clip)\t")
      string(APPEND bad "\n  ${r}")
    endif()
  endforeach()
  string(LENGTH "${bad}" nbad)
  check("layout audit, a narrow mixer (${nid}): no overlapping or cut text in the Stage${bad}" nbad EQUAL 0)
endforeach()
