# Gridline - K-133, in the real app (hidden, isolated config and HOME, dummy audio):
#   1. a lost OpenGL context at the splash: the context is made again and the start goes on; when
#      no new context can be had, a graphics report (as the main window does), exit code 3;
#   2. a lost context in the crash pop-up (the report of 1): it is drawn again, the same picture;
#      when no new context can be had it ends with code 3 and leaves the report for the next start;
#   3. a plugin's own interface is closed and opened again after a reset (its OpenGL is the plugin's);
#   4. a file job whose worker stops moving on is reported, and reported moving again;
#   5. a Track Receipt whose measurement fails tells the person.
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DCLAP=<test bundle> -DOUT=<dir> -P k133_recovery_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

# run(<tag> <expected exit code> <script> [args...]): its own config and HOME.
function(run tag code script)
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}/home")
  # The "Log file" switch, so the test can read what the person was told.
  file(WRITE "${OUT}/cfg_${tag}/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"debug.logToFile\": true}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1280x800 --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 150)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL ${code})
    message(FATAL_ERROR "FAIL (${tag}): ended with ${rc}, expected ${code}\n${out}\n${err}")
  endif()
  set(out "${out}\n${err}" PARENT_SCOPE)
endfunction()
function(must tag regex what)
  if(NOT out MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()

# ---- 1. the splash.
set(ENV{GRIDLINE_DEV_GL_LOSS_EARLY} "splash")
run(splash 0 "20 rmchan 0\n30 docstate\n40 quit discard\n")
must(splash "context rebuilt \\(splash\\)" "a lost context at the splash is made again")
must(splash "docstate modified 1" "and the start goes on to a working project")
set(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT} "1")
run(splash_gone 3 "40 quit discard\n")
unset(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT})
unset(ENV{GRIDLINE_DEV_GL_LOSS_EARLY})
file(GLOB reports "${OUT}/cfg_splash_gone/gridline/crash-reports/graphics-*.txt")
list(LENGTH reports n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL: ${n} graphics reports after the splash lost its context for good\n${out}")
endif()
file(READ "${reports}" report)
foreach(field "kind: graphics" "cause: graphics driver reset")
  if(NOT report MATCHES "${field}")
    message(FATAL_ERROR "FAIL: the report lacks ${field}:\n${report}")
  endif()
endforeach()
message(STATUS "ok - no new context at the splash: a graphics report and code 3, as in the main window")

# ---- 2. the crash pop-up, on that report.
function(dialog tag code)
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_splash_gone")
  set(ENV{HOME} "${OUT}/cfg_splash_gone/home")
  execute_process(COMMAND "${APP}" --crash-dialog "${reports}" --hidden --screenshot "${OUT}/${tag}.ppm" --frames 6
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 60)
  file(WRITE "${OUT}/${tag}.out" "${o}\n${e}")
  if(NOT rc EQUAL ${code})
    message(FATAL_ERROR "FAIL (${tag}): the pop-up ended with ${rc}, expected ${code}\n${o}\n${e}")
  endif()
  set(out "${o}\n${e}" PARENT_SCOPE)
endfunction()
dialog(dialog_plain 0)
set(ENV{GRIDLINE_DEV_GL_LOSS_EARLY} "dialog")
dialog(dialog_lost 0)
must(dialog_lost "context rebuilt \\(crash pop-up\\)" "a lost context in the crash pop-up is made again")
foreach(pic dialog_plain dialog_lost)
  if(NOT EXISTS "${OUT}/${pic}.ppm")
    message(FATAL_ERROR "FAIL: no picture of the pop-up (${pic})\n${out}")
  endif()
endforeach()
file(SIZE "${OUT}/dialog_plain.ppm" a)
file(SIZE "${OUT}/dialog_lost.ppm" b)
if(NOT a EQUAL b OR a LESS 10000)
  message(FATAL_ERROR "FAIL: the pop-up after the loss is not the same picture (${a} / ${b} bytes)")
endif()
file(READ "${OUT}/dialog_plain.ppm" pa HEX)
file(READ "${OUT}/dialog_lost.ppm" pb HEX)
if(pa STREQUAL pb)
  message(STATUS "ok - and it looks as it did")
else()
  message(STATUS "ok - and it is drawn again (the pictures differ in some pixels: what animates)")
endif()
set(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT} "1")
dialog(dialog_gone 3)
unset(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT})
unset(ENV{GRIDLINE_DEV_GL_LOSS_EARLY})
must(dialog_gone "the report is shown at the next start" "no new context in the pop-up: it ends, and says the report waits")
file(GLOB shown "${OUT}/cfg_splash_gone/gridline/crash-reports/*.showing")
if(shown)
  message(FATAL_ERROR "FAIL: the report still counts as shown: ${shown}")
endif()
message(STATUS "ok - the report is left for the next start")

# ---- 3. a plugin's own interface after a reset.
set(ENV{GRIDLINE_TEST_PLAIN_GUI} "1")
run(plugin 0 "10 junction scan clap ${CLAP}\n14 junction add clap:org.gridline.test.synth\n30 junction open last\n36 plugwin info\n40 glreset\n50 waitfor graphics-recovered 30\n70 plugwin info\n80 quit discard\n"
    --plugin gl.patcher)
unset(ENV{GRIDLINE_TEST_PLAIN_GUI})
if(out MATCHES "junction open last: 0")
  message(STATUS "SKIP: no plugin window on this machine (part 3)")
else()
  must(plugin "plugwin frame 36: 1 windows" "the plugin's interface is open")
  must(plugin "interface opened again after the graphics reset" "after a reset it is closed and opened again")
  must(plugin "plugwin frame 70: 1 windows" "and it is there")
endif()

# ---- 4. a worker that stops moving on.
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "2500")
set(ENV{GRIDLINE_DEV_WORKER_STALL_MS} "700")
run(stall 0 "5 forget file-job-finished\n6 filejob data \"${OUT}/res/data\"\n8 waitfor worker-stalled 30\n10 waitfor worker-moving 30\n20 waitfor file-job-finished 120\n30 quit discard\n")
must(stall "waitfor worker-stalled: reached" "a worker that stops moving on is reported")
must(stall "waitfor worker-moving: reached" "and reported moving again")
must(stall "waitfor file-job-finished: reached" "the job still finishes")
unset(ENV{GRIDLINE_DEV_WORKER_STALL_MS})
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "150")
run(nostall 0 "5 forget file-job-finished\n6 filejob data \"${OUT}/res/data2\"\n20 waitfor file-job-finished 60\n30 quit discard\n")
if(out MATCHES "worker-stalled")
  message(FATAL_ERROR "FAIL: a job that moves on was reported as stalled\n${out}")
endif()
message(STATUS "ok - a job that moves on is not reported")
unset(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS})
file(GLOB_RECURSE logs "${OUT}/cfg_stall/*.log")
set(logged 0)
foreach(l IN LISTS logs)
  file(READ "${l}" t)
  if(t MATCHES "stopped moving on")
    set(logged 1)
  endif()
endforeach()
if(NOT logged)
  message(FATAL_ERROR "FAIL: the stalled worker is not in the log (${logs})")
endif()
message(STATUS "ok - and it is in the log")

# ---- 5. a Track Receipt that fails.
set(ENV{GRIDLINE_TRACK_RECEIPT_DEMO} "calculate")
set(ENV{GRIDLINE_DEV_RECEIPT_FAIL} "1")
run(receipt 0 "2 forget receipt-failed\n3 waitfor receipt-failed 60\n10 quit discard\n")
unset(ENV{GRIDLINE_DEV_RECEIPT_FAIL})
unset(ENV{GRIDLINE_TRACK_RECEIPT_DEMO})
must(receipt "waitfor receipt-failed: reached" "a measurement that fails ends as a failure")
file(GLOB_RECURSE logs "${OUT}/cfg_receipt/*.log")
set(logged 0)
foreach(l IN LISTS logs)
  file(READ "${l}" t)
  if(t MATCHES "Track Receipt could not be calculated")
    set(logged 1)
  endif()
endforeach()
if(NOT logged)
  message(FATAL_ERROR "FAIL: the person was not told (no notification in the log: ${logs})")
endif()
message(STATUS "ok - and the person is told")
