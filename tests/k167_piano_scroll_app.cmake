# Gridline: the piano roll's scrollers and its wheel and trackpad scrolling (hidden, isolated configs,
# 1440x900, the piano roll on pattern 1, a fixed 16 ms frame time, the drawn view of every frame from
# "lane"):
#   1. the horizontal scroller: dragging the thumb scrolls the time (the thumb follows the pointer),
#      dragging its right end zooms in and its left end zooms out with the other end staying put,
#      a click beside the thumb pages, a double-click fits the pattern;
#   2. the plain wheel over the horizontal scroller scrolls sideways and glides (no jump), the keys stay;
#   3. the plain wheel over the grid still scrolls the keys, Shift+wheel the time;
#   4. a trackpad's fractional sideways scroll follows the fingers 1:1 at once (no glide afterwards);
#   5. Ctrl+wheel keeps the tick under the pointer;
#   6. the vertical scroller: dragging the thumb scrolls the keys, dragging its bottom end changes the
#      key height with the top end staying put;
#   7. the automation clip editor's time scroller: the thumb scrolls, an end zooms with the other end
#      staying put, a double-click fits the clip.
#   cmake -DAPP=<gridline-app> -DSONG=<test_song.gridline.json> -DOUT=<dir> -P k167_piano_scroll_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_REDUCED_MOTION} "0")  # the glides do not depend on the machine's accessibility setting
configure_file("${SONG}" "${OUT}/song.gridline.json" COPYONLY)  # a copy: the fixture is never opened in place
if(APPLE)
  set(ctrl super)  # Ctrl for ImGui (macOS swaps Cmd and Ctrl)
else()
  set(ctrl ctrl)
endif()

# run(<tag> <frames> <script> [view args]): output in ${out} (default: the piano roll).
function(run tag frames script)
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}/gridline")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "2 typing off\n${script}${frames} quit discard\n")
  set(shown --edit 0 6 --hide rack)
  if(ARGC GREATER 3)
    set(shown ${ARGN})
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${shown}
                          --frames 400 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n(output in ${OUT})")
endfunction()
function(check msg)
  if(NOT (${ARGN}))
    fail("${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
# "-12.3456" -> -12345 (thousandths); with digits 6: millionths.
function(fixed var v digits)
  string(REGEX MATCH "^(-?)([0-9]*)\\.?([0-9]*)$" _ "${v}")
  set(sign "${CMAKE_MATCH_1}")
  set(i "${CMAKE_MATCH_2}")
  set(f "${CMAKE_MATCH_3}000000")
  string(SUBSTRING "${f}" 0 ${digits} f)
  if(i STREQUAL "")
    set(i 0)
  endif()
  set(scale 1000)
  if(digits EQUAL 6)
    set(scale 1000000)
  endif()
  math(EXPR r "${i} * ${scale} + 1${f} - ${scale}")
  if(sign STREQUAL "-")
    math(EXPR r "0 - ${r}")
  endif()
  set(${var} ${r} PARENT_SCOPE)
endfunction()
function(absdiff var a b)
  math(EXPR d "${a} - ${b}")
  if(d LESS 0)
    math(EXPR d "0 - ${d}")
  endif()
  set(${var} ${d} PARENT_SCOPE)
endfunction()

# The piano roll at <frame>: v_x0 v_sx v_sy v_gx0 v_gy0 v_gx1 v_gy1 v_rh v_ht0 v_ht1 v_hy v_vt0 v_vt1 v_vx
# (thousandths of a px) and v_ppt (millionths of a px per tick).
function(view frame)
  string(REGEX MATCH "lane frame ${frame}: x0 ([-0-9.]+) pxPerTick ([0-9.]+) [^\n]* rowH ([0-9.]+) [^\n]* view sx ([-0-9.]+) sy ([-0-9.]+) grid ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)"
         _ "${out}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no piano roll view at frame ${frame}")
  endif()
  fixed(v "${CMAKE_MATCH_2}" 6)
  set(v_ppt ${v} PARENT_SCOPE)
  set(names x0 _ rh sx sy gx0 gy0 gx1 gy1)
  set(k 1)
  foreach(n IN LISTS names)
    if(NOT n STREQUAL "_")
      fixed(v "${CMAKE_MATCH_${k}}" 3)
      set(v_${n} ${v} PARENT_SCOPE)
    endif()
    math(EXPR k "${k} + 1")
  endforeach()
  string(REGEX MATCH "lane frame ${frame}: [^\n]* hthumb ([-0-9.]+) ([-0-9.]+) y ([-0-9.]+) vthumb ([-0-9.]+) ([-0-9.]+) x ([-0-9.]+)" _ "${out}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no scrollers at frame ${frame}")
  endif()
  set(names ht0 ht1 hy vt0 vt1 vx)
  set(k 1)
  foreach(n IN LISTS names)
    fixed(v "${CMAKE_MATCH_${k}}" 3)
    set(v_${n} ${v} PARENT_SCOPE)
    math(EXPR k "${k} + 1")
  endforeach()
endfunction()
function(lanes from to)
  set(sc "")
  foreach(f RANGE ${from} ${to})
    string(APPEND sc "${f} lane\n")
  endforeach()
  set(lanes "${sc}" PARENT_SCOPE)
endfunction()

# ---- the layout ----
run(geo 32 "28 lane\n")
view(28)
check("the horizontal scroller sits above the grid (y ${v_hy} above ${v_gy0})" v_hy LESS v_gy0)
check("the vertical scroller sits left of the grid (x ${v_vx} left of ${v_gx0})" v_vx LESS v_gx0)
check("the horizontal thumb is shorter than its rail (${v_ht0} .. ${v_ht1}, grid ${v_gx0} .. ${v_gx1})" v_ht1 LESS v_gx1)
check("the vertical thumb is shorter than its rail (${v_vt0} .. ${v_vt1})" v_vt1 LESS v_gy1)
math(EXPR hy "${v_hy} / 1000")
math(EXPR vx "${v_vx} / 1000")
math(EXPR hmid "(${v_ht0} + ${v_ht1}) / 2000")
math(EXPR hl "${v_ht0} / 1000 + 2")
math(EXPR hr "${v_ht1} / 1000 - 2")
math(EXPR vmid "(${v_vt0} + ${v_vt1}) / 2000")
math(EXPR vbot "${v_vt1} / 1000 - 2")
math(EXPR gx "(${v_gx0} + ${v_gx1}) / 2000")
math(EXPR gy "(${v_gy0} + ${v_gy1}) / 2000")
set(sx0 ${v_sx})
set(sy0 ${v_sy})
set(ppt0 ${v_ppt})
set(rh0 ${v_rh})
set(ht00 ${v_ht0})

# ---- 1. the horizontal scroller ----
set(pre "")
# Drag (<x0> <y0>) by (<dx> <dy>) in four steps from frame 32, lane on frames 30 and 50.
function(drag tag x0 y0 dx dy)
  set(sc "${pre}20 move ${x0} ${y0}\n30 lane\n32 down 0\n")
  foreach(s 1 2 3 4)
    math(EXPR x "${x0} + ${dx} * ${s} / 4")
    math(EXPR y "${y0} + ${dy} * ${s} / 4")
    math(EXPR f "32 + ${s} * 3")
    string(APPEND sc "${f} move ${x} ${y}\n")
  endforeach()
  string(APPEND sc "46 lane\n48 up 0\n50 lane\n")
  run(${tag} 52 "${sc}")
  set(out "${out}" PARENT_SCOPE)
endfunction()

drag(hthumb ${hmid} ${hy} 200 0)
view(30)
set(a ${v_sx})
set(t0 ${v_ht0})
view(50)
check("horizontal thumb dragged right: the time scrolls on (${a} -> ${v_sx})" v_sx GREATER a)
math(EXPR moved "${v_ht0} - ${t0}")
absdiff(d ${moved} 200000)
check("horizontal thumb dragged right: the thumb follows the pointer (${moved} / 1000 px for 200)" d LESS_EQUAL 2000)
check("horizontal thumb dragged: the keys stay (${sy0} -> ${v_sy})" v_sy EQUAL sy0)

drag(hright ${hr} ${hy} -60 0)
view(30)
set(a ${v_ht0})
set(p ${v_ppt})
view(50)
absdiff(d ${v_ht0} ${a})
check("horizontal scroller, right end dragged left: zoomed in (${p} -> ${v_ppt})" v_ppt GREATER p)
check("horizontal scroller, right end dragged left: the left end stays put (${a} -> ${v_ht0})" d LESS_EQUAL 1000)

# Zooming out with the right end held needs room on the left: scrolled on a little first.
set(pre "4 move ${gx} ${gy}\n6 mod shift 1\n8 wheel -6\n10 mod shift 0\n")
run(hscrolled 30 "${pre}28 lane\n")
view(28)
math(EXPR hl "${v_ht0} / 1000 + 2")
drag(hleft ${hl} ${hy} -40 0)
set(pre "")
view(30)
set(a ${v_ht1})
set(p ${v_ppt})
view(50)
absdiff(d ${v_ht1} ${a})
check("horizontal scroller, left end dragged left: zoomed out (${p} -> ${v_ppt})" v_ppt LESS p)
check("horizontal scroller, left end dragged left: the right end stays put (${a} -> ${v_ht1})" d LESS_EQUAL 1000)

math(EXPR page "${v_gx1} / 1000 - 6")  # right of the thumb: the rail
run(page 60 "20 move ${page} ${hy}\n30 lane\n32 down 0\n33 up 0\n50 lane\n")
view(30)
set(a ${v_sx})
math(EXPR gw "${v_gx1} - ${v_gx0}")
view(50)
math(EXPR got "${v_sx} - ${a}")
math(EXPR want "${gw} * 9 / 10")
absdiff(d ${got} ${want})
check("a click on the rail right of the thumb pages on by 90% of the view (${got} / 1000 px, want ${want})" d LESS_EQUAL 2000)

lanes(36 40)
run(fit 60 "10 move ${hmid} ${hy}\n12 mod ${ctrl} 1\n14 wheel 2\n16 mod ${ctrl} 0\n20 move 900 ${hy}\n30 lane\n32 down 0\n33 up 0\n35 down 0\n36 up 0\n50 lane\n")
view(30)
set(p ${v_ppt})
view(50)
check("a double-click on the scroller fits the pattern: the zoom changes back (${p} -> ${v_ppt})" NOT v_ppt EQUAL p)
check("a double-click on the scroller fits the pattern: from its start (${v_sx})" v_sx EQUAL 0)

# ---- 2. the plain wheel over the horizontal scroller ----
lanes(30 60)
run(barwheel 62 "20 move ${hmid} ${hy}\n${lanes}31 wheel -1\n")
view(30)
set(a ${v_sx})
set(b ${v_sy})
set(prev ${v_sx})
set(between 0)
foreach(f RANGE 31 60)
  view(${f})
  if(NOT v_sx EQUAL prev)
    math(EXPR between "${between} + 1")
  endif()
  set(prev ${v_sx})
endforeach()
math(EXPR got "${v_sx} - ${a}")
absdiff(d ${got} 60000)
check("the wheel over the time scroller scrolls sideways by one step (${got} / 1000 px)" d LESS_EQUAL 1000)
check("the wheel over the time scroller glides (${between} frames move)" between GREATER_EQUAL 3)
check("the wheel over the time scroller leaves the keys (${b} -> ${v_sy})" v_sy EQUAL b)

# ---- 3. the plain wheel and Shift+wheel over the grid ----
run(gridwheel 62 "20 move ${gx} ${gy}\n30 lane\n31 wheel -1\n44 lane\n46 mod shift 1\n47 wheel -1\n48 mod shift 0\n60 lane\n")
view(30)
set(a ${v_sx})
set(b ${v_sy})
view(44)
check("the wheel over the grid scrolls the keys (${b} -> ${v_sy})" NOT v_sy EQUAL b)
check("the wheel over the grid leaves the time (${a} -> ${v_sx})" v_sx EQUAL a)
set(b ${v_sy})
view(60)
check("Shift+wheel over the grid scrolls the time (${a} -> ${v_sx})" v_sx GREATER a)
check("Shift+wheel over the grid leaves the keys (${b} -> ${v_sy})" v_sy EQUAL b)

# ---- 4. a trackpad's fractional sideways scroll: 1:1 at once ----
run(pad 62 "20 move ${gx} ${gy}\n30 lane\n31 scroll -0.5 0\n32 lane\n33 lane\n40 lane\n")
view(30)
set(a ${v_sx})
view(32)
set(b ${v_sx})
view(40)
math(EXPR got "${b} - ${a}")
absdiff(d ${got} 30000)
check("a trackpad's sideways scroll moves the time at once, 1:1 (${got} / 1000 px for 30)" d LESS_EQUAL 500)
check("a trackpad's sideways scroll does not glide on afterwards (${b} -> ${v_sx})" v_sx EQUAL b)

# ---- 5. Ctrl+wheel keeps the tick under the pointer ----
math(EXPR cx "${gx} + 150")
lanes(30 62)
run(ctrlwheel 64 "20 move ${cx} ${gy}\n${lanes}30 mod ${ctrl} 1\n32 wheel 1\n60 mod ${ctrl} 0\n")
view(30)
math(EXPR off0 "${cx} * 1000 - ${v_x0}")
set(p0 ${v_ppt})
set(worst 0)
foreach(f RANGE 31 62)
  view(${f})
  math(EXPR want "${off0} * ${v_ppt} / ${p0}")
  math(EXPR got "${cx} * 1000 - ${v_x0}")
  absdiff(d ${got} ${want})
  if(d GREATER worst)
    set(worst ${d})
  endif()
endforeach()
check("Ctrl+wheel zooms in (${p0} -> ${v_ppt})" v_ppt GREATER p0)
check("Ctrl+wheel: the tick under the pointer stays put at every frame (worst ${worst} / 1000 px)" worst LESS_EQUAL 1500)

# ---- 6. the vertical scroller ----
drag(vthumb ${vx} ${vmid} 0 80)
view(30)
set(a ${v_sy})
set(t0 ${v_vt0})
view(50)
check("vertical thumb dragged down: the keys scroll down (${a} -> ${v_sy})" v_sy GREATER a)
math(EXPR moved "${v_vt0} - ${t0}")
absdiff(d ${moved} 80000)
check("vertical thumb dragged down: the thumb follows the pointer (${moved} / 1000 px for 80)" d LESS_EQUAL 2000)

drag(vbot ${vx} ${vbot} 0 -60)
view(30)
set(a ${v_vt0})
set(r ${v_rh})
view(50)
absdiff(d ${v_vt0} ${a})
check("vertical scroller, bottom end dragged up: the keys grow (${r} -> ${v_rh})" v_rh GREATER r)
check("vertical scroller, bottom end dragged up: the top end stays put (${a} -> ${v_vt0})" d LESS_EQUAL 1000)

# ---- 7. the automation clip editor's time scroller ----
# ae(<frame>): a_sx a_ht0 a_ht1 a_hy a_gx0 a_gx1 (thousandths), a_ppt (millionths).
function(ae frame)
  string(REGEX MATCH "autoedit frame ${frame}: open 1 [^\n]* view sx ([-0-9.]+) pxPerTick ([0-9.]+) hthumb ([-0-9.]+) ([-0-9.]+) y ([-0-9.]+) grid ([-0-9.]+) ([-0-9.]+)" _ "${out}")
  if(CMAKE_MATCH_1 STREQUAL "")
    fail("no automation editor view at frame ${frame}")
  endif()
  fixed(v "${CMAKE_MATCH_2}" 6)
  set(a_ppt ${v} PARENT_SCOPE)
  set(names sx _ ht0 ht1 hy gx0 gx1)
  set(k 1)
  foreach(n IN LISTS names)
    if(NOT n STREQUAL "_")
      fixed(v "${CMAKE_MATCH_${k}}" 3)
      set(a_${n} ${v} PARENT_SCOPE)
    endif()
    math(EXPR k "${k} + 1")
  endforeach()
endfunction()
function(aedrag tag x0 y0 dx)
  set(sc "20 move ${x0} ${y0}\n30 autoedit\n32 down 0\n")
  foreach(s 1 2 3 4)
    math(EXPR x "${x0} + ${dx} * ${s} / 4")
    math(EXPR f "32 + ${s} * 3")
    string(APPEND sc "${f} move ${x} ${y0}\n")
  endforeach()
  string(APPEND sc "48 up 0\n50 autoedit\n")
  run(${tag} 52 "${sc}" --show autoedit)
  set(out "${out}" PARENT_SCOPE)
endfunction()
run(aegeo 32 "28 autoedit\n" --show autoedit)
ae(28)
check("the automation editor has a time scroller with a thumb shorter than its rail (${a_ht0} .. ${a_ht1}, grid ${a_gx0} .. ${a_gx1})" a_ht1 LESS a_gx1)
math(EXPR ay "${a_hy} / 1000")
math(EXPR amid "(${a_ht0} + ${a_ht1}) / 2000")
math(EXPR ar "${a_ht1} / 1000 - 2")
aedrag(aethumb ${amid} ${ay} 100)
ae(30)
set(a ${a_sx})
ae(50)
check("automation editor, thumb dragged right: the time scrolls on (${a} -> ${a_sx})" a_sx GREATER a)
aedrag(aeright ${ar} ${ay} -50)
ae(30)
set(a ${a_ht0})
set(p ${a_ppt})
ae(50)
absdiff(d ${a_ht0} ${a})
check("automation editor, right end dragged left: zoomed in (${p} -> ${a_ppt})" a_ppt GREATER p)
check("automation editor, right end dragged left: the left end stays put (${a} -> ${a_ht0})" d LESS_EQUAL 1000)
run(aefit 60 "10 move ${amid} ${ay}\n12 mod ${ctrl} 1\n14 wheel 2\n16 mod ${ctrl} 0\n30 autoedit\n32 down 0\n33 up 0\n35 down 0\n36 up 0\n50 autoedit\n" --show autoedit)
ae(30)
set(p ${a_ppt})
ae(50)
check("automation editor, a double-click on the scroller fits the clip again (${p} -> ${a_ppt})" a_ppt LESS p)
