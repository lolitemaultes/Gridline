# Gridline — J-218: Seltmann records from an audio input on its start screen. Driven like a user
# (hidden window, isolated config and HOME, fixed frame time, SDL's dummy audio). The input is a
# synthetic signal, never a microphone: GRIDLINE_TEST_INPUT loops a generated break at 96 BPM into
# the engine's device input (In 1 - In 2).
#   1. the start screen has Record next to Load; Record opens the recorder (idle: Record, Back);
#   2. Record ~4 s, Pause, Resume, Finish, Load recording: Seltmann analyses it and is ready, the
#      file is in the Recorded folder of the unsaved project (the config's), its length is the take's;
#   3. a take recorded straight through: the detected tempo is near the loop's 96 BPM;
#   4. Clear and record again; 5. Back with a finished take asks first, Discard returns to the
#      start screen with nothing loaded.
# Screenshots of each recorder state (idle, recording, paused, finished) at 100 % and 200 % in <OUT>.
#   cmake -DAPP=<gridline-app> -DTESTBIN=<gridline_test_seltmann> -DRECBIN=<gridline_test_seltmann_rec> -DOUT=<dir> -P j218_seltmann_record.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg" "${OUT}/home")
execute_process(COMMAND "${TESTBIN}" writeloop "${OUT}/input.wav" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT EXISTS "${OUT}/input.wav")
  message(FATAL_ERROR "FAIL: could not write the synthetic input (${rc})")
endif()
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/home")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_SELTMANN_TRACE} "1")
set(ENV{GRIDLINE_TEST_INPUT} "${OUT}/input.wav")
set(ENV{SDL_AUDIODRIVER} "dummy")

function(run tag frames script scale)
  if(scale STREQUAL "2")
    set(size 2880x1920)
  else()
    set(size 1440x960)
  endif()
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --plugin gl.seltmann --size ${size} --ui-scale ${scale}
                          --frames ${frames} --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(last_out "${out}" PARENT_SCOPE)
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# the position of a traced point ("seltmann: <key> X Y", the last one) -> <var>_x, <var>_y
function(pos var key text)
  string(REGEX MATCHALL "seltmann: ${key} [0-9]+ [0-9]+" ms "${text}")
  list(LENGTH ms n)
  if(n EQUAL 0)
    message(FATAL_ERROR "FAIL: no \"${key}\" traced\nOutput:\n${text}")
  endif()
  list(GET ms -1 m)
  string(REGEX MATCH "([0-9]+) ([0-9]+)$" _ "${m}")
  set(${var}_x "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${var}_y "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

function(last_rec var text)
  string(REGEX MATCHALL "seltmann: rec open state [a-z]+[^\n]*" ls "${text}")
  list(LENGTH ls n)
  if(n EQUAL 0)
    set(${var} "" PARENT_SCOPE)
  else()
    list(GET ls -1 l)
    set(${var} "${l}" PARENT_SCOPE)
  endif()
endfunction()

foreach(scale 2 1)  # 100 % last: the later steps use its positions
  set(sx "")
  if(scale STREQUAL "2")
    set(sx "_200")
  endif()
  # ---- the start screen: Record next to Load
  run(start${sx} 20 "" ${scale})
  check("x${scale}: the start screen is empty" last_out MATCHES "seltmann: state empty")
  pos(entry recentry "${last_out}")
  # a click, frame by frame (move, down, up)
  set(clickEntry "10 move ${entry_x} ${entry_y}\n12 down 0\n13 up 0\n14 waitfor seltmann-rec-open 10\n")
  run(idle${sx} 30 "${clickEntry}" ${scale})
  last_rec(st "${last_out}")
  check("x${scale}: Record opens the recorder, ready to record" st MATCHES "state idle input 1 stereo")
  pos(rec "recbtn record" "${last_out}")
  pos(fin "recbtn finish" "${last_out}")
  pos(clr "recbtn clear" "${last_out}")
  pos(back "recbtn back" "${last_out}")
  pos(load "recbtn load" "${last_out}")
  check("x${scale}: no input warning with the test input" NOT last_out MATCHES "recbtn settings")
  macro(click var frame)
    math(EXPR _f1 "${frame} + 2")
    math(EXPR _f2 "${frame} + 3")
    set(_click "${frame} move ${${var}_x} ${${var}_y}\n${_f1} down 0\n${_f2} up 0\n")
  endmacro()
  click(rec 20)
  set(startRec "${clickEntry}${_click}")
  run(recording${sx} 40 "${startRec}26 waitfor seltmann-take-2 20\n" ${scale})
  last_rec(st "${last_out}")
  check("x${scale}: recording" st MATCHES "state recording")
  click(rec 30)
  run(paused${sx} 44 "${startRec}26 waitfor seltmann-take-2 20\n${_click}" ${scale})
  last_rec(st "${last_out}")
  check("x${scale}: paused" st MATCHES "state paused")
  click(rec 30)
  set(pause "${_click}")
  click(rec 40)
  set(resume "${_click}")
  click(fin 50)
  set(finish "${_click}")
  set(finished "${startRec}26 waitfor seltmann-take-4 20\n${pause}${resume}46 waitfor seltmann-take-5 20\n${finish}")
  run(finished${sx} 60 "${finished}" ${scale})
  last_rec(st "${last_out}")
  check("x${scale}: finished after pause and resume" st MATCHES "state finished")
  string(REGEX MATCHALL "seltmann: rec open state [a-z]+" seq "${last_out}")
  string(REPLACE "seltmann: rec open state " "" seq "${seq}")
  string(REPLACE ";" " " seq "${seq}")
  check("x${scale}: idle, recording, paused, recording, finished (${seq})" seq MATCHES "idle recording paused recording finished")
endforeach()

# ---- 2. load the paused and resumed take
click(load 60)
run(load 160 "${finished}${_click}64 waitfor seltmann-ready 120\n" 1)
check("Load recording: Seltmann analyses it and is ready" last_out MATCHES "seltmann: state ready")
string(REGEX MATCH "seltmann: rec loaded \"([^\"]+)\" frames ([0-9]+) rate ([0-9]+) channels ([0-9]+)" _ "${last_out}")
set(file "${CMAKE_MATCH_1}")
set(frames "${CMAKE_MATCH_2}")
set(rate "${CMAKE_MATCH_3}")
check("... the recording was written (${file})" EXISTS "${file}")
check("... into the Recorded folder of the unsaved project (the config's)" file MATCHES "^${OUT}/cfg/.*Recorded/Seltmann_rec-[0-9a-f]+\\.wav$")
execute_process(COMMAND "${RECBIN}" wavinfo "${file}" OUTPUT_VARIABLE info RESULT_VARIABLE rc)
check("... its length is the take's (${frames} frames, ${info})" rc EQUAL 0 AND info MATCHES "^frames ${frames} rate ${rate} channels 2")
math(EXPR minFrames "${rate} * 5")
check("... about five seconds or more were kept (${frames} frames)" frames GREATER_EQUAL minFrames)

# ---- 3. a take straight through: the tempo of the loop
click(fin 40)
set(fin2 "${_click}")
click(load 50)
run(tempo 160 "${startRec}26 waitfor seltmann-take-10 30\n${fin2}${_click}54 waitfor seltmann-ready 120\n" 1)
check("a straight take loads and is ready" last_out MATCHES "seltmann: state ready")
string(REGEX MATCH "seltmann: state ready kind [a-z]+ bpm ([0-9.]+)" _ "${last_out}")
set(bpm "${CMAKE_MATCH_1}")
check("... the detected tempo is near the loop's 96 BPM (${bpm})" bpm GREATER 93 AND bpm LESS 99)

# ---- 4. Clear, record again
click(clr 30)
set(clear "${_click}")
click(rec 40)
set(again "${_click}")
click(fin 50)
run(clear 70 "${startRec}26 waitfor seltmann-take-1 20\n${clear}${again}46 waitfor seltmann-take-1 20\n${_click}" 1)
string(REGEX MATCHALL "seltmann: rec open state [a-z]+" seq "${last_out}")
string(REPLACE "seltmann: rec open state " "" seq "${seq}")
string(REPLACE ";" " " seq "${seq}")
check("Clear discards the take and returns to ready; recording again finishes (${seq})" seq MATCHES "recording idle recording finished$")

# ---- 5. Back: asks before discarding a finished take; Discard: the start screen, nothing loaded
click(fin 30)
set(f3 "${_click}")
click(back 40)
set(b3 "${_click}")
run(ask 50 "${startRec}26 waitfor seltmann-take-1 20\n${f3}${b3}" 1)
last_rec(st "${last_out}")
check("Back with a finished take asks first" st MATCHES "state finished input 1 stereo ask 1")
pos(discard "recbtn discard" "${last_out}")
click(discard 50)
run(discard 64 "${startRec}26 waitfor seltmann-take-1 20\n${f3}${b3}${_click}" 1)
string(REGEX MATCH "seltmann: rec open[^\n]*\n(.*)$" _ "${last_out}")
check("Discard returns to the start screen" CMAKE_MATCH_1 MATCHES "seltmann: state empty")
check("... nothing was loaded" NOT last_out MATCHES "rec loaded" AND NOT last_out MATCHES "state analysing")
click(back 30)
run(backidle 40 "${clickEntry}${_click}" 1)
string(REGEX MATCH "seltmann: rec open[^\n]*\n(.*)$" _ "${last_out}")
check("Back without a take returns straight away" CMAKE_MATCH_1 MATCHES "seltmann: state empty")

foreach(f start idle recording paused finished start_200 idle_200 recording_200 paused_200 finished_200 load)
  check("screenshot ${f}.ppm written" EXISTS "${OUT}/${f}.ppm")
endforeach()
