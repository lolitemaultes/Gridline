# Gridline - hunt-clips-1119: a new Clips set used as a person uses it, in the real app (hidden, isolated config
# and HOME, the layout chosen through the real settings keys, no --layout), by pointer and key input over many
# frames:
#   arr  1. a time selection dragged on track 1, Cmd+Shift+M: a MIDI clip; a sound file dropped on track 3;
#        2. the MIDI clip pressed in its body (not its title bar) and dragged a bar on and a track down: it moves
#           (it drew a time selection); the audio clip the same: it moves and stays selected (the track pressed
#           alone was the selected one, so the clip band dropped a clip moved to another track);
#        3. a click in the body: the clip alone selected, the insert marker there;
#        4. Alt+drag in the body: a time selection inside the clip, on the grid; Cmd+E splits there;
#        5. Cmd+drag of the clip's right edge loops it; the clip band's Loop is lit, a click turns it off (it
#           read as off and a click made a loop as long as the clip);
#   grid 6. a MIDI clip copied and pasted into an audio track's slot: refused (it was pasted there);
#        7. a MIDI slot dragged up out of the grid onto an audio track of the Arrangement: refused (it landed on it);
#        8. a slot dragged, Tab during the drag: its clip lands on the Arrangement (Tab swapped the view back);
#   dev  9. an effect dragged from the browser onto the device band's "Drop effects here": it is added;
#       10. a click on the Arrangement's Main row selects Main (the row took no click).
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -DSRC=<source dir> -P hunt1119_clips_app.cmake
cmake_minimum_required(VERSION 3.16)
# The Cmd key: "super" on macOS (the dev input's "ctrl" is the physical Ctrl key there, a right-click),
# Ctrl elsewhere (Super is the system's key on Linux and Windows).
if(CMAKE_HOST_APPLE)
  set(cmd super)
else()
  set(cmd ctrl)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
configure_file("${SRC}/assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
set(WAV "${OUT}/Take.wav")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(ok what)
  message(STATUS "ok - ${what}")
endfunction()

# The dump printed at a frame (up to the next dump).
function(dumpAt frame)
  string(FIND "${out}" "dump frame ${frame}:" at)
  if(at LESS 0)
    fail("no dump at frame ${frame}")
  endif()
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(FIND "${rest}" "\ndump frame" next)
  if(next GREATER 0)
    string(SUBSTRING "${rest}" 0 ${next} rest)
  endif()
  set(d "${rest}" PARENT_SCOPE)
endfunction()

# ---- the script builder: S (the script), F (the next frame) ----
set(S "4 typing off\n")
set(F 8)
macro(at line)
  string(APPEND S "${F} ${line}\n")
  math(EXPR F "${F} + 1")
endmacro()
macro(wait n)
  math(EXPR F "${F} + ${n}")
endmacro()
macro(mods state)
  foreach(md ${ARGN})
    string(APPEND S "${F} mod ${md} ${state}\n")
  endforeach()
endmacro()
# A press at (x0, y0), 30 frames of moves to (x1, y1), a release; ARGN: the modifiers held.
macro(drag x0 y0 x1 y1)
  mods(1 ${ARGN})
  at("move ${x0} ${y0}")
  wait(1)  # (a hand rests on the spot a moment before it presses)
  at("down 0")
  foreach(i RANGE 1 30)
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 30")
    math(EXPR yi "${y0} + (${y1} - ${y0}) * ${i} / 30")
    at("move ${xi} ${yi}")
  endforeach()
  wait(2)
  at("up 0")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(click x y)
  mods(1 ${ARGN})
  at("move ${x} ${y}")
  wait(1)
  at("down 0")
  at("up 0")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(key k)
  mods(1 ${ARGN})
  wait(1)
  at("key ${k}")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(check name)
  wait(4)
  set(at_${name} ${F})
  at("dump")
  at("shot ${OUT}/${name}.ppm")
  wait(3)
endmacro()
macro(finish tag)
  wait(6)
  at("quit discard")
  run(${tag} "${S}")
  set(S "4 typing off\n")
  set(F 8)
endmacro()

# ---- the Arrangement's geometry (a new set opens on the clip grid; Tab shows the Arrangement) ----
run(geo "4 typing off\n8 key tab\n20 plgeom\n24 livegrid\n26 key tab\n36 livegrid\n40 quit discard\n")
if(NOT out MATCHES "plgeom frame [0-9]+: valid 1 x0 ([0-9]+)[.0-9]* pxPerTick ([0-9]+)\\.([0-9][0-9][0-9])")
  fail("no playlist geometry")
endif()
set(x0 ${CMAKE_MATCH_1})
set(whole ${CMAKE_MATCH_2})
string(REGEX REPLACE "^0+(.)" "\\1" fr "${CMAKE_MATCH_3}")
math(EXPR ppt "${whole} * 1000 + ${fr}")  # pixels per 1000 ticks
foreach(t 0 1 2 3)
  if(NOT out MATCHES "\n  track ${t} top ([0-9]+)[.0-9]* h ([0-9]+)[.0-9]* mode ([0-9]+)")
    fail("no geometry for track ${t}")
  endif()
  set(top${t} ${CMAKE_MATCH_1})
  set(mode${t} ${CMAKE_MATCH_3})
endforeach()
if(NOT mode0 EQUAL 0 OR NOT mode1 EQUAL 0 OR NOT mode2 EQUAL 1 OR NOT mode3 EQUAL 1)
  fail("a new Clips set has two MIDI tracks over two audio tracks (${mode0} ${mode1} ${mode2} ${mode3})")
endif()
if(NOT out MATCHES "grid [0-9.]+ [0-9.]+ ([0-9]+)[.0-9]* vthumb")
  fail("no grid bottom")
endif()
set(gridBottom ${CMAKE_MATCH_1})
if(NOT out MATCHES "headcol ([0-9]+)")
  fail("no header column")
endif()
set(headX ${CMAKE_MATCH_1})
foreach(t 0 1 2)
  if(NOT out MATCHES "livegrid title ${t} \"[^\"]*\" ([0-9]+) ([0-9]+)")
    fail("no clip grid column ${t}")
  endif()
  math(EXPR sx${t} "${CMAKE_MATCH_1} + 10")  # a slot's body, right of its launch cell
  set(titleY ${CMAKE_MATCH_2})
endforeach()
foreach(k 0 1)
  if(NOT out MATCHES "livegrid row ${k} y ([0-9]+)")
    fail("no clip grid row ${k}")
  endif()
  set(ry${k} ${CMAKE_MATCH_1})
endforeach()
function(xAt tick var)
  math(EXPR v "${x0} + ${tick} * ${ppt} / 1000")
  set(${var} ${v} PARENT_SCOPE)
endfunction()
math(EXPR body0 "${top0} + 30")  # in a clip's body, under its title bar
math(EXPR body1 "${top1} + 30")
math(EXPR body2 "${top2} + 30")
math(EXPR body3 "${top3} + 30")
math(EXPR mid0 "${top0} + 23")
math(EXPR mid2 "${top2} + 23")

# ================================ arr ================================
xAt(384 bx2)
xAt(1152 bx4)
xAt(1546 dropX)
key(tab)
wait(6)
drag(${bx2} ${mid0} ${bx4} ${mid0})
key(m ${cmd} shift)
wait(4)
at("dragenter ${dropX} ${mid2} ${WAV}")
foreach(i RANGE 1 8)
  at("dragmove ${dropX} ${mid2}")
endforeach()
at("drop ${dropX} ${mid2}")
wait(10)
check(made)
xAt(600 p0)
xAt(984 p1)
drag(${p0} ${body0} ${p1} ${body1})
check(midimoved)
xAt(1700 p0)
xAt(2084 p1)
drag(${p0} ${body2} ${p1} ${body3})
check(audiomoved)
xAt(1056 p0)
click(${p0} ${body1})
check(clicked)
xAt(870 p0)
xAt(1250 p1)
drag(${p0} ${body1} ${p1} ${body1} alt)
key(e ${cmd})
check(split)
finish(arr)

dumpAt(${at_made})
if(NOT d MATCHES "\n  clip ([0-9]+) kind 0 track 0 start 384 len 768 ")
  fail("Cmd+Shift+M over a time selection of bars 2 to 4 makes a MIDI clip there")
endif()
set(midi ${CMAKE_MATCH_1})
if(NOT d MATCHES "\n  clip ([0-9]+) kind 1 track 2 start 1536 ")
  fail("a dropped sound file makes an audio clip on track 3 at bar 5")
endif()
set(aud ${CMAKE_MATCH_1})
dumpAt(${at_midimoved})
if(NOT d MATCHES "\n  clip ${midi} kind 0 track 1 start 768 len 768 [^\n]* sel 1 ")
  fail("a MIDI clip pressed in its body and dragged a bar on and a track down moves there (selected)")
endif()
ok("a MIDI clip dragged by its body moves (a track down, a bar on)")
dumpAt(${at_audiomoved})
if(NOT d MATCHES "\n  clip ${aud} kind 1 track 3 start 1920 [^\n]* sel 1 ")
  fail("an audio clip dragged by its body moves a track down and a bar on, and stays selected")
endif()
ok("an audio clip dragged by its body moves and stays selected")
dumpAt(${at_clicked})
if(NOT d MATCHES "\n  clip ${midi} kind 0 track 1 start 768 [^\n]* sel 1 " OR NOT d MATCHES "\n  clip ${aud} [^\n]* sel 0 " OR NOT d MATCHES "position 1056\n")
  fail("a click in a clip's body selects it alone and puts the insert marker there")
endif()
ok("a click in the body selects the clip and puts the insert marker there")
dumpAt(${at_split})
if(NOT d MATCHES "\n  clip [0-9]+ kind 0 track 1 start 864 len 384 " OR NOT d MATCHES "\n  clip [0-9]+ kind 0 track 1 start 1248 len 288 "
   OR NOT d MATCHES "\n  clip ${midi} kind 0 track 1 start 768 len 96 ")
  fail("Alt+drag in the body selects time inside the clip, on the grid; Cmd+E splits it at both ends")
endif()
ok("Alt+drag in the body selects time on the grid, Cmd+E splits there")

# ---- 5. Cmd+edge loop, the clip band's Loop ----
xAt(384 bx2)
xAt(1152 bx4)
xAt(1135 e0)  # 3 px inside the right edge
xAt(1519 e1)
key(tab)
wait(6)
drag(${bx2} ${mid0} ${bx4} ${mid0})
key(m ${cmd} shift)
wait(10)
drag(${e0} ${body0} ${e1} ${body0} ${cmd})
check(looped)
click(443 775)  # the clip band's Loop (a new set's layout at 1440 x 900)
check(loopclick)
finish(loop)
dumpAt(${at_looped})
if(NOT d MATCHES "\n  clip ([0-9]+) kind 0 track 0 start 384 len 1152 [^\n]* loop 1 loopStart 0 loopLength 0 ")
  fail("Cmd+drag of the clip's right edge loops it on")
endif()
set(lc ${CMAKE_MATCH_1})
dumpAt(${at_loopclick})
if(NOT d MATCHES "\n  clip ${lc} kind 0 track 0 start 384 len 1152 [^\n]* loop 0 ")
  fail("the clip band's Loop shows the edge loop as on: a click turns it off")
endif()
ok("a clip looped by its edge shows Loop lit in the clip band (a click turns it off)")

# ================================ grid ================================
click(${sx0} ${ry0})
key(m ${cmd} shift)
wait(4)
click(${sx0} ${ry1})
key(m ${cmd} shift)
wait(4)
check(gridmade)
click(${sx0} ${ry0})
key(c ${cmd})
click(${sx2} ${ry1})
key(v ${cmd})
check(pasted)
# (0,0) dragged up out of the grid onto the audio track 3 of the Arrangement
math(EXPR upY "${titleY} - 20")
xAt(2000 ax)
at("move ${sx0} ${ry0}")
at("down 0")
foreach(i RANGE 1 15)
  math(EXPR yi "${ry0} - (${ry0} - ${upY}) * ${i} / 15")
  at("move ${sx0} ${yi}")
endforeach()
wait(4)
foreach(i RANGE 1 20)
  math(EXPR xi "${sx0} + (${ax} - ${sx0}) * ${i} / 20")
  math(EXPR yi "${upY} + (${mid2} - ${upY}) * ${i} / 20")
  at("move ${xi} ${yi}")
endforeach()
wait(3)
at("up 0")
wait(6)
check(upaudio)
# back to the grid: (0,1) pressed, Tab while it is dragged, dropped on track 1 of the Arrangement
key(tab)
wait(6)
click(${sx0} ${ry1})
wait(20)
at("move ${sx0} ${ry1}")
at("down 0")
foreach(i RANGE 1 7)
  math(EXPR yi "${ry1} + 2 * ${i}")
  at("move ${sx0} ${yi}")
endforeach()
key(tab)
math(EXPR y1s "${ry1} + 14")
foreach(i RANGE 1 20)
  math(EXPR xi "${sx0} + (${ax} - ${sx0}) * ${i} / 20")
  math(EXPR yi "${y1s} + (${mid0} - ${y1s}) * ${i} / 20")
  at("move ${xi} ${yi}")
endforeach()
wait(3)
at("up 0")
wait(6)
check(tabdrop)
finish(grid)
dumpAt(${at_gridmade})
string(REGEX MATCHALL "\n  clip [0-9]+ " c0 "${d}")
list(LENGTH c0 n0)
if(NOT n0 EQUAL 2)
  fail("two MIDI clips inserted in the grid (${n0})")
endif()
dumpAt(${at_pasted})
string(REGEX MATCHALL "\n  clip [0-9]+ " c1 "${d}")
list(LENGTH c1 n1)
if(NOT n1 EQUAL 2 OR d MATCHES "\n  clip [0-9]+ kind 0 track 2 ")
  fail("a MIDI clip pasted into an audio track's slot is refused (${n1} clips)")
endif()
ok("a MIDI clip is not pasted into an audio track's slot")
dumpAt(${at_upaudio})
if(d MATCHES "\n  clip [0-9]+ kind 0 track 2 ")
  fail("a MIDI slot dropped on an audio track of the Arrangement is refused")
endif()
ok("a MIDI slot dragged out of the grid does not land on an audio track")
dumpAt(${at_tabdrop})
string(REGEX MATCHALL "\n  clip [0-9]+ kind 0 track 0 " c2 "${d}")
list(LENGTH c2 n2)
if(NOT n2 EQUAL 3)
  fail("a slot dragged with Tab pressed during the drag lands on the Arrangement (${n2} MIDI clips on track 1)")
endif()
ok("Tab during a slot drag carries its clip to the Arrangement")

# ================================ dev ================================
key(tab)
wait(6)
xAt(800 ix)
drag(199 278 ${ix} ${mid0})  # Instruments > Analog Synth onto track 1
wait(8)
click(73 259)                # Audio effects
wait(8)
drag(191 598 960 750)       # Chime onto the device band's "Drop effects here"
wait(8)
math(EXPR mainY "${gridBottom} - 10")
math(EXPR mainX "${headX} + 30")
click(${mainX} ${mainY})     # the Main row
wait(8)
at("mixer")
at("save ${OUT}/dev.gridline.json")
at("shot ${OUT}/dev.ppm")
finish(dev)
file(READ "${OUT}/dev.gridline.json" song)
if(NOT song MATCHES "gl\\.analog")
  fail("the instrument dragged onto track 1")
endif()
if(NOT song MATCHES "gl\\.minichime")
  fail("an effect dragged from the browser onto \"Drop effects here\" is added to the track's chain")
endif()
ok("an effect dragged from the browser onto the device band is added")
if(NOT out MATCHES "mixer frame [0-9]+: [^\n]* focus 0\n")
  fail("a click on the Arrangement's Main row selects Main")
endif()
ok("a click on the Main row selects Main")
