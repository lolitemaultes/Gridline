@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix work:   <http://lv2plug.in/ns/ext/worker#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix opts:   <http://lv2plug.in/ns/ext/options#> .
@prefix bufsz:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix ui:     <http://lv2plug.in/ns/extensions/ui#> .
@prefix kx:     <http://kxstudio.sf.net/ns/lv2ext/external-ui#> .

<urn:gridline:lv2test:state>
    a lv2:DelayPlugin , lv2:Plugin ;
    doap:name "Gridline Test State (LV2)" ;
    lv2:requiredFeature urid:map , work:schedule , opts:options , bufsz:boundedBlockLength ;
    lv2:extensionData state:interface , work:interface ;
    ui:ui <urn:gridline:lv2test:state#extui> ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "trigger" ; lv2:name "Load" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "freewheel" ; lv2:name "Freewheel" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:designation lv2:freeWheeling ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 5 ; lv2:symbol "control" ; lv2:name "Control"
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 6 ; lv2:symbol "notify" ; lv2:name "Notify"
    ] .
