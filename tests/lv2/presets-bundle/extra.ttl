@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:gridline:lv2test:gain#extra>
    a pset:Preset ;
    rdfs:label "Extra" ;
    lv2:port [ lv2:symbol "gain" ; pset:value 0.5 ] , [ lv2:symbol "invert" ; pset:value 1.0 ] .
