# A presets-only bundle adding to a plugin of another bundle.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:gridline:lv2test:gain#extra>
    a pset:Preset ;
    lv2:appliesTo <urn:gridline:lv2test:gain> ;
    rdfs:seeAlso <extra.ttl> .
