# Gridline: GitHub #58 and #74, the channel menu's new rows (hidden app runs, isolated config and home):
#   * Clone without notes: one more channel, no lit steps, one undo step;
#   * Copy to a new pattern: one more pattern holding just that channel's steps, one undo step;
#     Move to a new pattern: the steps leave the source pattern;
#   * Hide from the rack: the channel is hidden (saved in the song), one undo step; the rack's
#     toolbar shows "1 hidden", and its list's Show all shows it again;
#   * in every layout that shows the rack.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P rack_hide_clone_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag layout script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --layout ${layout} --show rack --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
# rackAt(<frame>): k_undo, k_chans, k_hidden ("01000000": one digit per channel), k_velsum_<i>, and
# rk_<rect>_x / _y for every menu or button rectangle drawn.
function(rackAt frame)
  string(FIND "${out}" "rack frame ${frame}:" pos)
  if(pos LESS 0)
    message(FATAL_ERROR "FAIL: no rack dump at frame ${frame}\n${out}")
  endif()
  string(SUBSTRING "${out}" ${pos} -1 rest)
  string(REGEX MATCH "^rack frame [0-9]+:[^\n]*\n(  [^\n]*\n)*" d "${rest}")
  if(NOT d MATCHES "^rack frame [0-9]+:[^\n]* undo ([0-9]+)")
    message(FATAL_ERROR "FAIL: no undo in rack dump ${frame}")
  endif()
  set(k_undo ${CMAKE_MATCH_1} PARENT_SCOPE)
  string(REGEX MATCHALL "\n  channel [0-9]+ [^\n]*" cs "${d}")
  list(LENGTH cs n)
  set(k_chans ${n} PARENT_SCOPE)
  set(h "")
  foreach(c IN LISTS cs)
    if(c MATCHES "channel ([0-9]+) [^\n]* velsum ([0-9]+) [^\n]* hidden ([01])")
      string(APPEND h "${CMAKE_MATCH_3}")
      set(k_velsum_${CMAKE_MATCH_1} ${CMAKE_MATCH_2} PARENT_SCOPE)
    endif()
  endforeach()
  set(k_hidden "${h}" PARENT_SCOPE)
  string(REGEX MATCHALL "  rect [^\n]*" rects "${d}")
  foreach(r IN LISTS rects)
    if(r MATCHES "  rect (.+) ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*$")
      set(m1 "${CMAKE_MATCH_1}")
      math(EXPR cx "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
      math(EXPR cy "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_5}) / 2")
      string(REGEX REPLACE "[^A-Za-z0-9]" "_" nm "${m1}")
      set(rk_${nm}_x ${cx} PARENT_SCOPE)
      set(rk_${nm}_y ${cy} PARENT_SCOPE)
    endif()
  endforeach()
  set(row_x "" PARENT_SCOPE)
  if(d MATCHES "\n  rowgeom 0 [^\n]* name ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*")
    math(EXPR x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
    math(EXPR y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
    set(row_x ${x} PARENT_SCOPE)
    set(row_y ${y} PARENT_SCOPE)
  endif()
endfunction()
# Patterns of a saved song: n_pats, and the channel ids with steps lit in pattern <idx> -> lit_<idx>.
function(saved file)
  file(READ "${file}" j)
  string(JSON n LENGTH "${j}" patterns)
  set(n_pats ${n} PARENT_SCOPE)
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(ids "")
    string(JSON has ERROR_VARIABLE e GET "${j}" patterns ${i} steps)
    if(NOT e)
      string(JSON m LENGTH "${j}" patterns ${i} steps)
      if(m GREATER 0)
        math(EXPR ml "${m} - 1")
        foreach(k RANGE ${ml})
          string(JSON key MEMBER "${j}" patterns ${i} steps ${k})
          string(JSON row GET "${j}" patterns ${i} steps ${key})
          if(row MATCHES "[1-9]")
            list(APPEND ids ${key})
          endif()
        endforeach()
      endif()
    endif()
    set(lit_${i} "${ids}" PARENT_SCOPE)
  endforeach()
  string(JSON c0 GET "${j}" channels 0)
  set(hidden0 0)
  if(c0 MATCHES "\"rackHidden\" *: *true")
    set(hidden0 1)
  endif()
  set(hidden0 ${hidden0} PARENT_SCOPE)
endfunction()

set(tested 0)
foreach(layout studio live logic tracker)
  run(geo_${layout} ${layout} "6 rack\n10 quit discard\n")
  rackAt(6)
  if(row_x STREQUAL "")
    message(STATUS "skip - ${layout}: the rack is not shown")
    continue()
  endif()
  math(EXPR tested "${tested} + 1")
  set(kx ${row_x})
  set(ky ${row_y})
  set(n0 ${k_chans})
  set(rc "4 move ${kx} ${ky}\n6 down 1\n7 up 1\n")
  run(menu_${layout} ${layout} "${rc}12 rack\n16 quit discard\n")
  rackAt(12)
  foreach(item chmenu_cloneempty chmenu_newpattern chmenu_movepattern chmenu_hide)
    if(NOT DEFINED rk_${item}_x)
      message(FATAL_ERROR "FAIL: ${layout}: the channel menu has no ${item}\n${out}")
    endif()
  endforeach()
  set(ce_x ${rk_chmenu_cloneempty_x})
  set(ce_y ${rk_chmenu_cloneempty_y})
  set(np_x ${rk_chmenu_newpattern_x})
  set(np_y ${rk_chmenu_newpattern_y})
  set(mp_x ${rk_chmenu_movepattern_x})
  set(mp_y ${rk_chmenu_movepattern_y})
  set(hd_x ${rk_chmenu_hide_x})
  set(hd_y ${rk_chmenu_hide_y})
  set(click "14 down 0\n15 up 0\n")

  # Clone without notes.
  run(clone_${layout} ${layout} "${rc}10 rack\n12 move ${ce_x} ${ce_y}\n${click}22 rack\n24 undo\n28 rack\n32 quit discard\n")
  rackAt(10)
  set(u0 ${k_undo})
  rackAt(22)
  math(EXPR n1 "${n0} + 1")
  want("${layout}: Clone without notes adds a channel" "${k_chans}" "${n1}")
  want("${layout}: the clone has no lit steps" "${k_velsum_1}" "0")
  math(EXPR u1 "${u0} + 1")
  want("${layout}: Clone without notes is one undo step" "${k_undo}" "${u1}")
  rackAt(28)
  want("${layout}: undo removes the clone" "${k_chans}" "${n0}")

  # Copy (and move) to a new pattern.
  run(newpat_${layout} ${layout}
      "4 save \"${OUT}/np0_${layout}.gridline.json\"\n${rc}10 rack\n12 move ${np_x} ${np_y}\n${click}22 rack\n24 save \"${OUT}/np1_${layout}.gridline.json\"\n26 undo\n30 save \"${OUT}/np2_${layout}.gridline.json\"\n34 quit discard\n")
  saved("${OUT}/np0_${layout}.gridline.json")
  set(p0 ${n_pats})
  set(kick_id "${lit_0}")
  list(GET kick_id 0 kick_id)
  saved("${OUT}/np1_${layout}.gridline.json")
  math(EXPR p1 "${p0} + 1")
  want("${layout}: Copy to a new pattern adds a pattern" "${n_pats}" "${p1}")
  want("${layout}: the new pattern holds just that channel's steps" "${lit_1}" "${kick_id}")
  list(FIND lit_0 ${kick_id} still)
  if(still LESS 0)
    message(FATAL_ERROR "FAIL: ${layout}: copying took the steps out of the source pattern")
  endif()
  saved("${OUT}/np2_${layout}.gridline.json")
  want("${layout}: Copy to a new pattern is one undo step" "${n_pats}" "${p0}")
  run(movepat_${layout} ${layout} "${rc}12 move ${mp_x} ${mp_y}\n${click}22 save \"${OUT}/mp1_${layout}.gridline.json\"\n26 quit discard\n")
  saved("${OUT}/mp1_${layout}.gridline.json")
  want("${layout}: Move to a new pattern adds a pattern" "${n_pats}" "${p1}")
  want("${layout}: the moved steps are in the new pattern" "${lit_1}" "${kick_id}")
  list(FIND lit_0 ${kick_id} still)
  want("${layout}: and no longer in the source" "${still}" "-1")

  # Hide from the rack, the toolbar count, Show all.
  run(hide_${layout} ${layout} "${rc}10 rack\n12 move ${hd_x} ${hd_y}\n${click}22 rack\n24 save \"${OUT}/hd_${layout}.gridline.json\"\n26 undo\n30 rack\n32 quit discard\n")
  rackAt(10)
  set(u0 ${k_undo})
  rackAt(22)
  string(SUBSTRING "${k_hidden}" 0 1 h0)
  want("${layout}: Hide from the rack hides the channel" "${h0}" "1")
  math(EXPR u1 "${u0} + 1")
  want("${layout}: hiding is one undo step" "${k_undo}" "${u1}")
  if(NOT DEFINED rk_hiddenbtn_x)
    message(FATAL_ERROR "FAIL: ${layout}: the rack's toolbar shows no hidden count\n${out}")
  endif()
  set(hb_x ${rk_hiddenbtn_x})
  set(hb_y ${rk_hiddenbtn_y})
  saved("${OUT}/hd_${layout}.gridline.json")
  want("${layout}: the hidden channel is saved with the song" "${hidden0}" "1")
  rackAt(30)
  string(SUBSTRING "${k_hidden}" 0 1 h0)
  want("${layout}: undo shows it again" "${h0}" "0")
  run(show_${layout} ${layout}
      "${rc}12 move ${hd_x} ${hd_y}\n${click}20 move ${hb_x} ${hb_y}\n22 down 0\n23 up 0\n28 rack\n30 quit discard\n")
  rackAt(28)
  if(NOT DEFINED rk_hidden_showall_x)
    message(FATAL_ERROR "FAIL: ${layout}: the hidden count opens no list with Show all\n${out}")
  endif()
  run(showall_${layout} ${layout}
      "${rc}12 move ${hd_x} ${hd_y}\n${click}20 move ${hb_x} ${hb_y}\n22 down 0\n23 up 0\n28 move ${rk_hidden_showall_x} ${rk_hidden_showall_y}\n30 down 0\n31 up 0\n38 rack\n40 quit discard\n")
  rackAt(38)
  string(SUBSTRING "${k_hidden}" 0 1 h0)
  want("${layout}: Show all shows the channel again" "${h0}" "0")
endforeach()
if(tested EQUAL 0)
  message(FATAL_ERROR "FAIL: no layout showed the rack")
endif()
message(STATUS "ok - ${tested} layouts")
