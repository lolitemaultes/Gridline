# Gridline - 0.7.8: an instrument editor narrower than its channel window's rows sits in the middle
# of the window. Its zoomed region was as wide as the rows (600 px at the interface size), and the
# editor sat at the region's left, so all the room was at its right (Finger Bass, Pluck Model, Kick
# Sculpt, Grain Scanner and the Turntable at the default plugin window size). In the real app (hidden, isolated
# config and HOME, SDL's dummy audio driver, the real plugin window size) each editor's region is
# its own width and the room left and right of it is the same.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k078_plugin_centre_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/home")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}")
set(ENV{HOME} "${OUT}/home")
unset(ENV{GRIDLINE_PLUGIN_WINDOW_SIZE})
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
file(WRITE "${OUT}/script.txt" "32 edzoom channelsettings\n34 quit discard\n")
set(failures "")
# (0.7.8: no Sampler here: its settings are the Audio clip window's.)
foreach(type gl.fingerbass gl.plucker gl.kicksculpt gl.grainscan gl.turntable)
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --layout studio --size 1440x900 --ui-scale 1 --frames 40
                          --dev-input "${OUT}/script.txt" --plugin ${type}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${OUT}/${type}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    string(APPEND failures "${type}: the app ended with ${rc}\n")
    continue()
  endif()
  if(NOT out MATCHES "edfit channelsettings: type ${type} [^\n]* of ([0-9]+) region ([0-9]+)")
    string(APPEND failures "${type}: no edfit line\n")
    continue()
  endif()
  set(given ${CMAKE_MATCH_1})
  set(region ${CMAKE_MATCH_2})
  math(EXPR d "${region} - ${given}")
  if(d GREATER 1 OR d LESS -1)
    string(APPEND failures "${type}: the region is ${region} px for an editor of ${given} px\n")
  endif()
  if(NOT out MATCHES "edregion channelsettings: type ${type} width [0-9]+ left (-?[0-9]+) right (-?[0-9]+)")
    string(APPEND failures "${type}: no edregion line\n")
    continue()
  endif()
  math(EXPR d "${CMAKE_MATCH_1} - ${CMAKE_MATCH_2}")
  if(d GREATER 1 OR d LESS -1)
    string(APPEND failures "${type}: the room left (${CMAKE_MATCH_1}) and right (${CMAKE_MATCH_2}) of the editor differ\n")
  else()
    message(STATUS "ok - ${type}: editor ${given} px in the middle (${CMAKE_MATCH_1} / ${CMAKE_MATCH_2} px)")
  endif()
endforeach()
if(failures)
  message(FATAL_ERROR "FAIL:\n${failures}")
endif()
