# Plasma's theme button switches Gridline between dark and light live, and the result is the
# same as starting in that mode: the app palette, Plasma's own palette and ImGui's colours
# (dumped by GL_PLASMA_THEME_DUMP at the same editor frame, 150) match a fresh start, both ways and
# after switching there and back, from Plasma's button and from the app's own switch. A switch made inside Plasma's skin scope left the old colours.
cmake_minimum_required(VERSION 3.16)
file(MAKE_DIRECTORY "${OUT}")
set(ENV{GL_PLASMA_THEME_DUMP} "150")
# run(<tag> <start mode> <press frames or ""> <view> [dev-input script]) -> dump_<tag>
# The script's "theme dark|light" switches the way View > Dark theme does, with Plasma open.
function(run tag mode press view)
  file(REMOVE_RECURSE "${OUT}/${tag}")
  file(MAKE_DIRECTORY "${OUT}/${tag}/cfg/gridline")
  if(mode STREQUAL "light")
    file(WRITE "${OUT}/${tag}/cfg/gridline/settings.json" "{\"version\": 1, \"values\": {\"theme.mode\": \"light\", \"ui.darkTheme\": false}}\n")
  else()
    file(WRITE "${OUT}/${tag}/cfg/gridline/settings.json" "{\"version\": 1, \"values\": {\"theme.mode\": \"dark\", \"ui.darkTheme\": true}}\n")
  endif()
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/${tag}/cfg")
  set(ENV{HOME} "${OUT}/${tag}")
  set(ENV{GL_PLASMA_VIEW} "${view}")
  if(press STREQUAL "")
    unset(ENV{GL_PLASMA_THEME_AT})
  else()
    set(ENV{GL_PLASMA_THEME_AT} "${press}")
  endif()
  set(script)
  if(ARGC GREATER 4)
    file(WRITE "${OUT}/${tag}/input.txt" "${ARGV4}")
    set(script --dev-input "${OUT}/${tag}/input.txt")
  endif()
  # (--no-draw: the checks compare the colour dumps, never pixels; on a slow software OpenGL the
  # drawing alone took the sixteen runs past the test's time limit. --screenshot stays: it is what
  # ends the run after --frames; the picture itself is not drawn.)
  execute_process(COMMAND "${APP}" --hidden ${script} --no-ui-sounds --no-draw --fixed-dt 16 --plugin gl.plasma --size 1440x900 --frames 260
                          --screenshot "${OUT}/${tag}.ppm" TIMEOUT 240 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}):\n${out}\n${err}")
  endif()
  if(NOT err MATCHES "PLASMA_THEME_DUMP frame ([0-9]+) ([^\n]*)")
    message(FATAL_ERROR "FAIL: ${tag}: no theme dump (did the editor draw 150 frames?):\n${err}")
  endif()
  set(dumpFrame "${CMAKE_MATCH_1}")
  set(dump_${tag} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  # every app switch in the script ran, before the dump
  if(ARGC GREATER 4)
    string(REGEX MATCHALL "theme (dark|light)" wanted "${ARGV4}")
    string(REGEX MATCHALL "DEV_THEME (dark|light) frame [0-9]+" ran "${err}")
    list(LENGTH wanted nw)
    list(LENGTH ran nr)
    if(NOT nw EQUAL nr)
      message(FATAL_ERROR "FAIL: ${tag}: ${nw} app switches asked, ${nr} ran:\n${err}")
    endif()
    foreach(r ${ran})
      string(REGEX REPLACE ".* frame " "" f "${r}")
      if(NOT f LESS dumpFrame)
        message(FATAL_ERROR "FAIL: ${tag}: the app switch (${r}) came after the dump (frame ${dumpFrame})")
      endif()
    endforeach()
  endif()
  if(NOT press STREQUAL "")
    string(REPLACE "," ";" presses "${press}")
    foreach(p ${presses})
      if(NOT err MATCHES "PLASMA_THEME press ${p}\n")
        message(FATAL_ERROR "FAIL: ${tag}: the theme button was not pressed at editor frame ${p}:\n${err}")
      endif()
    endforeach()
  endif()
endfunction()

foreach(view synth patch)
  run(dark_${view} dark "" ${view})
  run(light_${view} light "" ${view})
  if(dump_dark_${view} STREQUAL dump_light_${view})
    message(FATAL_ERROR "FAIL: ${view}: the dark and light dumps are the same (the dump sees no theme)")
  endif()
  run(to_light_${view} dark "20" ${view})
  run(to_dark_${view} light "20" ${view})
  run(there_back_${view} dark "20,40" ${view})
  # the app's own switch while Plasma is open (before editor frame 150; each run checks it)
  run(menu_light_${view} dark "" ${view} "80 theme light\n")
  run(menu_dark_${view} light "" ${view} "80 theme dark\n")
  run(menu_back_${view} dark "" ${view} "80 theme light\n100 theme dark\n")
  foreach(pair "to_light;light" "to_dark;dark" "there_back;dark" "menu_light;light" "menu_dark;dark" "menu_back;dark")
    list(GET pair 0 a)
    list(GET pair 1 b)
    if(NOT dump_${a}_${view} STREQUAL dump_${b}_${view})
      message(FATAL_ERROR "FAIL: ${view}: switching (${a}) should give the colours of a fresh ${b} start:\n"
                          "switched ${dump_${a}_${view}}\nfresh    ${dump_${b}_${view}}")
    endif()
    message(STATUS "ok - ${view}: switching (${a}) gives the same colours as a fresh ${b} start")
  endforeach()
endforeach()
