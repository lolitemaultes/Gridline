# Gridline: moving mixer strips and playlist tracks by dragging, in the real app (hidden, isolated
# config and HOME, scripted input, 1280x800). Places come from a first run's reports, so the checks
# follow the layout:
#   1. mixer: a strip dragged by its name plate onto the left half of the first insert lands first
#      (an insertion line while dragging), one undo step, undo puts it back;
#   2. two selected strips (click, Ctrl+click) dragged together keep their order;
#   3. Esc during a drag changes nothing;
#   4. playlist: a header dragged below the middle of another lands after it with its clips, one
#      undo step ("move playlist track"); Alt+Down moves the selected track one place.
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> -P k197_reorder_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

if(CMAKE_HOST_APPLE)
  set(P super)
else()
  set(P ctrl)
endif()

function(run tag frames script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1280x800 --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${o}")
  endif()
  set(${tag}_out "${o}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# mdump(<tag> <n>): the n-th "mixer" report: m_undo, m_ids (mixer ids in order), m_drag (active
# before), and the strip plates m_x0<i> m_x1<i> m_y0<i> m_y1<i> (whole pixels).
function(mdump tag n)
  string(REGEX MATCHALL "mixer frame [0-9]+: [^\n]*\n(  [^\n]*\n)+" all "${${tag}_out}")
  list(LENGTH all count)
  if(count LESS_EQUAL n)
    message(FATAL_ERROR "FAIL (${tag}): no mixer report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${n} d)
  string(REGEX MATCH "undo ([0-9]+)" _ "${d}")
  set(m_undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCHALL "mtrack [0-9]+ id [0-9]+" ms "${d}")
  set(ids "")
  foreach(x IN LISTS ms)
    string(REGEX MATCH "id ([0-9]+)" _ "${x}")
    list(APPEND ids ${CMAKE_MATCH_1})
  endforeach()
  set(m_ids "${ids}" PARENT_SCOPE)
  string(REGEX MATCH "stripdrag active ([01]) cancelled ([01]) before ([-0-9]+)" _ "${d}")
  set(m_drag "${CMAKE_MATCH_1} ${CMAKE_MATCH_3}" PARENT_SCOPE)
  string(REGEX MATCHALL "rect strip [0-9]+ [-0-9.]+ [-0-9.]+ [-0-9.]+ [-0-9.]+" rs "${d}")
  foreach(r IN LISTS rs)
    string(REGEX MATCH "rect strip ([0-9]+) ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)" _ "${r}")
    set(m_x0${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(m_y0${CMAKE_MATCH_1} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(m_x1${CMAKE_MATCH_1} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(m_y1${CMAKE_MATCH_1} "${CMAKE_MATCH_5}" PARENT_SCOPE)
  endforeach()
endfunction()

# ---- the mixer's layout ----
run(mlayout 20 "6 focus Mixer\n12 mixer\n" --show mixer)
mdump(mlayout 0)
set(ids0 "${m_ids}")
foreach(i 1 2 3 4 5 6)
  if(NOT DEFINED m_x0${i})
    message(FATAL_ERROR "FAIL: strip ${i} not drawn\n${mlayout_out}")
  endif()
  math(EXPR cx${i} "(${m_x0${i}} + ${m_x1${i}}) / 2")
  math(EXPR lx${i} "${m_x0${i}} + (${m_x1${i}} - ${m_x0${i}}) / 4")
  math(EXPR rx${i} "${m_x1${i}} - (${m_x1${i}} - ${m_x0${i}}) / 4")
  math(EXPR cy${i} "(${m_y0${i}} + ${m_y1${i}}) / 2")
endforeach()
list(GET ids0 1 id1)
list(GET ids0 2 id2)
list(GET ids0 3 id3)
list(GET ids0 4 id4)
list(GET ids0 5 id5)
list(GET ids0 6 id6)

# ---- 1. one strip to the front, undo ----
math(EXPR mid "(${cx4} + ${lx1}) / 2")
run(mdrag 48 "6 focus Mixer\n8 move ${cx4} ${cy4}\n10 down 0\n12 move ${cx4} ${cy4}\n14 move ${mid} ${cy4}\n16 move ${lx1} ${cy1}\n18 move ${lx1} ${cy1}\n20 mixer\n22 up 0\n28 mixer\n32 undo\n36 mixer\n" --show mixer)
mdump(mdrag 0)
check("while dragging: an insertion point before the first insert (${m_drag})" m_drag STREQUAL "1 1")
mdump(mdrag 1)
list(GET m_ids 1 now1)
list(GET m_ids 2 now2)
check("the strip dropped on the first insert's left half lands first (${now1} ${now2})" now1 EQUAL id4 AND now2 EQUAL id1)
check("... as one undo step (${m_undo})" m_undo EQUAL 1)
mdump(mdrag 2)
check("undo puts it back" m_ids STREQUAL ids0 AND m_undo EQUAL 0)

# ---- 2. two selected strips together ----
run(mmulti 60 "6 focus Mixer\n8 move ${cx2} ${cy2}\n10 down 0\n11 up 0\n14 mod ${P} 1\n15 move ${cx3} ${cy3}\n16 down 0\n17 up 0\n19 mod ${P} 0\n22 move ${cx3} ${cy3}\n24 down 0\n26 move ${cx4} ${cy4}\n28 move ${rx6} ${cy6}\n30 move ${rx6} ${cy6}\n32 up 0\n38 mixer\n" --show mixer)
mdump(mmulti 0)
set(want "")
list(GET ids0 0 m)
list(APPEND want ${m} ${id1} ${id4} ${id5} ${id6} ${id2} ${id3})
list(SUBLIST m_ids 0 7 got)
check("two selected strips dropped after the sixth keep their order (${got})" got STREQUAL want)
check("... one undo step (${m_undo})" m_undo EQUAL 1)

# ---- 3. Esc cancels ----
run(mesc 40 "6 focus Mixer\n8 move ${cx2} ${cy2}\n10 down 0\n12 move ${cx3} ${cy3}\n14 move ${rx5} ${cy5}\n16 key escape\n18 move ${rx5} ${cy5}\n20 up 0\n26 mixer\n" --show mixer)
mdump(mesc 0)
check("Esc during a drag: nothing moves, nothing recorded" m_ids STREQUAL ids0 AND m_undo EQUAL 0)

# ---- 4. playlist ----
# pdump(<tag> <n>): p_undo, p_label, p_head0 p_head1, p_drop, p_sel, p_top<i> p_h<i>, clip y0 of clip c: p_cy<c>
function(pdump tag n)
  string(REGEX MATCHALL "plgeom frame [0-9]+: [^\n]*\n(  [^\n]*\n)+" all "${${tag}_out}")
  list(LENGTH all count)
  if(count LESS_EQUAL n)
    message(FATAL_ERROR "FAIL (${tag}): no plgeom report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${n} d)
  string(REGEX MATCH "undo ([0-9]+) \"([^\"]*)\"" _ "${d}")
  set(p_undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(p_label "${CMAKE_MATCH_2}" PARENT_SCOPE)
  string(REGEX MATCH "headcol ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* dragbefore ([-0-9]+) tracksel ([-0-9,]+)" _ "${d}")
  set(p_head0 "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(p_head1 "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(p_drop "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(p_sel "${CMAKE_MATCH_4}" PARENT_SCOPE)
  foreach(i 0 1 2 3 4 5 6)
    string(REGEX MATCH "  track ${i} top ([-0-9]+)[.0-9]* h ([0-9]+)" _ "${d}")
    set(p_top${i} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(p_h${i} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  endforeach()
  foreach(c 31 47)
    string(REGEX MATCH "  clip ${c} x [-0-9.]+ [-0-9.]+ y ([-0-9]+)" _ "${d}")
    set(p_cy${c} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endforeach()
endfunction()

run(playout 20 "4 typing off\n6 focus Playlist\n12 plgeom\n" --show playlist)
pdump(playout 0)
math(EXPR hx "${p_head0} + 34")
math(EXPR y1 "${p_top1} + 8")
math(EXPR ymid "${p_top3} + 4")
math(EXPR y4 "${p_top4} + ${p_h4} * 3 / 4")
check("the playlist shows its headers (${p_head0} ${p_head1}) and tracks (${p_top1} ${p_top4})" p_head1 GREATER p_head0 AND p_top4 GREATER p_top1)
set(ctop1 ${p_top1})
set(ctop4 ${p_top4})
run(pdrag 56 "4 typing off\n6 focus Playlist\n8 move ${hx} ${y1}\n10 down 0\n12 move ${hx} ${y1}\n14 move ${hx} ${ymid}\n16 move ${hx} ${y4}\n18 move ${hx} ${y4}\n20 plgeom\n22 up 0\n28 plgeom\n32 sdlkey #81 down alt\n33 sdlkey #81 up alt\n38 plgeom\n42 undo\n44 undo\n48 plgeom\n" --show playlist)
pdump(pdrag 0)
check("while dragging: the drop point after the fifth track (${p_drop})" p_drop EQUAL 5)
pdump(pdrag 1)
check("the header dragged below the middle of track 5 lands there (selected ${p_sel})" p_sel STREQUAL "4")
check("... as one undo step \"move playlist track\" (${p_undo} ${p_label})" p_undo EQUAL 1 AND p_label STREQUAL "move playlist track")
math(EXPR lo "${p_top4} - 2")
math(EXPR hi "${p_top4} + ${p_h4}")
check("... with its clips (clip 47 at y ${p_cy47}, track 5 from ${p_top4})" p_cy47 GREATER_EQUAL lo AND p_cy47 LESS hi)
pdump(pdrag 2)
check("Alt+Down moves the selected track one more place (${p_sel}, undo ${p_undo})" p_sel STREQUAL "5" AND p_undo EQUAL 2)
pdump(pdrag 3)
check("two undos: the clip is back on track 2 (${p_cy47} ${ctop1})" p_cy47 GREATER_EQUAL ctop1 AND p_undo EQUAL 0)
