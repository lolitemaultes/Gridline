# Gridline - K-106 cp20 (K-316 plan 7.3): a song written in the Tracker alone is the same song in every layout.
#   1. In the Tracker, from an empty project: six Tracker Sampler tracks, each given an audio file (Load...);
#      the Sample editor's edits (a range normalised, loops forward and back and forth, a loop pin moved, a
#      pencil stroke); the Instrument editor's (an envelope preset, a point added, sustain, fadeout, vibrato,
#      the Extra page's playback values); notes typed into every track; the pattern cloned on the Song page,
#      changed, and arranged 1 2 1 2; saved and rendered.
#   2. That file opened in Studio, Clips and Smooth and saved: byte for byte the Tracker's (Clips adds only
#      its own view key), and each layout's render is the Tracker's, sample for sample.
#   3. Opened in the Tracker again and saved: the same bytes; its Instrument editor reads the same values.
#   cmake -DAPP=<gridline-app> -DWAVS=<dir of .wav files> -DOUT=<dir> -P k316_layout_roundtrip_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/wav")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(failures 0)
macro(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR failures "${failures} + 1")
endmacro()
# Six short audio files (copied: the project refers to them where they are).
set(names kick snare hat bass pad pluck)
set(srcs startup task_done save open import export)
foreach(i RANGE 5)
  list(GET names ${i} n)
  list(GET srcs ${i} s)
  configure_file("${WAVS}/${s}.wav" "${OUT}/wav/${n}.wav" COPYONLY)
endforeach()

# run(<tag> <layout> <project or ""> <frames> <script>): a hidden run in its own config folder.
function(run tag lay project frames script)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${lay}\", \"keys.profile\": \"${lay}\", \"ui.menuStyle\": \"${lay}\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${cfg}/input.txt" "${script}")
  set(p "")
  if(NOT project STREQUAL "")
    set(p "${project}")
  endif()
  execute_process(COMMAND "${APP}" ${p} --hidden --layout-dev --no-ui-sounds --size 1440x900 --layout ${lay} --dev-input "${cfg}/input.txt" --fixed-dt 16
                          --frames ${frames}
                  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${o}\n--- stderr\n${e}")
  if(NOT rc EQUAL 0)
    fail("${tag}: exit ${rc} (${OUT}/${tag}.log)")
  endif()
  set(out "${o}" PARENT_SCOPE)
endfunction()

# ---- 1: the song, in the Tracker ----
set(E "tracker editors")
set(S "")
set(f 10)
macro(at cmd gap)
  string(APPEND S "${f} ${cmd}\n")
  math(EXPR f "${f} + ${gap}")
endmacro()
at("toasts clear" 2)
at("template -" 20)
foreach(i RANGE 5)
  list(GET names ${i} n)
  at("addvia rack gl.tracker" 6)
  at("${E} open sample ${i}" 4)
  at("${E} load \"${OUT}/wav/${n}.wav\"" 6)
endforeach()
# The Sample editor.
at("${E} open sample 0" 6)
at("${E} range 0 2000" 2)
at("${E} op normalise" 6)
at("${E} open sample 3" 6)
at("${E} loop forward" 4)
at("${E} open sample 4" 6)
at("${E} loop pingpong" 4)
at("${E} pin 2 2000" 4)
at("${E} open sample 5" 6)
at("${E} pencil 200 0.0 600 0.9 1000 -0.9 1400 0.0" 6)
at("${E} dump" 2)
# The Instrument editor.
at("${E} open instrument 4" 6)
at("${E} ins env vol preset 1" 4)
at("${E} ins env vol add 40 20" 4)
at("${E} ins env vol flag sustain" 4)
at("${E} ins env vol sustain 1" 4)
at("${E} ins set fadeout 600" 2)
at("${E} ins env vol end" 2)
at("${E} ins set rate 10" 2)
at("${E} ins set depth 4" 2)
at("${E} ins env vol end" 2)
at("${E} open instrument 3" 6)
at("${E} ins extra on" 4)
at("${E} ins dump" 2)
at("${E} close" 6)
# Notes in every track.
at("tracker page Pattern" 4)
at("tracker focus" 4)
at("tracker edit on" 2)
macro(note track row key)
  at("tracker cursor ${track} ${row} 0 0" 1)
  at("sdlkey ${key} down" 1)
  at("sdlkey ${key} up" 2)
endmacro()
foreach(r 0 4 8 12)
  note(0 ${r} z)
endforeach()
note(1 4 z)
note(1 12 z)
foreach(r 0 2 4 6 8 10 12 14)
  note(2 ${r} q)
endforeach()
note(3 0 z)
note(3 3 z)
note(3 6 v)
note(3 8 b)
note(4 0 q)
note(4 8 e)
note(5 0 q)
note(5 2 e)
note(5 4 t)
note(5 8 w)
at("tracker zoom fit" 4)
# The Song page: pattern 1 cloned, the clone changed, arranged 1 2 1 2.
at("tracker page Song" 4)
at("tracker order clone 1" 4)
at("tracker page Pattern" 4)
at("tracker focus" 4)
note(4 4 r)
note(5 1 u)
at("tracker page Song" 4)
foreach(p 1 2 1 2)
  at("tracker order append ${p}" 2)
endforeach()
at("tracker order dump" 2)
at("tracker page Pattern" 4)
at("save \"${OUT}/tracker.gridline.json\"" 6)
at("channels" 2)
string(APPEND S "${f} exportstart 1 \"${OUT}/r_tracker\"\n")
math(EXPR f "${f} + 2")
string(APPEND S "${f} waitfor render-finished 120\n")
math(EXPR f "${f} + 4")
string(APPEND S "${f} quit discard\n")
math(EXPR frames "${f} + 20")
run(tracker tracker "" ${frames} "${S}")
set(tlog "${out}")
string(REGEX MATCH "order frame [0-9]+ \\(dump\\): n ([0-9]+) \\|([^|]*)\\|" ord "${tlog}")
if(NOT CMAKE_MATCH_2 MATCHES "01 02 01 02 *$")
  fail("the Song page did not arrange 1 2 1 2: '${ord}'")
endif()
string(REGEX MATCH "channels frame [0-9]+: ([0-9]+) channels" ch "${tlog}")
if(NOT CMAKE_MATCH_1 STREQUAL "6")
  fail("the song has not six channels: '${ch}'")
endif()
if(NOT EXISTS "${OUT}/tracker.gridline.json")
  message(FATAL_ERROR "FAIL: the Tracker saved nothing (${OUT}/tracker.gridline.json)")
endif()
file(READ "${OUT}/tracker.gridline.json" tText)
string(REGEX MATCHALL "\"gl\\.tracker\"" tr "${tText}")
list(LENGTH tr nTr)
if(nTr LESS 6)
  fail("the song has ${nTr} Tracker Samplers, not 6")
endif()
foreach(w "#gl-tracker" "env v " "ins 600 ")
  string(FIND "${tText}" "${w}" pos)
  if(pos LESS 0)
    fail("the saved song lacks '${w}' (the editors' edits)")
  endif()
endforeach()
file(GLOB rT "${OUT}/r_tracker/*.wav")
list(LENGTH rT nrT)
if(NOT nrT EQUAL 1)
  fail("the Tracker's render wrote ${nrT} files")
endif()

# ---- 2: Studio, Clips and Smooth open it, save it and render it ----
foreach(lay studio live logic)
  run(${lay} ${lay} "${OUT}/tracker.gridline.json" 160
      "40 save \"${OUT}/${lay}.gridline.json\"\n44 exportstart 1 \"${OUT}/r_${lay}\"\n46 waitfor render-finished 120\n50 quit discard\n")
  if(NOT EXISTS "${OUT}/${lay}.gridline.json")
    fail("${lay}: nothing saved")
    continue()
  endif()
  file(READ "${OUT}/${lay}.gridline.json" h)
  if(lay STREQUAL "live")  # (Clips keeps its own view in the song, N48-07: the one key it adds)
    string(REGEX REPLACE "\n  \"live\": {\n    \"view\": \"[a-z]+\"\n  }," "" h "${h}")
  endif()
  if(NOT h STREQUAL tText)
    fail("${lay}: the save differs from the Tracker's (diff ${OUT}/tracker.gridline.json ${OUT}/${lay}.gridline.json)")
  endif()
  file(GLOB r "${OUT}/r_${lay}/*.wav")
  list(LENGTH r nr)
  if(NOT nr EQUAL 1 OR NOT nrT EQUAL 1)
    fail("${lay}: the render wrote ${nr} files")
    continue()
  endif()
  file(SHA256 "${r}" hr)
  file(SHA256 "${rT}" ht)
  file(SIZE "${rT}" szT)
  if(NOT hr STREQUAL ht)
    fail("${lay}: the render differs from the Tracker's (${rT} / ${r})")
  elseif(szT LESS 100000)
    fail("${lay}: the render is too short to tell (${szT} bytes)")
  endif()
endforeach()

# ---- 3: the Tracker again ----
run(back tracker "${OUT}/tracker.gridline.json" 80
    "20 ${E} open instrument 4\n30 ${E} ins dump\n40 save \"${OUT}/back.gridline.json\"\n50 quit discard\n")
file(SHA256 "${OUT}/back.gridline.json" hb)
file(SHA256 "${OUT}/tracker.gridline.json" ht)
if(NOT hb STREQUAL ht)
  fail("reopened in the Tracker, the save differs (diff ${OUT}/tracker.gridline.json ${OUT}/back.gridline.json)")
endif()
string(REGEX MATCH "ins shown 1 [^\n]* fade 600 vib [0-9]+ [0-9]+ 4 10 " ins "${out}")
if(NOT ins)
  fail("reopened, the Instrument editor does not read fadeout 600 and the vibrato 4 / 10: ${out}")
endif()

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} failure(s)")
endif()
message(STATUS "ok - written in the Tracker; Studio, Clips and Smooth save the same bytes and render the same audio; the Tracker reopens it as it was")
