# Gridline K-151: swing presets in the real app (hidden, isolated config and HOME, fixed frame time), scripted input:
#   1. the channel rack's header shows the swing preset chip; with no preset it reads "Step swing";
#   2. clicking it opens the preset menu (factory presets, the Groove editor, the notes switch);
#   3. picking a factory preset sets the Swing amount and the shape in one undo step, the chip shows its name;
#      undo goes back to the song's own swing;
#   4. the Groove editor (--show groove) draws: dragging in its timing lane changes one cell,
#      the chip then reads "Custom groove", the whole drag is one undo step;
#   5. screenshots of each, at 1440x900 and 1920x1080 (SHOTS=1 keeps them in OUT);
#   6. the rack's channel group menu: deleting a group from it (an edit made while the rack draws its rows)
#      is one undo step and does not crash; undo brings the group back;
#   7. a channel's right-click menu: Clone adds the channel (one undo step, undo removes it) and Freeze
#      freezes it, while the rack draws on (the menu's edits run at the start of the next frame).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k151_swing_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
string(REPLACE "\"channels\": [" "\"channelGroups\": [\"Drums\"], \"channels\": [" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag size show script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  set(extra)
  if(show)
    set(extra --show ${show})
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size ${size} ${extra}
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
# The "groove" dump of <frame> -> g_swing g_preset g_label g_cycle g_undo g_timing; and its rects as r_<name>_{x,y} (centre).
function(grooveAt frame)
  string(FIND "${out}" "groove frame ${frame}:" pos)
  if(pos LESS 0)
    message(FATAL_ERROR "FAIL: no groove dump at frame ${frame}\n${out}")
  endif()
  string(SUBSTRING "${out}" ${pos} -1 rest)
  string(REGEX MATCH "^groove frame [0-9]+:[^\n]*\n  timing[^\n]*\n  velocity[^\n]*\n(  rect [^\n]*\n)*" d "${rest}")
  if(NOT d MATCHES "swing ([0-9.]+) preset \"([^\"]*)\" label \"([^\"]*)\" grid ([0-9]+) cycle ([0-9]+) accent [0-9.]+ notes ([01]) undo ([0-9]+)")
    message(FATAL_ERROR "FAIL: bad groove dump at frame ${frame}\n${rest}")
  endif()
  set(g_swing ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(g_preset "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(g_label "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(g_cycle ${CMAKE_MATCH_5} PARENT_SCOPE)
  set(g_undo ${CMAKE_MATCH_7} PARENT_SCOPE)
  string(REGEX MATCH "\n  timing([^\n]*)" t "${d}")
  string(STRIP "${CMAKE_MATCH_1}" t)
  set(g_timing "${t}" PARENT_SCOPE)
  string(REGEX MATCHALL "  rect [^\n]*" rects "${d}")
  foreach(r IN LISTS rects)
    if(r MATCHES "  rect (.+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)$")
      set(m1 "${CMAKE_MATCH_1}")
      set(m2 "${CMAKE_MATCH_2}")
      set(m3 "${CMAKE_MATCH_3}")
      set(m4 "${CMAKE_MATCH_4}")
      set(m5 "${CMAKE_MATCH_5}")
      string(REGEX REPLACE "[^A-Za-z0-9]" "_" n "${m1}")
      string(REGEX REPLACE "\\..*" "" x0 "${m2}")
      string(REGEX REPLACE "\\..*" "" y0 "${m3}")
      string(REGEX REPLACE "\\..*" "" x1 "${m4}")
      string(REGEX REPLACE "\\..*" "" y1 "${m5}")
      math(EXPR cx "(${x0} + ${x1}) / 2")
      math(EXPR cy "(${y0} + ${y1}) / 2")
      set(r_${n}_x ${cx} PARENT_SCOPE)
      set(r_${n}_y ${cy} PARENT_SCOPE)
      set(r_${n}_x0 ${x0} PARENT_SCOPE)
      set(r_${n}_x1 ${x1} PARENT_SCOPE)
      set(r_${n}_y0 ${y0} PARENT_SCOPE)
      set(r_${n}_y1 ${y1} PARENT_SCOPE)
    endif()
  endforeach()
endfunction()

foreach(size 1440x900 1920x1080)
  # 1. the chip in the rack header
  run(geo_${size} ${size} "" "6 groove\n8 shot ${OUT}/rack_${size}.ppm\n12 quit discard\n")
  grooveAt(6)
  if(NOT DEFINED r_chip_x)
    message(FATAL_ERROR "FAIL: ${size}: the swing preset chip is not drawn\n${out}")
  endif()
  want("${size}: no preset, the chip reads Step swing" "${g_label}" "Step swing")
  set(cx ${r_chip_x})
  set(cy ${r_chip_y})
  # 2. the menu opens
  run(menu_${size} ${size} "" "4 move ${cx} ${cy}\n6 down 0\n7 up 0\n12 groove\n14 shot ${OUT}/menu_${size}.ppm\n18 quit discard\n")
  grooveAt(12)
  foreach(n item_Easy_shuffle item_Straight item_Late_hats menu_editor menu_notes)
    if(NOT DEFINED r_${n}_x)
      message(FATAL_ERROR "FAIL: ${size}: the preset menu has no ${n}\n${out}")
    endif()
  endforeach()
  message(STATUS "ok - ${size}: the chip opens the preset menu")
  # 3. pick Easy shuffle, then undo
  run(pick_${size} ${size} ""
      "4 move ${cx} ${cy}\n6 down 0\n7 up 0\n10 groove\n12 move ${r_item_Easy_shuffle_x} ${r_item_Easy_shuffle_y}\n14 down 0\n15 up 0\n20 groove\n22 shot ${OUT}/picked_${size}.ppm\n24 undo\n28 groove\n32 quit discard\n")
  grooveAt(10)
  set(u0 ${g_undo})
  set(s0 ${g_swing})
  grooveAt(20)
  want("${size}: the preset is the song's" "${g_preset}" "Easy shuffle")
  want("${size}: the chip shows its name" "${g_label}" "Easy shuffle")
  want("${size}: its amount" "${g_swing}" "0.3200")
  math(EXPR u1 "${u0} + 1")
  want("${size}: one undo step" "${g_undo}" "${u1}")
  grooveAt(28)
  want("${size}: undo gives the song's swing back" "${g_swing}" "${s0}")
  want("${size}: undo leaves no preset" "${g_preset}" "")
  # 4. the Groove editor: drag the first cell of the timing lane up (late)
  run(edgeo_${size} ${size} groove "6 groove\n8 shot ${OUT}/editor_${size}.ppm\n12 quit discard\n")
  grooveAt(6)
  foreach(n lane_timing lane_velocity button_frompattern button_reset editorchip)
    if(NOT DEFINED r_${n}_x)
      message(FATAL_ERROR "FAIL: ${size}: the Groove editor has no ${n}\n${out}")
    endif()
  endforeach()
  math(EXPR lx "${r_lane_timing_x0} + (${r_lane_timing_x1} - ${r_lane_timing_x0}) / 4")
  math(EXPR ly0 "${r_lane_timing_y}")
  math(EXPR ly1 "${r_lane_timing_y0} + 2")
  math(EXPR lym "(${ly0} + ${ly1}) / 2")
  run(eddrag_${size} ${size} groove
      "6 groove\n8 move ${lx} ${ly0}\n10 down 0\n12 move ${lx} ${lym}\n14 move ${lx} ${ly1}\n16 up 0\n20 groove\n22 shot ${OUT}/edited_${size}.ppm\n24 undo\n28 groove\n32 quit discard\n")
  grooveAt(6)
  set(u0 ${g_undo})
  set(t0 "${g_timing}")
  grooveAt(20)
  string(REPLACE " " ";" tl "${g_timing}")
  list(GET tl 0 off)
  if(NOT off GREATER 0.45)
    message(FATAL_ERROR "FAIL: ${size}: the drag did not move the first cell late (timing ${g_timing})\n${out}")
  endif()
  message(STATUS "ok - ${size}: the timing lane drag sets the cell (${g_timing})")
  want("${size}: the chip says it was edited" "${g_label}" "Custom groove")
  math(EXPR u1 "${u0} + 1")
  want("${size}: the drag is one undo step" "${g_undo}" "${u1}")
  grooveAt(28)
  want("${size}: undo gives the lane back" "${g_timing}" "${t0}")
endforeach()

# 6. channel groups: open the group combo, pick "Drums", open it again and delete the group.
# The "rack" dump -> k_undo, k_groups, k_filter and rects rk_<name>_{x,y}.
function(rackAt frame)
  string(FIND "${out}" "rack frame ${frame}:" pos)
  if(pos LESS 0)
    message(FATAL_ERROR "FAIL: no rack dump at frame ${frame}\n${out}")
  endif()
  string(SUBSTRING "${out}" ${pos} -1 rest)
  if(NOT rest MATCHES "^rack frame [0-9]+:[^\n]* undo ([0-9]+)")
    message(FATAL_ERROR "FAIL: no undo in rack dump ${frame}")
  endif()
  set(k_undo ${CMAKE_MATCH_1} PARENT_SCOPE)
  if(NOT rest MATCHES "\n  groups ([0-9]+) filter (-?[0-9]+)\n((  rect [^\n]*\n)*)")
    message(FATAL_ERROR "FAIL: no groups line in rack dump ${frame}\n${rest}")
  endif()
  set(k_groups ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(k_filter ${CMAKE_MATCH_2} PARENT_SCOPE)
  string(REGEX MATCHALL "  rect [^\n]*" rects "${CMAKE_MATCH_3}")
  foreach(r IN LISTS rects)
    if(r MATCHES "  rect (.+) ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*$")
      set(m1 "${CMAKE_MATCH_1}")
      math(EXPR cx "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
      math(EXPR cy "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_5}) / 2")
      string(REGEX REPLACE "[^A-Za-z0-9]" "_" n "${m1}")
      set(rk_${n}_x ${cx} PARENT_SCOPE)
      set(rk_${n}_y ${cy} PARENT_SCOPE)
    endif()
  endforeach()
endfunction()
run(grpgeo 1440x900 "" "6 rack\n10 quit discard\n")
rackAt(6)
want("groups: the song has one display group" "${k_groups}" "1")
set(gx ${rk_groupcombo_x})
set(gy ${rk_groupcombo_y})
run(grpmenu 1440x900 "" "4 move ${gx} ${gy}\n6 down 0\n7 up 0\n12 rack\n16 quit discard\n")
rackAt(12)
if(NOT DEFINED rk_group_0_x)
  message(FATAL_ERROR "FAIL: the group menu has no Drums row\n${out}")
endif()
set(dx ${rk_group_0_x})
set(dy ${rk_group_0_y})
run(grpdelgeo 1440x900 ""
    "4 move ${gx} ${gy}\n6 down 0\n7 up 0\n10 move ${dx} ${dy}\n12 down 0\n13 up 0\n18 move ${gx} ${gy}\n20 down 0\n21 up 0\n26 rack\n30 quit discard\n")
rackAt(26)
want("groups: picking Drums filters the rack" "${k_filter}" "0")
if(NOT DEFINED rk_menu_deletegroup_x)
  message(FATAL_ERROR "FAIL: the group menu has no Delete this group\n${out}")
endif()
run(grpdel 1440x900 ""
    "4 move ${gx} ${gy}\n6 down 0\n7 up 0\n10 move ${dx} ${dy}\n12 down 0\n13 up 0\n16 rack\n18 move ${gx} ${gy}\n20 down 0\n21 up 0\n24 move ${rk_menu_deletegroup_x} ${rk_menu_deletegroup_y}\n26 down 0\n27 up 0\n32 rack\n34 undo\n38 rack\n42 quit discard\n")
rackAt(16)
set(u0 ${k_undo})
