want("groups: undo brings the group back" "${k_groups}" "1")

# 7. the channel menu. rowAt(<frame> <index>) -> row_x row_y (the centre of the row's name button); chans(<frame>) -> n_chans.
function(rowAt frame idx)
  string(FIND "${out}" "rack frame ${frame}:" pos)
  string(SUBSTRING "${out}" ${pos} -1 rest)
  if(NOT rest MATCHES "\n  rowgeom ${idx} [^\n]* name ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*")
    message(FATAL_ERROR "FAIL: no name button for row ${idx} at frame ${frame}\n${rest}")
  endif()
  math(EXPR x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
  set(row_x ${x} PARENT_SCOPE)
  set(row_y ${y} PARENT_SCOPE)
endfunction()
function(chans frame)
  string(FIND "${out}" "rack frame ${frame}:" pos)
  string(SUBSTRING "${out}" ${pos} -1 rest)
  string(REGEX MATCH "^rack frame [0-9]+:[^\n]*\n(  [^\n]*\n)*" d "${rest}")
  string(REGEX MATCHALL "\n  channel [0-9]+ volume" cs "${d}")
  list(LENGTH cs n)
  set(n_chans ${n} PARENT_SCOPE)
endfunction()
run(chgeo 1440x900 "" "6 rack\n10 quit discard\n")
rowAt(6 0)
set(k_x ${row_x})
set(k_y ${row_y})
rowAt(6 5)
set(b_x ${row_x})
set(b_y ${row_y})
chans(6)
set(n0 ${n_chans})
run(chmenu 1440x900 "" "4 move ${k_x} ${k_y}\n6 down 1\n7 up 1\n12 rack\n16 quit discard\n")
rackAt(12)
if(NOT DEFINED rk_chmenu_clone_x)
  message(FATAL_ERROR "FAIL: the channel menu has no Clone\n${out}")
endif()
run(chclone 1440x900 ""
    "4 move ${k_x} ${k_y}\n6 down 1\n7 up 1\n10 rack\n12 move ${rk_chmenu_clone_x} ${rk_chmenu_clone_y}\n14 down 0\n15 up 0\n22 rack\n24 undo\n28 rack\n32 quit discard\n")
rackAt(10)
set(u0 ${k_undo})
rackAt(22)
chans(22)
math(EXPR n1 "${n0} + 1")
want("channel menu: Clone adds a channel" "${n_chans}" "${n1}")
math(EXPR u1 "${u0} + 1")
want("channel menu: Clone is one undo step" "${k_undo}" "${u1}")
chans(28)
want("channel menu: undo removes the clone" "${n_chans}" "${n0}")
run(chfrzgeo 1440x900 "" "4 move ${b_x} ${b_y}\n6 down 1\n7 up 1\n12 rack\n16 quit discard\n")
rackAt(12)
if(NOT DEFINED rk_menu_freeze_x)
  message(FATAL_ERROR "FAIL: the channel menu has no Freeze\n${out}")
endif()
run(chfreeze 1440x900 ""
    "4 move ${b_x} ${b_y}\n6 down 1\n7 up 1\n12 move ${rk_menu_freeze_x} ${rk_menu_freeze_y}\n14 down 0\n15 up 0\n20 freeze wait\n24 freeze state\n26 rack\n30 quit discard\n")
if(NOT out MATCHES "\n  c Bass frozen 1 ")
  message(FATAL_ERROR "FAIL: Freeze from the channel menu did not freeze Bass\n${out}")
endif()
message(STATUS "ok - channel menu: Freeze freezes the channel")
rackAt(26)
chans(26)
want("channel menu: the rack draws on after the freeze" "${n_chans}" "${n0}")

# A narrow rack: the chip is the first thing to make room, nothing overlaps.
run(narrow 900x700 "" "6 groove\n8 shot ${OUT}/rack_900x700.ppm\n12 quit discard\n")
grooveAt(6)
message(STATUS "ok - a narrow window draws (chip shown: ${r_chip_x})")

