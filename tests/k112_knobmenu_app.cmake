# Gridline - K-112c: the Live knob menu's own rows, through the menu's code (dev "knobmenu", on the
# first channel's volume), in the real app (hidden, isolated config and HOME):
#   1. Show automation in a new lane: an automation clip on a playlist track below every used one,
#      the track named after the control, one undo step;
#   2. a second time: another new track, never beside the first clip;
#   3. Re-enable automation: the control's muted automation clips play again;
#   4. Copy the parameter's name: the name on the clipboard.
#   5. (0.7.8) Modulate: New chaos and New random each make a source moving the knob in one undo step;
#      a click on a linked source unlinks it, undo links it again; Remove all modulation clears every
#      source in one step and undoes. And the menu's structure (Studio and Clips, --menu knob): one
#      Modulate submenu with LFO, Chaos, Random, Macro, Controller plugin in that order, each source
#      submenu with its New row, no old separate rows; a modulated knob adds its sources' settings and
#      Remove all modulation.
# (Which menu shows the rows, Live's alone, is pinned by k112_ctxmenus: ctxmenu_<style>_knob.txt.)
#   cmake -DAPP=<gridline-app> -DDEMO=<song> -DOUT=<dir> -P k112_knobmenu_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg/gridline" "${OUT}/home")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/home")
file(WRITE "${OUT}/cfg/gridline/settings.json"
     "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)
file(WRITE "${OUT}/in.txt" "6 knobmenu state\n8 knobmenu newlane\n10 knobmenu newlane\n12 knobmenu mute\n14 knobmenu reenable\n16 knobmenu copyname\n"
     "18 knobmenu mod new chaos\n20 knobmenu mod new random\n22 knobmenu mod toggle chaos 1\n24 knobmenu mod undo\n"
     "26 knobmenu mod removeall\n28 knobmenu mod undo\n30 knobmenu mod toggle random 1\n")
execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --frames 34 --screenshot "${OUT}/end.ppm"
                        --dev-input "${OUT}/in.txt"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${OUT}/run.out" "${out}\n---- stderr ----\n${err}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "gridline-app failed (${rc}): ${err}\n${out}")
endif()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
# One frame's "knobmenu" line, its fields as <var>_clips, _muted, _track, _used, _name, _clip, _undo.
function(at var frame)
  string(REGEX MATCH "knobmenu frame ${frame}: clips ([0-9]+) muted ([0-9]+) track (-?[0-9]+) used ([0-9]+) name \"([^\"]*)\" clipboard \"([^\"]*)\" undo \"([^\"]*)\"" m "${out}")
  if(m STREQUAL "")
    message(FATAL_ERROR "FAIL: no knobmenu line at frame ${frame}\nOutput:\n${out}")
  endif()
  set(${var}_clips "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${var}_muted "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${var}_track "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${var}_used "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${var}_name "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${var}_clip "${CMAKE_MATCH_6}" PARENT_SCOPE)
  set(${var}_undo "${CMAKE_MATCH_7}" PARENT_SCOPE)
endfunction()

at(s0 6)
at(s1 8)
at(s2 10)
at(s3 12)
at(s4 14)
at(s5 16)
math(EXPR c1 "${s0_clips} + 1")
math(EXPR c2 "${s0_clips} + 2")
check("new lane: one automation clip more (${s0_clips} -> ${s1_clips})" s1_clips EQUAL c1)
check("... on the track below every used one (${s1_track}, ${s0_used} used before)" s1_track EQUAL s0_used)
check("... the track named after the control (${s1_name})" s1_name)
set(want "create automation clip")
check("... one undo step (${s1_undo})" s1_undo STREQUAL want)
check("again: another clip (${s2_clips})" s2_clips EQUAL c2)
math(EXPR t2 "${s1_track} + 1")
check("... on a new track again (${s2_track})" s2_track EQUAL t2)
check("muted: the control's clips are off (${s3_muted})" s3_muted EQUAL s3_clips AND s3_muted GREATER 0)
check("re-enable: none muted (${s4_muted})" s4_muted EQUAL 0)
check("copy name: on the clipboard (${s5_clip})" s5_clip STREQUAL s1_name)

# --- 5. Modulate (0.7.8) ---
function(mod var frame)
  string(REGEX MATCH "knobmod frame ${frame}: sources ([0-9]+) links \"([^\"]*)\" undo \"([^\"]*)\"" m "${out}")
  if(m STREQUAL "")
    message(FATAL_ERROR "FAIL: no knobmod line at frame ${frame}\nOutput:\n${out}")
  endif()
  set(${var}_n "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${var}_links "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${var}_undo "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()
mod(m1 18)
mod(m2 20)
mod(m3 22)
mod(m4 24)
mod(m5 26)
mod(m6 28)
mod(m7 30)
check("New chaos: a source moving the knob (${m1_n}, ${m1_links})" m1_n EQUAL 1 AND m1_links STREQUAL "Chaos 1")
check("... one undo step (${m1_undo})" m1_undo STREQUAL "new chaos for this knob")
check("New random: a second source (${m2_links})" m2_n EQUAL 2 AND m2_links STREQUAL "Chaos 1,Random 1")
check("... one undo step (${m2_undo})" m2_undo STREQUAL "new random for this knob")
check("a click on Chaos 1 unlinks it (${m3_links}), the source stays (${m3_n})" m3_links STREQUAL "Random 1" AND m3_n EQUAL 2)
check("undo links it again (${m4_links})" m4_links STREQUAL "Chaos 1,Random 1")
set(none "x${m5_links}")
check("Remove all modulation: none left (${m5_links}), one step (${m5_undo})" none STREQUAL "x" AND m5_undo STREQUAL "remove all modulation")
check("... undo brings both back (${m6_links})" m6_links STREQUAL "Chaos 1,Random 1")
check("a click on Random 1 unlinks it (${m7_links})" m7_links STREQUAL "Chaos 1")

# The menu's structure, as drawn (MENUTREE: every submenu entered), in Studio and Clips, plain and modulated.
foreach(L studio live)
  foreach(V plain modulated)
    set(cfg "${OUT}/tree_${L}_${V}")
    file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${L}\", \"keys.profile\": \"${L}\", \"ui.menuStyle\": \"${L}\"}}\n")
    set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
    set(ENV{HOME} "${cfg}/home")
    configure_file("${DEMO}" "${cfg}/song.gridline.json" COPYONLY)
    if(V STREQUAL "modulated")
      file(WRITE "${cfg}/in.txt" "1 knobmenu mod new chaos\n1 knobmenu mod new random\n")
    else()
      file(WRITE "${cfg}/in.txt" "1 knobmenu state\n")
    endif()
    execute_process(COMMAND "${APP}" "${cfg}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x1200 --frames 10 --menu knob
                            --dev-input "${cfg}/in.txt" RESULT_VARIABLE trc OUTPUT_VARIABLE tout ERROR_VARIABLE terr TIMEOUT 120)
    file(WRITE "${cfg}/run.out" "${tout}\n---- stderr ----\n${terr}")
    if(NOT trc EQUAL 0)
      message(FATAL_ERROR "FAIL: ${L} ${V}: gridline-app failed (${trc})")
    endif()
    string(REGEX MATCH "MENUTREE BEGIN knob\n(.*)MENUTREE END" tm "${tout}")
    set(tree "${CMAKE_MATCH_1}")
    string(REGEX MATCH "MENUDUMP BEGIN knob\n(.*)\nMENUDUMP END" dm "${tout}")
    set(rows "${CMAKE_MATCH_1}")
    check("${L} ${V}: the menu tree was written" tree)
    set(order "")
    foreach(row "Modulate >" "Modulate > LFO >" "Modulate > Chaos" "Modulate > Random" "Modulate > Macro" "Modulate > Controller plugin")
      string(FIND "${tree}" "\n${row}" at)
      if(at LESS 0)
        string(FIND "${tree}" "${row}" at)
      endif()
      check("${L} ${V}: \"${row}\" is in the menu" at GREATER -1)
      list(APPEND order ${at})
    endforeach()
    set(prev -1)
    set(inorder TRUE)
    foreach(at IN LISTS order)
      if(at LESS prev)
        set(inorder FALSE)
      endif()
      set(prev ${at})
    endforeach()
    check("${L} ${V}: LFO, Chaos, Random, Macro, Controller plugin in that order" inorder)
    foreach(row "Modulate > LFO > New LFO" "Modulate > Chaos" "Modulate > Random" "Modulate > Open the LFO board")
      string(FIND "${tree}" "${row}" at)
      check("${L} ${V}: \"${row}\"" at GREATER -1)
    endforeach()
    string(REGEX MATCH "Modulate > Chaos[^\n]* > New chaos" nc "${tree}")
    string(REGEX MATCH "Modulate > Random[^\n]* > New random" nr "${tree}")
    check("${L} ${V}: Chaos and Random each have their New row" nc AND nr)
    # The old separate rows are gone from the knob menu itself.
    string(FIND "${rows}" "Modulate with LFO" old1)
    string(FIND "${rows}" "Link to macro" old2)
    string(FIND "${tree}" "Controller link settings" old3)
    check("${L} ${V}: no Modulate with LFO, Link to macro or Controller link settings rows" old1 EQUAL -1 AND old2 EQUAL -1 AND old3 EQUAL -1)
    string(REGEX MATCHALL "(^|\n)Modulate >\n" tops "${tree}")
    list(LENGTH tops ntops)
    check("${L} ${V}: one Modulate submenu (${ntops})" ntops EQUAL 1)
    if(V STREQUAL "modulated")
      string(FIND "${tree}" "Modulate > Chaos 1 settings" s1)
      string(FIND "${tree}" "Modulate > Random 1 settings" s2)
      string(FIND "${tree}" "Modulate > Remove all modulation" s3)
      check("${L} modulated: each source's settings and Remove all modulation" s1 GREATER -1 AND s2 GREATER -1 AND s3 GREATER -1)
      string(REGEX MATCH "Modulate > Chaos[^\n]* > +Chaos 1" c1 "${tree}")
      check("${L} modulated: Chaos 1 is listed under Chaos" c1)
    else()
      string(FIND "${tree}" "Remove all modulation" s3)
      check("${L} plain: no Remove all modulation on a knob nothing moves" s3 EQUAL -1)
    endif()
  endforeach()
endforeach()
