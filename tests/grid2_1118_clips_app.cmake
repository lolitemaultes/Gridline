# Gridline - grid2-1118: the Clips grid's new editing in the real app (hidden, isolated config and HOME,
# fixed frame time) on a copy of the test song with two scenes in the grid (bars 1 to 8, read as a version
# 10 file so its shared slots stay as they are), the first scene named "Verse 140 BPM 3/4":
#   1. Cmd+E removes the selected empty slot's stop button (one undo step) and adds it back;
#   2. Shift-click selects a range of slots; Delete deletes every clip in them as one undo step;
#   3. a rubber band from an empty slot selects the slots it touches;
#   4. Cmd+6 .. Cmd+0 set the global launch quantisation on every track (Cmd+6: 1/16, Cmd+0: None);
#   5. Cmd+5 / Cmd+1 / Cmd+3 / Cmd+4 on the Arrangement: a fixed, finer, triplet grid with snap off,
#      shown in the status bar;
#   6. the scene launched by Enter sets its tempo and time signature at its launch point (the song takes them);
#   7. a slot dragged up out of the grid shows the Arrangement and lands its clips there (one undo step).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P grid2_1118_clips_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
string(REGEX REPLACE "\"playlist\": \\[" "\"live\": {\"areaEnd\": 3072, \"view\": \"grid\", \"scenes\": [{\"name\": \"Verse 140 BPM 3/4\"}]}, \"playlist\": [" demo "${demo}")
string(REGEX REPLACE "\"version\": *[0-9]+" "\"version\": 10" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --layout-dev --layout live --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(ok what)
  message(STATUS "ok - ${what}")
endfunction()

# The text after "<what> frame <frame>:" (the dump or state printed then).
function(after what frame)
  string(FIND "${out}" "${what} frame ${frame}:" at)
  if(at LESS 0)
    fail("no ${what} at frame ${frame}")
  endif()
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(FIND "${rest}" "\n${what} frame" next)
  if(next GREATER 0)
    string(SUBSTRING "${rest}" 0 ${next} rest)
  endif()
  set(rest "${rest}" PARENT_SCOPE)
endfunction()

function(undoAt frame)
  if(NOT out MATCHES "dump frame ${frame}: ([0-9]+) clips, [0-9]+ selected, undo ([0-9]+)\n")
    fail("no dump at frame ${frame}")
  endif()
  set(n ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(undo ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()

# The grid's geometry: slot (t, k) centres.
run(geo "4 typing off\n10 livegrid\n14 quit discard\n")
foreach(cell "0 0" "0 1" "1 0" "1 1" "2 0" "2 1")
  string(REPLACE " " ";" tk "${cell}")
  list(GET tk 0 t)
  list(GET tk 1 k)
  if(NOT out MATCHES "\n  slot ${t} ${k} x ([0-9]+)[.0-9]* y ([0-9]+)[.0-9]* clip ([0-9]+)")
    fail("no slot ${t} ${k} in the grid")
  endif()
  set(x${t}${k} ${CMAKE_MATCH_1})
  set(y${t}${k} ${CMAKE_MATCH_2})
  set(c${t}${k} ${CMAKE_MATCH_3})
endforeach()
if(NOT c01 EQUAL 35 OR NOT c11 EQUAL 47 OR NOT c20 EQUAL 0 OR NOT c21 EQUAL 0)
  fail("the fixture's slots changed (${c01} ${c11} ${c20} ${c21})")
endif()
if(NOT out MATCHES "livegrid title 0 \"[^\"]*\" [0-9]+ ([0-9]+)")
  fail("no title row")
endif()
set(titleY ${CMAKE_MATCH_1})
math(EXPR bx20 "${x20} + 10")  # an empty slot's body (right of its button cell)
math(EXPR bx01 "${x01} + 10")
math(EXPR bx11 "${x11} + 10")

# ---- 1. Cmd+E: the stop button ----
run(stopbtn "4 typing off\n20 move ${bx20} ${y20}\n21 down 0\n22 up 0\n26 dump\n30 mod super 1\n31 key e\n32 mod super 0\n40 dump\n42 grid2state\n50 mod super 1\n51 key e\n52 mod super 0\n60 grid2state\n64 shot \"${OUT}/stop_removed.ppm\"\n70 quit discard\n")
undoAt(26)
set(u0 ${undo})
undoAt(40)
math(EXPR du "${undo} - ${u0}")
after(grid2 42)
if(NOT rest MATCHES "\n  gtrack 2 launch [0-9]+ nostop 0\n" OR NOT du EQUAL 1)
  fail("Cmd+E removes the selected empty slot's stop button in one undo step (undo ${du})")
endif()
after(grid2 60)
if(NOT rest MATCHES "\n  gtrack 2 launch [0-9]+ nostop -\n")
  fail("Cmd+E again gives it back")
endif()
ok("Cmd+E removes and adds back an empty slot's stop button (one undo step)")

# ---- 2. Shift-click range, Delete ----
run(range "4 typing off\n20 move ${bx01} ${y01}\n21 down 0\n22 up 0\n26 mod shift 1\n27 move ${bx11} ${y11}\n28 down 0\n29 up 0\n30 mod shift 0\n34 grid2state\n36 dump\n40 key delete\n50 dump\n54 quit discard\n")
after(grid2 34)
if(NOT rest MATCHES "sel 2 " OR NOT rest MATCHES "\n  selslot 0 1\n" OR NOT rest MATCHES "\n  selslot 1 1\n")
  fail("Shift-click selects the range of slots (0 1) .. (1 1)")
endif()
undoAt(36)
set(u0 ${undo})
set(n0 ${n})
undoAt(50)
math(EXPR du "${undo} - ${u0}")
math(EXPR dn "${n0} - ${n}")
after(dump 50)
if(rest MATCHES "\n  clip 35 " OR rest MATCHES "\n  clip 47 " OR NOT du EQUAL 1 OR dn LESS 2)
  fail("Delete deletes every selected slot's clips in one undo step (removed ${dn}, undo ${du})")
endif()
ok("Shift-click selects a range; Delete clears every selected slot (one undo step)")

# ---- 3. rubber band ----
run(band "4 typing off\n20 move ${bx20} ${y20}\n21 down 0\n22 move ${bx20} ${y21}\n24 move ${bx11} ${y21}\n26 move ${bx11} ${y21}\n28 up 0\n32 grid2state\n36 quit discard\n")
after(grid2 32)
foreach(sl "1 0" "1 1" "2 0" "2 1")
  if(NOT rest MATCHES "\n  selslot ${sl}\n")
    fail("the rubber band selects slot ${sl}")
  endif()
endforeach()
ok("a rubber band from an empty slot selects the slots it touches")

# ---- 4. Cmd+6 .. 0: the global quantisation ----
run(quant "4 typing off\n20 mod super 1\n21 key 6\n22 mod super 0\n30 grid2state\n40 mod super 1\n41 key 0\n42 mod super 0\n50 grid2state\n54 quit discard\n")
after(grid2 30)
if(NOT rest MATCHES "\n  gtrack 0 launch 1 " OR NOT rest MATCHES "\n  gtrack 1 launch 1 ")
  fail("Cmd+6 sets every track's launch grid to 1/16")
endif()
after(grid2 50)
if(NOT rest MATCHES "\n  gtrack 0 launch 0 " OR NOT rest MATCHES "\n  gtrack 1 launch 0 ")
  fail("Cmd+0 sets every track's launch grid to None")
endif()
ok("Cmd+6 .. Cmd+0 set the global launch quantisation")

# ---- 5. the edit grid keys on the Arrangement ----
run(editgrid "4 typing off\n10 key tab\n20 grid2state\n24 mod super 1\n25 key 5\n26 mod super 0\n30 grid2state\n34 mod super 1\n35 key 1\n36 key 3\n37 key 4\n38 mod super 0\n44 grid2state\n46 shot \"${OUT}/editgrid.ppm\"\n54 quit discard\n")
after(grid2 20)
if(NOT rest MATCHES "view arrangement")
  fail("Tab shows the Arrangement")
endif()
after(grid2 30)
if(NOT rest MATCHES "editgrid arrangement \"Grid ([^\" ]+) \\(fixed\\)\"")
  fail("Cmd+5: a fixed grid")
endif()
set(g1 "${CMAKE_MATCH_1}")
after(grid2 44)
if(NOT rest MATCHES "editgrid arrangement \"Grid ([^\" ]+)T \\(fixed\\), snap off\"")
  fail("Cmd+1, Cmd+3, Cmd+4: a finer triplet grid, snap off")
endif()
set(g2 "${CMAKE_MATCH_1}")
if(g1 STREQUAL g2)
  fail("Cmd+1 made the grid finer (${g1} -> ${g2})")
endif()
ok("Cmd+5 fixed, Cmd+1 finer (${g1} -> ${g2}), Cmd+3 triplet, Cmd+4 snap off")

# ---- 6. a scene's tempo and time signature ----
math(EXPR sx "${x20} + 10")
run(scenetempo "4 typing off\n10 key space\n20 move ${sx} ${y20}\n21 down 0\n22 up 0\n30 key right\n36 key enter\n40 grid2state\n300 grid2state\n304 shot \"${OUT}/scene_tempo.ppm\"\n310 quit discard\n")
after(grid2 300)
if(NOT rest MATCHES "scene 0 tempo 140.00 sig 3/4 songTempo 140.00 songSig 3/4 sceneLen 1536 ")
  fail("the scene's tempo and time signature (from its name) apply at its launch point and the song takes them, the rows keep their length")
endif()
ok("a scene named \"Verse 140 BPM 3/4\" sets 140 BPM and 3/4 when it launches (the scene rows keep their length)")

# ---- 7. drag a slot onto the Arrangement ----
math(EXPR upY "${titleY} - 40")
math(EXPR dropY "${y11} + 40")
run(toarr "4 typing off\n20 dump\n30 move ${bx01} ${y01}\n32 down 0\n34 move ${bx01} ${y00}\n36 move ${bx01} ${titleY}\n38 move ${bx01} ${upY}\n40 move ${bx01} ${upY}\n44 move ${x11} ${dropY}\n48 move ${x11} ${dropY}\n52 move ${x11} ${dropY}\n56 up 0\n70 dump\n72 grid2state\n76 shot \"${OUT}/to_arrangement.ppm\"\n80 quit discard\n")
undoAt(20)
set(u0 ${undo})
set(n0 ${n})
undoAt(70)
math(EXPR du "${undo} - ${u0}")
math(EXPR dn "${n} - ${n0}")
after(grid2 72)
if(NOT rest MATCHES "view arrangement")
  fail("the drag out of the grid shows the Arrangement")
endif()
if(NOT dn EQUAL 4 OR NOT du EQUAL 1)
  fail("the slot's four clips land on the Arrangement in one undo step (${dn} clips, undo ${du})")
endif()
after(dump 70)
if(NOT rest MATCHES "\n  clip 35 kind 0 track 0 start 1536 ")
  fail("the grid keeps its clip (a copy goes to the Arrangement)")
endif()
ok("a slot dragged up out of the grid lands its clips on the Arrangement (one undo step)")
message(STATUS "grid2_1118_clips_app: all checks passed")
