# Gridline - K-112c (checkpoint 48): Session record and Capture in the Clips layout's clip grid, in the
# real app (a new set, hidden, isolated config, fixed frame time, the typing keyboard on):
#   1. the selected MIDI track is armed: a click on an empty slot's record button records a new clip
#      there while the transport runs in the clip launch mode (never the pattern mode, so the other
#      clips would play on); the notes typed go into it, and it grows by whole bars;
#   2. a click on the recording clip's button stops the recording: the clip keeps its notes and whole
#      bars and plays on;
#   3. Capture with nothing playing on the track: the notes just played become a new clip in the
#      selected slot, which then plays.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P k112_clips_record_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")

function(run tag input frames)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  file(WRITE "${cfg}/input.txt" "5 toasts clear\n8 typing on\n${input}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --layout live --layout-dev
                          --dev-input "${cfg}/input.txt" --frames ${frames} --screenshot "${OUT}/${tag}.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc})")
  endif()
  set(${tag}_log "${out}" PARENT_SCOPE)
endfunction()

# The first slot of the first column, from the grid's own report ("livegrid" prints each slot's centre).
run(probe "10 livegrid\n" 20)
# (A new set has no scenes stored yet, so no slot lines: the first title's x and the first row's y.)
string(REGEX MATCH "livegrid title 0 \"[^\"]*\" ([0-9]+) " m "${probe_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the new set's grid printed no first title")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + 1")
string(REGEX MATCH "livegrid row 0 y ([0-9]+)\\.[0-9]" m "${probe_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the new set's grid printed no first row")
endif()
set(y0 "${CMAKE_MATCH_1}")
math(EXPR bx "${cx} - 36")   # the launch / record button cell at the slot's left (cells are 96 wide)
math(EXPR y2 "${y0} + 40")   # the third slot (rows 20 apart)

# 1 and 2. Select the first slot (its track is armed), record into the third slot, type, stop.
# N48-08 (checkpoint 49): Clips plays the A-row note keys (A = C, D = E, G = G; Z X C V set the octave and velocity).
run(rec "10 move ${cx} ${y0}\n11 down 0\n12 up 0\n20 move ${bx} ${y2}\n21 down 0\n22 up 0\n60 transport\n80 sdlkey a down\n90 sdlkey a up\n130 sdlkey d down\n140 sdlkey d up\n200 dump\n201 transport\n240 move ${bx} ${y2}\n241 down 0\n242 up 0\n270 dump\n271 notes\n272 playstate\n273 transport\n280 quit discard\n" 290)
string(REGEX MATCH "transport frame 60: pos [0-9]+ playing 1 seek [0-9]+ mode 2" m "${rec_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the recording should run with the transport in the clip launch mode (mode 2)\n${rec_log}")
endif()
string(REGEX MATCH "dump frame 270: 1 clips[^\n]*\n  clip [0-9]+ kind 0 track 0 start ([0-9]+) len ([0-9]+)" m "${rec_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: one MIDI clip on the first track after the recording\n${rec_log}")
endif()
set(start "${CMAKE_MATCH_1}")
set(len "${CMAKE_MATCH_2}")
string(REGEX MATCH "dump frame 200: 1 clips[^\n]*\n  clip [0-9]+ kind 0 track 0 start [0-9]+ len ([0-9]+)" m "${rec_log}")
set(len200 "${CMAKE_MATCH_1}")
message(STATUS "recorded clip: start ${start}, length ${len} (while recording: ${len200})")
if(start EQUAL 0)
  message(FATAL_ERROR "FAIL: the clip went into the first slot, not the third one clicked")
endif()
math(EXPR rem "${len} % 384")
if(len LESS 384 OR NOT rem EQUAL 0)
  message(FATAL_ERROR "FAIL: a recorded clip keeps whole bars (${len} ticks)")
endif()
if(len200 LESS 768)
  message(FATAL_ERROR "FAIL: a new clip grows by bars while it records (${len200} ticks after 200 frames)")
endif()
string(REGEX MATCH "notes frame 271: ([0-9]+) notes" m "${rec_log}")
if(NOT m OR CMAKE_MATCH_1 LESS 2)
  message(FATAL_ERROR "FAIL: the two typed notes should be in the recorded clip\n${rec_log}")
endif()
string(REGEX MATCH "playstate frame 272: playing 1" m "${rec_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the clip plays on after the recording stops\n${rec_log}")
endif()
message(STATUS "ok - recorded into the clicked slot, notes kept, whole bars, still playing")

# 3. Capture: a clip in the second slot first (the track's instrument: the typing keyboard plays it),
# then select the first slot, play two notes, Capture: a new clip there, which plays.
math(EXPR y1 "${y0} + 20")
run(cap "6 move ${cx} ${y1}\n7 down 0\n8 up 0\n9 down 0\n10 up 0\n20 move ${cx} ${y0}\n21 down 0\n22 up 0\n30 sdlkey a down\n36 sdlkey a up\n46 sdlkey g down\n52 sdlkey g up\n60 sdlat capture\n61 sdldown 0\n62 sdlup 0\n90 dump\n91 notes\n92 playstate\n93 transport\n100 quit discard\n" 110)
string(REGEX MATCH "dump frame 90: 2 clips[^\n]*\n(  clip [^\n]*\n)*  clip [0-9]+ kind 0 track 0 start 0 len ([0-9]+)" m "${cap_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: Capture should make one clip in the selected (first) slot\n${cap_log}")
endif()
string(REGEX MATCH "notes frame 91: ([0-9]+) notes" m "${cap_log}")  # (the selected new clip's notes)
if(NOT m OR NOT CMAKE_MATCH_1 EQUAL 2)
  message(FATAL_ERROR "FAIL: the captured clip holds the two notes played\n${cap_log}")
endif()
string(REGEX MATCH "playstate frame 92: playing 1" m "${cap_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the captured clip plays\n${cap_log}")
endif()
message(STATUS "ok - Capture made a clip of the notes in the selected slot, and it plays")

# 4. Checkpoint 59 (N58-01): automation recorded with the defaults (the control bar's automation arm is lit
# by default, and it is the one switch). (a) A MIDI clip in the first slot is launched, F9 records into
# the Arrangement, and 3 Audio's pan moves four times: the moves become an automation clip in the
# Arrangement (from the clip grid's end, 1536 for one scene), on a lane right under 3 Audio (track 3),
# never in the clip grid. (b) Session record into the third slot of 1 MIDI while its instrument's volume
# moves: the moves go into the recording clip (its pattern's automation), not the playlist.
math(EXPR lx "${cx} - 36")
set(pans "60 mcp call edit_mixer_track {'mixer': 1, 'pan': -0.5}\n64 mcp call edit_mixer_track {'mixer': 1, 'pan': -0.2}\n68 mcp call edit_mixer_track {'mixer': 1, 'pan': 0.3}\n72 mcp call edit_mixer_track {'mixer': 1, 'pan': 0.6}\n")
run(autoarr "10 move ${cx} ${y0}\n11 down 0\n12 up 0\n13 down 0\n14 up 0\n30 move ${lx} ${y0}\n31 down 0\n32 up 0\n50 key f9\n${pans}130 key space\n150 dump\n152 toastlist\n153 save \"${OUT}/autoarr.gridline\"\n154 undo\n156 dump\n158 quit discard\n" 170)
string(REGEX MATCH "\n  clip [0-9]+ kind 2 track ([0-9]+) start ([0-9]+) len" m "${autoarr_log}")
if(NOT m)
  message(FATAL_ERROR "FAIL: the pan moves recorded with F9 should be an automation clip\n${autoarr_log}")
endif()
set(atrack "${CMAKE_MATCH_1}")
set(astart "${CMAKE_MATCH_2}")
message(STATUS "Arrangement automation: track ${atrack}, start ${astart}")
if(astart LESS 1536)
  message(FATAL_ERROR "FAIL: the automation landed in the clip grid's storage (start ${astart} < 1536)")
endif()
if(NOT atrack EQUAL 3)
  message(FATAL_ERROR "FAIL: the automation should be on 3 Audio's lane, right under it (track 3, got ${atrack})")
endif()
if(NOT autoarr_log MATCHES "clips? recorded into the arrangement")
  message(FATAL_ERROR "FAIL: the launched clip should be recorded into the arrangement too\n${autoarr_log}")
endif()
message(STATUS "ok - F9: knob moves land in the Arrangement on the control's lane, with the defaults")
# Checkpoint 60 (N59-03): the take (its launches, the knob moves' values and their automation) is one undo
# step: one undo takes all of it out of the Arrangement.
string(REGEX MATCH "dump frame 156:[^\n]*\n(  [^\n]*\n)*" after_undo "${autoarr_log}")
if(after_undo MATCHES "\n  clip [0-9]+ kind [0-9] track [0-9]+ start (1[5-9][0-9][0-9]|[2-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9]) ")
  message(FATAL_ERROR "FAIL: one undo should remove the whole F9 take (launches and automation)\n${after_undo}")
endif()
message(STATUS "ok - F9: a take with automation is one undo step")

set(vols "60 mcp call set_parameter {'channel': 1, 'param': 'volume', 'value': 0.2, 'normalized': true}\n64 mcp call set_parameter {'channel': 1, 'param': 'volume', 'value': 0.5, 'normalized': true}\n68 mcp call set_parameter {'channel': 1, 'param': 'volume', 'value': 0.9, 'normalized': true}\n")
run(autosess "10 move ${cx} ${y0}\n11 down 0\n12 up 0\n20 move ${bx} ${y2}\n21 down 0\n22 up 0\n${vols}120 move ${bx} ${y2}\n121 down 0\n122 up 0\n150 patauto\n151 dump\n155 quit discard\n" 170)
string(REGEX MATCH "patauto frame 150: undo [0-9]+\n  pa [0-9]+ [0-9]+ [0-9]+ name \"[^\"]*\" points ([0-9]+)" m "${autosess_log}")
if(NOT m OR CMAKE_MATCH_1 LESS 2)
  message(FATAL_ERROR "FAIL: the volume moves during Session record should be in the recording clip\n${autosess_log}")
endif()
if(autosess_log MATCHES "\n  clip [0-9]+ kind 2 ")
  message(FATAL_ERROR "FAIL: Session record's moves should not make a playlist automation clip\n${autosess_log}")
endif()
message(STATUS "ok - Session record: knob moves go into the recording clip, with the defaults")

# 5. Checkpoint 59 (N58-13): a launch that loops while F9 records is written as one looping clip in the
# Arrangement (the reference's one clip per launch), not one clip per pass.
run(autoloop "10 move ${cx} ${y0}\n11 down 0\n12 up 0\n13 down 0\n14 up 0\n30 move ${lx} ${y0}\n31 down 0\n32 up 0\n50 key f9\n470 key space\n490 dump\n495 quit discard\n" 510)
if(NOT autoloop_log MATCHES "arrangement record: 1 clip from 1 launch")
  message(FATAL_ERROR "FAIL: one launch looping for about three passes should be one Arrangement clip\n${autoloop_log}")
endif()
string(REGEX MATCH "\n  clip [0-9]+ kind 0 track 0 start (1[5-9][0-9][0-9]|[2-9][0-9][0-9][0-9]) len ([0-9]+)" m "${autoloop_log}")
if(NOT m OR CMAKE_MATCH_2 LESS 769)
  message(FATAL_ERROR "FAIL: the Arrangement clip should cover the passes played (more than two bars)\n${autoloop_log}")
endif()
message(STATUS "ok - F9: a looping launch is one Arrangement clip of ${CMAKE_MATCH_2} ticks")

# 6. Checkpoint 60 (N59-01): the hand override. The F9 take above saved 3 Audio's pan automation. Played
# back, a move of that pan (no recording) overrides it: the control holds the hand value (the engine
# plays it), the move is one ordinary edit (its undo step; the override adds none), and the override
# is session state: a save while overridden equals a save after Re-enable automation. Clips keeps the
# override when the transport stops, until Re-enable; an undo of the move plays the undone value, still
# held. Studio ends it on stop; Smooth when the control is let go (its Read convention).
function(runl tag layout input frames)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\", \"keys.profile\": \"${layout}\", \"ui.menuStyle\": \"${layout}\"}}\n")
  file(WRITE "${cfg}/input.txt" "5 toasts clear\n${input}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --layout ${layout} --layout-dev
                          --dev-input "${cfg}/input.txt" --frames ${frames}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc})")
  endif()
  set(${tag}_log "${out}" PARENT_SCOPE)
endfunction()

# The "autooverride" report of a frame: count, overridden, held, live, stored, undo, playing.
function(ovr_line log frame out)
  string(REGEX MATCH "autooverride frame ${frame}: count ([0-9]+) overridden ([0-9]) held ([0-9]) live ([-0-9.a-z]+) stored ([-0-9.]+) undo ([0-9]+) playing ([0-9])" m "${log}")
  if(NOT m)
    message(FATAL_ERROR "FAIL: no override report at frame ${frame}\n${log}")
  endif()
  set(${out} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6};${CMAKE_MATCH_7}" PARENT_SCOPE)
endfunction()

set(ovfile "${OUT}/autoarr.gridline")
set(ovmove "40 mcp call edit_mixer_track {'mixer': 1, 'pan': 0.9}\n")
run(ovclips "10 open \"${ovfile}\"\n20 key space\n36 autooverride show pan 1\n${ovmove}50 autooverride show pan 1\n60 key space\n66 autooverride show pan 1\n68 save \"${OUT}/ov_held.gridline\"\n70 key space\n80 autooverride show pan 1\n82 undo\n90 autooverride show pan 1\n92 redo\n94 autooverride reenable\n100 autooverride show pan 1\n102 save \"${OUT}/ov_free.gridline\"\n110 quit discard\n" 120)
ovr_line("${ovclips_log}" 36 a)
ovr_line("${ovclips_log}" 50 b)
ovr_line("${ovclips_log}" 66 c)
ovr_line("${ovclips_log}" 80 d)
ovr_line("${ovclips_log}" 90 e)
ovr_line("${ovclips_log}" 100 f)
list(GET a 0 a_count)
list(GET a 5 a_undo)
list(GET b 0 b_count)
list(GET b 2 b_held)
list(GET b 3 b_live)
list(GET b 4 b_stored)
list(GET b 5 b_undo)
list(GET c 0 c_count)
list(GET c 6 c_playing)
list(GET d 1 d_over)
list(GET d 5 d_undo)
list(GET e 1 e_over)
list(GET e 3 e_live)
list(GET e 4 e_stored)
list(GET f 0 f_count)
list(GET f 5 f_undo)
if(NOT a_count EQUAL 0)
  message(FATAL_ERROR "FAIL: nothing is overridden before a move\n${ovclips_log}")
endif()
math(EXPR want_undo "${a_undo} + 1")
if(NOT b_count EQUAL 1 OR NOT b_held EQUAL 1 OR NOT b_live STREQUAL "0.9000" OR NOT b_stored STREQUAL "0.9000" OR NOT b_undo EQUAL want_undo)
  message(FATAL_ERROR "FAIL: a move during playback should override the pan: held at 0.9, one undo step (${b})\n${ovclips_log}")
endif()
if(NOT c_count EQUAL 1 OR NOT c_playing EQUAL 0)
  message(FATAL_ERROR "FAIL: Clips keeps the override when the transport stops (${c})")
endif()
if(NOT d_over EQUAL 1)
  message(FATAL_ERROR "FAIL: the override holds on the next playback (${d})")
endif()
if(NOT e_over EQUAL 1 OR NOT e_live STREQUAL e_stored OR e_stored STREQUAL "0.9000")
  message(FATAL_ERROR "FAIL: an undo of the move plays the undone value, still held (${e})")
endif()
if(NOT f_count EQUAL 0 OR NOT f_undo EQUAL d_undo)
  message(FATAL_ERROR "FAIL: Re-enable automation ends the override and makes no undo step (${f}, undo before ${d_undo})")
endif()
file(READ "${OUT}/ov_held.gridline" held_txt)
file(READ "${OUT}/ov_free.gridline" free_txt)
if(NOT held_txt STREQUAL free_txt)
  message(FATAL_ERROR "FAIL: the override must never be saved: a save while overridden differs from one after Re-enable")
endif()
message(STATUS "ok - Clips: a move of an automated control overrides it (held, one undo step, kept over a stop, ended by Re-enable, never saved)")

runl(ovstudio studio "10 open \"${ovfile}\"\n20 key space\n${ovmove}50 autooverride show pan 1\n60 key space\n66 autooverride show pan 1\n70 quit discard\n" 80)
ovr_line("${ovstudio_log}" 50 g)
ovr_line("${ovstudio_log}" 66 h)
list(GET g 2 g_held)
list(GET h 0 h_count)
if(NOT g_held EQUAL 1 OR NOT h_count EQUAL 0)
  message(FATAL_ERROR "FAIL: Studio: a move overrides during playback (${g}) and the stop ends it (${h})\n${ovstudio_log}")
endif()
message(STATUS "ok - Studio: the override lasts until the transport stops")

runl(ovsmooth logic "10 open \"${ovfile}\"\n20 key space\n${ovmove}41 autooverride show pan 1\n70 autooverride show pan 1\n72 key space\n76 quit discard\n" 80)
ovr_line("${ovsmooth_log}" 41 i)
ovr_line("${ovsmooth_log}" 70 j)
list(GET i 2 i_held)
list(GET j 0 j_count)
if(NOT i_held EQUAL 1 OR NOT j_count EQUAL 0)
  message(FATAL_ERROR "FAIL: Smooth: a move holds while the control is touched (${i}) and its curve takes over once let go (${j})\n${ovsmooth_log}")
endif()
message(STATUS "ok - Smooth: the override ends when the control is let go (Read)")
