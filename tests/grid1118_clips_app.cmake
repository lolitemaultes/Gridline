# Gridline - grid-1118: the Clips layout's clip grid as a session grid, in the real app (hidden, isolated
# config and HOME, fixed frame time) on a copy of the test song with two scenes in the grid (bars 1 to 8):
#   1. a clip launched while the arrangement plays: the song transport runs on (no jump, song mode), the
#      clip waits for the bar line, then takes its track only; the other tracks play their arrangement;
#      F10 (Back to arrangement) gives the track back at once;
#   2. Alt+drag copies a slot's clip to another slot (the original stays), one undo step;
#   3. a clip dragged onto a full slot replaces that slot's clip, one undo step;
#   4. Capture and insert scene (Cmd+Shift+I): a new scene under the selected one holds copies of the
#      clips playing, which take over at once; one undo step;
#   5. the keys: Right from the last track selects the row's scene, Down the next scene, Enter launches
#      it (and selects the next one); Cmd+Enter stops the selected slot's track.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P grid1118_clips_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
string(REGEX REPLACE "\"playlist\": \\[" "\"live\": {\"areaEnd\": 3072, \"view\": \"grid\"}, \"playlist\": [" demo "${demo}")
# grid2-1118: read as a version 10 file (one written by Studio, whose grid slots may hold several clips): an
# older version moves a slot's further clips into scenes of their own when it loads (test_grid2_1118).
string(REGEX REPLACE "\"version\": *[0-9]+" "\"version\": 10" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  # (--video-clock: the song moves on by one 60 Hz frame of samples a frame, not by the wall clock: in a busy
  # parallel run the dummy audio driver's real time ran ahead of the frames, so a launch met its bar line early)
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --video-clock 60 --size 1440x900
                          --layout-dev --layout live --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(ok what)
  message(STATUS "ok - ${what}")
endfunction()

# The grid's geometry: slot (t, k) centres, the scene column.
run(geo "4 typing off\n10 livegrid\n14 quit discard\n")
foreach(cell "0 0" "0 1" "1 0" "1 1" "2 0" "2 1")
  string(REPLACE " " ";" tk "${cell}")
  list(GET tk 0 t)
  list(GET tk 1 k)
  if(NOT out MATCHES "\n  slot ${t} ${k} x ([0-9]+)[.0-9]* y ([0-9]+)[.0-9]* clip ([0-9]+)")
    fail("no slot ${t} ${k} in the grid")
  endif()
  set(x${t}${k} ${CMAKE_MATCH_1})
  set(y${t}${k} ${CMAKE_MATCH_2})
  set(c${t}${k} ${CMAKE_MATCH_3})
  math(EXPR b${t}${k} "${CMAKE_MATCH_1} - 39")  # the launch triangle's cell at the slot's left
endforeach()
if(NOT c01 EQUAL 35 OR NOT c11 EQUAL 47 OR NOT c20 EQUAL 0 OR NOT c21 EQUAL 0)
  fail("the fixture's slots changed (${c01} ${c11} ${c20} ${c21})")
endif()

# drag <var> <frame> <x0> <y0> <x1> <y1>: a press, four moves and a release (ends 16 frames on).
function(drag var f x0 y0 x1 y1)
  math(EXPR f1 "${f} + 2")
  set(s "${f} move ${x0} ${y0}\n${f1} down 0\n")
  foreach(i 1 2 3 4)
    math(EXPR fi "${f1} + 2 * ${i}")
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 4")
    math(EXPR yi "${y0} + (${y1} - ${y0}) * ${i} / 4")
    string(APPEND s "${fi} move ${xi} ${yi}\n")
  endforeach()
  math(EXPR fu "${f} + 14")
  string(APPEND s "${fu} up 0\n")
  set(${var} "${s}" PARENT_SCOPE)
endfunction()

# livestate <frame> <track>: active, queued and off of that track, and the header's mode / pos / back.
function(livestate frame t)
  if(NOT out MATCHES "livestate frame ${frame}: mode ([0-9]) playing ([0-9]) pos ([0-9]+) back ([0-9])\n")
    fail("no livestate at frame ${frame}")
  endif()
  set(mode ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(playing ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(pos ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(back ${CMAKE_MATCH_4} PARENT_SCOPE)
  string(FIND "${out}" "livestate frame ${frame}:" at)
  string(SUBSTRING "${out}" ${at} -1 rest)
  if(NOT rest MATCHES "\n  live ${t} active ([0-9]+) queued ([0-9]+) off ([0-9])")
    fail("no live state of track ${t} at frame ${frame}")
  endif()
  set(active ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(queued ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(off ${CMAKE_MATCH_3} PARENT_SCOPE)
endfunction()

function(undoAt frame)
  if(NOT out MATCHES "dump frame ${frame}: ([0-9]+) clips, [0-9]+ selected, undo ([0-9]+)\n")
    fail("no dump at frame ${frame}")
  endif()
  set(n ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(undo ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()

# ---- 1. a launch over the playing arrangement, then F10 ----
run(over "4 typing off\n10 key space\n40 livestate\n42 move ${b01} ${y01}\n43 down 0\n44 up 0\n50 livestate\n200 livestate\n204 key f10\n214 livestate\n220 quit discard\n")
livestate(40 0)
set(pos40 ${pos})
livestate(50 0)
if(NOT mode EQUAL 1 OR NOT playing EQUAL 1 OR pos LESS pos40)
  fail("a launch keeps the song transport running (mode ${mode}, playing ${playing}, pos ${pos40} -> ${pos})")
endif()
ok("a launch keeps the song transport (no jump to 0, no separate clock)")
if(NOT queued EQUAL 35 OR NOT off EQUAL 0)
  fail("the launched clip waits for the bar line, the track still plays its arrangement (queued ${queued}, off ${off})")
endif()
ok("the clip waits for its launch grid line; the arrangement plays on meanwhile")
livestate(200 0)
if(NOT active EQUAL 35 OR NOT off EQUAL 1 OR NOT back EQUAL 1)
  fail("the clip plays and has the track (active ${active}, off ${off}, back ${back})")
endif()
livestate(200 1)
if(NOT active EQUAL 0 OR NOT off EQUAL 0)
  fail("the other track plays its arrangement (active ${active}, off ${off})")
endif()
ok("the grid takes the launched clip's track only")
livestate(214 0)
if(NOT active EQUAL 0 OR NOT off EQUAL 0 OR NOT back EQUAL 0 OR NOT playing EQUAL 1)
  fail("F10 gives the track back (active ${active}, off ${off}, back ${back}, playing ${playing})")
endif()
ok("F10: back to the arrangement at once, the transport runs on")

# ---- 2. Alt+drag copies ----
drag(d 30 ${x11} ${y11} ${x21} ${y21})
run(altcopy "4 typing off\n20 dump\n28 mod alt 1\n${d}48 mod alt 0\n60 dump\n64 quit discard\n")
undoAt(20)
set(u0 ${undo})
set(n0 ${n})
undoAt(60)
math(EXPR du "${undo} - ${u0}")
math(EXPR dn "${n} - ${n0}")
if(NOT out MATCHES "\n  clip 47 kind 0 track 1 start 1536 ")
  fail("Alt+drag leaves the original in its slot")
endif()
if(NOT out MATCHES "\n  clip [0-9]+ kind 0 track 2 start 1536 len 768 ")
  fail("Alt+drag puts a copy in the target slot")
endif()
if(NOT du EQUAL 1 OR NOT dn EQUAL 2)
  fail("the copy is one undo step (${du}) adding the slot's two clips (${dn})")
endif()
ok("Alt+drag copies a slot (one undo step)")

# ---- 3. a drag onto a full slot replaces its clip ----
drag(d 30 ${x00} ${y00} ${x01} ${y01})
run(replace "4 typing off\n20 dump\n${d}60 dump\n64 quit discard\n")
undoAt(20)
set(u0 ${undo})
undoAt(60)
math(EXPR du "${undo} - ${u0}")
string(FIND "${out}" "dump frame 60:" at)
string(SUBSTRING "${out}" ${at} -1 after)
if(after MATCHES "\n  clip 35 ")
  fail("the full slot's clip is replaced")
endif()
if(NOT after MATCHES "\n  clip 31 kind 0 track 0 start 1536 ")
  fail("the dragged clip lands in the full slot")
endif()
if(NOT du EQUAL 1)
  fail("the replacing move is one undo step (${du})")
endif()
ok("a clip dragged onto a full slot replaces its clip (one undo step)")

# ---- 4. Capture and insert scene ----
math(EXPR sx "${x00} + 10")
run(capture "4 typing off\n10 key space\n20 move ${b00} ${y00}\n21 down 0\n22 up 0\n24 move ${b11} ${y11}\n25 down 0\n26 up 0\n200 dump\n202 move ${sx} ${y00}\n203 down 0\n204 up 0\n210 mod super 1\n211 mod shift 1\n212 key i\n214 mod shift 0\n215 mod super 0\n240 dump\n242 livestate\n250 quit discard\n")
undoAt(200)
set(u0 ${undo})
set(n0 ${n})
undoAt(240)
math(EXPR du "${undo} - ${u0}")
math(EXPR dn "${n} - ${n0}")
string(FIND "${out}" "dump frame 240:" at)
string(SUBSTRING "${out}" ${at} -1 after)
if(NOT dn EQUAL 2 OR NOT du EQUAL 1)
  fail("Capture and insert scene: two copies (${dn}) in one undo step (${du})")
endif()
if(NOT after MATCHES "\n  clip ([0-9]+) kind 0 track 0 start 1536 len 384 [^\n]* pattern ([0-9]+)")
  fail("a copy of the playing Drums clip in the new scene (scene 2, tick 1536)")
endif()
set(capId ${CMAKE_MATCH_1})
if(NOT after MATCHES "\n  clip 35 kind 0 track 0 start 3072 ")
  fail("the scene after it moved down a row")
endif()
livestate(242 0)
if(NOT active EQUAL capId)
  fail("the captured copy plays at once in the playing clip's place (active ${active}, copy ${capId})")
endif()
ok("Capture and insert scene: copies in a new scene, playing on without a break, one undo step")

# ---- 5. keys: Right to the scene, Down, Enter launches it; Cmd+Enter stops a track ----
math(EXPR sx2 "${x20} + 10")
run(keys "4 typing off\n10 key space\n20 move ${sx2} ${y20}\n21 down 0\n22 up 0\n30 key right\n36 key down\n42 key enter\n200 livestate\n202 move ${sx} ${y01}\n203 down 0\n204 up 0\n210 mod super 1\n212 key enter\n214 mod super 0\n400 livestate\n404 quit discard\n")
livestate(200 0)
if(NOT active EQUAL 35)
  fail("Right, Down, Enter: scene 2 launched (Drums plays ${active})")
endif()
livestate(200 1)
if(NOT active EQUAL 47)
  fail("Right, Down, Enter: scene 2 launched (Bass plays ${active})")
endif()
ok("Right from the last track selects the scene, Down the next, Enter launches it")
livestate(400 0)
if(NOT active EQUAL 0)
  fail("Cmd+Enter stops the selected slot's track (Drums plays ${active})")
endif()
livestate(400 1)
if(NOT active EQUAL 47)
  fail("Cmd+Enter stops that track only (Bass plays ${active})")
endif()
ok("Cmd+Enter stops the selected slot's track")
message(STATUS "grid1118_clips_app: all checks passed")
