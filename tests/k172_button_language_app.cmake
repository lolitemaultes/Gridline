# Gridline - K-172: the button language in every control style and both themes, from the dev
# gallery (`--gallery <style>`), which prints where it drew a primary button, a pressed primary,
# a toggled-on text button and a held one. Reading the screenshot's pixels:
#   1. the primary's face is clearly coloured (filled with the lit colour);
#   2. a toggle that is on does not look like the primary (far less colour);
#   3. the pressed primary is darker than the primary at rest (it sinks for the click only);
#   4. a toggle that is on does not look like a held button.
# Screenshots: <OUT>/<style>_<theme>.ppm.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P k172_button_language_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

# Byte offset of the pixel data and the image width of a binary PPM (P6).
function(ppm_header file outOff outW)
  file(READ "${file}" head LIMIT 32 HEX)
  # walk the header: P6 <ws> W <ws> H <ws> 255 <one ws>
  set(fields "")
  set(cur "")
  set(i 0)
  set(nf 0)
  string(LENGTH "${head}" hl)
  while(i LESS hl AND nf LESS 4)
    string(SUBSTRING "${head}" ${i} 2 byte)
    math(EXPR i "${i} + 2")
    if(byte STREQUAL "0a" OR byte STREQUAL "20" OR byte STREQUAL "0d" OR byte STREQUAL "09")
      if(NOT cur STREQUAL "")
        list(APPEND fields "${cur}")
        set(cur "")
        math(EXPR nf "${nf} + 1")
      endif()
    else()
      math(EXPR c "0x${byte}")
      string(ASCII ${c} ch)
      string(APPEND cur "${ch}")
    endif()
  endwhile()
  math(EXPR off "${i} / 2")
  list(GET fields 1 w)
  set(${outOff} ${off} PARENT_SCOPE)
  set(${outW} ${w} PARENT_SCOPE)
endfunction()

# Mean r g b of a few pixels in a logical rect's left part (away from the centred caption).
function(face_rgb file off w scale x0 y0 x1 y1 out)
  set(sr 0)
  set(sg 0)
  set(sb 0)
  set(n 0)
  math(EXPR ym "(${y0} + ${y1}) / 2")
  foreach(dx 4 6 8 10)
    foreach(dy -4 0 4)
      math(EXPR px "(${x0} + ${dx}) * ${scale}")
      math(EXPR py "(${ym} + ${dy}) * ${scale}")
      math(EXPR o "${off} + (${py} * ${w} + ${px}) * 3")
      file(READ "${file}" hx OFFSET ${o} LIMIT 3 HEX)
      string(SUBSTRING "${hx}" 0 2 r)
      string(SUBSTRING "${hx}" 2 2 g)
      string(SUBSTRING "${hx}" 4 2 b)
      math(EXPR sr "${sr} + 0x${r}")
      math(EXPR sg "${sg} + 0x${g}")
      math(EXPR sb "${sb} + 0x${b}")
      math(EXPR n "${n} + 1")
    endforeach()
  endforeach()
  math(EXPR sr "${sr} / ${n}")
  math(EXPR sg "${sg} / ${n}")
  math(EXPR sb "${sb} / ${n}")
  set(${out} "${sr};${sg};${sb}" PARENT_SCOPE)
endfunction()
function(sat rgb out)  # max - min channel
  list(GET rgb 0 r)
  list(GET rgb 1 g)
  list(GET rgb 2 b)
  set(mx ${r})
  set(mn ${r})
  foreach(c ${g} ${b})
    if(c GREATER mx)
      set(mx ${c})
    endif()
    if(c LESS mn)
      set(mn ${c})
    endif()
  endforeach()
  math(EXPR s "${mx} - ${mn}")
  set(${out} ${s} PARENT_SCOPE)
endfunction()
function(luma rgb out)
  list(GET rgb 0 r)
  list(GET rgb 1 g)
  list(GET rgb 2 b)
  math(EXPR l "(${r} * 3 + ${g} * 6 + ${b}) / 10")
  set(${out} ${l} PARENT_SCOPE)
endfunction()
function(dist a b out)
  set(d 0)
  foreach(k 0 1 2)
    list(GET a ${k} x)
    list(GET b ${k} y)
    math(EXPR e "${x} - ${y}")
    if(e LESS 0)
      math(EXPR e "0 - ${e}")
    endif()
    math(EXPR d "${d} + ${e}")
  endforeach()
  set(${out} ${d} PARENT_SCOPE)
endfunction()

set(fails 0)
foreach(style slate graphite hairline lumen classic)
  foreach(th dark light)
    set(tag "${style}_${th}")
    file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
    set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
    set(ENV{HOME} "${OUT}/cfg_${tag}")
    set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
    set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
    set(extra "")
    if(th STREQUAL "light")
      set(extra "--light")
    endif()
    execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --frames 8 --gallery ${style} ${extra}
                            --screenshot "${OUT}/${tag}.ppm"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
    endif()
    string(REGEX MATCH "gallery primary [0-9]+ [0-9]+ [0-9]+ [0-9]+ pressed [0-9]+ [0-9]+ [0-9]+ [0-9]+ on [0-9]+ [0-9]+ [0-9]+ [0-9]+ held [0-9]+ [0-9]+ [0-9]+ [0-9]+" gline "${out}")
    if(NOT gline)
      message(FATAL_ERROR "FAIL ${tag}: the gallery printed no button geometry")
    endif()
    string(REGEX MATCHALL "[0-9]+" g "${gline}")
    ppm_header("${OUT}/${tag}.ppm" off w)
    math(EXPR scale "${w} / 1440")
    if(scale LESS 1)
      set(scale 1)
    endif()
    list(SUBLIST g 0 4 r)
    face_rgb("${OUT}/${tag}.ppm" ${off} ${w} ${scale} ${r} prim)
    list(SUBLIST g 4 4 r)
    face_rgb("${OUT}/${tag}.ppm" ${off} ${w} ${scale} ${r} pressed)
    list(SUBLIST g 8 4 r)
    face_rgb("${OUT}/${tag}.ppm" ${off} ${w} ${scale} ${r} on)
    list(SUBLIST g 12 4 r)
    face_rgb("${OUT}/${tag}.ppm" ${off} ${w} ${scale} ${r} held)
    sat("${prim}" sPrim)
    sat("${on}" sOn)
    luma("${prim}" lPrim)
    luma("${pressed}" lPressed)
    dist("${on}" "${held}" dOnHeld)
    dist("${on}" "${prim}" dOnPrim)
    message(STATUS "${tag}: primary ${prim} (sat ${sPrim}, luma ${lPrim}) pressed ${pressed} (luma ${lPressed}) on ${on} (sat ${sOn}) held ${held}")
    set(ok TRUE)
    if(sPrim LESS 90)
      message(STATUS "FAIL ${tag}: the primary is not filled with the lit colour (saturation ${sPrim})")
      set(ok FALSE)
    endif()
    math(EXPR gap "${sPrim} - ${sOn}")
    if(gap LESS 40 AND dOnPrim LESS 120)
      message(STATUS "FAIL ${tag}: a toggle that is on looks like the primary")
      set(ok FALSE)
    endif()
    if(NOT lPressed LESS lPrim)
      message(STATUS "FAIL ${tag}: the pressed primary is not darker than at rest")
      set(ok FALSE)
    endif()
    if(dOnHeld LESS 20)
      message(STATUS "FAIL ${tag}: a toggle that is on looks like a held button (difference ${dOnHeld})")
      set(ok FALSE)
    endif()
    if(ok)
      message(STATUS "ok - ${tag}")
    else()
      math(EXPR fails "${fails} + 1")
    endif()
  endforeach()
endforeach()
if(fails GREATER 0)
  message(FATAL_ERROR "FAIL: ${fails} style/theme combinations break the button language")
endif()
