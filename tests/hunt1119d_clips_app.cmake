# Gridline - hunt-clips4-1119: a new Clips set used as a person uses it, in the real app (hidden, isolated
# config and HOME, the layout chosen through the real settings keys), by pointer and key input:
#   1. Main's title clicked, an effect double-clicked in the browser: it goes on Main and the device band
#      shows Main's chain (it showed the instrument track chosen before);
#   2. an effect dragged from the browser onto a track's strip and onto Main's strip lands there (only the
#      titles took the drop, Main none);
#   3. A Reverb's title clicked, an effect double-clicked: it goes on the return and the band shows it;
#   4. track 2's title clicked, an instrument double-clicked: it goes onto track 2 (it made a new channel
#      and opened its editor window);
#   5. notes drawn by turns at two heights keep two pitches: the notes view no longer scrolls under the
#      pointer while drawing (each note at a new pitch re-centred it, so the next landed a key or more off).
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -DSRC=<source dir> -P hunt1119d_clips_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(ok what)
  message(STATUS "ok - ${what}")
endfunction()

# ---- the script builder: S (the script), F (the next frame) ----
set(S "4 typing off\n")
set(F 8)
macro(at line)
  string(APPEND S "${F} ${line}\n")
  math(EXPR F "${F} + 1")
endmacro()
macro(wait n)
  math(EXPR F "${F} + ${n}")
endmacro()
macro(drag x0 y0 x1 y1)
  at("move ${x0} ${y0}")
  wait(1)
  at("down 0")
  foreach(i RANGE 1 30)
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 30")
    math(EXPR yi "${y0} + (${y1} - ${y0}) * ${i} / 30")
    at("move ${xi} ${yi}")
  endforeach()
  wait(2)
  at("up 0")
  wait(4)
endmacro()
macro(click x y)
  at("move ${x} ${y}")
  wait(1)
  at("down 0")
  at("up 0")
  wait(4)
endmacro()
macro(dblclick x y)
  at("move ${x} ${y}")
  wait(1)
  at("down 0")
  at("up 0")
  wait(1)
  at("down 0")
  at("up 0")
  wait(8)
endmacro()
macro(key k)
  foreach(md ${ARGN})
    string(APPEND S "${F} mod ${md} 1\n")
  endforeach()
  wait(1)
  at("key ${k}")
  foreach(md ${ARGN})
    string(APPEND S "${F} mod ${md} 0\n")
  endforeach()
  wait(4)
endmacro()
macro(finish tag)
  wait(6)
  at("save ${OUT}/${tag}.json")
  wait(2)
  at("quit discard")
  run(${tag} "${S}")
  file(READ "${OUT}/${tag}.json" song)
  set(S "4 typing off\n")
  set(F 8)
endmacro()

# The effect types on the mixer track named `name` of the saved song.
function(fxOf name var)
  set(r "")
  string(JSON n LENGTH "${song}" mixer)
  math(EXPR n "${n} - 1")
  foreach(i RANGE ${n})
    string(JSON nm GET "${song}" mixer ${i} name)
    if(nm STREQUAL "${name}")
      string(JSON k ERROR_VARIABLE e LENGTH "${song}" mixer ${i} slots)
      if(NOT e AND k GREATER 0)
        math(EXPR k "${k} - 1")
        foreach(j RANGE ${k})
          string(JSON ty ERROR_VARIABLE e2 GET "${song}" mixer ${i} slots ${j} plugin type)
          if(NOT e2)
            list(APPEND r "${ty}")
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
  set(${var} "${r}" PARENT_SCOPE)
endfunction()

# The browser (a new set opens on the clip grid): its places and their rows at 1440 x 900.
set(instrY 239)
set(effectsY 259)
set(rowAnalogSynth 278)
set(rowCeiling 558)
set(rowChime 598)

# ================================ 1, 2: effects on Main and on the strips ================================
run(geo "4 typing off\n8 livegrid\n12 quit discard\n")
foreach(t 0 1 2)
  if(NOT out MATCHES "livegrid title ${t} \"[^\"]*\" ([0-9]+) ([0-9]+)")
    fail("no clip grid column ${t}")
  endif()
  set(tx${t} ${CMAKE_MATCH_1})
  set(titleY ${CMAKE_MATCH_2})
endforeach()
if(NOT out MATCHES "livegrid scene x ([0-9]+)")
  fail("no scene column")
endif()
set(mainX ${CMAKE_MATCH_1})
if(NOT out MATCHES "livegrid row 0 y ([0-9]+)")
  fail("no clip grid row")
endif()
set(row0 ${CMAKE_MATCH_1})
# A Reverb's title: the returns stand left of Main (two return columns of 96 and the gap before Main's).
math(EXPR retX "${mainX} - 221")
math(EXPR stripY "${titleY} + 404")  # in the strips under the slots (the fader's column)

click(${mainX} ${titleY})
click(73 ${effectsY})
dblclick(190 ${rowCeiling})
wait(10)
at("move 342 853")  # the device band's chain label
wait(20)
set(at_band ${F})
at("hint")
wait(2)
drag(190 ${rowChime} ${tx2} ${stripY})
wait(10)
drag(190 ${rowChime} ${mainX} ${stripY})
wait(10)
finish(fx)
if(NOT out MATCHES "hint frame ${at_band}: ([^\n]*)")
  fail("no hint at the device band")
endif()
set(h "${CMAKE_MATCH_1}")
fxOf("Master" master)
fxOf("3 Audio" t3)
if(NOT master MATCHES "gl.miniceiling")
  fail("Main chosen, an effect double-clicked in the browser goes on Main (${master})")
endif()
if(NOT h MATCHES "^Main:")
  fail("Main chosen and an effect put on it: the device band shows Main's chain (its label's hint: ${h})")
endif()
ok("an effect double-clicked with Main chosen goes on Main, and the band shows Main's chain")
if(NOT t3 MATCHES "gl.minichime")
  fail("an effect dropped on track 3's strip goes on its mixer track (${t3})")
endif()
if(NOT master MATCHES "gl.minichime")
  fail("an effect dropped on Main's strip goes on Main (${master})")
endif()
ok("effects dropped on a track's strip and on Main's strip land there")

# ================================ 3: an effect on a return ================================
click(${retX} ${titleY})
click(73 ${effectsY})
dblclick(190 ${rowChime})
wait(10)
at("move 342 853")
wait(20)
set(at_band ${F})
at("hint")
wait(2)
finish(ret)
string(REGEX MATCH "hint frame ${at_band}: [^\n]*" h "${out}")
fxOf("Reverb" rv)
if(NOT rv MATCHES "gl.minichime")
  fail("A Reverb chosen, an effect double-clicked goes on the return (${rv})")
endif()
if(NOT h MATCHES ": Reverb:")
  fail("A Reverb chosen and an effect put on it: the band shows the return's chain (${h})")
endif()
ok("an effect double-clicked with a return chosen goes on it, and the band shows it")

# ================================ 4, 5: an instrument onto track 2, then notes drawn ================================
click(${tx1} ${titleY})
click(73 ${instrY})
dblclick(190 ${rowAnalogSynth})
wait(20)
math(EXPR sx "${tx1} + 10")
click(${sx} ${row0})
key(m super shift)
wait(10)
foreach(i RANGE 0 5)
  math(EXPR nx "800 + 60 * ${i}")
  math(EXPR odd "${i} % 2")
  math(EXPR ny "740 + 50 * ${odd}")  # two rows by turns: each note is at a new pitch
  dblclick(${nx} ${ny})
endforeach()
finish(notes)
string(JSON n2 GET "${song}" tracks 1 name)
string(JSON nch LENGTH "${song}" channels)
if(NOT n2 MATCHES "Analog Synth")
  fail("track 2 chosen, an instrument double-clicked goes onto track 2 (track 2 \"${n2}\")")
endif()
if(NOT nch EQUAL 1)
  fail("the double-clicked instrument is one channel, on track 2 (${nch} channels)")
endif()
ok("an instrument double-clicked with a MIDI track chosen goes onto it")
# The notes' pitches in drawing order (by start).
set(pitches "")
string(JSON np LENGTH "${song}" patterns)
math(EXPR np "${np} - 1")
foreach(i RANGE ${np})
  string(JSON nn ERROR_VARIABLE e LENGTH "${song}" patterns ${i} notes)
  if(NOT e AND nn GREATER 0)
    string(JSON chk MEMBER "${song}" patterns ${i} notes 0)
    string(JSON k LENGTH "${song}" patterns ${i} notes ${chk})
    math(EXPR k "${k} - 1")
    foreach(j RANGE ${k})
      string(JSON st GET "${song}" patterns ${i} notes ${chk} ${j} start)
      string(JSON pt GET "${song}" patterns ${i} notes ${chk} ${j} pitch)
      math(EXPR key0 "100000 + ${st}")
      list(APPEND pitches "${key0}:${pt}")
    endforeach()
  endif()
endforeach()
list(SORT pitches)
list(LENGTH pitches cnt)
if(NOT cnt EQUAL 6)
  fail("six notes drawn (${pitches})")
endif()
# The notes drawn at one height share a pitch, and the two heights' pitches differ.
set(even "")
set(odd "")
set(i 0)
foreach(p ${pitches})
  string(REGEX REPLACE "^[0-9]+:" "" v "${p}")
  math(EXPR o "${i} % 2")
  if(o)
    list(APPEND odd ${v})
  else()
    list(APPEND even ${v})
  endif()
  math(EXPR i "${i} + 1")
endforeach()
list(REMOVE_DUPLICATES even)
list(REMOVE_DUPLICATES odd)
list(LENGTH even ne)
list(LENGTH odd no)
if(NOT ne EQUAL 1 OR NOT no EQUAL 1 OR even EQUAL odd)
  fail("notes drawn by turns at two heights keep two pitches: the notes view stays put while drawing (${pitches})")
endif()
ok("notes drawn by turns at two heights keep their two pitches (the notes view stays under the pointer)")
