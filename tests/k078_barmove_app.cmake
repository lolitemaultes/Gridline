# Gridline 0.7.8 - moving parts in the control bar list (right-click an empty bit of a bar), in the real
# app (hidden, an isolated config folder and HOME, SDL's dummy audio driver, the development layouts),
# with the mouse through dev input:
#   1. Studio, Clips and Smooth: a part dragged down by its name lands after the row the line showed, a
#      part dragged up by its grip lands before the first row, and a part dragged below the last row of
#      its group lands at the end of the group; the line is reported while dragging; the bar's model
#      follows at once, is the same after a restart, and Reset puts it back;
#   2. the Tracker's list has no parts to drag (its bar is fixed) and its bar stays as it is;
#   3. a workspace with its own bar: the drag changes that bar, not the layout's.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k078_barmove_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(failures 0)
macro(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR failures "${failures} + 1")
endmacro()
macro(ok msg)
  message(STATUS "ok - ${msg}")
endmacro()

# run(<tag> <cfg> <layout> <script>): config ${OUT}/cfg_<cfg> (kept between runs of one cfg).
function(run tag cfg layout script)
  set(c "${OUT}/cfg_${cfg}")
  if(NOT EXISTS "${c}/gridline/settings.json")
    file(MAKE_DIRECTORY "${c}/gridline" "${c}/home")
    file(WRITE "${c}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\"}}\n")
  endif()
  set(ENV{GRIDLINE_CONFIG_HOME} "${c}")
  set(ENV{HOME} "${c}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --layout-dev --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}):\n${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

# The bar's parts in order (from "toolbar dump").
function(parts_of text layout var)
  string(REGEX MATCH "TOOLBAR ${layout} own [01]/[01] parts ([^\n]*) pins\n" _ "${text}")
  string(REPLACE " " ";" l "${CMAKE_MATCH_1}")
  set(${var} "${l}" PARENT_SCOPE)
endfunction()
# Only the ids in `keep`, in the order of `list`.
function(only list keep var)
  set(o "")
  foreach(x ${list})
    string(REGEX REPLACE "[-!]+$" "" x "${x}")
    if(x IN_LIST keep)
      list(APPEND o "${x}")
    endif()
  endforeach()
  set(${var} "${o}" PARENT_SCOPE)
endfunction()

configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)
set(open "5 toasts clear\n8 move 720 20\n10 toolbar list\n")

# A drag in the list: press at (x0,y0), move in steps, report the rows (and the line) while held,
# optionally take a picture, let go at (x1,y1). Frames from `f`.
function(drag var f x0 y0 x1 y1 tag shot)
  math(EXPR a "${f} + 2")
  math(EXPR b "${f} + 4")
  math(EXPR c "${f} + 6")
  math(EXPR d "${f} + 8")
  math(EXPR e "${f} + 10")
  math(EXPR g "${f} + 12")
  math(EXPR h "${f} + 14")
  math(EXPR my "(${y0} + ${y1}) / 2")
  math(EXPR y1b "${y1} + 1")
  set(s "${f} move ${x0} ${y0}\n${a} down 0\n${b} move ${x0} ${y0}\n${c} move ${x0} ${my}\n${d} move ${x1} ${y1}\n${e} move ${x1} ${y1b}\n${g} toolbar rows\n")
  if(shot)
    string(APPEND s "${g} shot \"${OUT}/${tag}.ppm\"\n")
  endif()
  string(APPEND s "${h} up 0\n")
  set(${var} "${s}" PARENT_SCOPE)
endfunction()

# ---- 1. Studio, Clips and Smooth ----
set(sec_studio left)
set(sec_live left)
set(sec_logic switches)
foreach(l studio live logic)
  # Where the rows of the group are (the list draws the same in every run of one size and config).
  run(rows_${l} ${l} ${l} "${open}30 toolbar rows\n32 toolbar dump\n40 quit discard\n")
  parts_of("${out}" ${l} before)
  set(ids "")
  set(y0s "")
  set(y1s "")
  string(REGEX MATCHALL "BARLIST row ${sec_${l}} [^ ]+ [0-9-]+ [0-9-]+ [0-9-]+ [0-9-]+" rows "${out}")
  foreach(r ${rows})
    string(REGEX MATCH "BARLIST row [^ ]+ ([^ ]+) ([0-9-]+) ([0-9-]+) ([0-9-]+) ([0-9-]+)" _ "${r}")
    list(APPEND ids "${CMAKE_MATCH_1}")
    set(x "${CMAKE_MATCH_2}")
    list(APPEND y0s "${CMAKE_MATCH_3}")
    list(APPEND y1s "${CMAKE_MATCH_5}")
  endforeach()
  list(LENGTH ids n)
  if(n LESS 3)
    fail("${l}: the list shows the parts of its ${sec_${l}} group (${n} rows)")
    continue()
  endif()
  math(EXPR last "${n} - 1")
  math(EXPR xname "${x} + 70")
  math(EXPR xgrip "${x} + 9")
  list(GET y0s 0 r0a)
  list(GET y1s 0 r0b)
  list(GET y1s 2 r2b)
  list(GET y0s ${last} rLa)
  list(GET y1s ${last} rLb)
  math(EXPR r0m "(${r0a} + ${r0b}) / 2")
  math(EXPR rLm "(${rLa} + ${rLb}) / 2")
  math(EXPR dropDown "${r2b} - 4")   # the lower half of the third row: after it
  math(EXPR dropUp "${r0a} + 4")     # the upper half of the first row: before it
  math(EXPR dropEnd "${rLb} + 4")    # just below the last row of the group (above the next side's heading): after it

  # The order the list shows after each drop.
  list(GET ids 0 p0)
  list(GET ids 2 p2)
  set(e1 "${ids}")
  list(REMOVE_AT e1 0)
  list(INSERT e1 2 "${p0}")          # first after the (old) third
  list(GET e1 ${last} pl)
  set(e2 "${e1}")
  list(REMOVE_AT e2 ${last})
  list(INSERT e2 0 "${pl}")          # last before the first
  list(GET e2 0 q0)
  set(e3 "${e2}")
  list(REMOVE_AT e3 0)
  list(APPEND e3 "${q0}")            # first to the end

  drag(d1 30 ${xname} ${r0m} ${xname} ${dropDown} drag_${l} ON)
  drag(d2 60 ${xgrip} ${rLm} ${xgrip} ${dropUp} drag_up_${l} OFF)
  drag(d3 90 ${xname} ${r0m} ${xname} ${dropEnd} drag_end_${l} OFF)
  run(move_${l} ${l} ${l} "${open}${d1}48 toolbar dump\n${d2}78 toolbar dump\n${d3}108 toolbar dump\n110 shot \"${OUT}/moved_${l}.ppm\"\n120 quit discard\n")
  string(REGEX MATCHALL "TOOLBAR ${l} own [^\n]*\n" dumps "${out}")
  list(LENGTH dumps nd)
  string(REGEX MATCHALL "BARLIST drag [^\n]*" lines "${out}")
  list(LENGTH lines nl)
  if(NOT nd EQUAL 3 OR NOT nl EQUAL 3)
    fail("${l}: three drags reported their line and three dumps (${nl} lines, ${nd} dumps)")
    continue()
  endif()
  list(GET lines 0 l1)
  list(GET lines 1 l2)
  list(GET lines 2 l3)
  list(GET e1 ${last} e1last)
  if(NOT l1 MATCHES "^BARLIST drag ${p0} after ${p2} " OR NOT l2 MATCHES "^BARLIST drag ${pl} before ${q0} |^BARLIST drag ${pl} before [^ ]+ " OR NOT l3 MATCHES "^BARLIST drag ${q0} after ")
    fail("${l}: the line shows where the part lands (${l1} | ${l2} | ${l3})")
  else()
    ok("${l}: the insertion line follows the pointer (${l1})")
  endif()
  set(i 0)
  foreach(want e1 e2 e3)
    list(GET dumps ${i} dump)
    parts_of("${dump}" ${l} got)
    only("${got}" "${ids}" got)
    if(NOT got STREQUAL "${${want}}")
      fail("${l}: drag ${i}: the bar's order (got [${got}], want [${${want}}])")
    else()
      ok("${l}: drag ${i}: the part landed where the line was (${got})")
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  # Kept after a restart, then Reset.
  run(restart_${l} ${l} ${l} "20 toolbar dump\n24 toolbar reset\n30 toolbar dump\n40 quit discard\n")
  string(REGEX MATCHALL "TOOLBAR ${l} own [^\n]*\n" dumps "${out}")
  list(GET dumps 0 dump)
  parts_of("${dump}" ${l} got)
  only("${got}" "${ids}" got)
  list(GET dumps 1 dump)
  parts_of("${dump}" ${l} reset)
  if(NOT got STREQUAL "${e3}")
    fail("${l}: the new order is kept after a restart (got [${got}], want [${e3}])")
  elseif(NOT reset STREQUAL "${before}")
    fail("${l}: Reset puts the bar back (got [${reset}], want [${before}])")
  else()
    ok("${l}: kept after a restart; Reset puts it back")
  endif()
endforeach()

# ---- 2. the Tracker: nothing to drag ----
run(rows_tracker tracker tracker "${open}30 toolbar rows\n32 toolbar dump\n40 quit discard\n")
if(NOT out MATCHES "BARLIST open 1" OR out MATCHES "BARLIST row " OR NOT out MATCHES "TOOLBAR tracker own 0/0 parts pins pins")
  fail("Tracker: the list opens with no parts to drag, its bar as it is")
else()
  ok("Tracker: the list opens with no parts to drag")
endif()

# ---- 3. a workspace with its own bar ----
run(rows_ws ws studio "5 toasts clear\n10 workspace add Mix\n14 workspace keep 1 bar on\n18 move 720 20\n20 toolbar list\n40 toolbar rows\n50 quit discard\n")
string(REGEX MATCH "BARLIST row left ([^ ]+) ([0-9-]+) ([0-9-]+) [0-9-]+ ([0-9-]+)" _ "${out}")
set(first "${CMAKE_MATCH_1}")
math(EXPR xname "${CMAKE_MATCH_2} + 70")
math(EXPR ym "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}) / 2")
math(EXPR yd "${CMAKE_MATCH_4} + 26 + 22")  # the lower half of the third row
drag(dw 40 ${xname} ${ym} ${xname} ${yd} ws OFF)
run(move_ws ws studio "5 toasts clear\n18 move 720 20\n20 toolbar list\n${dw}60 toolbar dump\n62 workspace select 0\n66 toolbar dump\n68 workspace select 1\n72 toolbar dump\n80 quit discard\n")
string(REGEX MATCHALL "TOOLBAR studio own [^\n]*\n" dumps "${out}")
list(LENGTH dumps nd)
if(NOT nd EQUAL 3)
  fail("workspace: three dumps (${nd})")
else()
  list(GET dumps 0 d0)
  list(GET dumps 1 d1)
  list(GET dumps 2 d2)
  if(NOT first STREQUAL "menus" OR NOT d0 MATCHES "own 1/0 parts transport pins tempo menus position" OR NOT d1 MATCHES "own 0/0 parts menus transport pins tempo position"
     OR NOT d2 STREQUAL "${d0}")
    fail("workspace: the drag changes the workspace's own bar only (${d0} | ${d1} | ${d2})")
  else()
    ok("workspace: the drag changes the workspace's own bar, the layout's stays")
  endif()
endif()

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} check(s) failed")
endif()
