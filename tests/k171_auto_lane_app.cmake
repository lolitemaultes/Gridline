# Gridline - K-171: the piano roll's automation lane edits points like the automation clip editor.
# Runs the app hidden (isolated config, fixed frame time) with the demo pattern lane (`--show autolane`:
# 16 stepped points, one a step apart) and drives the mouse and keys:
#   A. the Delete tool erases the points it is dragged over (it used to draw);
#   B. the Select tool's box selects points and the Delete key removes only those;
#   C. dragging a selected point moves it (value up, same position), one undo step;
#   D. Ctrl+C / Ctrl+V copies points and pastes them after the selection;
#   E. with the Linear curve chosen, a right-drag line writes just its two ends, as straight lines;
#   F. Simplify reduces the lane to fewer points (one undo step);
#   G. the splitter above the lane resizes it; a double-click gives back the automatic height;
#   H. the draw-curve chip is drawn under the lane name.
# Screenshots: <OUT>/lane_1440.ppm, <OUT>/lane_1920.ppm (light: <OUT>/lane_light.ppm).
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> -P k171_auto_lane_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(run tag frames script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  set(size 1440x900)
  if(DEFINED SIZE)
    set(size ${SIZE})
  endif()
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size ${size} --frames ${frames}
                          --show autolane ${ARGN} --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# The last "alane" line printed at <frame>: sets <prefix>_points, _sel, _undo, _pts (list of pos:value:shape).
function(alane out frame prefix)
  string(REGEX MATCH "alane frame ${frame}: target [0-9]+ [0-9]+ points [0-9]+ sel [0-9]+ focus [0-9] shape [0-9]+ lane [0-9. ]+ chip [0-9. ]+ undo [0-9]+ pts[^\n]*" line "${out}")
  if(NOT line)
    message(FATAL_ERROR "FAIL: no alane line at frame ${frame}\n${out}")
  endif()
  string(REGEX MATCH " pts([^\n]*)" _ "${line}")
  string(STRIP "${CMAKE_MATCH_1}" pts)
  string(REGEX REPLACE " pts[^\n]*" "" head "${line}")
  string(REGEX REPLACE "^alane frame [0-9]+: target [0-9]+ [0-9]+ " "" head "${head}")
  string(REGEX MATCHALL "[0-9.]+" n "${head}")
  # points sel focus shape lane x4 chip x4 undo
  list(GET n 0 v)
  set(${prefix}_points ${v} PARENT_SCOPE)
  list(GET n 1 v)
  set(${prefix}_sel ${v} PARENT_SCOPE)
  list(GET n 2 v)
  set(${prefix}_focus ${v} PARENT_SCOPE)
  list(SUBLIST n 4 4 v)
  set(${prefix}_lane ${v} PARENT_SCOPE)
  list(SUBLIST n 8 4 v)
  set(${prefix}_chip ${v} PARENT_SCOPE)
  list(GET n 12 v)
  set(${prefix}_undo ${v} PARENT_SCOPE)
  string(REPLACE " " ";" pts "${pts}")
  set(${prefix}_pts "${pts}" PARENT_SCOPE)
endfunction()

function(trunc var)  # a float to an integer (screen pixels)
  string(REGEX REPLACE "\\..*" "" v "${${var}}")
  set(${var} ${v} PARENT_SCOPE)
endfunction()

# ---- probe: where the lane and its points are
run(probe 24 "20 lane\n20 alane\n")
set(last_out "${probe_out}")
alane("${probe_out}" 20 P)
string(REGEX MATCH "lane frame 20: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([0-9.]+) yBottom ([0-9.]+)" _ "${probe_out}")
set(x0 ${CMAKE_MATCH_1})
set(ppt ${CMAKE_MATCH_2})
set(yTop ${CMAKE_MATCH_3})
set(yBot ${CMAKE_MATCH_4})
check("the demo lane has 16 points (${P_points})" P_points EQUAL 16)
list(GET P_lane 0 lx0)
list(GET P_lane 1 ly0)
list(GET P_lane 3 ly1)
trunc(lx0)
trunc(ly0)
trunc(ly1)
check("the lane is drawn (${ly0}..${ly1})" ly1 GREATER ly0)
# x / y of point i
function(ptxy i outx outy)
  list(GET P_pts ${i} e)
  string(REPLACE ":" ";" e "${e}")
  list(GET e 0 pos)
  list(GET e 1 val)
  math(EXPR x "0")
  # x = x0 + pos * pxPerTick ; y = yBottom - value * (yBottom - yTop)  (pan lane: range 0..1)
  set(code "${x0} + ${pos} * ${ppt}")
  string(REGEX REPLACE "\\..*" "" xi "${x0}")
  # cmake math has no floats: scale by 1000
  string(REGEX MATCH "^(-?)([0-9]+)\\.?([0-9]*)" _ "${ppt}")
  set(pi "${CMAKE_MATCH_2}")
  set(pf "${CMAKE_MATCH_3}000000")
  string(SUBSTRING "${pf}" 0 6 pf)
  math(EXPR pmicro "${pi} * 1000000 + 1${pf} - 1000000")
  math(EXPR px "${xi} + (${pos} * ${pmicro}) / 1000000 + 1")
  string(REGEX MATCH "^([0-9]+)\\.?([0-9]*)" _ "${val}")
  set(vi "${CMAKE_MATCH_1}")
  set(vf "${CMAKE_MATCH_2}0000")
  string(SUBSTRING "${vf}" 0 4 vf)
  math(EXPR vmil "${vi} * 10000 + 1${vf} - 10000")
  string(REGEX REPLACE "\\..*" "" yt "${yTop}")
  string(REGEX REPLACE "\\..*" "" yb "${yBot}")
  math(EXPR py "${yb} - (${vmil} * (${yb} - ${yt})) / 10000")
  set(${outx} ${px} PARENT_SCOPE)
  set(${outy} ${py} PARENT_SCOPE)
endfunction()
math(EXPR ymid "(${ly0} + ${ly1}) / 2")

# ---- A. the Delete tool erases what it is dragged over
ptxy(2 ax ay)
ptxy(4 bx by)
run(erase 40 "20 alane\n22 pianotool erase\n24 move ${ax} ${ymid}\n26 down 0\n28 move ${bx} ${ymid}\n30 up 0\n34 alane\n")
set(last_out "${erase_out}")
alane("${erase_out}" 20 A0)
alane("${erase_out}" 34 A1)
math(EXPR undoA "${A1_undo} - ${A0_undo}")
check("the Delete tool erases the three points it crossed (${A0_points} -> ${A1_points})" A1_points EQUAL 13)
check("... in one undo step (${undoA})" undoA EQUAL 1)

# ---- B. box select, then the Delete key
ptxy(5 cx cy)
ptxy(8 dx dy)
math(EXPR bx0 "${cx} - 5")
math(EXPR bx1 "${dx} + 5")
math(EXPR by0 "${ly0} + 1")
math(EXPR by1 "${ly1} - 1")
run(boxdel 44 "22 pianotool select\n24 move ${bx0} ${by0}\n26 down 0\n28 move ${bx1} ${by1}\n30 up 0\n32 alane\n34 key delete\n38 alane\n")
set(last_out "${boxdel_out}")
alane("${boxdel_out}" 32 B0)
alane("${boxdel_out}" 38 B1)
check("the Select tool's box selects the four points inside it (${B0_sel})" B0_sel EQUAL 4 AND B0_focus EQUAL 1)
check("the Delete key removes only them (${B1_points})" B1_points EQUAL 12 AND B1_sel EQUAL 0)

# ---- C. drag a selected point
ptxy(6 ex ey)
math(EXPR ey2 "${ey} - 12")
run(move 44 "22 pianotool select\n24 move ${ex} ${ey}\n26 down 0\n28 move ${ex} ${ey2}\n30 move ${ex} ${ey2}\n32 up 0\n36 alane\n")
set(last_out "${move_out}")
alane("${move_out}" 36 C1)
list(GET P_pts 6 before)
list(GET C1_pts 6 after)
string(REPLACE ":" ";" b "${before}")
string(REPLACE ":" ";" c "${after}")
list(GET b 0 bpos)
list(GET c 0 cpos)
list(GET b 1 bval)
list(GET c 1 cval)
string(REPLACE "." "" bv "${bval}")
string(REPLACE "." "" cv "${cval}")
string(REPLACE "*" "" cv "${cv}")
check("dragging a point up raises its value and keeps its position (${before} -> ${after})" cpos EQUAL bpos AND cv GREATER bv)
check("... the dragged point stays selected" C1_sel EQUAL 1)

# ---- D. copy and paste (points 1..4: point 0 sits on the lane's left edge)
ptxy(1 fx fy)
ptxy(4 gx gy)
math(EXPR fx0 "${fx} - 5")
math(EXPR gx1 "${gx} + 5")
run(copy 50 "22 pianotool select\n24 move ${fx0} ${by0}\n26 down 0\n28 move ${gx1} ${by1}\n30 up 0\n32 mod ctrl 1\n33 key c\n35 key v\n36 mod ctrl 0\n40 alane\n")
set(last_out "${copy_out}")
alane("${copy_out}" 40 D1)
set(same TRUE)
foreach(k 1 2 3 4)
  list(GET D1_pts ${k} s0)
  math(EXPR k2 "${k} + 4")
  list(GET D1_pts ${k2} s1)
  string(REPLACE ":" ";" s0 "${s0}")
  string(REPLACE ":" ";" s1 "${s1}")
  list(GET s0 1 v0)
  list(GET s1 1 v1)
  if(NOT v0 STREQUAL v1)
    set(same FALSE)
  endif()
endforeach()
check("Ctrl+C / Ctrl+V pastes the four points after the selection (${D1_points} points, pasted ones selected: ${D1_sel})"
      same AND D1_sel EQUAL 4 AND D1_points EQUAL 16)

# ---- E. linear line: two ends
ptxy(2 hx hy)
ptxy(10 ix iy)
math(EXPR hy0 "${ly1} - 4")
math(EXPR iy0 "${ly0} + 4")
run(line 44 "20 alaneshape 1\n22 pianotool draw\n24 move ${hx} ${hy0}\n26 down 1\n28 move ${ix} ${iy0}\n30 move ${ix} ${iy0}\n32 up 1\n36 alane\n")
set(last_out "${line_out}")
alane("${line_out}" 36 E1)
set(lin 0)
foreach(e IN LISTS E1_pts)
  if(e MATCHES ":0\\*?$")
    math(EXPR lin "${lin} + 1")
  endif()
endforeach()
check("a Linear right-drag line replaces the points it spans with its two ends (${E1_points} points, ${lin} straight)" E1_points EQUAL 9 AND lin EQUAL 2)

# ---- F. simplify
run(simp 34 "20 alane\n24 alanesimplify 20 0\n28 alane\n")
set(last_out "${simp_out}")
alane("${simp_out}" 20 F0)
alane("${simp_out}" 28 F1)
math(EXPR undoF "${F1_undo} - ${F0_undo}")
check("Simplify keeps fewer points (${F0_points} -> ${F1_points}) in one undo step (${undoF})" F1_points LESS F0_points AND F1_points GREATER 1 AND undoF EQUAL 1)

# ---- G. the splitter
math(EXPR sy "${ly0} - 8")
math(EXPR sy2 "${sy} - 60")
math(EXPR sxm "${lx0} + 300")
run(split 70 "20 alane\n22 move ${sxm} ${sy}\n24 down 0\n26 move ${sxm} ${sy2}\n28 move ${sxm} ${sy2}\n30 up 0\n34 alane\n40 move ${sxm} ${sy2}\n42 down 0\n43 up 0\n45 down 0\n46 up 0\n52 alane\n")
set(last_out "${split_out}")
alane("${split_out}" 20 G0)
alane("${split_out}" 34 G1)
alane("${split_out}" 52 G2)
list(GET G0_lane 1 g0a)
list(GET G0_lane 3 g0b)
list(GET G1_lane 1 g1a)
list(GET G1_lane 3 g1b)
list(GET G2_lane 1 g2a)
list(GET G2_lane 3 g2b)
foreach(v g0a g0b g1a g1b g2a g2b)
  trunc(${v})
endforeach()
math(EXPR h0 "${g0b} - ${g0a}")
math(EXPR h1 "${g1b} - ${g1a}")
math(EXPR h2 "${g2b} - ${g2a}")
math(EXPR grow "${h1} - ${h0}")
check("dragging the splitter up 60 px makes the lane taller (${h0} -> ${h1})" grow GREATER 50 AND grow LESS 70)
check("a double-click on the splitter gives back the automatic height (${h2})" h2 EQUAL h0)

# ---- H. the chip, and screenshots
list(GET P_chip 0 c0)
list(GET P_chip 2 c1)
trunc(c0)
trunc(c1)
check("the draw-curve chip sits in the key column under the lane name (${c0}..${c1})" c1 GREATER c0 AND c1 LESS lx0)
run(lane_1440 30 "20 pianotool select\n22 move ${fx0} ${by0}\n23 down 0\n25 move ${gx1} ${by1}\n27 up 0\n")
set(SIZE 1920x1080)
run(lane_1920 30 "20 alaneshape 2\n")
unset(SIZE)
run(lane_light 30 "20 alaneshape 1\n" --light)
message(STATUS "screenshots: ${OUT}/lane_1440.ppm ${OUT}/lane_1920.ppm ${OUT}/lane_light.ppm")
