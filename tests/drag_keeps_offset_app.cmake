# Gridline: clips and notes placed off the grid keep their offset, driven by scripted input in the real
# app (hidden, isolated config and HOME, fixed frame time) on copies of the test song:
#   1. playlist: a click on an off-grid clip (body, either edge), or with a 2 px slip, changes nothing and
#      adds no undo step; dragged one bar it moves exactly one bar; a clip on the grid stays on it;
#   2. piano roll: the same for a note, with snap on Line and on Bar; a drag of under half a bar in Bar
#      leaves it where it is.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P drag_keeps_offset_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
set(clips "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 7, \"start\": 437, \"length\": 1000, \"pattern\": 0, \"gain\": 1.0}, ")
string(APPEND clips "{\"id\": 71, \"kind\": \"audio\", \"source\": 60, \"track\": 8, \"start\": 384, \"length\": 1000, \"pattern\": 0, \"gain\": 1.0}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${chan}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clips}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${ARGN}
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()

# ---- playlist ----
set(pl --show playlist)
run(plgeo "4 typing off\n8 plgeom\n12 quit discard\n" ${pl})
string(REGEX MATCH "plgeom frame 8: valid 1 x0 ([-0-9]+)[.0-9]* pxPerTick ([0-9.]+)" _ "${out}")
set(ppt ${CMAKE_MATCH_2})
foreach(id 70 71)
  if(NOT out MATCHES "  clip ${id} x ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* ([-0-9]+)")
    message(FATAL_ERROR "FAIL: no geometry for clip ${id}\n${out}")
  endif()
  set(x0_${id} ${CMAKE_MATCH_1})
  set(x1_${id} ${CMAKE_MATCH_2})
  math(EXPR y_${id} "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}) / 2 + 4")
endforeach()
# Pixels for one bar (384 ticks), from the clip's own drawn width (1000 ticks).
math(EXPR barPx "(${x1_70} - ${x0_70}) * 384 / 1000")

# clip <id> at <frame> -> c_start, c_len, c_offset; and undo.
function(clipAt frame id)
  string(REGEX MATCH "dump frame ${frame}: [0-9]+ clips, [0-9]+ selected, undo ([0-9]+)\n(  clip [^\n]*\n)*" d "${out}")
  set(undo_${frame} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "  clip ${id} kind [^\n]*" line "${d}")
  if(NOT line MATCHES " start ([0-9]+) len ([0-9]+) offset ([0-9]+)")
    message(FATAL_ERROR "FAIL: no clip ${id} in dump ${frame}\n${out}")
  endif()
  set(c_start ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(c_len ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(c_offset ${CMAKE_MATCH_3} PARENT_SCOPE)
endfunction()

# A click at <x>, with an optional slip of <slip> px before the release, leaves clip 70 as it was.
function(plClick tag x slip what)
  math(EXPR xs "${x} + ${slip}")
  run(${tag} "4 typing off\n6 dump\n8 move ${x} ${y_70}\n12 down 0\n16 move ${xs} ${y_70}\n20 up 0\n26 dump\n30 quit discard\n" ${pl})
  clipAt(6 70)
  set(undo0 ${undo_6})
  clipAt(26 70)
  want("${what}: start" "${c_start}" 437)
  want("${what}: length" "${c_len}" 1000)
  want("${what}: offset" "${c_offset}" 0)
  want("${what}: no undo step" "${undo_26}" "${undo0}")
endfunction()
math(EXPR xMid "(${x0_70} + ${x1_70}) / 2")
math(EXPR xLeft "${x0_70} + 1")
math(EXPR xRight "${x1_70} - 1")
plClick(click_body ${xMid} 0 "a click on the clip's body")
plClick(click_slip ${xMid} 2 "a click that slips 2 px")
plClick(click_left ${xLeft} 0 "a click on the clip's left edge")
plClick(click_right ${xRight} 0 "a click on the clip's right edge")

# Dragged one bar each way it keeps its offset exactly.
function(plDrag tag id from to expect what)
  math(EXPR xm "(${x0_${id}} + ${x1_${id}}) / 2")
  math(EXPR xe "${xm} + ${to}")
  math(EXPR xh "${xm} + ${to} / 2")
  run(${tag} "4 typing off\n8 move ${xm} ${y_${id}}\n12 down 0\n16 move ${xh} ${y_${id}}\n20 move ${xe} ${y_${id}}\n24 up 0\n30 dump\n34 quit discard\n" ${pl})
  clipAt(30 ${id})
  want("${what}" "${c_start}" ${expect})
endfunction()
plDrag(drag_right 70 0 ${barPx} 821 "an off-grid clip dragged a bar right moves exactly a bar")
math(EXPR back "0 - ${barPx}")
plDrag(drag_left 70 0 ${back} 53 "an off-grid clip dragged a bar left moves exactly a bar")
plDrag(drag_grid 71 0 ${barPx} 768 "a clip on the grid stays on it")

# ---- piano roll ----
set(pr --edit 0 6 --hide rack)
set(make "2 mknotes 2 437 96\n3 typing off\n")
run(prgeo "${make}14 lane\n17 quit discard\n" ${pr})
if(NOT out MATCHES "lane frame [0-9]+: x0 ([-0-9]+)[.0-9]* pxPerTick ([0-9]+)\\.([0-9][0-9][0-9])[0-9]* yTop [-0-9.]+ [^\n]* pitchY0 ([-0-9]+)[.0-9]* rowH ([0-9]+)")
  message(FATAL_ERROR "FAIL: no piano roll geometry\n${out}")
endif()
set(px0 ${CMAKE_MATCH_1})
set(pi ${CMAKE_MATCH_2})
set(pf ${CMAKE_MATCH_3})
math(EXPR ny "${CMAKE_MATCH_4} + (127 - 60) * ${CMAKE_MATCH_5} + ${CMAKE_MATCH_5} / 2")
string(REGEX REPLACE "^0+(.)" "\\1" pf "${pf}")
math(EXPR pptm "${pi} * 1000 + ${pf}")
function(xat tick var)
  math(EXPR v "${px0} + ${tick} * ${pptm} / 1000")
  set(${var} ${v} PARENT_SCOPE)
endfunction()
# note 1 at <frame> -> n_start, n_len.
function(noteAt frame)
  if(NOT out MATCHES "notes frame ${frame}:[^\n]*\n  note [^\n]*\n  note [0-9]+ ([^\n]*)")
    message(FATAL_ERROR "FAIL: no notes at frame ${frame}\n${out}")
  endif()
  set(l "${CMAKE_MATCH_1}")
  if(NOT l MATCHES "start ([0-9]+)")
    message(FATAL_ERROR "FAIL: no start in ${l}")
  endif()
  set(n_start ${CMAKE_MATCH_1} PARENT_SCOPE)
  if(NOT l MATCHES "len(gth)? ([0-9]+)")
    message(FATAL_ERROR "FAIL: no length in ${l}")
  endif()
  set(n_len ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()
xat(485 nMid)
xat(532 nEnd)
foreach(mode Line Bar)
  run(n_click_${mode} "${make}4 pianosnap ${mode}\n8 move ${nMid} ${ny}\n12 down 0\n16 up 0\n22 notes\n26 quit discard\n" ${pr})
  noteAt(22)
  want("${mode}: a click on an off-grid note: start" "${n_start}" 437)
  run(n_edge_${mode} "${make}4 pianosnap ${mode}\n8 move ${nEnd} ${ny}\n12 down 0\n16 up 0\n22 notes\n26 quit discard\n" ${pr})
  noteAt(22)
  want("${mode}: a click on its end: length" "${n_len}" 96)
  xat(869 nTo)
  xat(677 nHalf)
  run(n_drag_${mode} "${make}4 pianosnap ${mode}\n8 move ${nMid} ${ny}\n12 down 0\n16 move ${nHalf} ${ny}\n20 move ${nTo} ${ny}\n24 up 0\n30 notes\n34 quit discard\n" ${pr})
  noteAt(30)
  want("${mode}: dragged a bar it moves exactly a bar" "${n_start}" 821)
endforeach()
xat(600 nShort)
run(n_short "${make}4 pianosnap Bar\n8 move ${nMid} ${ny}\n12 down 0\n16 move ${nShort} ${ny}\n20 up 0\n26 notes\n30 quit discard\n" ${pr})
noteAt(26)
want("Bar: a drag of under half a bar leaves it" "${n_start}" 437)
message(STATUS "drag_keeps_offset_app: all checks passed")
