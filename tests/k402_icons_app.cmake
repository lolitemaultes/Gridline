# Gridline — K-402: Smooth and Clips SVG icon rendering audit at 1x/2x and dark/light themes.
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_NO_UPDATE_CHECK} "1")
set(ENV{GRIDLINE_QUIET_WINDOWS} "1")
unset(ENV{XDG_DATA_HOME})
unset(ENV{XDG_CONFIG_HOME})

function(check_layout tag layout theme scale)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(extra_args "")
  if(theme STREQUAL "light")
    list(APPEND extra_args --light)
  endif()
  if(NOT scale STREQUAL "1.0")
    list(APPEND extra_args --scale "${scale}")
  endif()
  set(shot "${OUT}/${tag}.ppm")
  execute_process(COMMAND "${APP}" "${DEMO}" --hidden --no-ui-sounds --fixed-dt 16 --layout "${layout}"
                          --size 1440x900 ${extra_args} --frames 20 --screenshot "${shot}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  if(NOT EXISTS "${shot}")
    message(FATAL_ERROR "${tag}: screenshot missing: ${shot}")
  endif()
  file(SIZE "${shot}" sz)
  if(scale STREQUAL "2.0")
    if(sz LESS 10000000)
      message(FATAL_ERROR "${tag}: 2x screenshot unexpectedly small (${sz} bytes)")
    endif()
  else()
    if(sz LESS 100000)
      message(FATAL_ERROR "${tag}: screenshot too small (${sz} bytes)")
    endif()
  endif()
  message(STATUS "ok - ${tag} (${layout}, ${theme}, scale=${scale}, ${sz} bytes)")
endfunction()

check_layout(clips_dark_1x live dark 1.0)
check_layout(clips_light_1x live light 1.0)
check_layout(clips_dark_2x live dark 2.0)
check_layout(smooth_dark_1x logic dark 1.0)
check_layout(smooth_light_1x logic light 1.0)
check_layout(smooth_dark_2x logic dark 2.0)
