# Gridline - K-112: no overlapping or cut text in any layout, at 100% and 200% interface size, on
# a 1280x800 and a 1440x900 screen (2560x1600 and 2880x1800 at 200%).
#   Each layout (Studio, and the development shells of Live, Logic and Tracker) runs with a
#   selection and every new panel open (View > Panels), and the alignment audit (--align-audit)
#   lists overlapping and cut text on the last frame. Checks:
#     - no overlapping text in any window more than Studio has at that size (none in new panels);
#     - no cut text in the docking chrome (region tab labels, title bars): a cut the dock host
#       reports that no window reports itself;
#     - text cut by a scrolling list's or canvas's own edge (the last visible row, a clip name at
#       the clip's end) is how those scroll in every layout: listed, not failed.
#   cmake -DAPP=<gridline-app> -DDEMO=<song> -DOUT=<dir> -P k112_textfit_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(failures 0)
macro(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR failures "${failures} + 1")
endmacro()

set(parts "Inspector;Library;Lists;Device chain;Clip panel;Track scopes;Info box;Files;Notes")
set(script "5 toasts clear\n6 layout select\n")
foreach(p IN LISTS parts)
  string(APPEND script "8 layout open ${p}\n")
endforeach()

foreach(sz "1440x900;1" "1280x800;1" "2880x1800;2" "2560x1600;2")
  list(GET sz 0 size)
  list(GET sz 1 scale)
  foreach(L studio live logic tracker)
    set(tag "${L}_${size}_${scale}")
    set(cfg "${OUT}/cfg_${tag}")
    file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true}}\n")
    file(WRITE "${cfg}/input.txt" "${script}")
    set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
    set(ENV{HOME} "${cfg}/home")
    configure_file("${DEMO}" "${cfg}/song.gridline.json" COPYONLY)
    set(tsv "${OUT}/${tag}.tsv")
    execute_process(COMMAND "${APP}" "${cfg}/song.gridline.json" --hidden --no-ui-sounds --size ${size} --ui-scale ${scale} --layout ${L}
                            --dev-input "${cfg}/input.txt" --fixed-dt 16 --frames 40 --align-audit "${tsv}" --screenshot "${OUT}/${tag}.ppm"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
    if(NOT EXISTS "${tsv}")
      fail("${tag}: no audit (${rc})")
      continue()
    endif()
    file(STRINGS "${tsv}" rows)
    # The texts the windows report cut themselves (their own scrolling edges).
    set(ownCuts "")
    set(overlaps 0)
    set(listed "")
    foreach(r IN LISTS rows)
      if(r MATCHES "^([^\t]*)\tclip\t[^\t]*\t[^\t]*\ttext '(.*)' is cut off")
        set(w "${CMAKE_MATCH_1}")
        set(t "${CMAKE_MATCH_2}")
        if(NOT w STREQUAL "##dockhost")
          list(APPEND ownCuts "${t}")
          string(APPEND listed " [${w}: ${t}]")
        endif()
      elseif(r MATCHES "^([^\t]*)\toverlap\t")
        set(w "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "###.*$" "" w "${w}")
        math(EXPR overlaps "${overlaps} + 1")
        list(FIND parts "${w}" isPart)
        if(NOT isPart EQUAL -1)
          fail("${tag}: overlapping text in the ${w} panel: ${r}")
        endif()
      endif()
    endforeach()
    foreach(r IN LISTS rows)
      if(r MATCHES "^##dockhost\tclip\t[^\t]*\t[^\t]*\ttext '(.*)' is cut off")
        list(FIND ownCuts "${CMAKE_MATCH_1}" own)
        if(own EQUAL -1)
          fail("${tag}: the docking chrome cuts '${CMAKE_MATCH_1}' (${tsv})")
        endif()
      endif()
    endforeach()
    if(L STREQUAL "studio")
      set(studioOverlaps ${overlaps})
    elseif(overlaps GREATER studioOverlaps)
      fail("${tag}: ${overlaps} overlapping texts, ${studioOverlaps} in Studio at this size (${tsv})")
    endif()
    message(STATUS "${tag}: ${overlaps} overlapping; cut by their own scrolling edge:${listed}")
  endforeach()
endforeach()
if(failures GREATER 0)
  message(FATAL_ERROR "${failures} failure(s)")
endif()
message(STATUS "ok - no overlapping text and no cut chrome in any layout or size")
