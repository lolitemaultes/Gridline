# Gridline: crash reports in the real app, hidden, with its config and HOME in the test's folder.
# Each failure is forced with GRIDLINE_CRASH_TEST_FORCE (a --hidden run only) and judged by the report
# the handler wrote: never with a debugger.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DONLY=<kind>] -P k39_crash_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")

function(run tag)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --size 800x600
                          --screenshot "${OUT}/${tag}.ppm" --frames ${FRAMES} ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "rc ${rc}\n${out}\n${err}")
  set(rc "${rc}" PARENT_SCOPE)
endfunction()

function(the_report tag kind outVar)
  file(GLOB files "${OUT}/cfg_${tag}/gridline/crash-reports/${kind}-*.txt")
  list(LENGTH files n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "${tag}: ${n} ${kind} reports (rc ${rc}): ${files}")
  endif()
  file(READ "${files}" text)
  set(${outVar} "${text}" PARENT_SCOPE)
endfunction()

function(must text what)
  if(NOT text MATCHES "${what}")
    message(FATAL_ERROR "${CURRENT}: the report lacks /${what}/:\n${text}")
  endif()
endfunction()

# What every report must say, and must not.
function(common text)
  foreach(field "GRIDLINE CRASH CODE 1" "\nid: GL-[0-9A-F]+\n" "\nversion: [0-9]" "\nbuild: " "\nos: " "\narch: " "\ngpu: " "\nstack:\n  0 "
                "recent actions:\n" "END GRIDLINE CRASH CODE")
    must("${text}" "${field}")
  endforeach()
  # The folders of this test (and so anyone's home) never get into a code.
  string(FIND "${text}" "${OUT}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "${CURRENT}: a path got into the report:\n${text}")
  endif()
  foreach(word "/Users/" "/home/" "Secret Songs" "song.gridline.json")
    string(FIND "${text}" "${word}" at)
    if(NOT at EQUAL -1)
      message(FATAL_ERROR "${CURRENT}: \"${word}\" in the report:\n${text}")
    endif()
  endforeach()
endfunction()

# Each fatal kind: the expected cause and which thread.
set(FRAMES 400)
set(kinds "segv|SIGSEGV|thread: ui" "bus|SIGBUS|thread: ui" "ill|SIG(ILL|TRAP)|thread: ui" "fpe|SIGFPE|thread: ui" "abort|SIGABRT|thread: ui"
          "heap|SIGABRT|thread: ui" "overflow|SIG(SEGV|BUS)|stack overflow" "thread|SIGSEGV|thread: worker" "audio|SIGSEGV|thread: audio"
          "terminate|SIGABRT|uncaught exception")
foreach(entry IN LISTS kinds)
  string(REPLACE "|" ";" parts "${entry}")
  # (the middle alternatives come back as a list too: first and last pieces are the kind and the line)
  list(GET parts 0 kind)
  if(DEFINED ONLY AND NOT ONLY STREQUAL kind)
    continue()
  endif()
  set(CURRENT "${kind}")
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "${kind}")
  run("${kind}")
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
  if(rc EQUAL 0)
    message(FATAL_ERROR "${kind}: the run did not crash")
  endif()
  the_report("${kind}" crash text)
  common("${text}")
  must("${text}" "\nkind: crash\n")
  list(LENGTH parts np)
  math(EXPR last "${np}-1")
  list(GET parts ${last} line)
  must("${text}" "${line}")
  if(kind STREQUAL "segv")
    must("${text}" "cause: SIGSEGV \\(11\\) code [0-9]+ address 0x8")
    must("${text}" "\n  [0-9]+ gridline-app\\+0x")   # module + offset
    must("${text}" "\n  gridline-app id [0-9a-f]+\n")
    must("${text}" "project open")                   # recent actions
  endif()
  if(kind STREQUAL "terminate")
    must("${text}" "<path>")                         # the message's path is gone, its text stays
    must("${text}" "forced uncaught failure")
  endif()
  message(STATUS "${kind}: report ok")
endforeach()

# A caught exception in a frame: reported, the pop-up shows, the run goes on and ends well.
if(NOT DEFINED ONLY OR ONLY STREQUAL "exception")
  set(CURRENT exception)
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "exception")
  set(FRAMES 30)
  run(exception)
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exception: the run did not go on (rc ${rc})")
  endif()
  the_report(exception exception text)
  common("${text}")
  must("${text}" "\ndoing: Drawing the interface\n")
  must("${text}" "\nmessage: forced failure in <path>: test\n")
  if(NOT EXISTS "${OUT}/exception.ppm")
    message(FATAL_ERROR "exception: no frame after the failure")
  endif()
  # And it is not offered again at the next start.
  file(GLOB seen "${OUT}/cfg_exception/gridline/crash-reports/exception-*.txt.seen")
  if(NOT seen)
    message(FATAL_ERROR "exception: the report is still pending")
  endif()
  message(STATUS "exception: goes on, report ok")

  # The same failure in every frame: the pop-up alone, the project still in memory.
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "exception-always")
  run(always)
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
  if(NOT rc EQUAL 0 OR NOT EXISTS "${OUT}/always.ppm")
    message(FATAL_ERROR "exception-always: rc ${rc}, no picture of the pop-up")
  endif()
  message(STATUS "exception-always: pop-up alone")
endif()

# A frozen interface: the report comes within the time, with the UI thread's stack.
if(NOT DEFINED ONLY OR ONLY STREQUAL "freeze")
  set(CURRENT freeze)
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "stall:9")
  set(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS} "3")
  set(FRAMES 30)
  run(freeze)
  # It came back after nine seconds: no report stays behind.
  file(GLOB left "${OUT}/cfg_freeze/gridline/crash-reports/freeze-*.txt")
  if(left)
    message(FATAL_ERROR "freeze: a report stayed behind after the interface came back")
  endif()
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "freeze: rc ${rc}")
  endif()
  message(STATUS "freeze: gone when it comes back")

  # It does not come back: killed from outside after the report. The script needs the report while
  # the app sits frozen, so a background watcher ends it.
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "freeze")
  file(REMOVE_RECURSE "${OUT}/cfg_hang")
  file(MAKE_DIRECTORY "${OUT}/cfg_hang")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_hang")
  set(ENV{HOME} "${OUT}/cfg_hang")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --size 800x600 --screenshot "${OUT}/hang.ppm" --frames 400
                  RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET TIMEOUT 14)
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
  unset(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS})
  set(rc "${rc}")
  the_report(hang freeze text)
  set(CURRENT hang)
  common("${text}")
  must("${text}" "\nkind: freeze\n")
  must("${text}" "gridline-app\\+0x")
  message(STATUS "freeze: report with the UI stack")
endif()

# ---- recovery ----
function(recovery_file tag outVar)
  file(GLOB files "${OUT}/cfg_${tag}/gridline/recovery/*.gridline")  # K-121: the new name
  list(LENGTH files n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "${tag}: ${n} recovery copies: ${files}")
  endif()
  set(${outVar} "${files}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ONLY OR ONLY STREQUAL "recovery")
  set(CURRENT rescue)
  # A fresh copy from the crash path: the change made a moment before the crash is in it.
  set(ENV{GRIDLINE_CRASH_TEST_DIRTY} "1")
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "segv@60")
  set(FRAMES 400)
  run(rescue)
  if(rc EQUAL 0)
    message(FATAL_ERROR "rescue: no crash")
  endif()
  recovery_file(rescue copy)
  file(READ "${copy}" song)
  must("${song}" "k39-unsaved-marker")
  file(GLOB mark "${OUT}/cfg_rescue/gridline/recovery/*.rescued")
  if(NOT mark)
    message(FATAL_ERROR "rescue: not marked as saved at the crash")
  endif()
  the_report(rescue crash report)
  must("${report}" "unsaved work: yes")
  message(STATUS "rescue: the crash path saved the last change")

  # The periodic copy alone (what stays when the crash path cannot save, as on Windows).
  set(ENV{GRIDLINE_CRASH_TEST_NO_RESCUE} "1")
  set(ENV{GRIDLINE_CRASH_TEST_COPY_SECONDS} "1")
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "segv@300")
  run(periodic)
  unset(ENV{GRIDLINE_CRASH_TEST_NO_RESCUE})
  unset(ENV{GRIDLINE_CRASH_TEST_COPY_SECONDS})
  recovery_file(periodic copy)
  file(READ "${copy}" song)
  must("${song}" "k39-unsaved-marker")
  file(GLOB mark "${OUT}/cfg_periodic/gridline/recovery/*.rescued")
  if(mark)
    message(FATAL_ERROR "periodic: marked as rescued")
  endif()
  file(GLOB meta "${OUT}/cfg_periodic/gridline/recovery/*.meta")
  file(READ "${meta}" metaText)
  must("${metaText}" "saved=[1-9]")
  must("${metaText}" "song.gridline.json")   # the project's real home, kept locally only
  the_report(periodic crash report)
  string(FIND "${report}" "song.gridline.json" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "periodic: the project's name in the code")
  endif()
  message(STATUS "periodic: the copy is there, without the crash path")
  unset(ENV{GRIDLINE_CRASH_TEST_DIRTY})
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})

  # The next start finds the report and offers the copy.
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_rescue")
  set(ENV{HOME} "${OUT}/cfg_rescue")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --size 800x600 --screenshot "${OUT}/nextstart.ppm" --frames 20
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "next start: rc ${rc}: ${e}")
  endif()
  must("${e}" "crash report shown: crash GL-")
  message(STATUS "next start: pop-up offered")

  # Restart with the copy: the project is the copy's, and the change is there.
  file(GLOB reportFile "${OUT}/cfg_rescue/gridline/crash-reports/crash-*.txt")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --size 800x600 --crash-recover "${reportFile}" --screenshot "${OUT}/recovered.ppm" --frames 40
                          --save-at-exit "${OUT}/recovered.gridline.json"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "recover: rc ${rc}: ${e}")
  endif()
  file(READ "${OUT}/recovered.gridline.json" song)
  must("${song}" "k39-unsaved-marker")
  file(GLOB seen "${OUT}/cfg_rescue/gridline/crash-reports/crash-*.txt.seen")
  if(NOT seen)
    message(FATAL_ERROR "recover: the report is still offered")
  endif()
  # A later start has nothing more to say.
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --size 800x600 --screenshot "${OUT}/after.ppm" --frames 10
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e TIMEOUT 120)
  string(FIND "${e}" "crash report shown" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "after recovery: offered again")
  endif()
  message(STATUS "recover: the change is back, offered once")

  # A clean end leaves nothing: no report, no session, no copy.
  set(ENV{GRIDLINE_CRASH_TEST_DIRTY} "1")
  set(ENV{GRIDLINE_CRASH_TEST_COPY_SECONDS} "1")
  set(FRAMES 150)
  run(clean)
  unset(ENV{GRIDLINE_CRASH_TEST_DIRTY})
  unset(ENV{GRIDLINE_CRASH_TEST_COPY_SECONDS})
  file(GLOB leftovers "${OUT}/cfg_clean/gridline/crash-reports/*.txt" "${OUT}/cfg_clean/gridline/recovery/*.gridline" "${OUT}/cfg_clean/gridline/recovery/*.gridline.json")
  if(leftovers)
    message(FATAL_ERROR "clean end: left behind: ${leftovers}")
  endif()
  message(STATUS "clean end: nothing left")
endif()

# ---- the separate process (not on a --hidden run unless a test asks) ----
if(NOT DEFINED ONLY OR ONLY STREQUAL "sentinel")
  set(CURRENT sentinel)
  function(wait_for path)
    foreach(i RANGE 60)
      if(EXISTS "${path}")
        return()
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.5)
    endforeach()
    message(FATAL_ERROR "${CURRENT}: no ${path}")
  endfunction()

  # After a crash the pop-up process runs by itself.
  file(MAKE_DIRECTORY "${OUT}/sent_crash")
  set(ENV{GRIDLINE_CRASH_TEST_SENTINEL} "${OUT}/sent_crash")
  set(ENV{GRIDLINE_CRASH_TEST_DIRTY} "1")
  set(ENV{GRIDLINE_CRASH_TEST_FORCE} "segv@60")
  set(FRAMES 400)
  run(sent)
  unset(ENV{GRIDLINE_CRASH_TEST_DIRTY})
  unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
  wait_for("${OUT}/sent_crash/dialog.ppm")
  message(STATUS "crash: the pop-up process ran")

  if(UNIX)
    # Killed outright, no chance to report anything: the sentinel still knows and writes what it can.
    file(MAKE_DIRECTORY "${OUT}/sent_kill")
    file(MAKE_DIRECTORY "${OUT}/cfg_killed")
    set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_killed")
    set(ENV{HOME} "${OUT}/cfg_killed")
    set(ENV{GRIDLINE_CRASH_TEST_SENTINEL} "${OUT}/sent_kill")
    file(WRITE "${OUT}/kill.sh" "\"$1\" \"$2\" --hidden --no-ui-sounds --size 800x600 --screenshot \"$3\" --frames 100000 &\npid=$!\nsleep 5\nkill -9 $pid\nwait $pid\nexit 0\n")
    execute_process(COMMAND sh "${OUT}/kill.sh" "${APP}" "${OUT}/song.gridline.json" "${OUT}/killed.ppm" OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
    wait_for("${OUT}/sent_kill/dialog.ppm")
    file(GLOB ended "${OUT}/cfg_killed/gridline/crash-reports/ended-*.txt")
    if(NOT ended)
      message(FATAL_ERROR "killed: no report from the sentinel")
    endif()
    file(READ "${ended}" text)
    must("${text}" "kind: ended")
    must("${text}" "project open")
    message(STATUS "killed: the sentinel wrote the report and started the pop-up")

    # Frozen: the pop-up shows beside the frozen window; when the interface comes back, it closes
    # by itself (its own --frames picture is the proof that it ran) and no report stays.
    file(MAKE_DIRECTORY "${OUT}/sent_freeze")
    set(ENV{GRIDLINE_CRASH_TEST_SENTINEL} "${OUT}/sent_freeze")
    set(ENV{GRIDLINE_CRASH_TEST_FORCE} "stall:10")
    set(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS} "2")
    set(FRAMES 60)
    run(sentfreeze)
    unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
    unset(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS})
    wait_for("${OUT}/sent_freeze/dialog.ppm")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "frozen: the app did not go on (rc ${rc})")
    endif()
    file(GLOB left "${OUT}/cfg_sentfreeze/gridline/crash-reports/freeze-*.txt")
    if(left)
      message(FATAL_ERROR "frozen: a report stayed behind")
    endif()
    message(STATUS "frozen: the pop-up ran, the app came back, nothing stayed")
  endif()
  unset(ENV{GRIDLINE_CRASH_TEST_SENTINEL})
endif()

# ---- no false alarm in the app: a slow project load keeps the interface drawing ----
if(NOT DEFINED ONLY OR ONLY STREQUAL "falsealarm")
  set(CURRENT falsealarm)
  set(ENV{GRIDLINE_DEV_SLOW_LOAD_MS} "6000")
  set(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS} "2")
  set(FRAMES 30)
  # Opened from the list of files on the command line, so it loads with the interface running.
  file(MAKE_DIRECTORY "${OUT}/cfg_slow")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_slow")
  set(ENV{HOME} "${OUT}/cfg_slow")
  file(WRITE "${OUT}/slow.txt" "1 waitfor project-loaded 30\n")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --size 800x600 --screenshot "${OUT}/slow.ppm" --frames 200
                          --dev-input "${OUT}/slow.txt"
                  RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET TIMEOUT 120)
  unset(ENV{GRIDLINE_DEV_SLOW_LOAD_MS})
  unset(ENV{GRIDLINE_CRASH_TEST_FREEZE_SECONDS})
  file(GLOB left "${OUT}/cfg_slow/gridline/crash-reports/*.txt")
  if(left)
    message(FATAL_ERROR "slow work: a false alarm: ${left}")
  endif()
  message(STATUS "a long stretch of frames: no alarm")
endif()
