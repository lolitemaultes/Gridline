# Gridline - K-112: panels open where the layout homes them.
#   * Logic: the Device chain and Track scopes float over the tracks (inside the centre region,
#     below its toolbar), not docked, side by side (neither covers the other); the Info box is the
#     Quick help panel docked under the right pane (logic.help), not in the status bar.
#   * Live: Track scopes float over the playlist (inside the centre region), not docked; when Lists
#     opens afterwards (the side region takes room from the centre) they move in again and do not
#     cover Lists.
#   * Tracker: the Info box has no window and shows in the status bar.
#   cmake -DAPP=<gridline-app> -DDEMO=<song> -DOUT=<dir> -P k112_homes_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(failures 0)
macro(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR failures "${failures} + 1")
endmacro()

function(run tag layout script)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true}}\n")
  file(WRITE "${cfg}/input.txt" "${script}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  configure_file("${DEMO}" "${OUT}/${tag}.gridline.json" COPYONLY)
  execute_process(COMMAND "${APP}" "${OUT}/${tag}.gridline.json" --hidden --no-ui-sounds --size 1440x900 --fixed-dt 16
                          --dev-input "${cfg}/input.txt" --switch-layout ${layout}@3 --frames 60 --screenshot "${OUT}/${tag}.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(SEND_ERROR "FAIL: ${tag}: gridline-app failed (${rc})")
  endif()
  set(log "${out}" PARENT_SCOPE)
endfunction()

# A floating window inside the centre region.
function(floats tag name)
  if(NOT log MATCHES "frame [0-9]+ where ${name} layout [a-z]+ drawn ([01]) docked ([01]) region [^ ]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    fail("${tag}: no where line for ${name}")
    set(failures ${failures} PARENT_SCOPE)
    return()
  endif()
  set(drawn ${CMAKE_MATCH_1})
  set(docked ${CMAKE_MATCH_2})
  set(x ${CMAKE_MATCH_3})
  set(y ${CMAKE_MATCH_4})
  set(w ${CMAKE_MATCH_5})
  set(h ${CMAKE_MATCH_6})
  if(NOT log MATCHES "frame [0-9]+ whereextra ${name} centre (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) inbar")
    fail("${tag}: no centre for ${name}")
    set(failures ${failures} PARENT_SCOPE)
    return()
  endif()
  set(cx ${CMAKE_MATCH_1})
  set(cy ${CMAKE_MATCH_2})
  math(EXPR cr "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  math(EXPR cb "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  math(EXPR r "${x} + ${w}")
  math(EXPR b "${y} + ${h}")
  math(EXPR below "${cy} + 40")  # the centre's tab row and toolbar stay clear
  if(NOT drawn EQUAL 1 OR NOT docked EQUAL 0)
    fail("${tag}: ${name} is not a floating window (drawn ${drawn} docked ${docked})")
  elseif(x LESS cx OR r GREATER cr OR y LESS below OR b GREATER cb)
    fail("${tag}: ${name} at ${x} ${y} ${w}x${h} is not over the centre region (${cx} ${cy} to ${cr} ${cb}, below ${below})")
  else()
    message(STATUS "ok - ${tag}: ${name} floats over the centre (${x} ${y} ${w}x${h})")
  endif()
  set(rect_${tag} ${rect_${tag}} "${name}:${x}:${y}:${r}:${b}" PARENT_SCOPE)
  set(failures ${failures} PARENT_SCOPE)
endfunction()

# The last where line of a window, as "x y right bottom" (docked windows too).
function(rectOf name var)
  string(REGEX MATCHALL "frame [0-9]+ where ${name} layout [a-z]+ drawn 1 docked [01] region [^ ]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)" all "${log}")
  list(LENGTH all n)
  if(n EQUAL 0)
    set(${var} "" PARENT_SCOPE)
    return()
  endif()
  math(EXPR last "${n} - 1")
  list(GET all ${last} line)
  string(REGEX MATCH "rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)" _ "${line}")
  math(EXPR r "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  math(EXPR b "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  set(${var} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${r};${b}" PARENT_SCOPE)
endfunction()

# Two rects ("x;y;right;bottom") must not overlap.
function(apart tag a an b bn)
  list(GET a 0 ax)
  list(GET a 1 ay)
  list(GET a 2 ar)
  list(GET a 3 ab)
  list(GET b 0 bx)
  list(GET b 1 by)
  list(GET b 2 br)
  list(GET b 3 bb)
  if(ax LESS br AND bx LESS ar AND ay LESS bb AND by LESS ab)
    fail("${tag}: ${an} (${a}) and ${bn} (${b}) overlap")
  else()
    message(STATUS "ok - ${tag}: ${an} and ${bn} do not overlap")
  endif()
  set(failures ${failures} PARENT_SCOPE)
endfunction()

function(inbar tag)
  if(NOT log MATCHES "frame [0-9]+ where Info box layout [a-z]+ drawn ([01]) ")
    fail("${tag}: no where line for the Info box")
  elseif(NOT CMAKE_MATCH_1 EQUAL 0)
    fail("${tag}: the Info box opened a window (its home is the status bar)")
  elseif(NOT log MATCHES "whereextra Info box centre [^\n]* inbar 1")
    fail("${tag}: the Info box is not in the status bar")
  else()
    message(STATUS "ok - ${tag}: the Info box shows in the status bar")
  endif()
  set(failures ${failures} PARENT_SCOPE)
endfunction()

function(inhelp tag)
  if(NOT log MATCHES "frame [0-9]+ where Info box layout [a-z]+ drawn 1 docked 1 region logic.help ")
    fail("${tag}: the Info box is not docked in the Quick help region")
  elseif(NOT log MATCHES "whereextra Info box centre [^\n]* inbar 0")
    fail("${tag}: the Info box also shows in the status bar")
  else()
    message(STATUS "ok - ${tag}: the Info box is the Quick help panel")
  endif()
  set(failures ${failures} PARENT_SCOPE)
endfunction()

set(script "8 layout open Device chain\n9 layout open Track scopes\n10 layout open Info box\n30 layout where Device chain\n30 layout where Track scopes\n31 layout where Info box\n")
run(logic logic "${script}")
floats(logic "Device chain")
floats(logic "Track scopes")
inhelp(logic)
rectOf("Device chain" dc)
rectOf("Track scopes" ts)
if(dc AND ts)
  apart(logic "${dc}" "Device chain" "${ts}" "Track scopes")
else()
  fail("logic: no rects for the floating parts")
endif()

run(live live "8 layout open Track scopes\n20 layout open Lists\n40 layout where Track scopes\n40 layout where Lists\n")
# The centre after Lists opened: the last where line's centre.
string(REGEX MATCHALL "whereextra Track scopes centre [^\n]*" ex "${log}")
floats(live "Track scopes")
rectOf("Track scopes" ts)
rectOf("Lists" li)
if(ts AND li)
  apart(live "${ts}" "Track scopes" "${li}" "Lists")
else()
  fail("live: no rects for Track scopes and Lists")
endif()

# The rect of a window at one frame, as "x;y;w;h".
function(rectAt name frame var)
  if(log MATCHES "frame ${frame} where ${name} layout [a-z]+ drawn 1 docked 0 region [^ ]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    set(${var} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Working a control inside a floating part (Track scopes' scroll bar dragged) does not count as
# moving the part: it stays put while dragged and still follows the tiling afterwards (the Device
# chain closes, Track scopes takes the right-hand slot it had). The editors pane is shown first (closed
# by default since K-112B checkpoint 40) so the parts tile where these coordinates expect.
run(logicdrag logic "5 layout show logic.lower\n8 layout open Device chain\n9 layout open Track scopes\n20 layout where Device chain\n20 layout where Track scopes\n22 move 300 541\n23 down 0\n24 move 290 541\n25 move 280 541\n26 move 270 541\n27 move 260 541\n28 up 0\n31 layout where Track scopes\n33 layout close Device chain\n45 layout where Track scopes\n")
rectAt("Device chain" 20 dc0)
rectAt("Track scopes" 20 ts0)
rectAt("Track scopes" 31 ts1)
rectAt("Track scopes" 45 ts2)
if(NOT dc0 OR NOT ts0 OR NOT ts1 OR NOT ts2)
  fail("logicdrag: missing where lines (${dc0} | ${ts0} | ${ts1} | ${ts2})")
else()
  if(NOT ts1 STREQUAL ts0)
    fail("logicdrag: dragging a control moved Track scopes (${ts0} -> ${ts1})")
  else()
    message(STATUS "ok - logicdrag: a control dragged inside Track scopes leaves it in place")
  endif()
  list(GET dc0 0 dx)
  list(GET dc0 2 dw)
  list(GET ts2 0 tx)
  list(GET ts2 2 tw)
  math(EXPR dr "${dx} + ${dw}")
  math(EXPR tr "${tx} + ${tw}")
  math(EXPR diff "${dr} - ${tr}")
  if(diff GREATER 1 OR diff LESS -1)
    fail("logicdrag: Track scopes stopped following the tiling after a control was dragged (right edge ${tr}, slot ${dr})")
  else()
    message(STATUS "ok - logicdrag: Track scopes still tiles (right edge ${tr})")
  endif()
endif()

# Moving a part by its title bar does count: it stays where it was put when the others retile.
# The press lands on the Device chain's title bar where the drag run above found it (the same
# panels open in the same order), so the check follows the layout's proportions.
set(gx 700)
set(gy 304)
if(dc0)
  list(GET dc0 0 gx)
  list(GET dc0 1 gy)
  math(EXPR gx "${gx} + 127")
  math(EXPR gy "${gy} + 12")
endif()
set(mv "")
foreach(k 1 2 3 4)
  math(EXPR f "23 + ${k}")
  math(EXPR mx "${gx} - 10 * ${k}")
  math(EXPR my "${gy} - 5 * ${k}")
  string(APPEND mv "${f} move ${mx} ${my}\n")
endforeach()
run(logicmove logic "5 layout show logic.lower\n8 layout open Device chain\n9 layout open Track scopes\n20 layout where Device chain\n22 move ${gx} ${gy}\n23 down 0\n${mv}28 up 0\n33 layout close Track scopes\n45 layout where Device chain\n")
rectAt("Device chain" 20 m0)
rectAt("Device chain" 45 m1)
if(NOT m0 OR NOT m1)
  fail("logicmove: missing where lines (${m0} | ${m1})")
else()
  list(GET m0 0 x0)
  list(GET m0 1 y0)
  list(GET m1 0 x1)
  list(GET m1 1 y1)
  math(EXPR ex "${x0} - 40")
  math(EXPR ey "${y0} - 20")
  if(NOT x1 EQUAL ex OR NOT y1 EQUAL ey)
    fail("logicmove: the moved Device chain did not stay where it was put (${m0} -> ${m1}, expected ${ex} ${ey})")
  else()
    message(STATUS "ok - logicmove: the moved Device chain stays where it was put")
  endif()
endif()

run(tracker tracker "10 layout open Info box\n31 layout where Info box\n")
inbar(tracker)

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} failure(s)")
endif()
message(STATUS "ok - the Bar and Float homes are met")
