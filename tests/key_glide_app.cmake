# Gridline: every on-screen keyboard of the built-in editors and the channel window follows the mouse.
# With the button held, a drag across the keys plays one key at a time, the key under the pointer (the
# key left behind stops before the next one starts), and the release stops it. No key is left
# sounding when Escape is pressed, the pointer leaves the window, the app loses the focus or the
# editor is closed while a key is held.
#
# Runs the app hidden (isolated config and HOME, fixed frame time, dummy audio) with each editor open
# on a new channel. The app reports each keyboard it drew (`keybeds`): its rectangle, the key it sounds
# and eight points to drag through (8 white keys of a piano, or 8 neighbouring keys of a strip), plus
# the log of the notes the keyboards started and stopped. Every check: the keyboard sounds the key
# under the pointer and at most one live note is held; after each release nothing sounds; the log
# alternates on, off of the same key, on of the next.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P key_glide_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(run tag type size script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size ${size} --plugin ${type} --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

set(checked 0)
# editor type | keyboard name in the keybeds report | set-up command ("-": none) | window size
foreach(entry "gl.matrixfm|iskin|-|1600x1100" "gl.twinva|iskin|-|1600x1100" "gl.fmduo|fmduo|-|1600x1100" "gl.warmsynth|warmsynth|-|1600x1100"
              "gl.slicer|kerf|-|1600x1100" "gl.tracker|tracker|scroll|1600x1100" "gl.multisampler|multisampler|-|1600x1100"
              "gl.scratch|scratch|-|1600x1100" "gl.hat|chstrip|strip on|1600x1100")
  string(REPLACE "|" ";" f "${entry}")
  list(GET f 0 type)
  list(GET f 1 bed)
  list(GET f 2 setup)
  list(GET f 3 size)
  set(pre "")
  if(NOT setup STREQUAL "-" AND NOT setup STREQUAL "scroll")
    set(pre "10 ${setup}\n")
  endif()
  string(REPLACE "." "_" tag "${type}")
  set(tag "${tag}_${bed}")
  if(setup STREQUAL "scroll")  # a keyboard at the foot of a tall editor: the wheel over the editor brings it into view
    run(${tag}_where ${type} ${size} "20 keybeds\n22 quit discard\n")
    if(NOT ${tag}_where_out MATCHES "keybed ${bed} x0 ([-0-9]+)[.0-9]* y0 ([-0-9]+)[.0-9]* x1 ([-0-9]+)")
      message(FATAL_ERROR "FAIL: ${type}: no ${bed} keyboard drawn\n${${tag}_where_out}")
    endif()
    math(EXPR cx "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
    math(EXPR cy "${CMAKE_MATCH_2} - 450")
    set(pre "6 move ${cx} ${cy}\n8 wheel -30\n10 wheel -30\n")
  endif()
  run(${tag}_geo ${type} ${size} "${pre}60 keybeds\n62 quit discard\n")
  if(NOT ${tag}_geo_out MATCHES "keybed ${bed} [^\n]* held -1 probes ([-0-9: ]+)")
    message(FATAL_ERROR "FAIL: ${type}: no ${bed} keyboard drawn\n${${tag}_geo_out}")
  endif()
  string(STRIP "${CMAKE_MATCH_1}" probes)
  string(REPLACE " " ";" probes "${probes}")
  set(notes "")
  set(xs "")
  set(ys "")
  foreach(pr IN LISTS probes)
    string(REPLACE ":" ";" q "${pr}")
    list(GET q 0 n)
    list(GET q 1 x)
    list(GET q 2 y)
    list(APPEND notes ${n})
    list(APPEND xs ${x})
    list(APPEND ys ${y})
  endforeach()
  # The script: each step is a pointer or button action, then a check two frames later.
  set(script "${pre}")
  set(frame 60)  # (a scrolled editor glides to its place first)
  set(wants "")  # per check: the key the keyboard must sound (-1: none), "closed" / "gone": its editor closed / no longer drawn
  set(ons "")    # the keys the log must start, in order
  macro(step cmd want)
    math(EXPR frame "${frame} + 2")
    string(APPEND script "${frame} ${cmd}\n")
    math(EXPR frame "${frame} + 2")
    string(APPEND script "${frame} keybeds\n")
    list(APPEND wants ${want})
  endmacro()
  macro(at i)
    list(GET xs ${i} px)
    list(GET ys ${i} py)
    list(GET notes ${i} pn)
    math(EXPR frame "${frame} + 2")
    string(APPEND script "${frame} move ${px} ${py}\n")
  endmacro()
  # 1. a drag across eight keys, then the release
  at(0)
  step("down 0" ${pn})
  list(APPEND ons ${pn})
  foreach(i RANGE 1 7)
    list(GET xs ${i} px)
    list(GET ys ${i} py)
    list(GET notes ${i} pn)
    step("move ${px} ${py}" ${pn})
    list(APPEND ons ${pn})
  endforeach()
  step("up 0" -1)
  # 2. Escape while a key is held: silent, and it stays silent over the next key until the release
  at(0)
  step("down 0" ${pn})
  list(APPEND ons ${pn})
  step("key escape" -1)
  list(GET xs 1 px)
  list(GET ys 1 py)
  step("move ${px} ${py}" -1)
  step("up 0" -1)
  # 3. the pointer leaves the window: silent; back over a key, that key plays
  at(2)
  step("down 0" ${pn})
  list(APPEND ons ${pn})
  step("move -5000 -5000" -1)
  list(GET xs 3 px)
  list(GET ys 3 py)
  list(GET notes 3 pn)
  step("move ${px} ${py}" ${pn})
  list(APPEND ons ${pn})
  step("up 0" -1)
  # 4. the app loses the focus while a key is held
  at(4)
  step("down 0" ${pn})
  list(APPEND ons ${pn})
  step("focuslost" -1)
  step("up 0" -1)
  # 5. the editor is closed while a key is held
  at(5)
  step("down 0" ${pn})
  list(APPEND ons ${pn})
  step("closeplugins" closed)
  step("up 0" gone)
  math(EXPR fq "${frame} + 4")
  string(APPEND script "${fq} quit discard\n")
  run(${tag}_drag ${type} ${size} "${script}")
  set(out "${${tag}_drag_out}")
  string(REGEX MATCHALL "keybeds frame [0-9]+ live [0-9]+\n(keybed [^\n]*\n)*glidelog[^\n]*" reports "${out}")
  list(LENGTH reports n)
  list(LENGTH wants nw)
  if(NOT n EQUAL nw)
    message(FATAL_ERROR "FAIL: ${type}: want ${nw} checks, got ${n}\n${out}")
  endif()
  set(k 0)
  foreach(rep IN LISTS reports)
    list(GET wants ${k} want)
    string(REGEX MATCH "live ([0-9]+)" _ "${rep}")
    set(live ${CMAKE_MATCH_1})
    if(live GREATER 1)
      message(FATAL_ERROR "FAIL: ${type}: check ${k}: ${live} notes held at once (the key left behind must stop)\n${out}")
    endif()
    if(want STREQUAL "closed")  # (the report still lists a keyboard drawn on the last two frames)
      if(NOT live EQUAL 0)
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: the editor closed with a key held, ${live} notes still sound\n${out}")
      endif()
    elseif(want STREQUAL "gone")
      if(rep MATCHES "keybed ${bed} ")
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: the editor was closed, its keyboard is still drawn\n${out}")
      endif()
      if(NOT live EQUAL 0)
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: the editor closed with a key held, ${live} notes still sound\n${out}")
      endif()
    else()
      if(NOT rep MATCHES "keybed ${bed} [^\n]* held (-?[0-9]+) probes")
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: no ${bed} keyboard drawn\n${out}")
      endif()
      set(held ${CMAKE_MATCH_1})
      if(NOT held EQUAL want)
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: the keyboard sounds ${held}, want ${want}\n${out}")
      endif()
      if(want EQUAL -1 AND NOT live EQUAL 0)
        message(FATAL_ERROR "FAIL: ${type}: check ${k}: nothing should sound, ${live} notes held\n${out}")
      endif()
    endif()
    math(EXPR k "${k} + 1")
  endforeach()
  # The log: on, then off of that key before the next on; it ends silent.
  list(GET reports -1 last)
  string(REGEX MATCH "glidelog([^\n]*)" _ "${last}")
  string(STRIP "${CMAKE_MATCH_1}" evs)
  string(REPLACE " " ";" evs "${evs}")
  set(expectOn TRUE)
  set(prev "")
  set(seen "")
  foreach(ev IN LISTS evs)
    string(REPLACE ":" ";" q "${ev}")
    list(GET q 0 kind)
    list(GET q 1 note)
    if(expectOn)
      if(NOT kind STREQUAL "on")
        message(FATAL_ERROR "FAIL: ${type}: the log stops ${note} with no key sounding: ${evs}")
      endif()
      list(APPEND seen ${note})
      set(prev ${note})
      set(expectOn FALSE)
    else()
      if(NOT kind STREQUAL "off" OR NOT note EQUAL prev)
        message(FATAL_ERROR "FAIL: ${type}: ${ev} while ${prev} still sounds (one key at a time): ${evs}")
      endif()
      set(expectOn TRUE)
    endif()
  endforeach()
  if(NOT expectOn)
    message(FATAL_ERROR "FAIL: ${type}: the log ends with ${prev} sounding: ${evs}")
  endif()
  if(NOT "${seen}" STREQUAL "${ons}")
    message(FATAL_ERROR "FAIL: ${type}: keys played ${seen}, want ${ons}")
  endif()
  math(EXPR checked "${checked} + 1")
endforeach()
message(STATUS "ok - ${checked} keyboards play the key under the pointer, one at a time, and leave no key sounding")
