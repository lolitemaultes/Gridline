# Gridline: the on-screen keyboards of the instrument editors follow the mouse. With the button held,
# a drag across the keys plays one key at a time, the key under the pointer (the key left behind stops),
# and the release stops it. Runs the app hidden (isolated config and HOME, fixed frame time, dummy
# audio) with each editor open on a new channel: press a white key, slide right one white key per two
# frames, release; every check, the keyboard sounds the key under the pointer and at most one live note
# is held; after the release nothing sounds.
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P key_glide_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(run tag type script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --size 1600x1100 --plugin ${type} --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

set(wOff 0 2 4 5 7 9 11)
set(checked 0)
# editor type | keyboard name in the keybeds report
foreach(entry "gl.matrixfm|iskin" "gl.twinva|iskin" "gl.fmduo|fmduo" "gl.warmsynth|warmsynth")
  string(REPLACE "|" ";" f "${entry}")
  list(GET f 0 type)
  list(GET f 1 bed)
  string(REPLACE "." "_" tag "${type}")
  run(${tag}_geo ${type} "20 keybeds\n22 quit discard\n")
  if(NOT ${tag}_geo_out MATCHES "keybed ${bed} x0 ([-0-9.]+) y0 ([-0-9.]+) x1 ([-0-9.]+) y1 ([-0-9.]+) lo ([0-9]+) whites ([0-9]+) held -1")
    message(FATAL_ERROR "FAIL: ${type}: no ${bed} keyboard drawn\n${${tag}_geo_out}")
  endif()
  set(raw "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6}")
  set(i 0)
  foreach(m IN LISTS raw)
    math(EXPR i "${i} + 1")
    string(REGEX REPLACE "\\..*" "" v${i} "${m}")
  endforeach()
  set(x0 ${v1})
  set(y0 ${v2})
  set(x1 ${v3})
  set(y1 ${v4})
  set(lo ${v5})
  set(whites ${v6})
  math(EXPR y "${y0} + (${y1} - ${y0}) * 85 / 100")  # the lower part of the keys: white keys only
  # Press white key 2, slide to white key 9, one key per two frames (the move, then the check).
  set(script "")
  set(frame 20)
  set(wants "")
  foreach(wi RANGE 2 9)
    math(EXPR x "${x0} + (${x1} - ${x0}) * (2 * ${wi} + 1) / (2 * ${whites})")
    math(EXPR oct "${wi} / 7")
    math(EXPR deg "${wi} % 7")
    list(GET wOff ${deg} off)
    math(EXPR note "${lo} + 12 * ${oct} + ${off}")
    list(APPEND wants ${note})
    math(EXPR f1 "${frame} + 2")
    math(EXPR f2 "${frame} + 4")
    if(wi EQUAL 2)
      math(EXPR fd "${frame} + 3")
      string(APPEND script "${f1} move ${x} ${y}\n${fd} down 0\n")
      math(EXPR f2 "${frame} + 6")
    else()
      string(APPEND script "${f1} move ${x} ${y}\n")
    endif()
    string(APPEND script "${f2} keybeds\n")
    set(frame ${f2})
  endforeach()
  math(EXPR fu "${frame} + 2")
  math(EXPR fl "${frame} + 6")
  math(EXPR fq "${frame} + 8")
  string(APPEND script "${fu} up 0\n${fl} keybeds\n${fq} quit discard\n")
  run(${tag}_drag ${type} "${script}")
  string(REGEX MATCHALL "keybeds frame [0-9]+ live [0-9]+\nkeybed ${bed} [^\n]* held -?[0-9]+" lines "${${tag}_drag_out}")
  list(LENGTH lines n)
  if(NOT n EQUAL 9)
    message(FATAL_ERROR "FAIL: ${type}: want 9 checks, got ${n}\n${${tag}_drag_out}")
  endif()
  set(k 0)
  foreach(l IN LISTS lines)
    string(REGEX MATCH "live ([0-9]+)\n.* held (-?[0-9]+)" _ "${l}")
    set(live ${CMAKE_MATCH_1})
    set(held ${CMAKE_MATCH_2})
    if(k LESS 8)
      list(GET wants ${k} want)
      if(NOT held EQUAL want)
        message(FATAL_ERROR "FAIL: ${type}: key ${k} of the drag: the keyboard sounds ${held}, the pointer is on ${want}\n${${tag}_drag_out}")
      endif()
      if(live GREATER 1)
        message(FATAL_ERROR "FAIL: ${type}: key ${k}: ${live} notes held at once (the key left behind must stop)\n${${tag}_drag_out}")
      endif()
    elseif(NOT held EQUAL -1 OR NOT live EQUAL 0)
      message(FATAL_ERROR "FAIL: ${type}: after the release nothing sounds (held ${held}, live ${live})\n${${tag}_drag_out}")
    endif()
    math(EXPR k "${k} + 1")
  endforeach()
  math(EXPR checked "${checked} + 1")
endforeach()
message(STATUS "ok - ${checked} instrument keyboards play the key under the pointer, one at a time, and stop on release")
