# Gridline: K-48, the tap tempo button in the top bar, driven by real SDL clicks in the real app
# (hidden, isolated config and HOME, fixed frame time of 16 ms, so 25 frames are 0.4 s, 150 BPM):
#   1. the first tap changes nothing, from the second on the tempo follows, a run of taps is one undo step;
#   2. a pause of over 2 seconds starts over, and the next run is a step of its own;
#   3. an undo or another edit in a run: the next tap starts a new step, never folded into that edit;
#   4. the button, the controller action and the Tools menu share one tapper (the menu measures only);
#   5. the same clicks at interface scale 2, and a key bound in the settings taps (J, free until then);
#   6. the bar at every width: same size as its neighbours, nothing overlaps or leaves the window, and
#      the button still taps at the narrowest width;
#   7. (K-132) the tap button in the overflow popup taps, with the popup open.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k48_tap_tempo_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  if(NOT tag MATCHES "^keep")
    file(REMOVE_RECURSE "${cfg}")
  endif()
  file(MAKE_DIRECTORY "${cfg}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  # (--no-draw: every check reads the tapper, bar and click reports, never pixels; on a slow software
  # OpenGL the drawing alone took the dozen runs past the test's time limit)
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --no-draw --fixed-dt 16 ${ARGN}
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

# The "taptempo" line of frame `fr`: taps, tempo x1000 as text, undo position, listening.
function(state tag fr)
  if(NOT ${tag}_out MATCHES "taptempo frame ${fr}: taps ([0-9]+) bpm ([0-9.]+) tempo ([0-9.]+) undo ([0-9]+) listening ([01])")
    message(FATAL_ERROR "FAIL (${tag}): no tapper line at frame ${fr}\n${${tag}_out}")
  endif()
  set(taps ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(bpm ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(tempo ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(undo ${CMAKE_MATCH_4} PARENT_SCOPE)
  set(listening ${CMAKE_MATCH_5} PARENT_SCOPE)
endfunction()
function(want tag what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n  want: ${expect}\n  got:  ${got}\n${${tag}_out}")
  endif()
endfunction()
# A click (down and up a frame later) at each of the frames. A click reaches the button two frames
# after its "sdldown" line.
function(clicks out)
  set(s "")
  foreach(f ${ARGN})
    math(EXPR g "${f} + 1")
    string(APPEND s "${f} sdldown 0\n${g} sdlup 0\n")
  endforeach()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# ---- 1. to 3.: follows, one step, a pause, an undo and an edit in a run ----
clicks(c 12 37 62 87 107)
clicks(p 240 270)
clicks(q 300)
clicks(r 330)
run(main "5 toasts clear\n8 taptempo\n9 sdlat taptempo\n${c}15 taptempo\n40 taptempo\n90 taptempo\n110 taptempo\n112 undo\n114 taptempo\n116 redo\n118 taptempo\n236 taptempo\n${p}243 taptempo\n273 taptempo\n275 undo\n277 taptempo\n${q}303 taptempo\n305 undo\n307 taptempo\n309 redo\n311 tempo 99\n313 taptempo\n${r}333 taptempo\n335 undo\n337 taptempo\n340 quit discard\n" --size 1440x900)
state(main 8)
set(t0 ${tempo})
set(u0 ${undo})
want(main "at rest: no taps, nothing lit" "${taps}/${listening}" "0/0")
state(main 15)
want(main "the first tap changes nothing" "${taps}/${tempo}/${undo}/${listening}" "1/${t0}/${u0}/1")
math(EXPR u1 "${u0} + 1")
state(main 40)
want(main "the second tap sets 150 BPM (0.4 s) as a new step" "${taps}/${tempo}/${undo}" "2/150.000/${u1}")
state(main 90)
want(main "steady taps hold the tempo, the same step" "${taps}/${tempo}/${undo}" "4/150.000/${u1}")
state(main 110)
want(main "a faster tap moves the average (0.38 s), the same step" "${taps}/${tempo}/${undo}" "5/157.900/${u1}")
state(main 114)
want(main "one undo takes back the whole run" "${tempo}/${undo}" "${t0}/${u0}")
state(main 118)
want(main "redo brings it back" "${tempo}/${undo}" "157.900/${u1}")
message(STATUS "ok - the tempo follows from the second tap, a run of taps is one undo step")
state(main 236)
want(main "after 2 seconds the button is no longer lit" "${listening}" "0")
state(main 243)
want(main "after a pause a tap starts over and changes nothing" "${taps}/${tempo}/${undo}/${listening}" "1/157.900/${u1}/1")
math(EXPR u2 "${u0} + 2")
state(main 273)
want(main "the next run is a step of its own (0.48 s)" "${taps}/${tempo}/${undo}" "2/125.000/${u2}")
state(main 277)
want(main "its undo returns to the last run's tempo" "${tempo}/${undo}" "157.900/${u1}")
message(STATUS "ok - a pause of over 2 seconds starts over, as a new step")
state(main 303)
want(main "a tap after an undo is a new step" "${tempo}/${undo}" "125.000/${u2}")
state(main 307)
want(main "... which undoes alone" "${tempo}/${undo}" "157.900/${u1}")
math(EXPR u4 "${u0} + 4")  # the redo and the edit took it to 3
state(main 333)
want(main "a tap after another edit is a new step" "${tempo}/${undo}" "125.000/${u4}")
state(main 337)
want(main "... and undo returns to that edit, not before it" "${tempo}" "99.000")
message(STATUS "ok - an undo or another edit inside a run is never folded in")

# ---- 4. one tapper: button, controller action, Tools menu ----
clicks(c 10)
clicks(m0 44)
clicks(m1 54)
clicks(m2 80 105)
clicks(after 130 150)  # the first click closes the menu
run(shared "6 sdlat taptempo\n${c}37 taptempo action\n39 taptempo\n40 sdlat menutools\n${m0}48 sdlat tapmenu\n${m1}60 sdlat tapmenutap\n${m2}108 taptempo\n125 sdlat taptempo\n${after}153 taptempo\n156 quit discard\n" --size 1440x900)
state(shared 39)
want(shared "the controller action continues the button's run" "${taps}/${tempo}" "2/150.000")
state(shared 108)
want(shared "the Tools menu taps the same tapper and only measures" "${taps}/${tempo}" "4/150.000")
if(NOT bpm MATCHES "^117\\.")  # three beats over 96 frames (its button acts on the release)
  message(FATAL_ERROR "FAIL (shared): the menu's reading: ${bpm}\n${shared_out}")
endif()
state(shared 153)
want(shared "the button continues the menu's run" "${taps}" "5")
if(tempo STREQUAL "150.000")
  message(FATAL_ERROR "FAIL (shared): the button should follow the shared average\n${shared_out}")
endif()
message(STATUS "ok - the button, the controller action and the Tools menu share one tapper")

# ---- 5. scale 2, and a key ----
clicks(c 12 37)
run(scale2 "9 sdlat taptempo\n${c}40 taptempo\n42 quit discard\n" --ui-scale 2 --size 2880x1800)
state(scale2 40)
want(scale2 "clicks at interface scale 2" "${taps}/${tempo}" "2/150.000")
message(STATUS "ok - interface scale 2")

run(keep_key "5 quit discard\n" --size 1440x900)
file(GLOB_RECURSE settings "${OUT}/cfg_keep_key/*settings.json")
if(NOT settings)
  message(FATAL_ERROR "FAIL (key): no settings file")
endif()
run(nokey "6 taptempo\n8 key j\n12 taptempo\n14 quit discard\n" --size 1440x900)
state(nokey 12)
want(nokey "J does nothing until it is bound" "${taps}" "0")
file(READ "${settings}" js)
string(JSON js SET "${js}" values "keys.bindings" "\"{\\\"transport.tapTempo\\\":[\\\"J\\\"]}\"")
file(WRITE "${settings}" "${js}")
run(keep_key "6 taptempo\n8 key j\n12 taptempo\n33 key j\n37 taptempo\n39 quit discard\n" --size 1440x900)
state(keep_key 12)
want(keep_key "a bound key taps" "${taps}" "1")
state(keep_key 37)
want(keep_key "the second key tap sets the tempo (25 frames)" "${taps}/${tempo}" "2/150.000")
message(STATUS "ok - a key bound in the settings taps")

# ---- 6. the bar at every width ----
function(tenths s out)
  string(REPLACE "." "" v "${s}")
  math(EXPR v "${v} + 0")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
foreach(sc 1 2)
  foreach(lw 960 1000 1040 1080 1120 1160 1200 1240 1280 1320 1360 1400 1440 1500 1600 1700 1800 1920 2200 2560)
    set(tag "w${lw}s${sc}")
    math(EXPR w "${lw} * ${sc}")
    math(EXPR wh "700 * ${sc}")
    run(${tag} "8 taptempo bar\n10 quit discard\n" --ui-scale ${sc} --size ${w}x${wh})
    string(REGEX MATCHALL "bar frame 8: [a-z_]+ [-0-9.]+ [-0-9.]+ [-0-9.]+ [-0-9.]+" lines "${${tag}_out}")
    math(EXPR limit "${lw} * 10")
    set(prev 0)
    set(seen "")
    foreach(l ${lines})
      if(NOT l MATCHES "bar frame 8: ([a-z_]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)")
        continue()
      endif()
      set(n ${CMAKE_MATCH_1})
      tenths(${CMAKE_MATCH_2} x0)
      tenths(${CMAKE_MATCH_3} y0)
      tenths(${CMAKE_MATCH_4} x1)
      tenths(${CMAKE_MATCH_5} y1)
      list(APPEND seen ${n})
      set(${n}_x0 ${x0})
      set(${n}_x1 ${x1})
      set(${n}_y0 ${y0})
      set(${n}_y1 ${y1})
      if(n STREQUAL "bar_tempo" OR n STREQUAL "stop")  # panels and buttons checked below
        continue()
      endif()
      if(x0 LESS prev)
        message(FATAL_ERROR "FAIL (${tag}): ${n} overlaps what is left of it (${x0} < ${prev}, tenths of a pixel)\n${${tag}_out}")
      endif()
      if(x1 GREATER limit)
        message(FATAL_ERROR "FAIL (${tag}): ${n} leaves the window (${x1} > ${limit})\n${${tag}_out}")
      endif()
      set(prev ${x1})
    endforeach()
    if("taptempo" IN_LIST seen)
      list(FIND seen bar_tempo i)
      if(i LESS 0)
        message(FATAL_ERROR "FAIL (${tag}): the button without its panel\n${${tag}_out}")
      endif()
      math(EXPR side "${taptempo_x1} - ${taptempo_x0}")
      math(EXPR high "${taptempo_y1} - ${taptempo_y0}")
      math(EXPR stopw "${stop_x1} - ${stop_x0}")
      want(${tag} "the same size as the stop button" "${side}x${high}/${taptempo_y0}" "${stopw}x${high}/${stop_y0}")
      if(taptempo_x0 LESS bar_tempo_x0 OR taptempo_x1 GREATER bar_tempo_x1)
        message(FATAL_ERROR "FAIL (${tag}): the button leaves the tempo panel\n${${tag}_out}")
      endif()
    endif()
  endforeach()
endforeach()
message(STATUS "ok - the bar fits at every width and scale, the button matches its neighbours")

# The button's width comes out of the room between the clusters, so no group goes earlier for it.
function(hasgroup tag name)
  if(NOT ${tag}_out MATCHES "bar frame 8: ${name} ")
    message(FATAL_ERROR "FAIL (${tag}): ${name} went into the overflow popup\n${${tag}_out}")
  endif()
endfunction()
run(w1440 "8 taptempo bar\n10 quit discard\n" --size 1440x700)
hasgroup(w1440 bar_monitor)
run(w960 "8 taptempo bar\n10 quit discard\n" --size 960x700)
hasgroup(w960 bar_pattern)
message(STATUS "ok - the monitor stays at 1440, the pattern selector at 960")

# The narrowest window (960 logical px, its minimum at every scale): other groups have gone into the
# overflow popup, the tempo and its button stay on the bar (they are nearly the last to go) and tap.
clicks(t 12 37)
run(narrow "8 sdlat bar_more\n9 sdlat taptempo\n${t}40 taptempo\n42 quit discard\n" --size 960x600)
if(NOT narrow_out MATCHES "sdlat frame 8: bar_more at")
  message(FATAL_ERROR "FAIL (narrow): no overflow button at the narrowest width\n${narrow_out}")
endif()
state(narrow 40)
want(narrow "taps at the narrowest width" "${taps}/${tempo}" "2/150.000")
message(STATUS "ok - at the narrowest width the button stays on the bar and taps")

# K-132: the tap button inside the overflow popup. The bar is told to fit a narrower width than any
# window can have, so the tempo goes into the popup: the popup opens from the "more" button and its
# own tap button follows the clicks (two taps 0.4 s apart: 150 BPM) while the popup stays open.
clicks(o 10)
clicks(t 18 43)
run(overflow "6 taptempo fit 420\n8 sdlat bar_more\n${o}15 taptempo bar\n16 sdlat taptempo\n${t}46 taptempo\n47 taptempo bar\n50 quit discard\n" --size 1440x900)
if(NOT overflow_out MATCHES "sdlat frame 8: bar_more at")
  message(FATAL_ERROR "FAIL (overflow): no overflow button when the bar fits 420 px\n${overflow_out}")
endif()
if(overflow_out MATCHES "bar frame 15: bar_tempo ")
  message(FATAL_ERROR "FAIL (overflow): the tempo stayed on the bar\n${overflow_out}")
endif()
if(NOT overflow_out MATCHES "sdlat frame 16: taptempo at")
  message(FATAL_ERROR "FAIL (overflow): no tap button in the open popup\n${overflow_out}")
endif()
state(overflow 46)
want(overflow "the popup's tap button taps" "${taps}/${tempo}" "2/150.000")
if(NOT overflow_out MATCHES "bar frame 47: taptempo ")
  message(FATAL_ERROR "FAIL (overflow): the popup closed after the taps\n${overflow_out}")
endif()
message(STATUS "ok - the tap button in the overflow popup taps and keeps the popup open")
