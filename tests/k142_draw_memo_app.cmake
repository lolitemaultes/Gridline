# Gridline - K-142 (0.7.8): the plugin editors' shape memo (src/app/PluginSkinMemo.h) in the real app
# (hidden, isolated config, SDL's dummy audio driver). Each editor is opened with the memo in verify
# mode (GRIDLINE_DRAW_MEMO=verify): every knob the memo would copy from the frame before is built again
# and compared with the copy. While the editor sits still and while its values change from outside the
# knob (the mouse wheel, undo, redo, a preset, the theme turned light and back), no copy may differ
# from a built drawing: a stale knob would count as a mismatch. Also checks that the memo is used.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> [-DONLY=<type:param;...>] -P k142_draw_memo_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_DRAW_MEMO} "verify")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

# <type>:<a knob's parameter number>, or <type>:- for an editor whose knobs keep their values in the
# plugin's own data (only the preset and the theme change there); a third part draws it in another
# control style (classic, graphite, hairline, lumen, slate), in the light theme (light) or magnified
# (zoom: the editor's own zoom at 140 %).
set(editors gl.delay:32 gl.hexsynth:1 gl.matrixfm:- gl.wavetable:1 gl.twinstring:1 gl.eq:1
            gl.hexsynth:1:classic gl.hexsynth:1:graphite gl.hexsynth:1:hairline gl.hexsynth:1:lumen
            gl.delay:32:classic gl.delay:32:lumen gl.hexsynth:1:light gl.delay:32:light gl.hexsynth:1:zoom gl.delay:32:zoom)
if(ONLY)
  set(editors ${ONLY})
endif()
set(fails "")
foreach(e IN LISTS editors)
  string(REPLACE ":" ";" pair "${e}")
  list(GET pair 0 type)
  list(GET pair 1 k)
  set(how "")
  list(LENGTH pair np)
  if(np GREATER 2)
    list(GET pair 2 how)
  endif()
  set(tag "${type}${how}")
  set(extra "")
  set(pre "15 setting ui.pluginWindowSize 1\n")
  if(how STREQUAL "light")
    set(extra --light)
  elseif(how STREQUAL "zoom")
    set(pre "15 setting ui.pluginWindowSize 1\n16 edzoomset ${type} 1.4\n")
  elseif(how)
    set(extra --look ${how})
  endif()
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}/home")
  if(k STREQUAL "-")
    file(WRITE "${OUT}/${tag}.txt" "${pre}52 pickpreset 1\n58 theme light\n64 theme dark\n70 pickpreset 0\n78 quit discard\n")
  else()
    file(WRITE "${OUT}/${tag}.txt"
         "${pre}20 plug ${k}\n24 atparam ${k} 0 0\n26 wheel 1\n28 wheel 1\n30 plug ${k}\n"
         "36 undo\n38 plug ${k}\n44 redo\n46 plug ${k}\n52 pickpreset 1\n58 theme light\n64 theme dark\n70 pickpreset 0\n78 quit discard\n")
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size 1440x900 --frames 90
                          --dev-input "${OUT}/${tag}.txt" --plugin ${type} ${extra}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.out" "${out}")
  if(NOT rc EQUAL 0)
    list(APPEND fails "${tag}: gridline-app failed (${rc}): ${err}")
    continue()
  endif()
  string(REGEX MATCHALL "drawmemo: hits [0-9]+ misses [0-9]+ kept [0-9]+ verified [0-9]+ mismatches [0-9]+" lines "${out}")
  list(LENGTH lines n)
  if(n EQUAL 0)
    list(APPEND fails "${tag}: no memo report")
    continue()
  endif()
  list(GET lines -1 last)
  string(REGEX MATCH "kept ([0-9]+) verified ([0-9]+) mismatches ([0-9]+)" _ "${last}")
  set(kept ${CMAKE_MATCH_1})
  set(verified ${CMAKE_MATCH_2})
  set(bad ${CMAKE_MATCH_3})
  set(vals "")
  if(NOT k STREQUAL "-")
    string(REGEX MATCHALL "param ${k} [-0-9.]+" vals "${out}")
  endif()
  message(STATUS "${tag}: ${last}; values ${vals}")
  if(kept LESS 1 OR verified LESS 100)
    list(APPEND fails "${tag}: the memo was hardly used (${last})")
  endif()
  if(NOT bad EQUAL 0)
    list(APPEND fails "${tag}: ${bad} copied knobs differ from built ones (${last})")
  endif()
  # The wheel changed the value and undo / redo moved it back and forth: the run did change things.
  list(LENGTH vals nv)
  if(k STREQUAL "-")
  elseif(nv LESS 4)
    list(APPEND fails "${tag}: parameter ${k} not read (${vals})")
  else()
    list(GET vals 0 v0)
    list(GET vals 1 v1)
    list(GET vals 2 v2)
    list(GET vals 3 v3)
    if(v0 STREQUAL v1 OR NOT v0 STREQUAL v2 OR NOT v1 STREQUAL v3)
      list(APPEND fails "${tag}: the wheel / undo / redo did not move parameter ${k} as expected (${vals})")
    endif()
  endif()
endforeach()
if(fails)
  string(REPLACE ";" "\n" f "${fails}")
  message(FATAL_ERROR "${f}")
endif()
message(STATUS "every copied knob matched a built one")
