# Gridline: K-28, pitch bend points follow the piano roll's snap, driven by scripted input in the
# real app (hidden, isolated config and HOME, fixed frame time) on a copy of the test song,
# editing pattern 0 on channel 6 (four C5 notes made by the script):
#   1. snap 1/4 step: a drag from an off-grid spot lands the point on the 1/4 step grid, on whole
#      semitones; with Alt held the value is free (cents);
#   2. snap Line (the grid in view): the point lands on the grid the view shows;
#   3. snap None: free time and value; with Alt held the grid in view and whole semitones;
#   4. a click alone adds nothing; dragging a segment's curve ring sets its curve amount; Alt+right-
#      click on a point removes it.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k28_bend_snap_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --edit 0 6 --hide rack
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

set(make "2 mknotes 4 96 96\n3 typing off\n")
run(geo "${make}14 lane\n15 notes\n17 quit discard\n")
if(NOT geo_out MATCHES "lane frame [0-9]+: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([-0-9.]+) [^\n]* pitchY0 ([-0-9.]+) rowH ([0-9.]+)")
  message(FATAL_ERROR "FAIL: no piano roll geometry\n${geo_out}")
endif()
set(x0 ${CMAKE_MATCH_1})
set(ppt ${CMAKE_MATCH_2})
set(py0 ${CMAKE_MATCH_4})
set(rowH ${CMAKE_MATCH_5})
foreach(v x0 py0 rowH)
  string(REGEX REPLACE "\\..*" "" ${v} "${${v}}")
endforeach()
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)$" _p "${ppt}")
set(pptInt ${CMAKE_MATCH_1})
string(REGEX REPLACE "^0+" "" pptFrac "${CMAKE_MATCH_2}")
if(pptFrac STREQUAL "")
  set(pptFrac 0)
endif()
function(xat tick out)
  math(EXPR v "${x0} + ${tick} * ${pptInt} + ${tick} * ${pptFrac} / 1000000")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
math(EXPR cy "${py0} + (127 - 60) * ${rowH} + ${rowH} / 2")
math(EXPR keyX "${x0} - 20")
math(EXPR y2 "${cy} - 2 * ${rowH}")
math(EXPR yFree "${cy} - 2 * ${rowH} - ${rowH} * 3 / 10")
xat(229 xFrom)  # 37 ticks into the third note (off every grid)
xat(242 xTo)    # 50 ticks into it
# The drag: focus the piano roll (a key click), the bend tool (N), a snap mode, Alt (or not), a
# drag on the third note from xFrom to xTo, `ty` rows up; then the notes and the snap.
function(drag tag snap alt ty)
  set(m0 "")
  set(m1 "")
  if(alt)
    set(m0 "19 mod alt 1\n")
    set(m1 "28 mod alt 0\n")
  endif()
  run(${tag} "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n17 pianosnap ${snap}\n18 key n\n${m0}20 move ${xFrom} ${cy}\n21 down 0\n23 move ${xTo} ${cy}\n25 move ${xTo} ${ty}\n27 up 0\n${m1}30 notes\n31 pianosnap\n33 quit discard\n")
  set(${tag}_out "${${tag}_out}" PARENT_SCOPE)
endfunction()
# Reads the third note's one point and the grid in force.
function(point tag)
  if(NOT ${tag}_out MATCHES "note 2 [^\n]* bend 1 ([0-9.]+):([-0-9.]+):0\n")
    message(FATAL_ERROR "FAIL (${tag}): the drag should leave one point on the third note\n${${tag}_out}")
  endif()
  set(t ${CMAKE_MATCH_1})
  set(v ${CMAKE_MATCH_2})
  string(REGEX REPLACE "\\.00$" "" ti "${t}")
  set(${tag}_t ${ti} PARENT_SCOPE)
  set(${tag}_v ${v} PARENT_SCOPE)
  if(NOT ${tag}_out MATCHES "pianosnap frame [0-9]+: [^\n]* grid ([0-9]+)")
    message(FATAL_ERROR "FAIL (${tag}): no snap report\n${${tag}_out}")
  endif()
  set(${tag}_g ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()
function(onGrid tag tick grid)
  if(NOT tick MATCHES "^[0-9]+$")
    message(FATAL_ERROR "FAIL (${tag}): the point should sit on a whole tick, got ${tick}")
  endif()
  math(EXPR abs "192 + ${tick}")
  math(EXPR r "${abs} % ${grid}")
  if(NOT r EQUAL 0)
    message(FATAL_ERROR "FAIL (${tag}): tick ${abs} is off the ${grid}-tick grid")
  endif()
endfunction()

# 1. 1/4 step (6 ticks at 96 PPQ): on the grid, whole semitones; Alt: cents.
drag(quarter "\"1/4 step\"" OFF ${y2})
point(quarter)
onGrid(quarter ${quarter_t} 6)
if(NOT quarter_v STREQUAL "2.00" OR quarter_t LESS 42 OR quarter_t GREATER 54)
  message(FATAL_ERROR "FAIL (1/4 step): want about 48 ticks and +2.00, got ${quarter_t} ${quarter_v}")
endif()
message(STATUS "ok - snap 1/4 step: point at ${quarter_t} ticks, ${quarter_v} st")
drag(quarterAlt "\"1/4 step\"" ON ${yFree})
point(quarterAlt)
if(quarterAlt_v MATCHES "\\.00$")
  message(FATAL_ERROR "FAIL (1/4 step + Alt): the value should be free, got ${quarterAlt_v}")
endif()
message(STATUS "ok - snap 1/4 step with Alt: free, ${quarterAlt_t} ticks, ${quarterAlt_v} st")

# 2. Line: the grid in view.
drag(line Line OFF ${y2})
point(line)
onGrid(line ${line_t} ${line_g})
if(NOT line_v STREQUAL "2.00")
  message(FATAL_ERROR "FAIL (Line): whole semitones, got ${line_v}")
endif()
message(STATUS "ok - snap Line: point at ${line_t} ticks on the ${line_g}-tick grid in view, ${line_v} st")

# 3. None: free; Alt: the grid in view and whole semitones.
drag(none None OFF ${yFree})
point(none)
if(none_v MATCHES "\\.00$")
  message(FATAL_ERROR "FAIL (None): the value should be free, got ${none_v}")
endif()
drag(noneAlt None ON ${yFree})
point(noneAlt)
onGrid(noneAlt ${noneAlt_t} ${line_g})
if(NOT noneAlt_v STREQUAL "2.00")
  message(FATAL_ERROR "FAIL (None + Alt): whole semitones, got ${noneAlt_v}")
endif()
message(STATUS "ok - snap None: free (${none_t}, ${none_v}); with Alt on the grid in view (${noneAlt_t}, ${noneAlt_v})")

# 4. A click alone, the curve ring, Alt+right-click.
run(click "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n18 key n\n20 move ${xFrom} ${cy}\n21 down 0\n23 up 0\n26 notes\n28 quit discard\n")
if(NOT click_out MATCHES "note 2 [^\n]* bend 0\n")
  message(FATAL_ERROR "FAIL: a click alone should add nothing\n${click_out}")
endif()
xat(216 xRing)  # the ring of the segment 0..48 of the third note (point made at 240 with snap 1/4 step)
xat(240 xPt)
math(EXPR yRing "${cy} - ${rowH}")
math(EXPR yUp "${yRing} - 40")
run(ring "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n17 pianosnap \"1/4 step\"\n18 key n\n20 move ${xFrom} ${cy}\n21 down 0\n23 move ${xTo} ${cy}\n25 move ${xTo} ${y2}\n27 up 0\n30 move ${xRing} ${yRing}\n32 down 0\n34 move ${xRing} ${yUp}\n36 up 0\n38 notes\n40 move ${xPt} ${y2}\n42 mod alt 1\n43 down 1\n44 up 1\n45 mod alt 0\n47 notes\n49 quit discard\n")
if(NOT ring_out MATCHES "notes frame 38:[^\n]*\n[^\n]*\n[^\n]*\n  note 2 [^\n]* bend 1 48.00:2.00:0:(-[0-9.]+)\n")
  message(FATAL_ERROR "FAIL: dragging the ring up should set a curve amount on the segment\n${ring_out}")
endif()
message(STATUS "ok - the curve ring dragged up 40 px: amount ${CMAKE_MATCH_1}")
if(NOT ring_out MATCHES "notes frame 47:[^\n]*\n[^\n]*\n[^\n]*\n  note 2 [^\n]* bend 0\n")
  message(FATAL_ERROR "FAIL: Alt+right-click on the point should remove it\n${ring_out}")
endif()
message(STATUS "ok - Alt+right-click removes the point")
