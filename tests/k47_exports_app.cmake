# Gridline - K-47, in the real app (hidden, isolated config, HOME and cache, dummy audio):
#   1. zip save, project data files, project bones, WAV of a sample and of a clip run off the interface
#      thread: the frame right after the start finds the job running and frames go on, the result is
#      there at the end; Cancel leaves no target; an earlier archive stays; the project stays editable
#      and edits made during a save stay unsaved;
#   2. Edit > Copy of an effect chain from a zipped project, that project closed and its copy swept,
#      Paste in another project: the file is still there, and stays while that project is open;
#   3. a lost OpenGL context: the interface comes back whole, more than once, the project as it was; a
#      detached window comes back too; when no new context can be had, a report and a recovery copy,
#      then the crash pop-up with its Recover button, never a black window.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DSOUNDS=<assets/sounds> -DOUT=<dir> [-DSHOTS=<dir>] -P k47_exports_app.cmake
cmake_minimum_required(VERSION 3.18)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg" "${OUT}/music" "${OUT}/build")
set(cache "${OUT}/cache/unpacked")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/cfg")
set(ENV{XDG_CACHE_HOME} "${OUT}/xdgcache")
set(ENV{GRIDLINE_CACHE_DIR} "${OUT}/cache")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")

# The project: a sampler and an audio clip on a sound beside it, and an impulse response on the master.
file(GLOB wavs "${SOUNDS}/classic/*.wav")
list(GET wavs 0 wav)
configure_file("${wav}" "${OUT}/build/near.wav" COPYONLY)
configure_file("${wav}" "${OUT}/build/impulse.wav" COPYONLY)
file(READ "${DEMO}" demo)
string(REPLACE "\"channels\": [" "\"channels\": [{\"id\": 9001, \"name\": \"Near\", \"mixerTrack\": 3, \"gain\": 0.7, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/build/near.wav\"}}, " song "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 9100" song "${song}")
string(REPLACE "\"playlist\": [" "\"playlist\": [{\"id\": 9002, \"kind\": \"audio\", \"source\": 9001, \"track\": 40, \"start\": 0, \"length\": 96}, " song "${song}")
file(WRITE "${OUT}/song.gridline.json" "${song}")
configure_file("${DEMO}" "${OUT}/other.gridline.json" COPYONLY)

function(run tag script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1280x800 --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 200)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
  set(${tag}_err "${err}" PARENT_SCOPE)
endfunction()
function(must tag regex what)
  if(NOT "${${tag}_out}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${${tag}_out}\n${${tag}_err}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()

# ---- 1. off the interface thread; each job takes its time.
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "150")
foreach(job IN ITEMS "zip;${OUT}/res/Song.gridline.zip" "data;${OUT}/res/data" "bones;${OUT}/res/bones" "sample;${OUT}/res/sample.wav" "clip;${OUT}/res/clip.wav")
  list(GET job 0 kind)
  list(GET job 1 target)
  file(MAKE_DIRECTORY "${OUT}/res")
  run(${kind} "5 forget file-job-finished\n6 filejob ${kind} \"${target}\"\n7 filejob state\n8 filejob state\n40 waitfor file-job-finished 60\n42 filejob state\n44 quit discard\n")
  must(${kind} "filejob running 1 finished 0 count 0" "${kind}: the frame after the start finds it running")
  must(${kind} "filejob running 0 finished 0 count 1" "${kind}: it ends by itself")
endforeach()
foreach(f "${OUT}/res/Song.gridline.zip" "${OUT}/res/sample.wav" "${OUT}/res/clip.wav" "${OUT}/res/data/Gridline Demo/Gridline Demo.gridline.json" "${OUT}/res/bones/Gridline Demo bones/Gridline Demo.gridline.json")
  if(NOT EXISTS "${f}")
    file(GLOB_RECURSE have "${OUT}/res/*")
    message(FATAL_ERROR "FAIL: ${f} was not written: ${have}")
  endif()
endforeach()
file(GLOB_RECURSE parts "${OUT}/res/*.part*" "${OUT}/res/*.tmp.*")
if(parts)
  message(FATAL_ERROR "FAIL: temporary files stayed: ${parts}")
endif()
file(SIZE "${OUT}/res/clip.wav" clipSize)
if(clipSize LESS 1000)
  message(FATAL_ERROR "FAIL: the clip's file is empty")
endif()
message(STATUS "ok - every export wrote its target, without temporary files")

# Cancel: no target. The archive that is there stays for a zip.
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "4000")  # (a slow machine's next frame must not find it finished)
file(READ "${OUT}/res/Song.gridline.zip" zipBefore HEX)
file(MAKE_DIRECTORY "${OUT}/can")
foreach(job IN ITEMS "zip;${OUT}/can/Song.gridline.zip" "data;${OUT}/can/data" "bones;${OUT}/can/bones" "sample;${OUT}/can/sample.wav" "clip;${OUT}/can/clip.wav")
  list(GET job 0 kind)
  list(GET job 1 target)
  run(cancel_${kind} "5 forget file-job-finished\n6 filejob ${kind} \"${target}\"\n7 filejob cancel\n40 waitfor file-job-finished 60\n42 filejob state\n44 quit discard\n")
  must(cancel_${kind} "filejob running 0 finished 0 count 1" "${kind}: Cancel ends it")
endforeach()
file(GLOB_RECURSE left "${OUT}/can/*")
if(left)
  message(FATAL_ERROR "FAIL: cancelled exports left ${left}")
endif()
message(STATUS "ok - cancelled exports leave nothing")
run(cancel_over "5 forget file-job-finished\n6 filejob zip \"${OUT}/res/Song.gridline.zip\"\n7 filejob cancel\n40 waitfor file-job-finished 60\n44 quit discard\n")
file(READ "${OUT}/res/Song.gridline.zip" zipAfter HEX)
if(NOT zipBefore STREQUAL zipAfter)
  message(FATAL_ERROR "FAIL: a cancelled save changed the archive that was there")
endif()
message(STATUS "ok - a cancelled save leaves the archive that was there")
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "150")

# Quitting in the middle ends the app, and leaves no target.
file(MAKE_DIRECTORY "${OUT}/quit")
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "4000")  # (a slow machine's next frame must not find it finished)
run(quit_in "5 filejob data \"${OUT}/quit/data\"\n6 quit discard\n")
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "150")
file(GLOB_RECURSE left "${OUT}/quit/*")
if(left)
  message(FATAL_ERROR "FAIL: quitting during an export left ${left}")
endif()
message(STATUS "ok - quitting during an export ends the app and leaves nothing")

# Edits during a zip save: they stay unsaved, and the project now lives in the archive. A second job
# is refused while one runs. A save with no edits leaves the project saved.
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "4000")  # (still running two frames later, on a slow machine too)
run(edit_during "5 forget file-job-finished\n6 filejob zip \"${OUT}/res/During.gridline.zip\"\n8 filejob data \"${OUT}/res/refused\"\n10 rmchan 0\n40 waitfor file-job-finished 60\n44 docstate\n50 quit discard\n")
set(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS} "150")
if(EXISTS "${OUT}/res/refused")
  message(FATAL_ERROR "FAIL: a second job ran beside the first")
endif()
message(STATUS "ok - one job at a time")
must(edit_during "docstate modified 1 path [^\n]*During.gridline.zip" "an edit during a save stays unsaved, and the project is the saved archive")
run(no_edit "5 forget file-job-finished\n6 rmchan 0\n8 filejob zip \"${OUT}/res/Quiet.gridline.zip\"\n40 waitfor file-job-finished 60\n44 docstate\n50 quit discard\n")
must(no_edit "docstate modified 0 path [^\n]*Quiet.gridline.zip" "a save with no edit during it leaves the project saved")
# Another project opens while the save runs: the file is written, and it does not become that project's.
run(switch "2 loadhold off\n5 forget file-job-finished\n6 filejob zip \"${OUT}/res/Switch.gridline.zip\"\n8 open \"${OUT}/other.gridline.json\"\n40 waitfor file-job-finished 60\n44 docstate\n50 quit discard\n")
must(switch "docstate modified 0 path [^\n]*other.gridline.json" "a project opened during a save stays what it is")
if(NOT EXISTS "${OUT}/res/Switch.gridline.zip")
  message(FATAL_ERROR "FAIL: the save did not finish after the project changed")
endif()
message(STATUS "ok - the save still finished")
unset(ENV{GRIDLINE_DEV_SLOW_FILE_JOB_MS})

# ---- 2. the clipboard. The project in a zip: a sampler, and an impulse response on the master.
file(READ "${OUT}/song.gridline.json" zipped)
string(REPLACE "${OUT}/build/near.wav" "near.wav" zipped "${zipped}")
string(JSON zipped SET "${zipped}" mixer 0 slots 0 "{\"plugin\":{\"type\":\"gl.convolver\",\"data\":\"impulse.wav\",\"params\":[]}}")
file(WRITE "${OUT}/build/Chain.gridline.json" "${zipped}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/music/Song.zip" --format=zip Chain.gridline.json near.wav impulse.wav WORKING_DIRECTORY "${OUT}/build" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not make the archive")
endif()
set(script "2 loadhold off\n3 forget cache-swept\n4 open \"${OUT}/music/Song.zip\"\n6 waitfor project-loaded 60\n8 cache list\n10 edit copy mixer 0\n14 forget project-loaded\n15 forget cache-swept\n16 open \"${OUT}/other.gridline.json\"\n18 waitfor project-loaded 60\n20 waitfor cache-swept 30\n22 cache list\n24 edit paste mixer 1\n26 save \"${OUT}/pasted.gridline.json\"\n30 quit discard\n")
run(clip "${script}")
must(clip "edit copy frame" "the chain was copied")
string(REGEX MATCH "cache listed\n.*cache entry Song-[0-9a-f]+\n" stays "${clip_out}")
if(NOT stays)
  message(FATAL_ERROR "FAIL: the copy went while the clipboard refers to it\n${clip_out}")
endif()
message(STATUS "ok - the closed project's copy stays while the clipboard refers to it")
file(READ "${OUT}/pasted.gridline.json" pasted)
string(REGEX MATCH "\"data\": *\"([^\"]*impulse.wav)\"" hit "${pasted}")
if(NOT hit)
  message(FATAL_ERROR "FAIL: the pasted chain is not in the project:\n${clip_out}")
endif()
if(NOT EXISTS "${CMAKE_MATCH_1}")
  message(FATAL_ERROR "FAIL: the pasted chain's file is gone: ${CMAKE_MATCH_1}")
endif()
message(STATUS "ok - the pasted chain's file is there, in a project saved with it")

# ---- 3. graphics.
if(DEFINED SHOTS)
  set(shotDir "${SHOTS}")
else()
  set(shotDir "${OUT}/shots")
endif()
file(MAKE_DIRECTORY "${shotDir}")
# The same frame before and after a loss. (Fixed time and no transport: nothing moves by itself.)
run(glloss "20 rmchan 0\n40 toasts clear\n50 shot \"${shotDir}/gl_before.ppm\"\n52 glreset\n56 docstate\n60 waitfor graphics-recovered 30\n70 toasts clear\n80 shot \"${shotDir}/gl_after.ppm\"\n82 forget graphics-recovered\n84 glreset\n90 waitfor graphics-recovered 30\n100 toasts clear\n110 shot \"${shotDir}/gl_again.ppm\"\n112 docstate\n114 channels\n116 ppmdiff \"${shotDir}/gl_before.ppm\" \"${shotDir}/gl_after.ppm\"\n117 ppmdiff \"${shotDir}/gl_before.ppm\" \"${shotDir}/gl_again.ppm\"\n120 quit discard\n" --fixed-dt 16)
must(glloss "docstate modified 1" "the edit is still there after a lost context")
foreach(pic gl_after gl_again)
  if(NOT EXISTS "${shotDir}/${pic}.ppm")
    message(FATAL_ERROR "FAIL: no picture ${pic} after the loss\n${glloss_out}\n${glloss_err}")
  endif()
endforeach()
# (Two frames of a run without any loss differ in about a hundred pixels: what animates by itself.)
string(REGEX MATCHALL "ppmdiff pixels [0-9]+ differ [0-9]+" diffs "${glloss_out}")
list(LENGTH diffs nDiffs)
if(NOT nDiffs EQUAL 2)
  message(FATAL_ERROR "FAIL: no comparison of the pictures\n${glloss_out}")
endif()
foreach(d IN LISTS diffs)
  string(REGEX REPLACE ".* differ " "" n "${d}")
  if(n GREATER 400)
    message(FATAL_ERROR "FAIL: the interface looks different after a lost context (${d}): ${shotDir}")
  endif()
endforeach()
message(STATUS "ok - after a lost context, twice, the interface looks as it did (${diffs})")

# A detached window goes with the context and comes back.
run(gldetach "8 detach Mixer 1600 120 900 380\n20 viewports\n24 glreset\n30 waitfor graphics-recovered 30\n44 viewports\n46 vpshot Mixer \"${shotDir}/gl_detached.ppm\"\n60 quit discard\n" --fixed-dt 16)
if(EXISTS "${shotDir}/gl_detached.ppm")
  message(STATUS "ok - a detached window comes back after a lost context")
else()
  message(FATAL_ERROR "FAIL: no picture of the detached window after the loss\n${gldetach_out}\n${gldetach_err}")
endif()

# No new context to be had: a report, a recovery copy, the pop-up process, and a Recover button.
function(waitForFile path)
  foreach(i RANGE 150)
    if(EXISTS "${path}")
      return()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.2)
  endforeach()
  message(FATAL_ERROR "FAIL: no ${path}")
endfunction()
function(lostForGood tag script)
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}" "${OUT}/sent_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CRASH_TEST_SENTINEL} "${OUT}/sent_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1280x800 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  unset(ENV{GRIDLINE_CRASH_TEST_SENTINEL})
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 3)
    message(FATAL_ERROR "FAIL (${tag}): the app should end with its code for this (3), ended with ${rc}\n${out}\n${err}")
  endif()
  waitForFile("${OUT}/sent_${tag}/dialog.ppm")
  file(GLOB reports "${OUT}/cfg_${tag}/gridline/crash-reports/graphics-*.txt")
  list(LENGTH reports n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "FAIL (${tag}): ${n} graphics reports\n${out}\n${err}")
  endif()
  file(READ "${reports}" report)
  foreach(field "kind: graphics" "cause: graphics driver reset" "unsaved work: yes" "stack:\n  0 " "graphics lost for good")
    if(NOT report MATCHES "${field}")
      message(FATAL_ERROR "FAIL (${tag}): the report lacks ${field}:\n${report}")
    endif()
  endforeach()
  string(FIND "${report}" "${OUT}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "FAIL (${tag}): a path got into the report:\n${report}")
  endif()
  file(GLOB copies "${OUT}/cfg_${tag}/gridline/recovery/*.gridline.json")
  list(LENGTH copies n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "FAIL (${tag}): ${n} recovery copies\n${out}\n${err}")
  endif()
  file(READ "${copies}" copy)
  if(copy MATCHES "\"id\": 9001")
    message(FATAL_ERROR "FAIL (${tag}): the recovery copy lacks the last edit (channel 9001 was removed)")
  endif()
  file(GLOB marks "${OUT}/cfg_${tag}/gridline/recovery/*.rescued")
  message(STATUS "ok - ${tag}: a report with no paths, a recovery copy with the last edit, and the pop-up process ran")
endfunction()
set(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT} "1")
lostForGood(nocontext "20 rmchan 0\n40 glreset\n200 quit discard\n")
unset(ENV{GRIDLINE_DEV_GL_NO_NEW_CONTEXT})
# A driver that keeps resetting is not coming back: the fourth loss in a minute ends the same way.
lostForGood(keeps "20 rmchan 0\n30 glreset\n40 glreset\n50 glreset\n60 glreset\n400 quit discard\n")
if(DEFINED SHOTS)
  file(COPY "${OUT}/sent_nocontext/dialog.ppm" DESTINATION "${shotDir}")
endif()
