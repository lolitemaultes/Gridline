# Gridline - K-45: the unpacked project cache in the real app (hidden, isolated config, HOME and cache;
# a local folder is made to count as a drive with GRIDLINE_DEV_REMOTE_PATHS):
#   1. a local zip opens from the cache and its folder stays as it was; opening another project
#      deletes the copy; so does quitting;
#   2. a drive's copy stays after closing;
#   3. a copy a crash left behind goes at the startup sweep, a half-unpacked folder too, a saved
#      project's copy and a backup's copy stay, and the start does not wait for any of it;
#   4. Settings > Files: the size, the Clear cache button with its question, what it kept and why, the
#      size after it; screenshots at both themes and scales (written to SHOTS when given);
#   5. a real crash with unsaved work: its recovery copy holds the cached copy until dealt with.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DSOUNDS=<assets/sounds> -DOUT=<dir> [-DSHOTS=<dir>] -P k45_cache_app.cmake
cmake_minimum_required(VERSION 3.18)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg" "${OUT}/music" "${OUT}/drive/Music" "${OUT}/build")
set(cache "${OUT}/cache/unpacked")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/cfg")
set(ENV{XDG_CACHE_HOME} "${OUT}/xdgcache")
set(ENV{GRIDLINE_CACHE_DIR} "${OUT}/cache")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_DEV_REMOTE_PATHS} "${OUT}/drive")

# The project: one sampler on a sound beside it, referred to by name.
file(GLOB wavs "${SOUNDS}/classic/*.wav")
list(GET wavs 0 wav)
configure_file("${wav}" "${OUT}/build/near.wav" COPYONLY)
file(READ "${DEMO}" demo)
string(REPLACE "\"channels\": [" "\"channels\": [{\"id\": 9001, \"name\": \"Near\", \"mixerTrack\": 3, \"gain\": 0.7, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"near.wav\"}}, " song "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 9002" song "${song}")
file(WRITE "${OUT}/build/Song.gridline.json" "${song}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/music/Song.zip" --format=zip Song.gridline.json near.wav WORKING_DIRECTORY "${OUT}/build" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not make the archive")
endif()
configure_file("${OUT}/music/Song.zip" "${OUT}/drive/Music/Song.zip" COPYONLY)
configure_file("${DEMO}" "${OUT}/other.gridline.json" COPYONLY)
file(GLOB_RECURSE musicBefore RELATIVE "${OUT}/music" "${OUT}/music/*")

function(run tag script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/other.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1280x800 --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()
function(must tag regex what)
  if(NOT "${${tag}_out}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${${tag}_out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
function(mustnot tag regex what)
  if("${${tag}_out}" MATCHES "${regex}")
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n${${tag}_out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
function(copiesNow out)
  file(GLOB c LIST_DIRECTORIES true "${cache}/*")
  set(${out} "${c}" PARENT_SCOPE)
endfunction()
function(musicUntouched what)
  file(GLOB_RECURSE now RELATIVE "${OUT}/music" "${OUT}/music/*")
  if(NOT now STREQUAL musicBefore)
    message(FATAL_ERROR "FAIL: something landed beside the archive (${what}): ${now}")
  endif()
endfunction()

set(zip "${OUT}/music/Song.zip")

# 1. A local zip: in the cache while open, gone when another project opens.
run(local "2 loadhold off\n3 forget cache-swept\n4 open \"${zip}\"\n6 waitfor project-loaded 60\n8 channels\n10 cache list\n14 forget project-loaded\n15 forget cache-swept\n16 open \"${OUT}/other.gridline.json\"\n18 waitfor project-loaded 60\n20 waitfor cache-swept 30\n22 cache list\n24 quit discard\n")
must(local "channel [^\n]*Near" "the project in the zip opened")
mustnot(local "Sample not found|Could not read sample" "its sample is found")
must(local "cache entry Song-[0-9a-f]+\n" "its copy is in the cache while it is open")
string(REGEX REPLACE "^.*cache listed\n" "" afterClose "${local_out}")
if(afterClose MATCHES "cache entry ")
  message(FATAL_ERROR "FAIL: the copy is still there after the project closed: ${afterClose}")
endif()
message(STATUS "ok - opening another project deletes the copy")
musicUntouched("open and close")
file(READ "${OUT}/cfg/gridline/recent.txt" recent)
if(NOT recent MATCHES "music/Song.zip")
  message(FATAL_ERROR "FAIL: the archive is not the recent entry: ${recent}")
endif()
message(STATUS "ok - the archive is the recent entry")

# ... and quitting.
run(quit "2 loadhold off\n4 open \"${zip}\"\n6 waitfor project-loaded 60\n8 cache list\n10 quit discard\n")
must(quit "cache entry Song-" "opened again: unpacked again")
copiesNow(left)
if(left)
  message(FATAL_ERROR "FAIL: quitting left ${left}")
endif()
message(STATUS "ok - quitting deletes the copy")
musicUntouched("quit")

# 2. A drive's copy stays.
run(drive "2 loadhold off\n4 open \"${OUT}/drive/Music/Song.zip\"\n6 waitfor project-loaded 60\n10 quit discard\n")
copiesNow(driveCopy)
list(LENGTH driveCopy n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL: a drive's copy should stay after closing: ${driveCopy}")
endif()
message(STATUS "ok - a drive's copy stays after closing")

# 3. The startup sweep. Made-up leftovers of a crash, as an earlier run would leave them.
function(fakeCopy name)
  file(WRITE "${cache}/${name}/near.wav" "x")
  file(WRITE "${cache}/${name}/.gridline-unpacked" "gridline-unpacked 1\n${OUT}/music/${name}.zip\n1\n1\nnear.wav\n")
  file(WRITE "${cache}/${name}/.gridline-local" "")
endfunction()
fakeCopy("Crashed-1111111111111111")
fakeCopy("Saved-2222222222222222")
file(WRITE "${cache}/Saved-2222222222222222/.gridline-kept" "")
fakeCopy("Backed-3333333333333333")
file(WRITE "${OUT}/cfg/gridline/Backup/Untitled (backup 2026-11-04 10-00-00).gridline.json" "{\"s\": \"${cache}/Backed-3333333333333333/near.wav\"}")
file(MAKE_DIRECTORY "${cache}.locks")
file(WRITE "${cache}/Half-4444444444444444.part-1-1/half.wav" "x")
file(WRITE "${cache}.locks/Half-4444444444444444.part-1-1" "")
run(sweep "2 waitfor cache-swept 40\n4 quit discard\n")
foreach(gone Crashed-1111111111111111 Half-4444444444444444.part-1-1)
  if(EXISTS "${cache}/${gone}")
    message(FATAL_ERROR "FAIL: the sweep left ${gone}")
  endif()
endforeach()
foreach(kept Saved-2222222222222222 Backed-3333333333333333)
  if(NOT EXISTS "${cache}/${kept}/near.wav")
    message(FATAL_ERROR "FAIL: the sweep removed ${kept}")
  endif()
endforeach()
if(NOT EXISTS "${driveCopy}/near.wav")
  message(FATAL_ERROR "FAIL: the sweep removed the drive's copy")
endif()
message(STATUS "ok - the startup sweep takes what a crash left and keeps what is needed")

# 4. The Settings control, with the real button (its place from one run, the click in the next; the
# layout is the same).
fakeCopy("Stale-5555555555555555")
file(WRITE "${cache}/Stale-5555555555555555/big.bin" "0123456789")
run(where "2 forget x\n40 cache state\n44 quit discard\n" --show files)
if(NOT where_out MATCHES "cache button ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "FAIL: no button: ${where_out}")
endif()
set(bx "${CMAKE_MATCH_1}")
set(by "${CMAKE_MATCH_2}")
if(bx EQUAL 0)
  message(FATAL_ERROR "FAIL: the Clear cache button did not draw: ${where_out}")
endif()
set(s "2 forget cache-cleared\n40 cache state\n42 move ${bx} ${by}\n46 down 0\n48 up 0\n52 shot \"${OUT}/ask.ppm\"\n56 key enter\n58 waitfor cache-cleared 30\n62 cache state\n70 shot \"${OUT}/done.ppm\"\n74 quit discard\n")
run(clear "${s}" --show files)
must(clear "cache bytes [1-9][0-9]* measured 1" "the section shows the size")
must(clear "cache clear removed [1-9][0-9]* open 0 saved 1 recovery 1 busy 0 unknown 0" "the button asks, clears what is not needed and says what it kept and why")
foreach(gone Stale-5555555555555555)
  if(EXISTS "${cache}/${gone}")
    message(FATAL_ERROR "FAIL: Clear cache left ${gone}")
  endif()
endforeach()
if(EXISTS "${driveCopy}")
  message(FATAL_ERROR "FAIL: Clear cache left the drive's copy")
endif()
foreach(kept Saved-2222222222222222 Backed-3333333333333333)
  if(NOT EXISTS "${cache}/${kept}/near.wav")
    message(FATAL_ERROR "FAIL: Clear cache removed ${kept}")
  endif()
endforeach()
if(NOT EXISTS "${OUT}/xdgcache" AND EXISTS "${OUT}/nothing")
  message(STATUS "(unused)")
endif()
message(STATUS "ok - Clear cache keeps what is needed")
foreach(f ask done)
  if(NOT EXISTS "${OUT}/${f}.ppm")
    message(FATAL_ERROR "FAIL: no screenshot ${f}")
  endif()
endforeach()

# 5. A real crash with unsaved work on a zipped project: the crash code's own recovery copy, in its own
# folder, holds the copy through the sweep and Clear cache, and lets it go once it has been dealt with.
file(GLOB leftBefore LIST_DIRECTORIES true "${cache}/Song-*")
if(leftBefore)
  file(REMOVE_RECURSE ${leftBefore})
endif()
set(ENV{GRIDLINE_CRASH_TEST_DIRTY} "1")
set(ENV{GRIDLINE_CRASH_TEST_FORCE} "segv@120")
execute_process(COMMAND "${APP}" "${zip}" --hidden --no-ui-sounds --no-update-check --size 800x600
                        --screenshot "${OUT}/crash.ppm" --frames 400
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
unset(ENV{GRIDLINE_CRASH_TEST_DIRTY})
unset(ENV{GRIDLINE_CRASH_TEST_FORCE})
file(WRITE "${OUT}/crash.out" "rc ${rc}\n${out}\n${err}")
if(rc EQUAL 0)
  message(FATAL_ERROR "FAIL: the crash test did not crash")
endif()
file(GLOB rescued "${OUT}/cfg/gridline/recovery/*.gridline")
list(LENGTH rescued n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL: ${n} recovery copies: ${rescued}")
endif()
file(GLOB crashed LIST_DIRECTORIES true "${cache}/Song-*")
list(LENGTH crashed n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL: the crash should leave one copy: ${crashed}")
endif()
get_filename_component(crashedName "${crashed}" NAME)
file(READ "${rescued}" rescuedText)
string(FIND "${rescuedText}" "${crashedName}" at)
if(at LESS 0)
  message(FATAL_ERROR "FAIL: the recovery copy does not point into the cached copy")
endif()
message(STATUS "ok - the recovery copy points into the cached copy")
run(afterCrash "2 waitfor cache-swept 40\n4 quit discard\n")
if(NOT EXISTS "${crashed}/near.wav")
  message(FATAL_ERROR "FAIL: the startup sweep removed a copy the recovery copy needs")
endif()
message(STATUS "ok - the startup sweep keeps it")
# (The crash's pop-up has been answered "Not now": it would otherwise cover the Settings button.)
file(GLOB crashReports "${OUT}/cfg/gridline/crash-reports/*.txt")
foreach(r ${crashReports})
  file(WRITE "${r}.seen" "seen\n")
endforeach()
run(clearCrash "${s}" --show files)
must(clearCrash "cache clear removed [0-9]+ open 0 saved 1 recovery 2 busy 0 unknown 0" "Clear cache says it kept it")
if(NOT EXISTS "${crashed}/near.wav")
  message(FATAL_ERROR "FAIL: Clear cache removed a copy the recovery copy needs")
endif()
message(STATUS "ok - Clear cache keeps it")
file(GLOB recoveryFiles "${OUT}/cfg/gridline/recovery/*")
file(REMOVE ${recoveryFiles})
# (On a slow machine the timed backup runs before the crash: a backup holds the copy too, rightly.)
file(GLOB timedBackups "${OUT}/cfg/gridline/Backup/*")
foreach(b ${timedBackups})
  file(READ "${b}" backupText)
  string(FIND "${backupText}" "${crashedName}" at)
  if(at GREATER -1)
    file(REMOVE "${b}")
  endif()
endforeach()
run(afterDealt "2 waitfor cache-swept 40\n4 quit discard\n")
if(EXISTS "${crashed}")
  file(GLOB_RECURSE stillThere "${OUT}/cfg/gridline/recovery/*" "${OUT}/cfg/gridline/Backup/*")
  run(whyKept "${s}" --show files)
  message(FATAL_ERROR "FAIL: the copy stayed after its recovery copy was dealt with\nreferences: ${stillThere}\n${afterDealt_out}\n${whyKept_out}")
endif()
message(STATUS "ok - once the recovery copy has been dealt with the copy goes")
