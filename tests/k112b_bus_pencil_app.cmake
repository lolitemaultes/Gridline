# Gridline - K-112B (R09-01): in Smooth, with automation shown, a Pencil click near the top of a bus
# track's row adds an automation point and never a region. Runs the demo hidden in Smooth (dummy
# audio, isolated config), shows the automation (A), finds the first bus track on screen ("plrows"),
# clicks with the Pencil 4 px under the row's top, saves, and checks:
#   1. no pattern or audio region lies on the bus track (before: Kick's pattern landed there);
#   2. the song has one more automation point than before;
#   3. the bus track keeps only its automation, and no other track gained a region;
#   4. (R09-10) with the typing keyboard on, R still arms recording (R plays no note on the A row);
#   5. (R10-01) an audio file dragged onto the bus track's lane, then onto its header, is refused:
#      no region on the bus track, no region anywhere, the same number of tracks;
#   6. (R10-02) in a new project, two Pencil clicks on its empty track make two new, empty
#      one-bar regions with patterns of their own (they placed the one existing pattern twice);
#      (R12-05) the new project shows one track row, while the song keeps its default tracks.
#   7. (R11-01) Pad Intro (Haze Pad) copied, Felt Keys' header clicked, the playhead at bar 9 and
#      Cmd+V twice: two regions on Felt Keys, one after the other (never stacked), each with a pattern
#      of its own whose notes play Felt Keys' sound; in No Overlap nothing on Felt Keys overlaps,
#      and (R12-01) each paste keeps Pad Intro's full length.
#   cmake -DAPP=<gridline-app> -DDEMO=<Gridline.gridline.json> -DOUT=<dir> -P k112b_bus_pencil_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(run tag input)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"logic\", \"keys.profile\": \"logic\", \"ui.menuStyle\": \"logic\"}}\n")
  file(WRITE "${cfg}/input.txt" "5 toasts clear\n${input}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  configure_file("${DEMO}" "${OUT}/${tag}.gridline.json" COPYONLY)
  execute_process(COMMAND "${APP}" "${OUT}/${tag}.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x1400 --layout logic --layout-dev
                          --dev-input "${cfg}/input.txt" --frames 70
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_log "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# The song's automation points, and the regions (non-automation clips) per track, from a save.
function(tally file pointsVar regionsVar)
  file(READ "${file}" j)
  set(points 0)
  string(JSON na LENGTH "${j}" automations)
  if(na GREATER 0)
    math(EXPR last "${na} - 1")
    foreach(i RANGE ${last})
      string(JSON np LENGTH "${j}" automations ${i} points)
      math(EXPR points "${points} + ${np}")
    endforeach()
  endif()
  set(regions "")
  string(JSON nc LENGTH "${j}" playlist)
  math(EXPR last "${nc} - 1")
  foreach(i RANGE ${last})
    string(JSON kind ERROR_VARIABLE noKind GET "${j}" playlist ${i} kind)
    if(noKind)
      set(kind "pattern")
    endif()
    if(NOT kind STREQUAL "automation")
      string(JSON tr GET "${j}" playlist ${i} track)
      list(APPEND regions "${tr}")
    endif()
  endforeach()
  set(${pointsVar} ${points} PARENT_SCOPE)
  set(${regionsVar} "${regions}" PARENT_SCOPE)
endfunction()

# ---- the rows with automation shown
run(probe "10 key a\n24 plrows\n30 save \"${OUT}/before.json\"\n34 quit discard\n")
string(REGEX MATCHALL "plrow [0-9]+ \"[^\"]*\" [-0-9]+ [-0-9]+ top [-0-9]+ h [-0-9]+ lane [-0-9]+ bus 1 grid [-0-9]+ [-0-9]+ [-0-9]+" busRows "${probe_log}")
set(bus -1)
foreach(l ${busRows})
  string(REGEX MATCH "plrow ([0-9]+) \"([^\"]*)\" [-0-9]+ [-0-9]+ top ([-0-9]+) h ([-0-9]+) lane ([-0-9]+) bus 1 grid ([-0-9]+) ([-0-9]+) ([-0-9]+)" m "${l}")
  if(bus LESS 0 AND CMAKE_MATCH_5 GREATER 0 AND CMAKE_MATCH_3 GREATER_EQUAL CMAKE_MATCH_7)
    math(EXPR bottom "${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}")
    if(bottom LESS_EQUAL CMAKE_MATCH_8)
      set(bus ${CMAKE_MATCH_1})
      set(busName "${CMAKE_MATCH_2}")
      math(EXPR cy "${CMAKE_MATCH_3} + 4")
      math(EXPR cx "${CMAKE_MATCH_6} + 260")
      math(EXPR my "${CMAKE_MATCH_3} + ${CMAKE_MATCH_4} / 2")
      math(EXPR hx "${CMAKE_MATCH_6} - 140")
    endif()
  endif()
endforeach()
check("a bus track with its automation lane is on screen (track ${bus} \"${busName}\")" bus GREATER_EQUAL 0)
tally("${OUT}/before.json" p0 r0)
list(FIND r0 ${bus} busHad)
check("the demo's bus track holds no region to begin with" busHad EQUAL -1)
list(LENGTH r0 n0)

# ---- a Pencil click 4 px under the bus row's top (above its curve)
run(pencil "10 key a\n20 pltool draw\n26 move ${cx} ${cy}\n30 down 0\n32 up 0\n40 save \"${OUT}/after.json\"\n44 quit discard\n")
tally("${OUT}/after.json" p1 r1)
list(FIND r1 ${bus} busHas)
check("no region on the bus track after the Pencil click" busHas EQUAL -1)
list(LENGTH r1 n1)
check("no region added anywhere (${n0} -> ${n1})" n1 EQUAL n0)
math(EXPR want "${p0} + 1")
check("the click added one automation point (${p0} -> ${p1})" p1 EQUAL want)

# ---- R09-10: with the typing keyboard on, R (no note on the A row) still starts recording
run(typing "6 typing on\n12 typing state\n16 key r\n24 recording\n30 quit discard\n")
check("R arms recording while the typing keyboard is on" "${typing_log}" MATCHES "recording frame 24: armed 1")

# ---- R10-01: an audio file dragged onto the bus track's lane, then onto its header
configure_file("${CMAKE_CURRENT_LIST_DIR}/../assets/sounds/prism/save.wav" "${OUT}/tone.wav" COPYONLY)
run(drop "10 key a\n20 dragenter ${cx} ${my} \"${OUT}/tone.wav\"\n22 dragmove ${cx} ${my}\n24 dragmove ${cx} ${my}\n26 drop ${cx} ${my}\n40 dragenter ${hx} ${my} \"${OUT}/tone.wav\"\n42 dragmove ${hx} ${my}\n44 dragmove ${hx} ${my}\n46 drop ${hx} ${my}\n60 save \"${OUT}/drop.json\"\n64 quit discard\n")
tally("${OUT}/drop.json" p2 r2)
list(FIND r2 ${bus} busDrop)
check("no region on the bus track after the file drops (lane and header)" busDrop EQUAL -1)
list(LENGTH r2 n2)
check("the file drops added no region anywhere (${n0} -> ${n2})" n2 EQUAL n0)
file(READ "${OUT}/before.json" jb)
file(READ "${OUT}/drop.json" jd)
string(JSON tb LENGTH "${jb}" tracks)
string(JSON td LENGTH "${jd}" tracks)
check("the file drops made no track (${tb} -> ${td})" td EQUAL tb)

# ---- R10-02: two Pencil clicks on the empty track of a new project
# R12-05: a new project shows only its first track (the song's spare default rows take no room).
run(blank "6 template -\n16 plrows\n20 save \"${OUT}/blank.json\"\n24 quit discard\n")
string(REGEX MATCHALL "plrow [0-9]+ \"[^\"]*\" [-0-9]+ [-0-9]+ top [-0-9]+ h [1-9][0-9]* lane [-0-9]+ bus 0 grid [-0-9]+ [-0-9]+ [-0-9]+" rows "${blank_log}")
list(LENGTH rows nrows)
check("the new project shows one track (${nrows})" nrows EQUAL 1)
file(READ "${OUT}/blank.json" jbl)
string(JSON nbt LENGTH "${jbl}" tracks)
check("the song keeps its default tracks for the other layouts (${nbt})" nbt GREATER 1)
set(clicks "")
set(f 20)
foreach(k 0 1)
  list(GET rows 0 l)
  string(REGEX MATCH "top ([-0-9]+) h ([-0-9]+) lane [-0-9]+ bus 0 grid ([-0-9]+)" m "${l}")
  math(EXPR py "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} / 2")
  math(EXPR px "${CMAKE_MATCH_3} + 120 + ${k} * 200")
  math(EXPR f1 "${f} + 2")
  math(EXPR f2 "${f} + 4")
  string(APPEND clicks "${f} move ${px} ${py}\n${f1} down 0\n${f2} up 0\n")
  math(EXPR f "${f} + 12")
endforeach()
run(pencil2 "6 template -\n14 pltool draw\n${clicks}${f} save \"${OUT}/pencil2.json\"\n80 quit discard\n")
file(READ "${OUT}/pencil2.json" jp)
string(JSON nc LENGTH "${jp}" playlist)
check("two Pencil clicks made two regions (${nc})" nc EQUAL 2)
string(JSON pa GET "${jp}" playlist 0 pattern)
string(JSON pb GET "${jp}" playlist 1 pattern)
check("each Pencil region has a pattern of its own (${pa}, ${pb})" NOT pa STREQUAL pb)

# ---- R11-01: Pad Intro (Haze Pad, track 4) pasted twice onto Felt Keys (track 6) at bar 9
file(READ "${DEMO}" jd0)
string(JSON nc0 LENGTH "${jd0}" playlist)
math(EXPR last0 "${nc0} - 1")
set(padClip -1)
set(padStart 999999999)
set(keysPat -1)
set(keysStart 999999999)
set(oldIds "")
foreach(i RANGE ${last0})
  string(JSON tr GET "${jd0}" playlist ${i} track)
  string(JSON st GET "${jd0}" playlist ${i} start)
  string(JSON id GET "${jd0}" playlist ${i} id)
  list(APPEND oldIds ${id})
  if(tr EQUAL 4 AND st LESS padStart)
    set(padStart ${st})
    set(padClip ${id})
    string(JSON padPat GET "${jd0}" playlist ${i} pattern)
    string(JSON padLen GET "${jd0}" playlist ${i} length)
  endif()
  if(tr EQUAL 6 AND st LESS keysStart)
    set(keysStart ${st})
    string(JSON keysPat GET "${jd0}" playlist ${i} pattern)
  endif()
endforeach()
check("the demo has Pad Intro on Haze Pad and a region on Felt Keys (${padClip}, ${keysPat})" padClip GREATER 0 AND keysPat GREATER 0)
# Felt Keys' sound: the channel its first region's notes play.
string(JSON np0 LENGTH "${jd0}" patterns)
math(EXPR lastp "${np0} - 1")
set(keysCh "")
foreach(i RANGE ${lastp})
  string(JSON pid GET "${jd0}" patterns ${i} id)
  if(pid EQUAL keysPat)
    string(JSON keysCh MEMBER "${jd0}" patterns ${i} notes 0)
  endif()
endforeach()
run(probe2 "16 plrows\n20 quit discard\n")
string(REGEX MATCH "plrow 4 \"[^\"]*\" ([-0-9]+) ([-0-9]+)" m4 "${probe2_log}")
math(EXPR hx4 "${CMAKE_MATCH_1} + 150")
set(hy4 ${CMAKE_MATCH_2})
string(REGEX MATCH "plrow 6 \"[^\"]*\" ([-0-9]+) ([-0-9]+)" m6 "${probe2_log}")
math(EXPR hx6 "${CMAKE_MATCH_1} + 150")
set(hy6 ${CMAKE_MATCH_2})
run(paste "10 move ${hx4} ${hy4}\n12 down 0\n14 up 0\n18 clipsel ${padClip}\n20 mod super 1\n21 key c\n22 mod super 0\n26 move ${hx6} ${hy6}\n28 down 0\n30 up 0\n34 seekbeat 32 seek\n38 mod super 1\n39 key v\n40 mod super 0\n46 mod super 1\n47 key v\n48 mod super 0\n56 save \"${OUT}/paste.json\"\n60 quit discard\n")
file(READ "${OUT}/paste.json" jq)
string(JSON ncq LENGTH "${jq}" playlist)
math(EXPR lastq "${ncq} - 1")
set(newStarts "")
set(newPats "")
set(newLens "")
set(spans "")
foreach(i RANGE ${lastq})
  string(JSON tr GET "${jq}" playlist ${i} track)
  if(NOT tr EQUAL 6)
    continue()
  endif()
  string(JSON id GET "${jq}" playlist ${i} id)
  string(JSON st GET "${jq}" playlist ${i} start)
  string(JSON ln ERROR_VARIABLE noLen GET "${jq}" playlist ${i} length)
  if(noLen)
    set(ln 0)
  endif()
  math(EXPR en "${st} + ${ln}")
  list(APPEND spans "${st}:${en}")
  list(FIND oldIds ${id} wasThere)
  if(wasThere EQUAL -1)
    string(JSON pp GET "${jq}" playlist ${i} pattern)
    list(APPEND newStarts ${st})
    list(APPEND newPats ${pp})
    list(APPEND newLens ${ln})
  endif()
endforeach()
list(LENGTH newStarts nNew)
check("two regions pasted on Felt Keys (${newStarts})" nNew EQUAL 2)
list(SORT newStarts COMPARE NATURAL)
list(GET newStarts 0 s0)
list(GET newStarts 1 s1)
math(EXPR want1 "3072 + ${padLen}")
check("the first at the playhead, the second right after it (${s0}, ${s1})" s0 EQUAL 3072 AND s1 EQUAL want1)
list(GET newPats 0 q0)
list(GET newPats 1 q1)
check("each pasted region has a pattern of its own (${q0}, ${q1}, Pad Intro ${padPat})" NOT q0 EQUAL q1 AND NOT q0 EQUAL padPat AND NOT q1 EQUAL padPat)
string(JSON npq LENGTH "${jq}" patterns)
math(EXPR lastpq "${npq} - 1")
set(keysNotes 0)
foreach(i RANGE ${lastpq})
  string(JSON pid GET "${jq}" patterns ${i} id)
  if(pid EQUAL q0 OR pid EQUAL q1)
    string(JSON ch MEMBER "${jq}" patterns ${i} notes 0)
    string(JSON nch LENGTH "${jq}" patterns ${i} notes)
    if(ch STREQUAL keysCh AND nch EQUAL 1)
      math(EXPR keysNotes "${keysNotes} + 1")
    endif()
  endif()
endforeach()
check("both pasted regions play Felt Keys' sound (channel ${keysCh})" keysNotes EQUAL 2)
# No Overlap: no two regions on Felt Keys overlap.
list(SORT spans COMPARE NATURAL)
set(prevEnd -1)
set(overlap 0)
foreach(sp ${spans})
  string(REPLACE ":" ";" se "${sp}")
  list(GET se 0 sa)
  list(GET se 1 sb)
  if(sa LESS prevEnd)
    set(overlap 1)
  endif()
  set(prevEnd ${sb})
endforeach()
check("no regions overlap on Felt Keys after the pastes (${spans})" overlap EQUAL 0)
# R12-01: each paste keeps the full length of what was copied (the regions under it give way).
list(GET newLens 0 l0)
list(GET newLens 1 l1)
check("both pastes are full length (${l0}, ${l1}; Pad Intro ${padLen})" l0 EQUAL padLen AND l1 EQUAL padLen)
