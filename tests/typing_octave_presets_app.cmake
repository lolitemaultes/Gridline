# Gridline: GitHub issue 42, the typing keyboard's octave while presets and instruments change, in
# the real app (hidden, isolated config and HOME, SDL's dummy audio driver), in all four layouts.
# One octave for the whole app. Picking presets on built-in instruments (Plasma, Sampler, Tercet),
# replacing the instrument (built-in and, on macOS, Apple's DLS synth as a third-party Audio Unit),
# selecting other channels and opening and closing their plugin windows never change it, and the
# first note key always plays the same note: 48 in Studio (Z), 60 on the A row of Clips and Smooth
# (A), and 60 in the Tracker (Z, C-4) whatever has the keyboard: its pattern editor, which types C-4,
# or a plugin window in front. Before the fix the Tracker's keys played an octave lower as soon as a
# plugin window or the instrument list had the keyboard.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P typing_octave_presets_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")

function(fail what)
  message(FATAL_ERROR "FAIL: ${what}\n${out}")
endfunction()

# A third-party instrument: Apple's DLS synth, an Audio Unit every Mac has. Only it is described (the
# CLI's scanner, as a scan would) and put in each run's plugin cache: no other plugin is scanned.
set(dls "")
set(dlsCache "")
if(APPLE AND DEFINED CLI)
  file(MAKE_DIRECTORY "${OUT}")
  execute_process(COMMAND "${CLI}" --scan-plugin au "aumu/dls /appl" --out "${OUT}/dls.json" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  if(rc EQUAL 0 AND EXISTS "${OUT}/dls.json")
    file(READ "${OUT}/dls.json" one)
    string(JSON ok ERROR_VARIABLE jerr GET "${one}" ok)
    if(ok)
      set(dls "au:aumu/dls /appl")
      set(dlsCache "{\"version\": 3, \"bundles\": [${one}]}")
    endif()
  endif()
  if(NOT dls)
    message(STATUS "Apple's DLS synth could not be described: the third-party part is left out")
  endif()
endif()

# layout id, the first note key, the note it must play, the shortcut set
foreach(run "studio;z;48;studio" "live;a;60;live" "logic;a;60;logic" "tracker;z;60;tracker")
  list(GET run 0 lay)
  list(GET run 1 key)
  list(GET run 2 note)
  list(GET run 3 keyset)
  set(dir "${OUT}/${lay}")
  file(MAKE_DIRECTORY "${dir}/cfg/gridline" "${dir}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_CONFIG_HOME} "${dir}/cfg")
  set(ENV{HOME} "${dir}/home")
  file(WRITE "${dir}/cfg/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${lay}\", \"keys.profile\": \"${keyset}\"}}\n")
  configure_file("${DEMO}" "${dir}/song.gridline.json" COPYONLY)
  if(dlsCache)
    file(WRITE "${dir}/cfg/gridline/plugin-cache.json" "${dlsCache}")
  endif()

  set(script "5 toasts clear\n6 typing on\n8 addvia rack gl.plasma\n")
  set(f 12)
  set(checks 0)
  macro(play)  # the first note key down, the state, the key up
    string(APPEND script "${f} sdlkey ${key} down\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} typing where\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey ${key} up\n")
    math(EXPR f "${f} + 3")
    math(EXPR checks "${checks} + 1")
  endmacro()
  macro(then line)
    string(APPEND script "${f} ${line}\n")
    math(EXPR f "${f} + 4")
  endmacro()
  macro(openwin name)  # the channel's plugin window opened and in front, as a click on it does
    if(lay STREQUAL "tracker")
      then("tracker editors plugin \"${name}\"")
    else()
      then("typing select \"${name}\" open")
    endif()
  endmacro()
  if(lay STREQUAL "tracker")
    # The pattern editor has the keyboard: Z types C-4 (60) on track 6 (Chords, empty).
    then("tracker focus")
    string(APPEND script "${f} tracker cursor 6 0 0 0\n${f} tracker edit on\n")
    math(EXPR f "${f} + 2")
    string(APPEND script "${f} sdlkey z down\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey z up\n")
    math(EXPR f "${f} + 2")
    then("tracker dump")
    then("tracker edit off")
  endif()
  # The Plasma channel with its window open: its presets, one after another.
  openwin("Plasma")
  play()
  foreach(p 1 2 3 7)
    then("pickpreset ${p}")
    play()
  endforeach()
  # Other instruments in its place, with their presets.
  foreach(t gl.sampler gl.synth gl.fm ${dls})
    then("replace \"${t}\"")
    # (The Tracker: a third-party plugin's window is a window of its own, not one of the interface's,
    # so the pattern editor keeps the keyboard and plays the key itself, at the octave checked above.)
    if(lay STREQUAL "tracker" AND t MATCHES "^au:")
      then("pickpreset 1")
      then("pickpreset 2")
      then("closeplugins")
      continue()
    endif()
    play()
    then("pickpreset 1")
    play()
    then("pickpreset 2")
    play()
  endforeach()
  # Other channels: their windows opened, presets picked, then only selected.
  foreach(c Bass Chords Perc Kick)
    openwin("${c}")
    play()
    then("pickpreset 1")
    play()
    then("typing select \"${c}\"")
    play()
    if(lay STREQUAL "tracker")  # the lower band's Instrument screen with the keyboard
      then("tracker editors close")
      then("tracker editors open instrument \"${c}\"")
      then("tracker editors focus")
      play()
    endif()
  endforeach()
  then("closeplugins")
  if(lay STREQUAL "tracker")
    # K-391 (user 2026-11-22): an instrument without a Tracker screen (the Kick) opens its editor in a
    # floating window, not the lower band, so with every plugin window closed the pattern editor has
    # the keys again (HUNT2-1119) and plays a note key itself, not through the typing keyboard: Z,
    # in edit mode, types C-4 on the next row, at the same octave.
    then("tracker dump")
    string(APPEND script "${f} tracker cursor 6 1 0 0\n${f} tracker edit on\n")
    math(EXPR f "${f} + 2")
    string(APPEND script "${f} sdlkey z down\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey z up\n")
    math(EXPR f "${f} + 2")
    then("tracker dump")
    then("tracker edit off")
  else()
    play()
  endif()
  then("typing octave")
  math(EXPR frames "${f} + 4")
  file(WRITE "${dir}/input.txt" "${script}")
  execute_process(COMMAND "${APP}" "${dir}/song.gridline.json" --hidden --no-ui-sounds --size 1440x900 --layout ${lay}
                          --dev-input "${dir}/input.txt" --fixed-dt 16 --frames ${frames}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${dir}/run.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    fail("${lay}: gridline-app failed (${rc})")
  endif()
  if(lay STREQUAL "tracker")
    string(REGEX MATCH "tracker dump frame [0-9]+:.*tracker dump end" d "${out}")
    if(NOT d MATCHES "cell 6 0 0 C-4")
      fail("tracker: the pattern editor did not type C-4 with Z at octave 4")
    endif()
    string(REGEX MATCHALL "tracker dump frame [0-9]+: [^\n]*" dumps "${out}")
    list(LENGTH dumps nd)
    if(nd LESS 3)
      fail("tracker: ${nd} pattern dumps, not 3")
    endif()
    math(EXPR last "${nd} - 2")
    list(GET dumps ${last} back)
    if(NOT back MATCHES " keyboard 1 ")
      fail("tracker: with the plugin windows closed the pattern editor does not have the keys: ${back}")
    endif()
    if(NOT d MATCHES "cell 6 1 0 C-4")
      fail("tracker: with the plugin windows closed, Z did not type C-4 at octave 4 in the pattern editor")
    endif()
  endif()
  string(REGEX MATCHALL "typing where frame [0-9]+: [^\n]*" lines "${out}")
  list(LENGTH lines n)
  if(NOT n EQUAL checks)
    fail("${lay}: ${n} of ${checks} reports")
  endif()
  set(types "")
  foreach(l IN LISTS lines)
    if(NOT l MATCHES "notes ${note} octave 4 ")
      fail("${lay}: the first note key did not play ${note} at octave 4: ${l}")
    endif()
    if(NOT l MATCHES "steps 0$")
      fail("${lay}: the octave moved without an octave key: ${l}")
    endif()
    string(REGEX MATCH "type ([^ ]+)" t "${l}")
    list(APPEND types "${CMAKE_MATCH_1}")
  endforeach()
  list(REMOVE_DUPLICATES types)
  list(LENGTH types nt)
  if(dls AND NOT lay STREQUAL "tracker" AND NOT types MATCHES "au:aumu/dls")
    fail("${lay}: the DLS synth never played")
  endif()
  if(nt LESS 6)
    fail("${lay}: the keys played only ${nt} kinds of instrument (${types})")
  endif()
  if(NOT out MATCHES "typing octave 4 steps 0")
    fail("${lay}: the octave is not 4 at the end")
  endif()
  message(STATUS "${lay}: ${n} notes on ${nt} instruments (${types}), every one ${note} at octave 4")
endforeach()
message(STATUS "typing octave presets: PASS")
