# Gridline — J-204: Platter's hot cue pads tapped as fast as the input allows, in the app, driven
# like a user through the dev input hooks (hidden, isolated config, SDL's dummy audio driver).
# Deck A: pad 1 is set while stopped, pad 2 while playing; then, playing, 20 taps alternating the
# pads with press and release a frame apart and 20 with both in the same frame, and 10 + 10 on
# pad 1 alone; stopped, the same (20 + 10 + 10 + 10); 10 hot cue key notes (Gate, on the setup's
# channel: the default song's first channel is a kick); a pad held while Shift goes down before its release;
# a right-click clearing pad 2 and one on the empty pad 3. Every press is acted on (the engine's
# count), the pads send as many releases as presses, the deck ends stopped on pad 1, pad 2 is
# cleared, and the cue edits are one undo step (jumps add none).
# The waits are on the engine's own count ("platter-hot-<n>-playing|stopped"), not on time.
# Trace lines: "platter: hot A down <n> up <n> acted <n> set <n> playing <0|1> pos <f> h1 <f> h2 <f>".
#   cmake -DAPP=<gridline-app> -DTESTBIN=<gridline_test_platter> -DOUT=<dir> -P j204_hotcue_taps.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg")
file(MAKE_DIRECTORY "${OUT}/home")
execute_process(COMMAND "${TESTBIN}" writetrack "${OUT}/Deck A 120.wav" 120 RESULT_VARIABLE rc1)
execute_process(COMMAND "${TESTBIN}" writetrack "${OUT}/Deck B 100.wav" 100 RESULT_VARIABLE rc2)
if(NOT rc1 EQUAL 0 OR NOT rc2 EQUAL 0)
  message(FATAL_ERROR "FAIL: could not write the test tracks (${rc1} ${rc2})")
endif()
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/home")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_PLATTER_TRACE} "1")
set(ENV{GRIDLINE_PLATTER_DEMO} "${OUT}/Deck A 120.wav")
set(ENV{GRIDLINE_PLATTER_DEMO_B} "${OUT}/Deck B 100.wav")
set(ENV{SDL_AUDIODRIVER} "dummy")

function(run tag frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --plugin gl.platter --size 1700x1150 --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(WRITE "${OUT}/${tag}.log" "${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

macro(locate out name)
  string(REGEX MATCHALL "platter: rect ${name} [0-9-]+ [0-9-]+ [0-9-]+ [0-9-]+" all_ "${out}")
  set(last_ "")
  if(all_)
    list(GET all_ -1 last_)
  endif()
  string(REGEX MATCH "platter: rect ${name} ([0-9-]+) ([0-9-]+) ([0-9-]+) ([0-9-]+)" _ "${last_}")
  check("the ${name} control is shown" CMAKE_MATCH_1 MATCHES "[0-9]")
  math(EXPR ${name}_x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR ${name}_y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
endmacro()

# the last hot line: <var>_down, _up, _acted, _set, _playing, _pos, _h1, _h2
macro(hotline out var)
  string(REGEX MATCHALL "platter: hot A [^\n]*" all_ "${out}")
  list(GET all_ -1 l_)
  string(REGEX MATCH "down ([0-9]+) up ([0-9]+) acted ([0-9]+) set ([0-9]+) playing ([01]) pos ([0-9-]+) h1 ([0-9-]+) h2 ([0-9-]+)" _ "${l_}")
  set(${var}_down "${CMAKE_MATCH_1}")
  set(${var}_up "${CMAKE_MATCH_2}")
  set(${var}_acted "${CMAKE_MATCH_3}")
  set(${var}_set "${CMAKE_MATCH_4}")
  set(${var}_playing "${CMAKE_MATCH_5}")
  set(${var}_pos "${CMAKE_MATCH_6}")
  set(${var}_h1 "${CMAKE_MATCH_7}")
  set(${var}_h2 "${CMAKE_MATCH_8}")
  message(STATUS "${l_}")
endmacro()

# ---- where the controls are ("No controller" answers the first open's question)
run(setup 30 "# nothing\n")
set(last_out "${setup_out}")
locate("${setup_out}" none)
set(answer "8 move ${none_x} ${none_y}
10 down 0
11 up 0
12 waitfor platter-ready 300
")
run(decks 20 "${answer}")
set(last_out "${decks_out}")
locate("${decks_out}" playA)
locate("${decks_out}" hotA1)
locate("${decks_out}" hotA2)
locate("${decks_out}" hotA3)

# ---- the taps
set(s "${answer}")
# pad 1 set while stopped (on the cue), play, pad 2 set while playing
string(APPEND s "20 move ${hotA1_x} ${hotA1_y}\n22 down 0\n23 up 0\n24 waitfor platter-hot-1-stopped 60\n")
string(APPEND s "26 move ${playA_x} ${playA_y}\n28 down 0\n29 up 0\n30 waitfor platter-hot-1-playing 60\n32 waitfor j204-never 1\n")
string(APPEND s "40 move ${hotA2_x} ${hotA2_y}\n42 down 0\n43 up 0\n44 waitfor platter-hot-2-playing 60\n45 plug\n")
set(f 50)
set(acted 2)
# n taps alternating pads 1 and 2 (alt = 1) or on pad 1 only (alt = 0, double-click speed):
# same = 1 presses and releases in one frame, else a frame apart
macro(taps n same alt state)
  foreach(k RANGE 1 ${n})
    math(EXPR odd "${k} % 2")
    if(odd OR NOT ${alt})
      set(px ${hotA1_x})
      set(py ${hotA1_y})
    else()
      set(px ${hotA2_x})
      set(py ${hotA2_y})
    endif()
    math(EXPR f1 "${f} + 1")
    math(EXPR f2 "${f} + 2")
    if(${same})
      string(APPEND s "${f} move ${px} ${py}\n${f1} down 0\n${f1} up 0\n")
      set(f ${f2})
    else()
      string(APPEND s "${f} move ${px} ${py}\n${f1} down 0\n${f2} up 0\n")
      math(EXPR f "${f} + 3")
    endif()
  endforeach()
  math(EXPR acted "${acted} + ${n}")
  string(APPEND s "${f} waitfor platter-hot-${acted}-${state} 60\n")
  math(EXPR f "${f} + 2")
endmacro()
taps(20 0 1 playing)
taps(20 1 1 playing)
taps(10 0 0 playing)
taps(10 1 0 playing)
# stop (the play button), then the same on the stopped deck (each tap previews and returns)
string(APPEND s "${f} move ${playA_x} ${playA_y}\n")
math(EXPR f "${f} + 2")
string(APPEND s "${f} down 0\n")
math(EXPR f "${f} + 1")
string(APPEND s "${f} up 0\n")
math(EXPR f "${f} + 1")
string(APPEND s "${f} waitfor platter-hot-${acted}-stopped 60\n")
math(EXPR f "${f} + 2")
taps(20 0 1 stopped)
taps(10 1 1 stopped)
taps(10 0 0 stopped)
taps(10 1 0 stopped)
# the hot cue keys (notes 60 and 61 on the channel, Gate): pressed and released fast
foreach(k RANGE 1 10)
  math(EXPR odd "${k} % 2")
  if(odd)
    set(n 60)
  else()
    set(n 61)
  endif()
  math(EXPR f1 "${f} + 1")
  string(APPEND s "${f} noteon 1 ${n}\n${f1} noteoff 1 ${n}\n")
  math(EXPR f "${f} + 2")
endforeach()
math(EXPR acted "${acted} + 10")
string(APPEND s "${f} waitfor platter-hot-${acted}-stopped 60\n")
math(EXPR f "${f} + 2")
# pad 1 held, Shift goes down before the release (the release still ends the preview)
math(EXPR f1 "${f} + 1")
math(EXPR f2 "${f} + 2")
math(EXPR f3 "${f} + 3")
math(EXPR f4 "${f} + 4")
string(APPEND s "${f} move ${hotA1_x} ${hotA1_y}\n${f1} down 0\n${f2} mod shift 1\n${f3} up 0\n${f4} mod shift 0\n")
math(EXPR f "${f} + 6")
math(EXPR acted "${acted} + 1")
string(APPEND s "${f} waitfor platter-hot-${acted}-stopped 60\n")
math(EXPR f "${f} + 2")
# right-click: clears pad 2; on the empty pad 3 it does nothing
math(EXPR f1 "${f} + 1")
math(EXPR f2 "${f} + 2")
math(EXPR f3 "${f} + 3")
math(EXPR f4 "${f} + 4")
math(EXPR f5 "${f} + 5")
string(APPEND s "${f} move ${hotA2_x} ${hotA2_y}\n${f1} down 1\n${f2} up 1\n${f3} move ${hotA3_x} ${hotA3_y}\n${f4} down 1\n${f5} up 1\n")
math(EXPR f "${f} + 30")
string(APPEND s "${f} plug\n")
math(EXPR frames "${f} + 10")
run(taps ${frames} "${s}")
set(last_out "${taps_out}")
hotline("${taps_out}" e)
check("every press is acted on (${acted} presses, the deck acted on ${e_acted})" e_acted EQUAL ${acted})
math(EXPR pads "${acted} - 10")
check("the pads sent ${pads} presses (${e_down})" e_down EQUAL ${pads})
check("... and as many releases (${e_up})" e_up EQUAL e_down)
check("the deck ends stopped" e_playing EQUAL 0)
check("... on pad 1 (${e_pos} = ${e_h1})" e_pos EQUAL e_h1)
check("right-click cleared pad 2, pad 3 stays empty" e_set EQUAL 1 AND e_h2 EQUAL -1)
string(REGEX MATCHALL "plug frame [0-9]+: undo [0-9]+" plugs "${taps_out}")
list(LENGTH plugs np)
check("the undo position was read twice" np EQUAL 2)
list(GET plugs 0 p0)
list(GET plugs 1 p1)
string(REGEX MATCH "undo ([0-9]+)" _ "${p0}")
set(u0 ${CMAKE_MATCH_1})
string(REGEX MATCH "undo ([0-9]+)" _ "${p1}")
set(u1 ${CMAKE_MATCH_1})
# (after the sets: at most one more step for the clear; the jumps and previews add none)
math(EXPR du "${u1} - ${u0}")
check("the taps add no undo steps (${u0} -> ${u1})" du LESS_EQUAL 1)
