# Gridline - 0.7.8: the Audio clip window (one window for an audio clip and its sampler channel).
# Runs the app hidden (isolated config, fixed frame time) on a copy of the test song with a sampler
# channel playing an audio clip (Take, clip 70) and a sampler channel no clip plays (Kick), and checks
# in each layout (Studio, Clips, Smooth, Tracker):
#   A. the ways in: a double-click opens the clip on its Clip tab, Edit clip... on its Clip tab,
#      the channel settings of the clip's channel on its Playback tab (the clip with it);
#   B. every tab draws (in the Clips band, its own view: each tab's cards brought into view), the
#      header menu opens, and the checklist of the two old windows' controls has nothing missing;
#   C. one control of each card changes the song in one undo step, and undo brings it back (the
#      song saved after every change and its undo equals the song before);
#   D. a sampler channel with no clip: Channel settings open the window on Playback without the
#      clip's tabs (the Clip tab asked for shows Playback), every other tab draws, nothing missing,
#      its controls one undo step each.
#   E. (Clips) the device band shows a sampler channel as the band's own view in its card (the head
#      card, the sample display, a card per module; never a chip row or a popover): a selected sampler
#      with no clip, every tab's cards brought into view, the header menu opens, nothing missing, its
#      controls one undo step each; the clip's sampler shows its clip there; in a tall window Channel
#      settings show it in the sampler's card on Playback (nothing above the band, no window), drawn
#      once, by the band; every tab, nothing missing, one undo step each.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k078_clipwin_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Kick.wav" COPYONLY)
file(READ "${DEMO}" demo)
set(chanJson "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, {\"color\": 14251600, \"gain\": 0.8, \"id\": 61, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Kick\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Kick.wav\", \"params\": []}}, ")
set(clipJson "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 7, \"start\": 0, \"length\": 1536, \"pattern\": 0, \"gain\": 1.0}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${chanJson}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clipJson}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag layout frames script)
  # (the Tracker opens a Sampler on its classic Sample editor by default since K-391; this test checks the
  # Advanced editor's controls, so it starts there. k078_tracker_clipform checks the classic view and the tabs)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\", \"keys.profile\": \"${layout}\", \"ui.menuStyle\": \"${layout}\", \"tracker.sampleView\": \"advanced\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  if(NOT DEFINED RUN_SIZE)
    set(RUN_SIZE 1440x900)
  endif()
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size ${RUN_SIZE} --frames ${frames}
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# The n-th (0-based) "clipeditor state" line's fields.
function(stateAt out n host clip tab channel mode)
  string(REGEX MATCHALL "clipeditor state frame [0-9]+ host [a-z]+ shown [01] clip [0-9]+ tab [0-9]+ [^\n]* channel [0-9]+ mode [a-z]+" lines "${out}")
  list(LENGTH lines cnt)
  if(n GREATER_EQUAL cnt)
    message(FATAL_ERROR "FAIL: no state line ${n} (${cnt})\n${out}")
  endif()
  list(GET lines ${n} l)
  string(REGEX MATCH "host ([a-z]+) shown ([01]) clip ([0-9]+) tab ([0-9]+) .* channel ([0-9]+) mode ([a-z]+)" m "${l}")
  set(${host} "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${clip} ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${tab} ${CMAKE_MATCH_4} PARENT_SCOPE)
  set(${channel} ${CMAKE_MATCH_5} PARENT_SCOPE)
  set(${mode} ${CMAKE_MATCH_6} PARENT_SCOPE)
endfunction()

# Pokes at `f`, each followed by an undo; appends to the script variable named `var`; returns the next frame.
function(pokes var f keys)
  set(s "${${var}}")
  foreach(k ${keys})
    math(EXPR u "${f} + 2")
    string(APPEND s "${f} clipeditor poke ${k}\n${u} undo\n")
    math(EXPR f "${f} + 4")
  endforeach()
  set(${var} "${s}" PARENT_SCOPE)
  set(next ${f} PARENT_SCOPE)
endfunction()

function(checkPokes out keys what)
  foreach(k ${keys})
    check("${what}: ${k} is one undo step" "${out}" MATCHES "clipeditor poke ${k} done undo 1\n")
  endforeach()
endfunction()

set(clipKeys vol pan pitch colour gain reverse.clip fades semis loopclip tempo stretch engine startend removedc smpfades oneshot root volenv filter lfo fx.shape
             fx.tone fx.space tune)
set(chanKeys vol pan pitch colour engine startend removedc smpfades oneshot reverse.notes loop.notes root volenv filter lfo fx.shape fx.tone fx.space tune)

foreach(layout studio live logic tracker)
  # ---- A, B, C: the clip
  set(s "4 clipeditor reach on\n6 clipeditor dbl 70\n10 clipeditor state\n12 clipeditor tab 5\n14 clipeditor open 70 0\n18 clipeditor state\n")
  set(f 20)
  foreach(t RANGE 0 11)
    if(layout STREQUAL "live")
      string(APPEND s "${f} clipeditor chip ${t}\n")  # the band: each tab's cards brought into view
    else()
      string(APPEND s "${f} clipeditor tab ${t}\n")
    endif()
    math(EXPR f "${f} + 4")
  endforeach()
  string(APPEND s "${f} clipeditor menu\n")
  math(EXPR f "${f} + 4")
  string(APPEND s "${f} clipeditor checklist\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} clipeditor tab 0\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} save \"${OUT}/${layout}_before.gridline.json\"\n")
  math(EXPR f "${f} + 2")
  pokes(s ${f} "${clipKeys}")
  set(f ${next})
  string(APPEND s "${f} save \"${OUT}/${layout}_after.gridline.json\"\n")
  math(EXPR f "${f} + 4")
  string(APPEND s "${f} quit discard\n")
  math(EXPR frames "${f} + 10")
  run(${layout}_clip ${layout} ${frames} "${s}")
  set(out "${${layout}_clip_out}")
  set(last_out "${out}")
  stateAt("${out}" 0 H C T CH M)
  check("${layout}: a double-click opens the clip on its Clip tab (${H} ${C} ${T})" H MATCHES ":1$" AND C EQUAL 70 AND T EQUAL 0 AND CH EQUAL 60)
  stateAt("${out}" 1 H C T CH M)
  check("${layout}: Edit clip... opens it on its Clip tab (${H} ${C} ${T})" H MATCHES ":1$" AND C EQUAL 70 AND T EQUAL 0)
  check("${layout}: every old control drawn, nothing missing" "${out}" MATCHES "clipeditor checklist reached [0-9]+ missing 0\n")
  checkPokes("${out}" "${clipKeys}" "${layout} clip")
  file(READ "${OUT}/${layout}_before.gridline.json" before)
  file(READ "${OUT}/${layout}_after.gridline.json" after)
  check("${layout}: undo brought every change back (the song as before)" before STREQUAL after)

  # ---- A (channel settings of the clip's channel) and D: the channel with no clip
  if(layout STREQUAL "live")
    # (Clips shows a Sampler in its device band, where a channel's settings open: the window is opened on
    # the channel directly, to check it draws there too. Since K-391 the Tracker opens a channel's settings
    # in the floating window like Studio and Smooth; k078_tracker_clipform checks its Sample editor)
    set(openKick "clipeditor channel 61 3")
    set(openTake "clipeditor channel 60 3")
  else()
    set(openKick "plugwin chan 1")  # Channel settings, the rack's button, any "open the channel's window"
    set(openTake "plugwin chan 0")
  endif()
  set(s "4 clipeditor reach on\n6 ${openKick}\n10 clipeditor state\n12 clipeditor tab 0\n16 clipeditor state\n")
  set(f 18)
  foreach(t RANGE 2 11)
    string(APPEND s "${f} clipeditor tab ${t}\n")
    math(EXPR f "${f} + 4")
  endforeach()
  string(APPEND s "${f} clipeditor menu\n")
  math(EXPR f "${f} + 4")
  string(APPEND s "${f} clipeditor checklist\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} save \"${OUT}/${layout}_kbefore.gridline.json\"\n")
  math(EXPR f "${f} + 2")
  pokes(s ${f} "${chanKeys}")
  set(f ${next})
  string(APPEND s "${f} save \"${OUT}/${layout}_kafter.gridline.json\"\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} clipeditor close\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} ${openTake}\n")
  math(EXPR f "${f} + 6")
  string(APPEND s "${f} clipeditor state\n")
  math(EXPR f "${f} + 2")
  string(APPEND s "${f} quit discard\n")
  math(EXPR frames "${f} + 10")
  run(${layout}_chan ${layout} ${frames} "${s}")
  set(out "${${layout}_chan_out}")
  set(last_out "${out}")
  stateAt("${out}" 0 H C T CH M)
  check("${layout}: a channel with no clip opens on Playback (${H} ${C} ${T} ${CH} ${M})" H MATCHES ":1$" AND C EQUAL 0 AND T EQUAL 3 AND CH EQUAL 61 AND M STREQUAL "channel")
  stateAt("${out}" 1 H C T CH M)
  check("${layout}: no clip, the Clip tab asked for shows Playback (${T})" T EQUAL 3)
  check("${layout}: no clip, every old control it needs drawn" "${out}" MATCHES "clipeditor checklist reached [0-9]+ missing 0\n")
  checkPokes("${out}" "${chanKeys}" "${layout} channel")
  file(READ "${OUT}/${layout}_kbefore.gridline.json" before)
  file(READ "${OUT}/${layout}_kafter.gridline.json" after)
  check("${layout}: no clip, undo brought every change back" before STREQUAL after)
  stateAt("${out}" 2 H C T CH M)
  check("${layout}: the clip's channel's settings open its clip on Playback (${H} ${C} ${T} ${CH})" H MATCHES ":1$" AND C EQUAL 70 AND T EQUAL 3 AND CH EQUAL 60)
endforeach()

# ---- E: the Clips device band hands a sampler channel to the window's band form
# The device band's state line: its clip, tab, channel, and the chip row or not.
function(deviceState out n clip tab channel chips)
  string(REGEX MATCHALL "clipeditor state frame [0-9]+ host device shown 1 clip [0-9]+ tab [0-9]+ [^\n]* channel [0-9]+ mode [a-z]+ [^\n]* chips [01]" lines "${out}")
  list(LENGTH lines cnt)
  if(n GREATER_EQUAL cnt)
    message(FATAL_ERROR "FAIL: no device band state line ${n} (${cnt})\n${out}")
  endif()
  list(GET lines ${n} l)
  string(REGEX MATCH "clip ([0-9]+) tab ([0-9]+) .* channel ([0-9]+) mode [a-z]+ .* chips ([01])" m "${l}")
  set(${clip} ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${tab} ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${channel} ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${chips} ${CMAKE_MATCH_4} PARENT_SCOPE)
endfunction()

# E1: a short band (1440 x 900): the band's own view in the sampler's card.
set(s "4 layout show live.device\n5 clipeditor reach on\n6 typing select 1\n14 clipeditor host device\n16 clipeditor state\n")
set(f 18)
foreach(t RANGE 2 11)
  string(APPEND s "${f} clipeditor chip ${t}\n")
  math(EXPR f "${f} + 4")
endforeach()
string(APPEND s "${f} clipeditor menu\n")
math(EXPR f "${f} + 4")
string(APPEND s "${f} clipeditor checklist\n")
math(EXPR f "${f} + 2")
string(APPEND s "${f} save \"${OUT}/band_before.gridline.json\"\n")
math(EXPR f "${f} + 2")
pokes(s ${f} "${chanKeys}")
set(f ${next})
string(APPEND s "${f} save \"${OUT}/band_after.gridline.json\"\n")
math(EXPR f "${f} + 2")
string(APPEND s "${f} plugwin chan 0\n")  # the clip's sampler (Take): its clip with it
math(EXPR f "${f} + 10")
string(APPEND s "${f} clipeditor state\n")
math(EXPR f "${f} + 2")
pokes(s ${f} "gain;vol")
set(f ${next})
string(APPEND s "${f} quit discard\n")
math(EXPR frames "${f} + 10")
unset(RUN_SIZE)
run(band_chips live ${frames} "${s}")
set(out "${band_chips_out}")
set(last_out "${out}")
deviceState("${out}" 0 C T CH K)
check("Clips device band: a sampler with no clip shows the band form on Playback (${C} ${T} ${CH})" C EQUAL 0 AND T EQUAL 3 AND CH EQUAL 61)
check("Clips device band: no chip row, the band's own view (chips ${K})" K EQUAL 0)
check("Clips device band, short: every old control it needs drawn" "${out}" MATCHES "clipeditor checklist reached [0-9]+ missing 0\n")
checkPokes("${out}" "${chanKeys}" "Clips device band, short")
file(READ "${OUT}/band_before.gridline.json" before)
file(READ "${OUT}/band_after.gridline.json" after)
check("Clips device band, short: undo brought every change back" before STREQUAL after)
deviceState("${out}" 1 C T CH K)
check("Clips device band: the clip's sampler shows its clip (${C} ${CH})" C EQUAL 70 AND CH EQUAL 60)
checkPokes("${out}" "gain;vol" "Clips device band, with its clip")

# E2: a tall window (1440 x 1600): Channel settings show the sampler in its card, the band's own
# view (nothing opens above the band).
set(s "4 layout show live.device\n5 clipeditor reach on\n6 plugwin chan 1\n16 clipeditor host device\n18 clipeditor state\n18 layout bodies\n")
set(f 20)
foreach(t RANGE 2 11)
  string(APPEND s "${f} clipeditor chip ${t}\n")
  math(EXPR f "${f} + 4")
endforeach()
string(APPEND s "${f} clipeditor menu\n")
math(EXPR f "${f} + 4")
string(APPEND s "${f} clipeditor checklist\n")
math(EXPR f "${f} + 2")
string(APPEND s "${f} save \"${OUT}/tall_before.gridline.json\"\n")
math(EXPR f "${f} + 2")
pokes(s ${f} "${chanKeys}")
set(f ${next})
string(APPEND s "${f} save \"${OUT}/tall_after.gridline.json\"\n")
math(EXPR f "${f} + 2")
string(APPEND s "${f} quit discard\n")
math(EXPR frames "${f} + 10")
set(RUN_SIZE 1440x1600)
run(band_tabs live ${frames} "${s}")
unset(RUN_SIZE)
set(out "${band_tabs_out}")
set(last_out "${out}")
deviceState("${out}" 0 C T CH K)
check("Clips device band: Channel settings of a sampler open the band form on Playback (${C} ${T} ${CH})" C EQUAL 0 AND T EQUAL 3 AND CH EQUAL 61)
check("Clips device band: in its card, its own view, no chip row (chips ${K})" K EQUAL 0)
string(REGEX MATCH "frame 18 bodies \\[[^]\n]*\\]" b18 "${out}")
check("Clips device band: the form drawn once, by the band, no window (${b18})" b18 MATCHES "Audio clip [0-9-]+/[0-9-]+ x1 @Device chain" AND NOT b18 MATCHES "channel settings")
check("Clips device band, tall window: every old control it needs drawn" "${out}" MATCHES "clipeditor checklist reached [0-9]+ missing 0\n")
checkPokes("${out}" "${chanKeys}" "Clips device band, tall window")
file(READ "${OUT}/tall_before.gridline.json" before)
file(READ "${OUT}/tall_after.gridline.json" after)
check("Clips device band, tall window: undo brought every change back" before STREQUAL after)
