# Gridline - K-26: overlapping playlist clips show what is underneath, in the real app (hidden, isolated
# configs, 1440x900, the playlist shown, a fixed 16 ms frame time). A copy of the test song gets a sample
# channel and an empty pattern ("Blank": no notes, no steps, so any content drawn on its body comes from
# a clip beneath it):
#   track 0: an audio clip (the UI start sound, +12 dB so its waveform is well seen), a Blank clip lying
#            on all but its first quarter;
#   track 1: a Bassline pattern clip, a Blank clip lying on its right half;
#   track 2: a Blank clip alone where track 0's lies (the reference: an empty body);
#   track 3: three Blank clips, each lying on the one before (the user's case).
# Checks, dark and light theme, 100 % interface scale (200 %: screenshots in <OUT>/shots):
#   1. the content of the clip beneath shows through the top clip in the overlap (pixels that differ from
#      the lone Blank clip's body in the same columns);
#   2. dimmed: it stands out from the top clip's body less than the content of the uncovered part of the
#      clip beneath spans;
#   3. (100 %) no shadow falls from a top clip's edge onto the clip beneath (the pixels just left of the
#      edge are as bright as the body further left), and the grid lines seen through the clips keep one
#      brightness: every beat line and every bar line stands out from the body beside it by the same
#      amount in the overlaps as on the parts no other clip covers;
#   4. a right-click in the overlap deletes the top clip (the clip on top owns the pointer), the clip
#      beneath stays.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k26_clip_overlap.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/shots")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
set(pat "{\"bars\": 8, \"color\": 9474192, \"id\": 61, \"name\": \"Blank\", \"notes\": {}, \"steps\": {}, \"stepsPerBar\": 16, \"loop\": false}, ")
set(clips "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 0, \"start\": 0, \"length\": 768, \"pattern\": 0, \"gain\": 4.0}, ")
string(APPEND clips "{\"id\": 71, \"track\": 0, \"start\": 192, \"length\": 1728, \"pattern\": 61}, ")
string(APPEND clips "{\"id\": 72, \"track\": 1, \"start\": 0, \"length\": 768, \"pattern\": 29}, ")
string(APPEND clips "{\"id\": 73, \"track\": 1, \"start\": 384, \"length\": 1536, \"pattern\": 61}, ")
string(APPEND clips "{\"id\": 74, \"track\": 2, \"start\": 192, \"length\": 1728, \"pattern\": 61}, ")
string(APPEND clips "{\"id\": 75, \"track\": 3, \"start\": 0, \"length\": 1056, \"pattern\": 61}, ")
string(APPEND clips "{\"id\": 76, \"track\": 3, \"start\": 672, \"length\": 1248, \"pattern\": 61}, ")
string(APPEND clips "{\"id\": 77, \"track\": 3, \"start\": 1248, \"length\": 1440, \"pattern\": 61}")
string(REPLACE "\"channels\": [" "\"channels\": [${chan}" demo "${demo}")
string(REPLACE "\"patterns\": [" "\"patterns\": [${pat}" demo "${demo}")
string(REGEX REPLACE "\"playlist\": \\[[^]]*\\]" "\"playlist\": [${clips}]" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(run tag frames script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --show playlist
                          ${ARGN} --frames ${frames} --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  file(WRITE "${OUT}/${tag}.out" "${out}")
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
endfunction()
function(check msg)
  if(NOT (${ARGN}))
    fail("${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
function(int var v)  # "123.4" -> 123
  string(REGEX REPLACE "\\..*" "" i "${v}")
  set(${var} ${i} PARENT_SCOPE)
endfunction()

# Clip <id>'s box in the plgeom of frame <frame>: cx0 cx1 cy0 cy1 chead (logical px).
function(clipbox frame id)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n(  [^\n]*\n)*  clip ${id} x ([0-9.]+) ([0-9.]+) y ([0-9.]+) ([0-9.]+) head ([0-9.]+)" _ "${out}")
  if(CMAKE_MATCH_2 STREQUAL "")
    fail("clip ${id} not drawn at frame ${frame}")
  endif()
  foreach(n 2 3 4 5 6)
    int(v${n} "${CMAKE_MATCH_${n}}")
  endforeach()
  set(cx0 ${v2} PARENT_SCOPE)
  set(cx1 ${v3} PARENT_SCOPE)
  set(cy0 ${v4} PARENT_SCOPE)
  set(cy1 ${v5} PARENT_SCOPE)
  set(chead ${v6} PARENT_SCOPE)
endfunction()

# Pixel statistics of the logical rectangle [x0, x1) x [y0, y1) of <ppm>, every pixel of it read
# (100 % interface scale: playlist units are image pixels). With <dy>: each pixel against the pixel <dy>
# logical rows below it: `stand` = how many differ by more than 24 (of 1020: r + 2g + b), `peak` = the
# largest difference. Without: `range` = brightest minus darkest.
function(region ppm x0 x1 y0 y1 dy)
  file(READ "${ppm}" hdr LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" h "${hdr}")
  if(h STREQUAL "")
    fail("${ppm}: not a P6 image")
  endif()
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${h}" off)
  set(sc 1)
  math(EXPR px0 "${x0} * ${sc}")
  math(EXPR px1 "${x1} * ${sc}")
  math(EXPR py0 "${y0} * ${sc}")
  math(EXPR py1 "${y1} * ${sc} - 1")
  math(EXPR bytes "(${px1} - ${px0}) * 3")
  set(st 0)
  set(pk 0)
  set(cnt 0)
  set(lo 100000)
  set(hi 0)
  foreach(y RANGE ${py0} ${py1})
    set(rows ${y})
    if(NOT dy STREQUAL "")
      math(EXPR y2 "${y} + ${dy} * ${sc}")
      list(APPEND rows ${y2})
    endif()
    set(rl "")
    foreach(yy ${rows})
      math(EXPR o "${off} + (${yy} * ${w} + ${px0}) * 3")
      file(READ "${ppm}" hex OFFSET ${o} LIMIT ${bytes} HEX)
      string(REGEX MATCHALL "......" pix "${hex}")
      set(ls "")
      foreach(p ${pix})
        string(SUBSTRING "${p}" 0 2 r)
        string(SUBSTRING "${p}" 2 2 g)
        string(SUBSTRING "${p}" 4 2 b)
        math(EXPR l "0x${r} + 2 * 0x${g} + 0x${b}")
        list(APPEND ls ${l})
      endforeach()
      list(APPEND rl "${ls}")
    endforeach()
    if(dy STREQUAL "")
      foreach(l ${rl})
        if(l LESS lo)
          set(lo ${l})
        endif()
        if(l GREATER hi)
          set(hi ${l})
        endif()
      endforeach()
    else()
      list(LENGTH rl n2)
      math(EXPR n "${n2} / 2")
      math(EXPR last "${n} - 1")
      foreach(i RANGE 0 ${last})
        math(EXPR j "${i} + ${n}")
        list(GET rl ${i} a)
        list(GET rl ${j} b)
        math(EXPR d "${a} - ${b}")
        if(d LESS 0)
          math(EXPR d "0 - ${d}")
        endif()
        if(d GREATER 24)
          math(EXPR st "${st} + 1")
        endif()
        if(d GREATER pk)
          set(pk ${d})
        endif()
        math(EXPR cnt "${cnt} + 1")
      endforeach()
    endif()
  endforeach()
  math(EXPR rg "${hi} - ${lo}")
  set(stand ${st} PARENT_SCOPE)
  set(peak ${pk} PARENT_SCOPE)
  set(npix ${cnt} PARENT_SCOPE)
  set(range ${rg} PARENT_SCOPE)
endfunction()

# The brightness (r + 2g + b) of every pixel of image row <y> (image px), columns [x0, x1): list `lums`.
function(rowlum ppm y x0 x1)
  file(READ "${ppm}" hdr LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" h "${hdr}")
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${h}" off)
  math(EXPR o "${off} + (${y} * ${w} + ${x0}) * 3")
  math(EXPR bytes "(${x1} - ${x0}) * 3")
  file(READ "${ppm}" hex OFFSET ${o} LIMIT ${bytes} HEX)
  string(REGEX MATCHALL "......" pix "${hex}")
  set(out "")
  foreach(p ${pix})
    string(SUBSTRING "${p}" 0 2 r)
    string(SUBSTRING "${p}" 2 2 g)
    string(SUBSTRING "${p}" 4 2 b)
    math(EXPR l "0x${r} + 2 * 0x${g} + 0x${b}")
    list(APPEND out ${l})
  endforeach()
  set(lums "${out}" PARENT_SCOPE)
endfunction()

# The stack of three Blank clips (track 3) at 100 %: no shadow, one grid line brightness.
function(stack tag)
  set(ppm "${OUT}/shots/${tag}.ppm")
  string(REGEX MATCH "plgeom frame 20: valid 1 x0 ([0-9.]+) pxPerTick ([0-9.]+)" _ "${out}")
  set(gx "${CMAKE_MATCH_1}")
  set(ppt "${CMAKE_MATCH_2}")
  clipbox(20 75)
  set(s0 ${cx0})
  clipbox(20 76)
  set(s1 ${cx0})
  set(e0 ${cx1})
  clipbox(20 77)
  set(s2 ${cx0})
  set(e1 ${cx1})
  set(e2 ${cx1})
  math(EXPR y "(${cy0} + ${chead} + ${cy1}) / 2")
  rowlum("${ppm}" ${y} 0 1440)
  # 1. no shadow: just left of each top clip's edge, nothing darker than the body further left (by more
  #    than a grid line is).
  foreach(edge ${s1} ${s2})
    math(EXPR r "${edge} - 12")
    list(GET lums ${r} ref)
    set(dark 0)
    math(EXPR a "${edge} - 7")
    math(EXPR b "${edge} - 2")
    foreach(x RANGE ${a} ${b})
      list(GET lums ${x} l)
      math(EXPR d "${ref} - ${l}")
      if(d GREATER 32)
        math(EXPR dark "${dark} + 1")
      endif()
    endforeach()
    check("${tag}: no shadow left of the top clip's edge at x ${edge} (${dark} darker pixels)" dark LESS_EQUAL 1)
  endforeach()
  # 2. grid lines: each beat / bar line's step from the body beside it (2 px right) on the stack, against
  #    the same column of the lone Blank clip on track 2 (the same body, nothing beneath, the same bar
  #    shading), over the lone clip's span (overlaps 76 on 75 and 77 on 76, and the part of 76 between),
  #    away from every clip edge.
  set(stackLums "${lums}")
  clipbox(20 74)
  set(r0 ${cx0})
  set(r1 ${cx1})
  math(EXPR ry "(${cy0} + ${chead} + ${cy1}) / 2")
  rowlum("${ppm}" ${ry} 0 1440)
  set(refLums "${lums}")
  set(n 0)
  set(worst 0)
  set(seen "")
  string(REPLACE "." "" gxm "${gx}")
  string(REGEX REPLACE "^0+" "" gxm "${gxm}")
  string(REGEX MATCH "\\.([0-9]+)" _ "${ppt}")
  string(LENGTH "${CMAKE_MATCH_1}" pd)
  string(REPLACE "." "" pm "${ppt}")
  string(REGEX REPLACE "^0+" "" pm "${pm}")
  set(div 1)
  foreach(i RANGE 1 ${pd})
    math(EXPR div "${div} * 10")
  endforeach()
  foreach(k RANGE 1 31)
    math(EXPR t "${k} * 96")
    # x = round(x0 + t * pxPerTick) (x0 in thousandths, pxPerTick with <pd> decimals)
    math(EXPR x "(${gxm} * ${div} + ${t} * ${pm} * 1000 + 500 * ${div}) / (1000 * ${div})")
    math(EXPR xr "${x} + 2")
    if(x LESS_EQUAL r0 OR xr GREATER_EQUAL r1)
      continue()
    endif()
    set(near 0)
    foreach(edge ${s0} ${s1} ${s2} ${e0} ${e1} ${e2} ${r0} ${r1})
      math(EXPR d "${x} - ${edge}")
      if(d GREATER -4 AND d LESS 4)
        set(near 1)
      endif()
    endforeach()
    if(near)
      continue()
    endif()
    list(GET stackLums ${x} l)
    list(GET stackLums ${xr} lb)
    list(GET refLums ${x} rl)
    list(GET refLums ${xr} rlb)
    math(EXPR d "(${lb} - ${l}) - (${rlb} - ${rl})")
    if(d LESS 0)
      math(EXPR d "0 - ${d}")
    endif()
    if(d GREATER worst)
      set(worst ${d})
    endif()
    math(EXPR n "${n} + 1")
    string(APPEND seen " ${x}:${l}/${rl}")
  endforeach()
  check("${tag}: grid lines measured through the stack (${n})" n GREATER 6)
  check("${tag}: every grid line through the overlaps as bright as through a lone clip (worst ${worst}:${seen})" worst LESS_EQUAL 6)
endfunction()

# One look: <tag>, then app args. Every check on the shot of frame 24.
function(look tag)
  run(${tag} 28 "20 plgeom\n24 shot \"${OUT}/shots/${tag}.ppm\"\n" ${ARGN})
  set(ppm "${OUT}/shots/${tag}.ppm")
  foreach(case "70;71;audio" "72;73;pattern")
    list(GET case 0 lo)
    list(GET case 1 top)
    list(GET case 2 what)
    clipbox(20 ${lo})
    set(lx0 ${cx0})
    set(lx1 ${cx1})
    clipbox(20 ${top})
    set(tx0 ${cx0})
    math(EXPR by0 "${cy0} + ${chead} + 3")
    math(EXPR by1 "${cy1} - 3")
    # The overlap (clear of the top clip's edge shadow and rim, and the outline of the clip beneath),
    # the uncovered part of the clip beneath (clear of the shadow the top clip casts on it).
    math(EXPR ox0 "${tx0} + 4")
    math(EXPR ox1 "${lx1} - 4")
    math(EXPR ux0 "${lx0} + 4")
    math(EXPR ux1 "${tx0} - 10")
    check("${tag} ${what}: an overlap and an uncovered part to look at (${ox0}..${ox1}, ${ux0}..${ux1})" ox1 GREATER ox0 AND ux1 GREATER ux0)
    # The reference: the lone Blank clip on track 2 (the same body, nothing beneath), the same columns:
    # what differs from it in the overlap is the clip beneath showing through.
    clipbox(20 74)
    math(EXPR dy "${cy0} + ${chead} + 3 - ${by0}")
    region("${ppm}" ${ox0} ${ox1} ${by0} ${by1} ${dy})
    set(oStand ${stand})
    set(oPeak ${peak})
    set(oN ${npix})
    math(EXPR oMin "${oN} / 40")
    check("${tag} ${what}: the content beneath shows through the top clip (${oStand} of ${oN} pixels differ from a lone clip's body, at least ${oMin})"
          oStand GREATER oMin)
    # Dimmed: its strongest pixel stands out from the top clip's body less than the content of the
    # uncovered part spans (brightest to darkest).
    region("${ppm}" ${ux0} ${ux1} ${by0} ${by1} "")
    check("${tag} ${what}: ... dimmed (peak ${oPeak} < ${range} uncovered)" oPeak LESS range)
  endforeach()
  if(DO_STACK)
    stack(${tag})
  endif()
endfunction()

set(DO_STACK 1)  # (stack() reads the run's output in look()'s scope)
look(dark)
look(light --light)
set(DO_STACK 0)
# 200 %: screenshots for the eye (the playlist's interface units are not image pixels there).
run(dark200 28 "20 plgeom\n24 shot \"${OUT}/shots/dark200.ppm\"\n" --ui-scale 2)
run(light200 28 "20 plgeom\n24 shot \"${OUT}/shots/light200.ppm\"\n" --ui-scale 2 --light)

# A right-click in the overlap: the top clip goes, the clip beneath stays (the top clip owns the pointer).
run(geo 22 "20 plgeom\n")
set(geoOut "${out}")
foreach(case "70;71" "72;73" "76;77")
  list(GET case 0 lo)
  list(GET case 1 top)
  set(out "${geoOut}")
  clipbox(20 ${lo})
  set(lx1 ${cx1})
  clipbox(20 ${top})
  math(EXPR mx "(${cx0} + ${lx1}) / 2")
  math(EXPR my "(${cy0} + ${chead} + ${cy1}) / 2")
  run(rclick_${top} 40 "10 move ${mx} ${my}\n14 down 1\n15 up 1\n30 dump\n")
  string(REGEX MATCH "\n  clip ${top} kind" hasTop "${out}")
  string(REGEX MATCH "\n  clip ${lo} kind" hasLo "${out}")
  string(LENGTH "${hasTop}" topLeft)
  string(LENGTH "${hasLo}" loLeft)
  check("a right-click in the overlap (${mx} ${my}) deletes the top clip ${top}" topLeft EQUAL 0)
  check("... and keeps the clip beneath (${lo})" loLeft GREATER 0)
endforeach()
