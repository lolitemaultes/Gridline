# Gridline: K-262, the piano roll's Vibrato tool, driven by scripted input in the real app, in each of
# the four layouts. Runs the app hidden (isolated config and HOME, fixed frame time) on a copy of the
# test song, editing pattern 0 ("Beat") on channel 6 ("Chords", no notes in that pattern):
#   1. four notes on C5; the tool goes on (V in Studio and Tracker, the tool list elsewhere: the
#      pianotool command); a drag up one row from the middle of the third note gives that note a
#      vibrato of 100 cents and no other note any, in one undo step;
#   2. undo takes it away; a second drag sideways on it sets the rate of the default vibrato;
#   3. Studio: a screenshot with the tool on (the wave and its handles drawn on the note).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k262_vibrato_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)  # a copy: never the fixture itself

function(run layout tag script)
  set(cfg "${OUT}/cfg_${layout}_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  if(NOT layout STREQUAL "studio")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\", \"keys.profile\": \"${layout}\", \"ui.menuStyle\": \"${layout}\"}}\n")
    set(extra --layout-dev --layout ${layout})
  else()
    set(extra "")
  endif()
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${layout}_${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 ${extra} --edit 0 6 --hide rack
                          --dev-input "${OUT}/${layout}_${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${layout}_${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${layout} ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(run_out "${out}" PARENT_SCOPE)
endfunction()

set(make0 "2 mknotes 4 96 96\n3 typing off\n")
foreach(layout studio tracker live logic)
  set(make "${make0}")
  if(layout STREQUAL "tracker")
    string(APPEND make "4 tracker page Roll\n")  # the Tracker shows the piano roll on its Roll page
  elseif(layout STREQUAL "live")
    string(APPEND make "4 clipsel 31\n5 layout open Piano roll\n6 focus \"Piano roll\"\n")  # Clips: the clip band shows the selected clip (the fixture's first, pattern 0)
  elseif(NOT layout STREQUAL "studio")
    string(APPEND make "4 layout open Piano roll\n5 focus \"Piano roll\"\n")  # Smooth: in its bottom band
  endif()
  run(${layout} geo "${make}14 lane\n15 notes\n17 quit discard\n")
  if(NOT run_out MATCHES "lane frame [0-9]+: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([-0-9.]+) [^\n]* valid 1 pitchY0 ([-0-9.]+) rowH ([0-9.]+)")
    message(FATAL_ERROR "FAIL ${layout}: no piano roll geometry\n${run_out}")
  endif()
  set(x0 ${CMAKE_MATCH_1})
  set(ppt ${CMAKE_MATCH_2})
  set(py0 ${CMAKE_MATCH_4})
  set(rowH ${CMAKE_MATCH_5})
  foreach(v x0 py0 rowH)
    string(REGEX REPLACE "\\..*" "" ${v} "${${v}}")
  endforeach()
  string(REGEX MATCH "^([0-9]+)\\.([0-9]+)$" _p "${ppt}")
  set(pptInt ${CMAKE_MATCH_1})
  string(REGEX REPLACE "^0+" "" pptFrac "${CMAKE_MATCH_2}")
  if(pptFrac STREQUAL "")
    set(pptFrac 0)
  endif()
  # C5's row centre; the third note's middle (tick 240); the keyboard (to focus the piano roll).
  math(EXPR cy "${py0} + (127 - 60) * ${rowH} + ${rowH} / 2")
  math(EXPR xd "${x0} + 240 * ${pptInt} + 240 * ${pptFrac} / 1000000")
  math(EXPR xr "${xd} + 120")
  math(EXPR keyX "${x0} - 20")
  math(EXPR y1 "${cy} - ${rowH}")
  if(layout STREQUAL "studio" OR layout STREQUAL "tracker")
    set(tool "18 key v\n")
  else()
    set(tool "18 pianotool vibrato\n")
  endif()
  set(drag "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n17 dump\n${tool}20 move ${xd} ${cy}\n21 down 0\n23 move ${xd} ${cy}\n24 move ${xd} ${y1}\n26 move ${xd} ${y1}\n27 up 0\n29 notes\n30 dump\n")
  run(${layout} drag "${drag}32 shot \"${OUT}/${layout}_on.ppm\"\n34 undo\n36 notes\n38 quit discard\n")
  if(NOT run_out MATCHES "notes frame [0-9]+: 4 notes[^\n]*\n  note 0 [^\n]* bend 0\n  note 1 [^\n]* bend 0\n  note 2 [^\n]* bend 0 vib ([0-9]+) ([0-9.]+) 0 [^\n]*\n  note 3 [^\n]* bend 0\n")
    message(FATAL_ERROR "FAIL ${layout}: a drag up should give the third note a vibrato, no other note one\n${run_out}")
  endif()
  set(depth ${CMAKE_MATCH_1})
  if(depth LESS 90 OR depth GREATER 110)
    message(FATAL_ERROR "FAIL ${layout}: one row up should be about 100 cents, got ${depth}\n${run_out}")
  endif()
  string(REGEX MATCHALL "dump frame [0-9]+: [0-9]+ clips, [0-9]+ selected, undo ([0-9]+)" dumps "${run_out}")
  list(LENGTH dumps nd)
  if(nd LESS 2)
    message(FATAL_ERROR "FAIL ${layout}: no undo positions\n${run_out}")
  endif()
  list(GET dumps 0 d0)
  list(GET dumps 1 d1)
  string(REGEX REPLACE ".*undo ([0-9]+)" "\\1" u0 "${d0}")
  string(REGEX REPLACE ".*undo ([0-9]+)" "\\1" u1 "${d1}")
  math(EXPR steps "${u1} - ${u0}")
  if(NOT steps EQUAL 1)
    message(FATAL_ERROR "FAIL ${layout}: the drag should be one undo step, was ${steps}\n${run_out}")
  endif()
  if(run_out MATCHES "notes frame [0-9]+: 4 notes[^\n]*\n(  note [^\n]*\n)*  note 2 [^\n]* vib [^\n]*\n(  note [^\n]*\n)*notes frame [0-9]+: 4 notes[^\n]*\n(  note [^\n]*\n)*  note 2 [^\n]* vib ")
    message(FATAL_ERROR "FAIL ${layout}: undo should take the vibrato away\n${run_out}")
  endif()
  if(NOT EXISTS "${OUT}/${layout}_on.ppm")
    message(FATAL_ERROR "FAIL ${layout}: no screenshot")
  endif()
  message(STATUS "ok - ${layout}: the Vibrato tool gives the third note ${depth} cents in one undo step; undo takes it away")

  # A sideways drag on a plain note: the default depth at a faster rate.
  set(side "${make}14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n${tool}20 move ${xd} ${cy}\n21 down 0\n23 move ${xd} ${cy}\n24 move ${xr} ${cy}\n26 move ${xr} ${cy}\n27 up 0\n29 notes\n31 quit discard\n")
  run(${layout} side "${side}")
  if(NOT run_out MATCHES "note 2 [^\n]* vib ([0-9]+) ([0-9.]+) 0 ")
    message(FATAL_ERROR "FAIL ${layout}: a sideways drag should give the note the default vibrato\n${run_out}")
  endif()
  set(rate ${CMAKE_MATCH_2})
  if(rate LESS 6)
    message(FATAL_ERROR "FAIL ${layout}: dragging right should raise the rate above the default 5.6 Hz, got ${rate}\n${run_out}")
  endif()
  message(STATUS "ok - ${layout}: a sideways drag sets the rate (${rate} Hz)")
endforeach()
