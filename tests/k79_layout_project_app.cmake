# Gridline: K-79, the window layout is the person's own setting and never part of the project.
# Opens the same project (a copy of the fixture) and saves it at exit, once per layout:
#   - chosen in settings.json (ui.layout studio / live / logic, as a user would),
#   - switched while running (studio -> logic -> live -> studio),
# and checks that every saved file is byte-identical to the one saved under the studio layout,
# that the opened project file itself is never changed, and that no saved project mentions the layout.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k79_layout_project_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")

set(failures 0)
# run(<tag> <ui.layout value> <extra args>...): opens a fresh copy of the project, saves it at exit.
function(run tag layout)
  set(cfg "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layout\": \"${layout}\", \"ui.layoutChosen\": true}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  configure_file("${DEMO}" "${OUT}/${tag}.open.gridline.json" COPYONLY)
  file(SHA256 "${OUT}/${tag}.open.gridline.json" before)
  execute_process(COMMAND "${APP}" "${OUT}/${tag}.open.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900
                          ${ARGN} --screenshot "${OUT}/${tag}.ppm" --save-at-exit "${OUT}/${tag}.saved.gridline.json"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(SEND_ERROR "FAIL: ${tag}: gridline-app failed (${rc}): ${err}")
    math(EXPR f "${failures} + 1")
    set(failures ${f} PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${OUT}/${tag}.open.gridline.json" after)
  if(NOT before STREQUAL after)
    message(SEND_ERROR "FAIL: ${tag}: the opened project file was changed")
    math(EXPR f "${failures} + 1")
    set(failures ${f} PARENT_SCOPE)
  endif()
  if(NOT EXISTS "${OUT}/${tag}.saved.gridline.json")
    message(SEND_ERROR "FAIL: ${tag}: no project saved at exit")
    math(EXPR f "${failures} + 1")
    set(failures ${f} PARENT_SCOPE)
    return()
  endif()
  file(READ "${OUT}/${tag}.saved.gridline.json" text)
  if(text MATCHES "ui\\.layout|layoutChosen|theme\\.palette|keys\\.profile")
    message(SEND_ERROR "FAIL: ${tag}: the saved project mentions the window layout")
    math(EXPR f "${failures} + 1")
    set(failures ${f} PARENT_SCOPE)
  endif()
endfunction()

run(studio studio --frames 40)
run(live live --frames 40)
run(logic logic --frames 40)
run(switched studio --frames 40 --switch-layout logic@8 --switch-layout live@16 --switch-layout studio@24)
run(switched_logic logic --frames 40 --switch-layout studio@10)

# During playback: switched back and forth every few frames with the project open. The song
# stays the same as one played without switching, playback never stops, the play position keeps
# moving, every open window is on screen on the frames after each switch (no blank frame) and
# each switch takes well under a frame budget's worth of time.
run(play studio --play --frames 120)
run(play_switched studio --play --frames 120 --switch-check
    --switch-layout logic@10 --switch-layout live@20 --switch-layout studio@30 --switch-layout live@40
    --switch-layout logic@50 --switch-layout studio@60 --switch-layout logic@70 --switch-layout live@80 --switch-layout studio@90)
if(EXISTS "${OUT}/play.saved.gridline.json" AND EXISTS "${OUT}/play_switched.saved.gridline.json")
  file(SHA256 "${OUT}/play.saved.gridline.json" a)
  file(SHA256 "${OUT}/play_switched.saved.gridline.json" b)
  if(NOT a STREQUAL b)
    message(SEND_ERROR "FAIL: switching layouts during playback changed the song")
    math(EXPR failures "${failures} + 1")
  endif()
endif()
file(READ "${OUT}/play_switched.log" plog)
string(REGEX MATCHALL "\\[layout-switch\\] frame [0-9]+ to [a-z]+ took [0-9.]+ ms" took "${plog}")
list(LENGTH took nSwitch)
if(NOT nSwitch EQUAL 9)
  message(SEND_ERROR "FAIL: expected 9 layout switches during playback, saw ${nSwitch}")
  math(EXPR failures "${failures} + 1")
endif()
foreach(t IN LISTS took)
  string(REGEX MATCH "took ([0-9]+)" _ "${t}")
  if(CMAKE_MATCH_1 GREATER 100)
    message(SEND_ERROR "FAIL: a layout switch was slow: ${t}")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
string(REGEX MATCHALL "\\[layout-switch\\] frame [0-9]+ [a-z]+ playing [01] tick [0-9]+ [^\n]*" checks "${plog}")
list(LENGTH checks nCheck)
if(nCheck LESS 30)
  message(SEND_ERROR "FAIL: expected about 36 checked frames after the switches, saw ${nCheck}")
  math(EXPR failures "${failures} + 1")
endif()
set(lastTick -1)
foreach(c IN LISTS checks)
  if(NOT c MATCHES " ok$")
    message(SEND_ERROR "FAIL: a frame after a switch was not clean: ${c}")
    math(EXPR failures "${failures} + 1")
  endif()
  if(NOT c MATCHES "playing 1")
    message(SEND_ERROR "FAIL: playback stopped across a switch: ${c}")
    math(EXPR failures "${failures} + 1")
  endif()
  string(REGEX MATCH "tick ([0-9]+)" _ "${c}")
  if(CMAKE_MATCH_1 LESS lastTick)
    message(SEND_ERROR "FAIL: the play position went back across a switch: ${c}")
    math(EXPR failures "${failures} + 1")
  endif()
  set(lastTick ${CMAKE_MATCH_1})
endforeach()

# The open windows come back after a round trip: studio's windows, through logic (where the
# mixer and the editors share one pane) and live, are the same when studio returns.
run(roundtrip studio --frames 60 --switch-check --switch-layout logic@10 --switch-layout live@25 --switch-layout studio@40)
file(READ "${OUT}/roundtrip.log" rlog)
string(REGEX MATCHALL "\\[layout-switch\\] frame [0-9]+ studio playing [01] tick [0-9]+ open [a-z,]+" back "${rlog}")
list(LENGTH back nBack)
if(nBack LESS 1)
  message(SEND_ERROR "FAIL: no checked frame after switching back to studio")
  math(EXPR failures "${failures} + 1")
else()
  list(GET back -1 last)
  string(REGEX MATCH "open ([a-z,]+)" _ "${last}")
  set(openBack "${CMAKE_MATCH_1}")
  if(NOT openBack MATCHES "playlist" OR NOT openBack MATCHES "mixer" OR NOT openBack MATCHES "browser" OR NOT openBack MATCHES "piano"
     OR NOT openBack MATCHES "rack")
    message(SEND_ERROR "FAIL: studio's open windows did not come back after logic and live: ${openBack}")
    math(EXPR failures "${failures} + 1")
  endif()
endif()

file(SHA256 "${OUT}/studio.saved.gridline.json" ref)
foreach(tag live logic switched switched_logic)
  if(EXISTS "${OUT}/${tag}.saved.gridline.json")
    file(SHA256 "${OUT}/${tag}.saved.gridline.json" h)
    if(NOT h STREQUAL ref)
      message(SEND_ERROR "FAIL: the project saved under '${tag}' differs from the one saved under studio")
      math(EXPR failures "${failures} + 1")
    endif()
  endif()
endforeach()

if(failures GREATER 0)
  message(FATAL_ERROR "k79_layout_project_app: ${failures} failure(s)")
endif()
message(STATUS "k79_layout_project_app: OK (saves byte-identical, opened files unchanged, clean switches during playback)")
