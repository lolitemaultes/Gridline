# Gridline: K-29, double-clicks with the pitch bend tool, driven by scripted input in the real app
# (hidden, isolated config and HOME, fixed frame time) on a copy of the test song, editing pattern 0
# on channel 6. One long C5 note (384 ticks) gets the line 96:+2 straight, 192:+5 smooth (amount
# 0.5), 288:+3 ease in; then:
#   1. double-click the middle point: only it goes, the points before and after keep their time,
#      value, shape and amount; one undo step; undo brings the point back;
#   2. double-click the first glide's ring: that glide is a straight ramp again (the others stay);
#   3. double-click the line on the last glide: that glide is straight again;
#   4. double-click the note off its line: the note's whole line is reset;
#   5. a chord (two selected notes bending as one): double-click a point on one removes it on both;
#   6. a first click that slips 4 px (dragging the point, or adding a point on the line) before the
#      second click: the double-click still removes only that point / straightens only that glide,
#      leaves no stray point and is one undo step.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k29_bend_dblclick_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --edit 0 6 --hide rack
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

# "12.345" -> 12345 (thousandths), for integer pixel maths.
function(milli s out)
  if(NOT s MATCHES "^(-?)([0-9]+)(\\.([0-9]*))?$")
    message(FATAL_ERROR "not a number: ${s}")
  endif()
  set(sign "${CMAKE_MATCH_1}")
  set(i "${CMAKE_MATCH_2}")
  set(f "${CMAKE_MATCH_4}000")
  string(SUBSTRING "${f}" 0 3 f)
  string(REGEX REPLACE "^0+" "" f "${f}")
  if(f STREQUAL "")
    set(f 0)
  endif()
  math(EXPR v "${i} * 1000 + ${f}")
  if(sign STREQUAL "-")
    math(EXPR v "0 - ${v}")
  endif()
  set(${out} ${v} PARENT_SCOPE)
endfunction()

set(line "bendline 0 96:2:0 192:5:1:0.5 288:3:3")
set(make "2 mknotes 1 384 384\n3 typing off\n4 ${line}\n")
# The piano roll's geometry for the notes `make` writes (the view follows the notes).
macro(geometry tag)
  run(${tag} "${make}14 lane\n15 notes\n17 quit discard\n")
  if(NOT ${tag}_out MATCHES "lane frame [0-9]+: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([-0-9.]+) [^\n]* pitchY0 ([-0-9.]+) rowH ([0-9.]+)")
    message(FATAL_ERROR "FAIL: no piano roll geometry\n${${tag}_out}")
  endif()
  milli(${CMAKE_MATCH_1} x0m)
  milli(${CMAKE_MATCH_2} pptm)
  milli(${CMAKE_MATCH_4} py0m)
  milli(${CMAKE_MATCH_5} rowm)
endmacro()
geometry(geo)
if(NOT geo_out MATCHES "note 0 [^\n]* bend 3 96.00:2.00:0 192.00:5.00:1:0.50 288.00:3.00:3\n")
  message(FATAL_ERROR "FAIL: the dev line did not land\n${geo_out}")
endif()
# Screen position of (tick, semitones x1000) on note `pitch`.
function(xat tick out)
  math(EXPR v "(${x0m} + ${tick} * ${pptm}) / 1000")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
function(yat pitch semim out)
  math(EXPR v "(${py0m} + (127 - ${pitch}) * ${rowm} + ${rowm} / 2 - ${semim} * ${rowm} / 1000) / 1000")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
math(EXPR keyX "${x0m} / 1000 - 20")
yat(60 0 cy)
# Focus the piano roll (a click on its keyboard), then the bend tool (N).
set(focus "14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n18 key n\n")
math(EXPR pxPerPt "${pptm} * 24 / 1000")
message(STATUS "geometry: x0 ${x0m}, ${pptm} px/1000 ticks, rowH ${rowm}/1000 (24 ticks = ${pxPerPt} px)")

# A double-click at (x, y): move there, two clicks a frame apart, then the notes and the undo position.
function(dbl tag pre x y)
  run(${tag} "${make}${pre}${focus}20 tempo\n24 move ${x} ${y}\n26 move ${x} ${y}\n28 down 0\n29 up 0\n30 down 0\n31 up 0\n34 notes\n35 tempo\n37 undo\n39 notes\n41 quit discard\n")
  if(NOT ${tag}_out MATCHES "tempo frame 20: [0-9.]+ undo ([0-9]+)")
    message(FATAL_ERROR "FAIL (${tag}): no undo position\n${${tag}_out}")
  endif()
  set(u0 ${CMAKE_MATCH_1})
  if(NOT ${tag}_out MATCHES "tempo frame 35: [0-9.]+ undo ([0-9]+)")
    message(FATAL_ERROR "FAIL (${tag}): no undo position\n${${tag}_out}")
  endif()
  math(EXPR steps "${CMAKE_MATCH_1} - ${u0}")
  set(${tag}_out "${${tag}_out}" PARENT_SCOPE)
  set(${tag}_steps ${steps} PARENT_SCOPE)
endfunction()
# The bend of note `i` printed at frame `fr`.
function(bendof tag fr i out)
  if(NOT ${tag}_out MATCHES "notes frame ${fr}:[^\n]*\n(  [^\n]*\n)*  note ${i} [^\n]* bend ([0-9]+)([^\n]*)\n")
    message(FATAL_ERROR "FAIL (${tag}): no note ${i} at frame ${fr}\n${${tag}_out}")
  endif()
  string(STRIP "${CMAKE_MATCH_2}${CMAKE_MATCH_3}" b)
  set(${out} "${b}" PARENT_SCOPE)
endfunction()
function(want tag got expect what)
  if(NOT got STREQUAL expect)
    message(FATAL_ERROR "FAIL (${tag}): ${what}\n  want: ${expect}\n  got:  ${got}\n${${tag}_out}")
  endif()
endfunction()
set(orig "3 96.00:2.00:0 192.00:5.00:1:0.50 288.00:3.00:3")

# 1. The middle point.
xat(192 xP)
yat(60 5000 yP)
dbl(point "" ${xP} ${yP})
bendof(point 34 0 b)
want(point "${b}" "2 96.00:2.00:0 288.00:3.00:3" "double-click on the middle point removes only it")
want(point "${point_steps}" "1" "one undo step")
bendof(point 39 0 b)
want(point "${b}" "${orig}" "undo brings the point back")
message(STATUS "ok - double-click a point: only that point goes (one undo step, undo restores it)")

# 2. The first glide's ring (smooth: half way in time is half way in value, +3.5).
xat(144 xR)
yat(60 3500 yR)
dbl(ring "" ${xR} ${yR})
bendof(ring 34 0 b)
want(ring "${b}" "3 96.00:2.00:0 192.00:5.00:0 288.00:3.00:3" "double-click on the ring makes that glide straight")
want(ring "${ring_steps}" "1" "one undo step")
message(STATUS "ok - double-click a ring: that glide is a straight ramp again")

# 3. The line on the last glide (ease in from +5 to +3, at 3/4 of the way: 5 - 2 * 0.75^2.8).
xat(264 xL)
yat(60 4107 yL)
dbl(seg "" ${xL} ${yL})
bendof(seg 34 0 b)
want(seg "${b}" "3 96.00:2.00:0 192.00:5.00:1:0.50 288.00:3.00:0" "double-click on the line makes that glide straight")
want(seg "${seg_steps}" "1" "one undo step")
message(STATUS "ok - double-click the line: that glide is a straight ramp again")

# 4. The note off its line (below the rising first glide).
xat(20 xB)
yat(60 -350 yB)
dbl(body "" ${xB} ${yB})
bendof(body 34 0 b)
want(body "${b}" "0" "double-click on the note resets its line")
want(body "${body_steps}" "1" "one undo step")
message(STATUS "ok - double-click the note: its whole line is reset")

# 5. A chord: two selected notes (C5 and E5) with the same line; a double-click on C5's middle point.
set(make "2 mknotes 1 384 384x2\n3 typing off\n4 ${line}\n5 bendline 1 96:2:0 192:5:1:0.5 288:3:3\n6 selnotes 0,1\n")
geometry(geoChord)
xat(192 xC)
yat(60 5000 yC)
math(EXPR keyX "${x0m} / 1000 - 20")
yat(60 0 cy)
set(focus "14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n18 key n\n")
dbl(chord "" ${xC} ${yC})
bendof(chord 34 0 b0)
bendof(chord 34 1 b1)
want(chord "${b0}" "2 96.00:2.00:0 288.00:3.00:3" "the chord's first note loses only that point")
want(chord "${b1}" "2 96.00:2.00:0 288.00:3.00:3" "the chord's second note bends as one")
want(chord "${chord_steps}" "1" "one undo step")
message(STATUS "ok - a chord: the double-click applies to every selected note")
set(make "2 mknotes 1 384 384\n3 typing off\n4 ${line}\n")
geometry(geo)
math(EXPR keyX "${x0m} / 1000 - 20")
yat(60 0 cy)
set(focus "14 move ${keyX} ${cy}\n15 down 0\n16 up 0\n18 key n\n")

# 6. A slipping first click: on the point (a drag of 4 px), and on the line (a new point dragged
# 4 px); with the snap (the slip changes nothing) and with Alt held (free: the slip is an edit of its
# own, which the double-click takes back).
function(slip tag x y alt expect what)
  math(EXPR y4 "${y} - 4")
  set(m0 "")
  set(m1 "")
  if(alt)
    set(m0 "27 mod alt 1\n")
    set(m1 "31 mod alt 0\n")
  endif()
  run(${tag} "${make}${focus}20 tempo\n24 move ${x} ${y}\n26 move ${x} ${y}\n${m0}28 down 0\n29 move ${x} ${y4}\n30 notes\n30 move ${x} ${y4}\n31 up 0\n${m1}32 down 0\n33 up 0\n36 notes\n37 tempo\n39 quit discard\n")
  if(alt)
    bendof(${tag} 30 0 mid)
    if(mid STREQUAL "${orig}")
      message(FATAL_ERROR "FAIL (${tag}): the first click's slip should have changed the line (free with Alt)\n${${tag}_out}")
    endif()
  endif()
  bendof(${tag} 36 0 b)
  want(${tag} "${b}" "${expect}" "${what}")
  string(REGEX MATCH "tempo frame 20: [0-9.]+ undo ([0-9]+)" _m "${${tag}_out}")
  set(u0 ${CMAKE_MATCH_1})
  string(REGEX MATCH "tempo frame 37: [0-9.]+ undo ([0-9]+)" _m "${${tag}_out}")
  math(EXPR st "${CMAKE_MATCH_1} - ${u0}")
  want(${tag} "${st}" "1" "${what}: one undo step")
endfunction()
math(EXPR yP4 "${yP} - 4")
foreach(alt OFF ON)
  slip(slipP${alt} ${xP} ${yP} ${alt} "2 96.00:2.00:0 288.00:3.00:3" "a slipping double-click on a point removes only it (the others unmoved)")
  slip(slipL${alt} ${xL} ${yL} ${alt} "3 96.00:2.00:0 192.00:5.00:1:0.50 288.00:3.00:0" "a slipping double-click on the line straightens that glide, no stray point")
endforeach()
message(STATUS "ok - a first click that slips 4 px (snapped, and free with Alt): the double-click still acts on what it hit, one undo step, no stray point")
