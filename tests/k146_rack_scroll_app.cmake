# Gridline - K-146: a channel rack that is cut off (its rows scroll up and down) with a pattern
# too long for it (its steps scroll sideways under the step slider), in the real app (hidden,
# off-screen, isolated configs, SDL's dummy audio driver). Every frame is measured:
#   1. one sideways scroll control only: the rows pane never shows a scrollbar of its own and
#      never scrolls sideways itself (its items end at the row's right edge, also with a step
#      cut in half by the viewport's edge);
#   2. no frame-to-frame change of the window's height, its height limit or the rows' height;
#   3. the wheel scrolls the rows by a notch and stops at both ends;
#   4. a sideways swipe scrolls the steps by a beat, dragging the step slider scrolls them to
#      both ends;
#   5. the same at 1920x1080 and at UI scale 200 %, and docked.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k146_rack_scroll_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)  # a copy: the song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

function(run tag size spec frames script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}/home")
  set(s "${script}")
  foreach(f RANGE 8 ${frames})  # the rack as drawn, every frame
    string(APPEND s "${f} rack\n")
  endforeach()
  math(EXPR total "${frames} + 2")
  file(WRITE "${OUT}/${tag}.txt" "${s}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size ${size} --frames ${total} --rack ${spec}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 150)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  file(WRITE "${OUT}/${tag}.out" "${out}")
  string(REGEX MATCHALL "rack frame [^\n]*\n  geom [^\n]*" dumps "${out}")
  list(LENGTH dumps n)
  if(n LESS 3)
    message(FATAL_ERROR "FAIL (${tag}): only ${n} rack dumps. Output:\n${out}")
  endif()
  set(${tag}_dumps "${dumps}" PARENT_SCOPE)
endfunction()

# field(<dump> <key> <var>): a number after " <key> " in one dump
function(field d key var)
  string(REGEX MATCH " ${key} (-?[0-9.]+)" _ "${d}")
  set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
# at(<tag> <frame> <key> <var>): a field of the dump of one frame
function(at tag frame key var)
  foreach(d IN LISTS ${tag}_dumps)
    if(d MATCHES "^rack frame ${frame}:")
      field("${d}" ${key} v)
      set(${var} "${v}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "FAIL (${tag}): no rack dump at frame ${frame}")
endfunction()

# steady(<tag>): checks 1 and 2 over every frame of a run
function(steady tag what)
  set(first TRUE)
  set(bars 0)
  set(paneScroll 0)
  set(over 0)
  set(changes 0)
  foreach(d IN LISTS ${tag}_dumps)
    field("${d}" paneBarX bx)
    field("${d}" paneScrollX px)
    field("${d}" itemsRight ir)
    field("${d}" rowRight rr)
    field("${d}" winH wh)
    field("${d}" fitH fh)
    field("${d}" rowsContent rc)
    if(bx EQUAL 1)
      math(EXPR bars "${bars} + 1")
    endif()
    if(NOT px STREQUAL "0.0")
      math(EXPR paneScroll "${paneScroll} + 1")
    endif()
    # (whole pixels: items may end up to half a pixel past the edge from rounding)
    string(REGEX REPLACE "\\..*" "" iri "${ir}")
    string(REGEX REPLACE "\\..*" "" rri "${rr}")
    if(iri GREATER rri)
      math(EXPR over "${over} + 1")
    endif()
    if(first)
      set(wh0 "${wh}")
      set(fh0 "${fh}")
      set(rc0 "${rc}")
      set(first FALSE)
    elseif(NOT wh STREQUAL wh0 OR NOT fh STREQUAL fh0 OR NOT rc STREQUAL rc0)
      math(EXPR changes "${changes} + 1")
    endif()
  endforeach()
  list(LENGTH ${tag}_dumps n)
  check("${what}: no scrollbar of the rows pane's own in ${n} frames (${bars} frames had one)" bars EQUAL 0)
  check("${what}: the rows pane never scrolls sideways itself (${paneScroll} frames did)" paneScroll EQUAL 0)
  check("${what}: the rows' items end at the row's right edge (${over} frames reached past it)" over EQUAL 0)
  check("${what}: window height ${wh0}, height limit ${fh0} and rows height ${rc0} the same in every frame (${changes} frames changed)"
        changes EQUAL 0)
endfunction()

# The test song has 8 channels (the last plays piano-roll notes: a preview row). The pattern is made
# 64 steps long (4 bars of 16) and the floating rack 300 px tall: its rows scroll up and down and its
# steps scroll sideways. Over the steps (the plain wheel then scrolls the rows):
#   12 wheel down a notch, 24 a long way down (to the end), 62 a long way up (to the top), each
#   checked once the elastic edge has settled; 100 a sideways swipe of a third of a notch (a step
#   left cut in half at both edges), 112 one notch, 126 Shift+wheel, 134 a drag of the step slider
#   past its right end, 150 back past its left end.
function(geometry tag size)  # where the steps and the slider are, from a first short run
  run(${tag}_geo ${size} "steps64,h300" 12 "" ${ARGN})
  at(${tag}_geo 10 viewX0 vx)
  at(${tag}_geo 10 viewW vw)
  at(${tag}_geo 10 row0Y ry)
  list(GET ${tag}_geo_dumps 2 d)
  string(REGEX MATCH " addrow [-0-9.]+ ([-0-9.]+)" _ "${d}")
  set(by "${CMAKE_MATCH_1}")
  set(${tag}_vx "${vx}" PARENT_SCOPE)
  set(${tag}_vw "${vw}" PARENT_SCOPE)
  set(${tag}_ry "${ry}" PARENT_SCOPE)
  set(${tag}_by "${by}" PARENT_SCOPE)
endfunction()

function(scripted tag size)
  geometry(${tag} ${size} ${ARGN})
  # positions are in screen points (the UI scale applies to the whole frame)
  string(REGEX REPLACE "\\..*" "" vx "${${tag}_vx}")
  string(REGEX REPLACE "\\..*" "" vw "${${tag}_vw}")
  string(REGEX REPLACE "\\..*" "" ry "${${tag}_ry}")
  string(REGEX REPLACE "\\..*" "" by "${${tag}_by}")
  math(EXPR mx "${vx} + ${vw} / 2")
  math(EXPR my "${ry} + 30")
  math(EXPR sy "${by} + 10")
  math(EXPR t0 "${vx} + 4")
  math(EXPR tmid "${vx} + ${vw} / 2")
  math(EXPR t1 "${vx} + ${vw} - 4")
  math(EXPR tend "${vx} + ${vw} + 60")
  math(EXPR tback "${vx} - 60")
  set(s "10 move ${mx} ${my}\n12 wheel -1\n24 wheel -30\n62 wheel 30\n100 scroll -0.33 0\n112 scroll -1 0\n")
  string(APPEND s "126 mod shift 1\n127 wheel -1\n128 mod shift 0\n")
  string(APPEND s "134 move ${t0} ${sy}\n136 down 0\n138 move ${tmid} ${sy}\n140 move ${tend} ${sy}\n142 up 0\n")
  string(APPEND s "150 move ${t1} ${sy}\n152 down 0\n154 move ${tback} ${sy}\n156 up 0\n")
  run(${tag} ${size} "steps64,h300" 180 "${s}" ${ARGN})
  set(${tag}_dumps "${${tag}_dumps}" PARENT_SCOPE)
endfunction()

function(motions tag what)
  at(${tag} 11 rowsScroll y0)
  at(${tag} 11 rowsScrollMax ymax)
  at(${tag} 22 rowsScroll y1)
  at(${tag} 60 rowsScroll y2)
  at(${tag} 98 rowsScroll y3)
  check("${what}: the rows scroll up and down (${ymax} px more than the room)" ymax GREATER 0 AND y0 EQUAL 0)
  check("${what}: a wheel notch down scrolls the rows by 20 to 120 px (${y1})" y1 GREATER_EQUAL 20 AND y1 LESS_EQUAL 120)
  check("${what}: a long wheel down stops at the end (${y2} = ${ymax})" y2 EQUAL ymax)
  check("${what}: a long wheel up stops at the top (${y3})" y3 EQUAL 0)
  at(${tag} 98 scroll s0)
  at(${tag} 110 scroll s1)
  at(${tag} 110 stepW swf)
  string(REGEX REPLACE "\\..*" "" sw "${swf}")
  at(${tag} 110 scrollMax smax)
  check("${what}: the pattern scrolls sideways (${smax} px more than the view)" smax GREATER 0 AND s0 EQUAL 0)
  # a third of a notch: a third of a beat (four steps and their gaps), left a step cut in half
  math(EXPR third "(4 * (${sw} + 2) + 1) / 3")
  string(REGEX REPLACE "\\..*" "" s1i "${s1}")
  math(EXPR d "${s1i} - ${third}")
  check("${what}: a third of a sideways notch scrolls the steps by a third of a beat (${s1} for ${third})" d GREATER_EQUAL -3 AND d LESS_EQUAL 3)
  at(${tag} 124 scroll s2)
  string(REGEX REPLACE "\\..*" "" s2i "${s2}")
  math(EXPR beat "${s2i} - ${s1i}")
  math(EXPR want "4 * (${sw} + 2)")
  math(EXPR d "${beat} - ${want}")
  check("${what}: a sideways notch scrolls the steps by a beat (${beat} px for ${want})" d GREATER_EQUAL -3 AND d LESS_EQUAL 3)
  at(${tag} 148 scroll s3)
  at(${tag} 178 scroll s4)
  check("${what}: dragging the step slider to its right end scrolls to the pattern's end (${s3} = ${smax})" s3 EQUAL smax)
  check("${what}: dragging it back to its left end scrolls to the start (${s4})" s4 EQUAL 0)
endfunction()

# ---- floating, 1440x900 and 1920x1080 at 100 %, 1920x1080 at 200 %
scripted(f1440 1440x900)
steady(f1440 "1440x900")
motions(f1440 "1440x900")
scripted(f1920 1920x1080)
steady(f1920 "1920x1080")
motions(f1920 "1920x1080")
scripted(f200 1920x1080 --ui-scale 2)
steady(f200 "200 %")
motions(f200 "200 %")

# ---- docked (the dock node sets the size): the same steadiness while the steps scroll sideways
run(dock 1440x900 "steps64,dock" 60 "20 rack\n30 scroll -0.33 0\n40 scroll -1 0\n")
set(first TRUE)
set(changes 0)
foreach(d IN LISTS dock_dumps)
  field("${d}" paneBarX bx)
  field("${d}" paneScrollX px)
  field("${d}" itemsRight ir)
  field("${d}" rowRight rr)
  field("${d}" paneContentW cw)
  if(first)
    set(bx0 "${bx}")
    set(px0 "${px}")
    set(cw0 "${cw}")
    set(first FALSE)
  elseif(NOT bx STREQUAL bx0 OR NOT px STREQUAL px0 OR NOT cw STREQUAL cw0)
    math(EXPR changes "${changes} + 1")
  endif()
endforeach()
check("docked: the rows pane's own scrollbar (${bx0}), sideways scroll and width (${cw0}) the same in every frame (${changes} changed)"
      changes EQUAL 0)
