# Gridline - K-256 / K-340: customisable bars, pinned commands, what a workspace keeps, the Studio dock
# plan and Studio's zone keys, in the real app (hidden, isolated config folder and HOME, SDL's dummy
# audio driver, the development layouts):
#   1. every layout's bar model is the bar as designed (no pins, every part in its place);
#   2. a pinned command shows on the bar of every layout and a click on it (dev input) runs it; parts
#      switched off and moved stay so after a restart, one settings write each;
#   3. the palette: Ctrl+Enter (dev "palette pin") pins and unpins, the pinned rows lead the empty list;
#   4. a workspace with its own bar: switching swaps the bar in and out;
#   5. Studio: a workspace keeps its dock plan; switching rebuilds it (the tree captured again is the
#      same) and every open window is drawn inside the main window;
#   6. Studio's zone keys: off by default; on, Tab+digit jumps, Tab alone goes back, the digit never
#      plays a note with the typing keyboard on;
#   7. the drawer of cards, the bar list and the Layouts settings page draw (screenshots kept).
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k256_workspaces_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(failures 0)
macro(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR failures "${failures} + 1")
endmacro()
macro(ok msg)
  message(STATUS "ok - ${msg}")
endmacro()

# run(<tag> <cfg> <layout> <script> [args...]): config ${OUT}/cfg_<cfg> (kept between runs of one cfg).
function(run tag cfg layout script)
  set(c "${OUT}/cfg_${cfg}")
  if(NOT EXISTS "${c}/gridline/settings.json")
    file(MAKE_DIRECTORY "${c}/gridline" "${c}/home")
    file(WRITE "${c}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${layout}\"}}\n")
  endif()
  set(ENV{GRIDLINE_CONFIG_HOME} "${c}")
  set(ENV{HOME} "${c}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --layout-dev --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --dev-input "${OUT}/${tag}.txt" --screenshot "${OUT}/${tag}.ppm" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}):\n${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)

# ---- 1. the bars as designed ----
set(want_studio "menus transport pins tempo position pattern master monitor windows")
set(want_live "browser tempo meter metronome quantise key position transport recording capture sessionRecord recordMenu pins back follow loop punch range cpu draw typing view")
set(want_logic "panes toStart- nav cycle display countIn click typing pins master rightPanes")  # go to start: off as designed
set(want_tracker "pins")
foreach(l studio live logic tracker)
  run(default_${l} d_${l} ${l} "5 toasts clear\n30 toolbar dump\n40 quit discard\n" --frames 60)
  string(REGEX MATCH "TOOLBAR ${l} own 0/0 parts ([^\n]*) pins\n" line "${out}")
  set(got "${CMAKE_MATCH_1}")
  if(NOT got STREQUAL "${want_${l}}")
    fail("${l}: the bar as designed (got [${got}], want [${want_${l}}])")
  else()
    ok("${l}: the bar as designed, no pins (${got})")
  endif()
endforeach()

# ---- 2. a pinned command on every bar; a click on it runs it ----
foreach(l studio live logic tracker)
  set(s "5 toasts clear\n10 toolbar pin cmd:options.metronome Metronome\n20 toolbar dump\n24 palette state\n")
  string(APPEND s "30 toolbar run 0\n40 palette state\n50 shot \"${OUT}/pinned_${l}.ppm\"\n60 quit discard\n")
  run(pin_${l} p_${l} ${l} "${s}" --frames 80)
  if(NOT out MATCHES "TOOLBAR pin cmd:options.metronome ok" OR NOT out MATCHES "pins \\[cmd:options.metronome\\|Metronome\\|0\\|0\\]")
    fail("${l}: the pin was not kept")
  endif()
  string(REGEX MATCH "palette frame 24:[^\n]* metronome ([01])" _ "${out}")
  set(before "${CMAKE_MATCH_1}")
  string(REGEX MATCH "palette frame 40:[^\n]* metronome ([01])" _ "${out}")
  set(after "${CMAKE_MATCH_1}")
  if(NOT out MATCHES "TOOLBAR run 0 ok" OR before STREQUAL after OR before STREQUAL "")
    fail("${l}: the pinned button did not run its command (metronome ${before} -> ${after})")
  else()
    ok("${l}: pinned and run (metronome ${before} -> ${after})")
  endif()
endforeach()
# A setting, a plugin and a channel's own window cannot be pinned.
run(pin_refused pr studio "5 toolbar pin set:Audio/Output\n6 toolbar pin plug:gl.trio\n7 toolbar pin win:chan:1\n8 toolbar pin win:Mixer Mixer\n20 toolbar dump\n30 quit discard\n" --frames 40)
if(NOT out MATCHES "TOOLBAR pin set:Audio/Output refused" OR NOT out MATCHES "TOOLBAR pin plug:gl.trio refused" OR NOT out MATCHES "TOOLBAR pin win:chan:1 refused"
   OR NOT out MATCHES "TOOLBAR pin win:Mixer ok")
  fail("pins: settings, plugins and channel windows refused, a window kept")
else()
  ok("pins: settings, plugins and channel windows refused, a window kept")
endif()

# Parts switched off and moved stay after a restart.
run(parts_a pa studio "5 toasts clear\n10 toolbar hide monitor\n12 toolbar move pattern -1\n20 toolbar dump\n30 quit discard\n" --frames 40)
run(parts_b pa studio "20 toolbar dump\n30 quit discard\n" --frames 40)
string(REGEX MATCH "TOOLBAR studio own 0/0 parts ([^\n]*) pins" _ "${out}")
set(got "${CMAKE_MATCH_1}")
if(NOT got STREQUAL "menus transport pins tempo pattern position master monitor- windows")
  fail("Studio: a part off and the pattern picker one place earlier, kept after a restart (${got})")
else()
  ok("Studio: parts off and moved, kept after a restart")
endif()
file(READ "${OUT}/cfg_pa/gridline/settings.json" st)
if(NOT st MATCHES "layout.studio.toolbar")
  fail("Studio: the bar was not saved")
endif()
# Smooth: the older show / hide switches become its bar, once.
file(MAKE_DIRECTORY "${OUT}/cfg_mig/gridline" "${OUT}/cfg_mig/home")
file(WRITE "${OUT}/cfg_mig/gridline/settings.json"
     "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"logic\", \"ui.cbar.click\": false, \"ui.cbar.toStart\": true}}\n")
run(migrate mig logic "20 toolbar dump\n30 quit discard\n" --frames 40)
if(NOT out MATCHES "TOOLBAR logic own 0/0 parts [^\n]*toStart [^\n]*click-")
  fail("Smooth: ui.cbar.* not migrated")
else()
  ok("Smooth: the older switches migrated into its bar")
endif()

# ---- 3. the palette: pin and unpin, pinned first ----
set(s "5 toasts clear\n10 palette open\n14 palette pin cmd:file.save\n16 palette pin cmd:options.metronome\n20 palette state\n")
string(APPEND s "24 palette pin cmd:file.save\n28 palette state\n32 palette close\n40 quit discard\n")
run(palette pal studio "${s}" --frames 60)
string(REGEX MATCH "palette frame 20:[^\n]* top ([^ ]+) ;; ([^ ]+)" _ "${out}")
if(NOT CMAKE_MATCH_1 STREQUAL "cmd:file.save" OR NOT CMAKE_MATCH_2 STREQUAL "cmd:options.metronome")
  fail("palette: the pinned rows lead the empty list (${CMAKE_MATCH_1} ${CMAKE_MATCH_2})")
else()
  ok("palette: the pinned rows lead the empty list, in order")
endif()
string(REGEX MATCH "palette frame 28:[^\n]* top ([^ ]+)" _ "${out}")
if(NOT CMAKE_MATCH_1 STREQUAL "cmd:options.metronome" OR NOT out MATCHES "palette pin cmd:file.save off")
  fail("palette: unpinned (${CMAKE_MATCH_1})")
else()
  ok("palette: unpinned again")
endif()

# ---- 4. a workspace with its own bar ----
set(s "5 toasts clear\n10 workspace add Mix\n14 workspace keep 1 bar on\n18 toolbar hide click\n24 toolbar dump\n26 workspace dump\n")
string(APPEND s "30 workspace select 0\n40 toolbar dump\n50 workspace select 1\n60 toolbar dump\n70 quit discard\n")
run(ownbar ob logic "${s}" --frames 90)
string(REGEX MATCHALL "TOOLBAR logic own [01]/0 parts [^\n]*" dumps "${out}")
list(LENGTH dumps n)
if(n LESS 3)
  fail("own bar: three dumps (${n})")
else()
  list(GET dumps 0 d0)
  list(GET dumps 1 d1)
  list(GET dumps 2 d2)
  if(NOT d0 MATCHES "own 1/0.*click-" OR NOT d1 MATCHES "own 0/0" OR d1 MATCHES "click-" OR NOT d2 MATCHES "own 1/0.*click-")
    fail("own bar: switching swaps the workspace's bar in and out (${d0} | ${d1} | ${d2})")
  else()
    ok("own bar: switching swaps the workspace's own bar in and out")
  endif()
endif()
if(NOT out MATCHES "\\[Mix bar\\]")
  fail("own bar: the workspace says it keeps a bar")
endif()

# ---- 5. Studio: a workspace's dock plan ----
set(s "5 toasts clear\n10 layout open Mixer\n30 workspace add Mix\n40 layout close Mixer\n42 layout open Piano roll\n60 workspace select 0\n")
string(APPEND s "100 workspace dockcheck\n100 workspace switchcheck\n102 workspace select 1\n140 workspace dockcheck\n140 workspace switchcheck\n")
string(APPEND s "142 workspace dump\n150 shot \"${OUT}/studio_mix.ppm\"\n160 quit discard\n")
run(dock dk studio "${s}" --frames 180)
string(REGEX MATCHALL "WORKSPACE dockcheck [^\n]*" checks "${out}")
string(REGEX MATCHALL "WORKSPACE switchcheck [^\n]*" sw "${out}")
if(NOT checks STREQUAL "WORKSPACE dockcheck same;WORKSPACE dockcheck same")
  fail("Studio: the dock tree after each switch is the plan (${checks})")
else()
  ok("Studio: each switch rebuilds the workspace's dock plan")
endif()
if(NOT sw STREQUAL "WORKSPACE switchcheck ok;WORKSPACE switchcheck ok")
  fail("Studio: every open window drawn after each switch (${sw})")
else()
  ok("Studio: every open window drawn after each switch")
endif()

# ---- 6. Studio: zone keys ----
set(zk "20 sdlkey tab down\n21 sdlkey 2 down\n22 sdlkey 2 up\n23 sdlkey tab up\n30 zones dump\n")
run(zones_off zo studio "5 toasts clear\n${zk}40 quit discard\n" --frames 60)
if(out MATCHES "zones jump")
  fail("zone keys: off by default")
else()
  ok("zone keys: off by default")
endif()
set(s "5 toasts clear\n8 zones on\n10 palette run cmd:options.typingKeyboard\n")
string(APPEND s "20 sdlkey tab down\n21 sdlkey 1 down\n22 sdlkey 1 up\n23 sdlkey tab up\n30 zones dump\n")
string(APPEND s "40 sdlkey tab down\n41 sdlkey 2 down\n42 typing show\n43 sdlkey 2 up\n44 sdlkey tab up\n50 zones dump\n")
string(APPEND s "60 sdlkey tab down\n62 sdlkey tab up\n70 zones dump\n")
string(APPEND s "80 sdlkey tab down\n81 sdlkey 3 down\n82 sdlkey 3 up\n83 sdlkey tab up\n90 sdlkey tab down\n91 sdlkey 3 down\n92 sdlkey 3 up\n93 sdlkey tab up\n100 zones dump\n")
string(APPEND s "110 shot \"${OUT}/zones.ppm\"\n120 quit discard\n")
run(zones_on zn studio "${s}" --frames 140)
string(REGEX MATCHALL "zones jump [0-9] [^\n]*" jumps "${out}")
if(NOT jumps STREQUAL "zones jump 1 Playlist;zones jump 2 Piano roll;zones jump 1 Playlist;zones jump 3 Mixer;zones jump 3 Channel rack")
  fail("zone keys: Tab+1, Tab+2, Tab alone back, Tab+3 twice swaps (${jumps})")
else()
  ok("zone keys: Tab+digit jumps, Tab alone goes back, a second press swaps the zone's windows")
endif()
if(NOT out MATCHES "typing notes octave" OR out MATCHES "typing notes [0-9]")
  fail("zone keys: the digit played a note with the typing keyboard on")
else()
  ok("zone keys: the digit is taken, no note played")
endif()
if(NOT out MATCHES "ZONES on 1 live 1 tabset 0 [^\n]* tabbing 0")
  fail("zone keys: tabbing off while they are on")
endif()
# Clips' key set gives Tab its own work: zone keys never act there.
run(zones_clips zc live "5 toasts clear\n8 zones on\n${zk}40 quit discard\n" --frames 60)
if(out MATCHES "zones jump")
  fail("zone keys: none in Clips")
endif()

# ---- 7. the drawer, the bar list and the settings page draw ----
run(drawer dr studio "5 toasts clear\n10 workspace starters\n20 workspace drawer on\n40 shot \"${OUT}/drawer.ppm\"\n42 workspace drawer edit 1\n60 shot \"${OUT}/drawer_edit.ppm\"\n70 quit discard\n" --frames 90)
foreach(l studio live logic tracker)
  run(barlist_${l} bl_${l} ${l} "5 toasts clear\n8 toolbar pin cmd:options.metronome Metronome\n10 toolbar list\n20 toolbar find metro\n40 shot \"${OUT}/barlist_${l}.ppm\"\n50 quit discard\n" --frames 70)
endforeach()
run(page pg studio "5 toasts clear\n8 toolbar pin cmd:options.metronome Metronome\n10 workspace add Mix\n40 shot \"${OUT}/layouts_page.ppm\"\n60 quit discard\n" --frames 80 --show settings:13)
set(missing "")
foreach(f drawer drawer_edit barlist_studio barlist_live barlist_logic barlist_tracker layouts_page)
  if(NOT EXISTS "${OUT}/${f}.ppm")
    string(APPEND missing " ${f}")
  endif()
endforeach()
if(missing)
  fail("the drawer, the bar lists and the Layouts page drawn (no picture:${missing})")
else()
  ok("the drawer, the bar lists and the Layouts page drawn")
endif()

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} failure(s)")
endif()
