# Gridline - Plasma's keyboard drawer opens from its Keyboard button and from Alt+K, in the real
# app (hidden, off-screen, isolated config), at window sizes where the editor shows reduced
# (1440x900, 1280x800: its lower rows are laid out past the screen's edge at its design size)
# and at 100 % (1920x1080 with the editor size set to 100 %).
#   1. a run reports where the Keyboard button is on screen (GL_PLASMA_DRAWER_REPORT);
#   2. a click there opens the drawer, and it is drawn at its full height;
#   3. a click on an empty spot of the play bar, then Alt+K, opens it too; Alt+K again closes it.
# K-219, the drawer over the editor (at 50, 67, 75, 100 and 150 % and in a popped-out window):
#   4. a press, drag and wheel over the drawer (on a dial that lies under it, and on an empty
#      spot of the drawer) change nothing under it: the sound's other values stay the same;
#   5. its own controls work: the bend wheel moves while held and springs back, the mod wheel
#      stays, the bend range and trigger octave step with minus and plus, and the keys play
#      with a velocity by where they are pressed (louder lower on a key).
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -P k216_plasma_drawer_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/no-library")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GL_PLASMA_SERUM_ROOTS} "${OUT}/no-library")
set(ENV{GL_PLASMA_DRAWER_REPORT} "1")
unset(ENV{GRIDLINE_PLUGIN_WINDOW_SIZE})  # the real plugin window size setting (the suite pins 100 %)
set(kDrawerH 124)

# Runs the app with a script; sets `rep` to the last drawer report line in the parent scope.
function(run tag size script frames)
  file(MAKE_DIRECTORY "${OUT}/${tag}/cfg" "${OUT}/${tag}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/${tag}/cfg")
  set(ENV{HOME} "${OUT}/${tag}/home")
  file(WRITE "${OUT}/${tag}/in.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --plugin gl.plasma --size ${size} --frames ${frames}
                          --dev-input "${OUT}/${tag}/in.txt" --screenshot "${OUT}/${tag}/shot.ppm"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}/err.txt" "${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}):\n${err}")
  endif()
  string(REGEX MATCHALL "PLASMA_DRAWER [^\n]*" reps "${err}")
  list(LENGTH reps n)
  if(n EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: no drawer report:\n${err}")
  endif()
  list(GET reps -1 last)
  set(rep "${last}" PARENT_SCOPE)
  set(reps "${reps}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()

set(first "1440x900:0" "1280x800:0" "1920x1080:1")
if(ONLY219)
  set(first "")
endif()
foreach(case ${first})
  string(REPLACE ":" ";" parts "${case}")
  list(GET parts 0 size)
  list(GET parts 1 zoom)
  set(pre "")
  if(NOT zoom STREQUAL "0")
    set(pre "1 edzoomset gl.plasma ${zoom}\n")
  endif()

  # 1. where the button is once the window settled
  run(pos_${size} ${size} "${pre}" 30)
  if(NOT rep MATCHES "open 0 drawn 0 button ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "FAIL: ${size}: the drawer is not closed at first, or no button: ${rep}")
  endif()
  set(bx ${CMAKE_MATCH_1})
  set(by ${CMAKE_MATCH_2})
  set(bw ${CMAKE_MATCH_3})
  if(bw LESS 20)
    message(FATAL_ERROR "FAIL: ${size}: the Keyboard button is ${bw} px wide")
  endif()

  # 2. a click on the Keyboard button
  run(click_${size} ${size} "${pre}30 move ${bx} ${by}\n32 down 0\n34 up 0\n" 70)
  if(NOT rep MATCHES "open 1 drawn ([0-9]+) button")
    message(FATAL_ERROR "FAIL: ${size}: a click on the Keyboard button at ${bx},${by} did not open the drawer: ${rep}")
  endif()
  if(CMAKE_MATCH_1 LESS ${kDrawerH})
    message(FATAL_ERROR "FAIL: ${size}: the drawer opened from the button is drawn ${CMAKE_MATCH_1} of ${kDrawerH} high: ${rep}")
  endif()
  message(STATUS "ok - ${size}: the Keyboard button (${bx},${by}) opens the drawer, drawn ${CMAKE_MATCH_1} high")

  # 3. Alt+K (after a click on an empty spot of the play bar, left of the button: the editor has the keyboard)
  math(EXPR ex "${bx} - ${bw}")
  run(altk_${size} ${size} "${pre}30 move ${ex} ${by}\n32 down 0\n34 up 0\n40 mod alt 1\n41 key k\n42 mod alt 0\n" 80)
  if(NOT rep MATCHES "open 1 drawn ([0-9]+) button")
    message(FATAL_ERROR "FAIL: ${size}: Alt+K did not open the drawer: ${rep}")
  endif()
  if(CMAKE_MATCH_1 LESS ${kDrawerH})
    message(FATAL_ERROR "FAIL: ${size}: the drawer opened by Alt+K is drawn ${CMAKE_MATCH_1} of ${kDrawerH} high: ${rep}")
  endif()
  run(altk2_${size} ${size} "${pre}30 move ${ex} ${by}\n32 down 0\n34 up 0\n40 mod alt 1\n41 key k\n42 mod alt 0\n60 mod alt 1\n61 key k\n62 mod alt 0\n" 100)
  if(NOT rep MATCHES "open 0 drawn 0 button")
    message(FATAL_ERROR "FAIL: ${size}: Alt+K a second time did not close the drawer: ${rep}")
  endif()
  message(STATUS "ok - ${size}: Alt+K opens the drawer (full height) and closes it again")
endforeach()

# ---- K-219: nothing under the drawer reacts; the drawer's own controls work
function(devline tag)  # sets dev (the last PLASMA_DRAWER_DEV line) and devs (all of them)
  string(REGEX MATCHALL "PLASMA_DRAWER_DEV [^\n]*" d "${err}")
  list(LENGTH d n)
  if(n EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: no drawer parts report")
  endif()
  list(GET d -1 last)
  set(dev "${last}" PARENT_SCOPE)
  set(devs "${d}" PARENT_SCOPE)
endfunction()
function(field line name count out)  # the `count` numbers after `name` in a report line
  string(REGEX REPLACE ".* ${name} " "" rest "${line}")
  string(REPLACE " " ";" rest "${rest}")
  list(SUBLIST rest 0 ${count} v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()
function(r v out)  # a report number to an integer
  math(EXPR i "${v}" OUTPUT_FORMAT DECIMAL)
  set(${out} ${i} PARENT_SCOPE)
endfunction()

set(cases "1440x900:0:" "1280x800:0:" "1920x1080:0.5:" "1920x1080:0.67:" "1920x1080:0.75:" "1920x1080:1:" "2560x1600:1.5:" "1920x1080:1:detach")
foreach(case ${cases})
  string(REPLACE ":" ";" parts "${case}")
  list(GET parts 0 size)
  list(GET parts 1 zoom)
  list(LENGTH parts np)
  set(mode "")
  if(np GREATER 2)
    list(GET parts 2 mode)
  endif()
  set(tag "k219_${size}_${zoom}${mode}")
  string(REPLACE "." "_" tag "${tag}")
  set(pre "")
  if(NOT zoom STREQUAL "0")
    set(pre "1 edzoomset gl.plasma ${zoom}\n")
  endif()
  if(mode STREQUAL "detach")
    string(APPEND pre "2 vmonitors -240 -120 2160 1140\n6 detach Plasma 120 60 1500 1000\n")
  endif()
  # where the Keyboard button is, then the drawer opened from it: where its parts are
  run(${tag}_pos ${size} "${pre}" 40)
  if(NOT rep MATCHES "button ([0-9]+) ([0-9]+) ")
    message(FATAL_ERROR "FAIL: ${tag}: no Keyboard button: ${rep}")
  endif()
  set(bx ${CMAKE_MATCH_1})
  set(by ${CMAKE_MATCH_2})
  set(open "${pre}40 move ${bx} ${by}\n42 down 0\n44 up 0\n")
  run(${tag}_open ${size} "${open}" 90)
  if(NOT rep MATCHES "open 1 drawn ([0-9]+)")
    message(FATAL_ERROR "FAIL: ${tag}: the drawer did not open: ${rep}")
  endif()
  devline(${tag})
  set(before "${dev}")
  field("${before}" under 3 u)
  field("${before}" gap 2 g)
  field("${before}" "vals sum" 1 sum0)
  list(GET u 0 uk)
  r(${uk} uk)
  list(GET g 0 gx)
  list(GET g 1 gy)
  r(${gx} gx)
  r(${gy} gy)
  # 4. press, drag and wheel over the drawer: on the dial under it (when one is), on an empty spot
  set(s "${open}")
  set(f 100)
  set(spots "${gx}:${gy}")
  if(uk GREATER -1)
    list(GET u 1 ux)
    list(GET u 2 uy)
    r(${ux} ux)
    r(${uy} uy)
    list(APPEND spots "${ux}:${uy}")
  endif()
  foreach(spot ${spots})
    string(REPLACE ":" ";" xy "${spot}")
    list(GET xy 0 x)
    list(GET xy 1 y)
    math(EXPR y1 "${y} - 12")
    math(EXPR y2 "${y} + 12")
    math(EXPR f1 "${f} + 2")
    math(EXPR f2 "${f} + 4")
    math(EXPR f3 "${f} + 6")
    math(EXPR f4 "${f} + 8")
    math(EXPR f5 "${f} + 10")
    math(EXPR f6 "${f} + 12")
    math(EXPR f7 "${f} + 14")
    # hover, a wheel turn, a double-click, then a press dragged up and down
    string(APPEND s "${f} move ${x} ${y}\n${f1} wheel 3\n${f2} down 0\n${f2} up 0\n${f3} down 0\n${f3} up 0\n${f4} down 0\n${f5} move ${x} ${y1}\n${f6} move ${x} ${y2}\n${f7} up 0\n")
    math(EXPR f "${f} + 20")
  endforeach()
  math(EXPR fend "${f} + 20")
  run(${tag}_through ${size} "${s}" ${fend})
  devline(${tag})
  field("${dev}" "vals sum" 1 sum1)
  if(NOT sum1 STREQUAL sum0)
    message(FATAL_ERROR "FAIL: ${tag}: a press, drag or wheel over the drawer changed the sound under it (${sum0} -> ${sum1}; dial ${uk} under it):\n${dev}")
  endif()
  if(NOT rep MATCHES "open 1")
    message(FATAL_ERROR "FAIL: ${tag}: the drawer closed while it was used: ${rep}")
  endif()
  # and the drawer itself had the pointer wherever it was over the drawer (not a window under it)
  set(over 0)
  foreach(l ${devs})
    field("${l}" hot 1 hot)
    field("${l}" pop 1 pop)
    field("${l}" at 2 at)
    field("${l}" rect 4 rc)
    list(GET at 0 ax)
    list(GET at 1 ay)
    list(GET rc 0 rx0)
    list(GET rc 1 ry0)
    list(GET rc 2 rx1)
    list(GET rc 3 ry1)
    math(EXPR rx0 "${rx0} + 2")
    math(EXPR ry0 "${ry0} + 2")
    math(EXPR rx1 "${rx1} - 2")
    math(EXPR ry1 "${ry1} - 2")
    if(pop EQUAL 0 AND ax GREATER rx0 AND ax LESS rx1 AND ay GREATER ry0 AND ay LESS ry1)  # (a popup, such as a double-click's type-in, may lie over it)
      math(EXPR over "${over} + 1")
      if(NOT hot EQUAL 1)
        message(FATAL_ERROR "FAIL: ${tag}: the pointer at ${ax},${ay} is over the drawer but the drawer does not have it (a window under it does):\n${l}")
      endif()
    endif()
  endforeach()
  if(over EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: no report with the pointer over the drawer")
  endif()
  message(STATUS "ok - ${tag}: nothing under the drawer reacts to it (dial ${uk} under it, the empty spot ${gx},${gy})")

  # 5. the drawer's own controls
  field("${before}" pitch 4 pw)
  field("${before}" mod 4 mw)
  field("${before}" up 4 upb)
  field("${before}" down 4 dnb)
  field("${before}" oct 4 ocb)
  field("${before}" keys 4 kr)
  foreach(v pw mw upb dnb ocb kr)
    set(l "")
    foreach(n ${${v}})
      r(${n} n)
      list(APPEND l ${n})
    endforeach()
    set(${v} "${l}")
  endforeach()
  list(GET pw 0 px)
  list(GET pw 1 py)
  list(GET pw 3 ph)
  list(GET mw 0 mx)
  list(GET mw 1 my)
  list(GET mw 3 mh)
  math(EXPR pyU "${py} - ${ph} / 4")
  math(EXPR myU "${my} - ${mh} / 4")
  list(GET upb 0 upx)
  list(GET upb 1 upy)
  list(GET dnb 2 dmx)
  list(GET dnb 3 dmy)
  list(GET ocb 0 opx)
  list(GET ocb 1 opy)
  list(GET kr 0 kx0)
  list(GET kr 1 ky0)
  list(GET kr 3 ky1)
  math(EXPR kx "${kx0} + 3")
  math(EXPR kyTop "${ky0} + 3")
  math(EXPR kyBot "${ky1} - 3")
  set(s "${open}100 move ${px} ${py}\n102 down 0\n104 move ${px} ${pyU}\n106 move ${px} ${pyU}\n110 up 0\n")
  string(APPEND s "140 move ${mx} ${my}\n142 down 0\n144 move ${mx} ${myU}\n148 up 0\n")
  string(APPEND s "160 move ${upx} ${upy}\n162 down 0\n164 up 0\n170 move ${dmx} ${dmy}\n172 down 0\n174 up 0\n180 move ${opx} ${opy}\n182 down 0\n184 up 0\n")
  string(APPEND s "190 move ${kx} ${kyTop}\n192 down 0\n196 up 0\n200 move ${kx} ${kyBot}\n202 down 0\n206 up 0\n")
  run(${tag}_own ${size} "${s}" 230)
  devline(${tag})
  set(held 0)
  foreach(l ${devs})
    field("${l}" pw 1 v)
    if(v GREATER 0.05)
      set(held 1)
    endif()
  endforeach()
  if(NOT held)
    message(FATAL_ERROR "FAIL: ${tag}: dragging the bend wheel up did not bend: ${devs}")
  endif()
  field("${dev}" pw 1 pv)
  field("${dev}" mw 1 mv)
  field("${dev}" bu 1 bu)
  field("${dev}" bd 1 bd)
  field("${dev}" to 1 to)
  if(pv GREATER 0.001 OR pv LESS -0.001)
    message(FATAL_ERROR "FAIL: ${tag}: the bend wheel did not spring back to the centre (${pv}): ${dev}")
  endif()
  if(NOT mv GREATER 0.05)
    message(FATAL_ERROR "FAIL: ${tag}: the mod wheel did not stay where it was put (${mv}): ${dev}")
  endif()
  if(NOT bu EQUAL 3 OR NOT bd EQUAL -3 OR NOT to EQUAL 2)
    message(FATAL_ERROR "FAIL: ${tag}: the steppers: bend up ${bu} (want 3), bend down ${bd} (want -3), trigger octave ${to} (want 2): ${dev}")
  endif()
  # the two key presses: the same key, softer at its back than at its front
  set(vels "")
  set(lastKey "")
  foreach(l ${devs})
    field("${l}" key 1 kk)
    field("${l}" vel 1 vv)
    if(kk GREATER -1 AND NOT "${kk}:${vv}" STREQUAL "${lastKey}")
      list(APPEND vels "${kk}:${vv}")
      set(lastKey "${kk}:${vv}")
    endif()
  endforeach()
  list(LENGTH vels nv)
  if(nv LESS 2)
    message(FATAL_ERROR "FAIL: ${tag}: the keyboard did not play two notes: ${vels}")
  endif()
  list(GET vels 0 k0)
  list(GET vels -1 k1)
  string(REPLACE ":" ";" k0 "${k0}")
  string(REPLACE ":" ";" k1 "${k1}")
  list(GET k0 0 n0)
  list(GET k0 1 v0)
  list(GET k1 0 n1)
  list(GET k1 1 v1)
  if(NOT n0 EQUAL n1 OR NOT v1 GREATER v0)
    message(FATAL_ERROR "FAIL: ${tag}: the keys: key ${n0} at velocity ${v0} (its back), key ${n1} at ${v1} (its front): want the same key, louder at the front")
  endif()
  message(STATUS "ok - ${tag}: the bend wheel bends and springs back, the mod wheel stays (${mv}), the steppers step, key ${n0} plays at ${v0} at its back and ${v1} at its front")

  # 6. a slide across the keys plays each key in turn (the old one stops as the new one starts), and
  #    no key is left sounding: let go, Escape, the window losing focus, the drawer closed (Alt+K) or
  #    the plugin window closed while a key is held. After each of those a move onto another key
  #    (the button still held) must not sound it.
  list(GET kr 2 kx1)
  math(EXPR kstep "(${kx1} - ${kx0}) / 24")
  math(EXPR gy "(${ky0} + ${ky1} * 3) / 4")
  set(s "${open}")
  set(gx ${kx})
  string(APPEND s "100 move ${gx} ${gy}\n102 down 0\n")
  foreach(f 104 106 108 110 112 114)
    math(EXPR gx "${gx} + ${kstep}")
    string(APPEND s "${f} move ${gx} ${gy}\n")
  endforeach()
  string(APPEND s "118 up 0\n")
  math(EXPR k2 "${kx} + ${kstep} * 10")
  math(EXPR k3 "${kx} + ${kstep} * 14")
  set(f 130)
  foreach(stop "key escape" "focuslost" "mod alt 1\n#F1 key k\n#F2 mod alt 0" "closeplugins")
    math(EXPR f1 "${f} + 2")
    math(EXPR f2 "${f} + 6")
    math(EXPR f3 "${f} + 7")
    math(EXPR f4 "${f} + 8")
    math(EXPR f5 "${f} + 12")
    math(EXPR f6 "${f} + 16")
    string(REPLACE "#F1" "${f3}" stop "${stop}")
    string(REPLACE "#F2" "${f4}" stop "${stop}")
    string(APPEND s "${f} move ${k2} ${gy}\n${f1} down 0\n${f2} ${stop}\n${f5} move ${k3} ${gy}\n${f6} up 0\n")
    if(stop MATCHES "alt")  # open the drawer again
      math(EXPR f7 "${f} + 20")
      math(EXPR f8 "${f} + 21")
      math(EXPR f9 "${f} + 22")
      string(APPEND s "${f7} mod alt 1\n${f8} key k\n${f9} mod alt 0\n")
    endif()
    math(EXPR f "${f} + 40")
  endforeach()
  math(EXPR fend "${f} + 20")
  run(${tag}_glide ${size} "${s}" ${fend})
  string(REGEX MATCHALL "PLASMA_DRAWER_SOUND [^\n]*" snd "${err}")
  # the runs of keys between silences
  set(runs "")
  set(cur "")
  set(most 0)
  set(lastLive 0)
  foreach(l ${snd})
    field("${l}" note 1 nn)
    field("${l}" live 1 lv)
    set(lastLive ${lv})
    if(lv GREATER most)
      set(most ${lv})
    endif()
    if(nn EQUAL -1)
      if(NOT cur STREQUAL "")
        string(REPLACE ";" "," cur "${cur}")
        list(APPEND runs "${cur}")
        set(cur "")
      endif()
    else()
      set(prev "")
      if(NOT cur STREQUAL "")
        list(GET cur -1 prev)
      endif()
      if(NOT "${prev}" STREQUAL "${nn}")
        list(APPEND cur ${nn})
      endif()
    endif()
  endforeach()
  if(NOT cur STREQUAL "")
    message(FATAL_ERROR "FAIL: ${tag}: a key was left sounding (${cur}) after the plugin window closed:\n${snd}")
  endif()
  list(LENGTH runs nr)
  if(NOT nr EQUAL 5)
    message(FATAL_ERROR "FAIL: ${tag}: want five plays (the slide, then one key each before Escape, focus loss, Alt+K, closing the window), got ${nr}: ${runs}\n${snd}")
  endif()
  list(GET runs 0 slide)
  string(REPLACE "," ";" slide "${slide}")
  list(LENGTH slide ns)
  if(ns LESS 4)
    message(FATAL_ERROR "FAIL: ${tag}: the slide across the keys played ${ns} keys (${slide}), want 4 or more:\n${snd}")
  endif()
  set(prev -1)
  foreach(nn ${slide})
    if(NOT nn GREATER prev)
      message(FATAL_ERROR "FAIL: ${tag}: the slide went right but the keys did not rise: ${slide}")
    endif()
    set(prev ${nn})
  endforeach()
  foreach(i 1 2 3 4)
    list(GET runs ${i} one)
    if(one MATCHES ",")
      message(FATAL_ERROR "FAIL: ${tag}: a key kept playing after it should have stopped (play ${i}: ${one}):\n${snd}")
    endif()
  endforeach()
  if(most GREATER 1 OR NOT lastLive EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: the engine held ${most} keys at once (want 1 at most) and ${lastLive} at the end (want 0):\n${snd}")
  endif()
  message(STATUS "ok - ${tag}: a slide plays ${slide} one at a time (the engine held ${most} at most); Escape, focus loss, Alt+K and closing the window each stop the key")
endforeach()
message(STATUS "ok - the keyboard drawer opens from its button and from Alt+K at every window size")
