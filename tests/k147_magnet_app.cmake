# Gridline - K-147: magnetic divisions on Tracer's synced Time knob, in the real app (hidden,
# off-screen, isolated config, SDL's dummy audio driver). A scripted pointer drags the knob up one
# pixel a frame and the value is read every frame:
#   1. a plain drag rises steadily (never goes back), holds exactly on several divisions for a few
#      frames each and passes through values between them; the whole drag is one undo step;
#   2. with Shift held (fine drag) nothing holds: no division is kept for two frames running;
#   3. the mouse wheel steps from division to division (1/4 -> 1/2T -> 1/4. -> back to 1/2T).
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k147_magnet_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
set(kTicks 32)  # pp::DlyTicks
set(divisions 12 24 32 48 64 72 96 128 144 192 256 288 384 576 768)

function(run tag script frames)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size 1440x900 --frames ${frames} --screenshot "${OUT}/${tag}.ppm"
                          --dev-input "${OUT}/${tag}.txt" --plugin gl.delay
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${OUT}/${tag}.out" "${out}")
  file(REMOVE "${OUT}/${tag}.ppm")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

# values(<var>): every "param 32 <v>" read, rounded to 1/1000 tick, as a list of integers.
function(values var)
  string(REGEX MATCHALL "param ${kTicks} [-0-9.]+" all "${out}")
  set(v "")
  foreach(l IN LISTS all)
    string(REGEX MATCH "([-0-9]+)\\.([0-9][0-9][0-9])" _ "${l}")
    list(APPEND v "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
  endforeach()
  set(${var} "${v}" PARENT_SCOPE)
endfunction()

# drag(<shift 0|1>): the script for a 220 px drag up, with the value read every frame.
function(dragScript var shift)
  set(s "15 setting ui.pluginWindowSize 1\n20 atparam ${kTicks} 0 0\n20 plug ${kTicks}\n")
  if(shift)
    string(APPEND s "21 mod shift 1\n")
  endif()
  string(APPEND s "22 down 0\n")
  foreach(i RANGE 1 220)
    math(EXPR f "22 + ${i}")
    string(APPEND s "${f} atparam ${kTicks} 0 -${i}\n${f} plug ${kTicks}\n")
  endforeach()
  string(APPEND s "250 up 0\n252 plug ${kTicks}\n")
  set(${var} "${s}" PARENT_SCOPE)
endfunction()

# ---- 1. a plain drag
dragScript(script 0)
run(drag "${script}" 256)
values(v)
list(LENGTH v n)
if(n LESS 200)
  message(FATAL_ERROR "drag: only ${n} values read\n${out}")
endif()
string(REGEX MATCHALL "plug frame [0-9]+: undo [0-9]+" undos "${out}")
list(GET undos 0 u0)
list(GET undos -1 u1)
string(REGEX MATCH "undo ([0-9]+)" _ "${u0}")
set(undo0 ${CMAKE_MATCH_1})
string(REGEX MATCH "undo ([0-9]+)" _ "${u1}")
set(undo1 ${CMAKE_MATCH_1})
math(EXPR steps "${undo1} - ${undo0}")
if(NOT steps EQUAL 1)
  message(FATAL_ERROR "drag: ${steps} undo steps, expected one")
endif()
set(prev -1)
set(run 0)
set(held "")
set(between 0)
foreach(x IN LISTS v)
  if(x LESS prev)
    message(FATAL_ERROR "drag: the value went back from ${prev} to ${x} (thousandths of a tick): ${v}")
  endif()
  math(EXPR whole "${x} / 1000")
  math(EXPR frac "${x} % 1000")
  set(onDiv 0)
  if(frac EQUAL 0 AND whole IN_LIST divisions)
    set(onDiv 1)
  endif()
  if(x EQUAL prev AND onDiv)
    math(EXPR run "${run} + 1")
    if(run EQUAL 2 AND NOT whole IN_LIST held)
      list(APPEND held ${whole})
    endif()
  else()
    set(run 0)
  endif()
  if(NOT onDiv)
    math(EXPR between "${between} + 1")
  endif()
  set(prev ${x})
endforeach()
list(LENGTH held nheld)
if(nheld LESS 3 OR between LESS 20)
  message(FATAL_ERROR "drag: held on ${nheld} divisions (${held}), ${between} values between them; expected 3 or more and 20 or more: ${v}")
endif()
message(STATUS "ok - a drag holds on divisions ${held}, passes ${between} values between them, never goes back, one undo step")

# ---- 2. fine drag (Shift): no magnets
dragScript(script 1)
run(fine "${script}" 256)
values(v)
list(GET v 0 start)
set(prev -1)
set(moved 0)
foreach(x IN LISTS v)
  if(NOT x EQUAL start)
    set(moved 1)
  endif()
  math(EXPR whole "${x} / 1000")
  math(EXPR frac "${x} % 1000")
  if(moved AND x EQUAL prev AND frac EQUAL 0 AND whole IN_LIST divisions AND NOT x EQUAL 768000)
    message(FATAL_ERROR "fine drag: held on ${whole} ticks: ${v}")
  endif()
  set(prev ${x})
endforeach()
if(NOT moved)
  message(FATAL_ERROR "fine drag: the value never moved: ${v}")
endif()
message(STATUS "ok - with Shift the drag is free: no division holds")

# ---- 3. the wheel: division to division
run(wheel "15 setting ui.pluginWindowSize 1\n20 atparam ${kTicks} 0 0\n22 plug ${kTicks}\n24 wheel 1\n26 plug ${kTicks}\n28 wheel 1\n30 plug ${kTicks}\n32 wheel -1\n34 plug ${kTicks}\n" 38)
values(v)
if(NOT v STREQUAL "192000;256000;288000;256000")
  message(FATAL_ERROR "wheel: ${v}, expected 192, 256, 288, 256 ticks")
endif()
message(STATUS "ok - the wheel steps 1/4 -> 1/2T -> 1/4. -> 1/2T")
