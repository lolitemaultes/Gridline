# Gridline - K-7: Junction's map in the real app (hidden, isolated configs, off-screen, SDL's
# dummy audio driver), with a factory patch loaded into the effect:
#   1. the map draws its modules and ports inside the editor; the Panel page opens;
#   2. dragging from an output port to a free input port adds one cable as one undo step; undo
#      takes it back; dragging a module moves it as one undo step;
#   3. a click selects a module and Delete removes it, with its cables, as one undo step;
#   4. the wheel zooms about the pointer, F shows everything;
#   5. screenshots: both themes, interface scales 100 % and 200 %, Map and Panel. The whole matrix
#      runs where the frames are read by eye (macOS, or -DK7_FULL=ON). Elsewhere every check above
#      still runs, each app run stops soon after its last scripted frame, and four frames stand in
#      for the matrix: under Xvfb a software renderer took about 20 s per run, and 33 runs of 150
#      frames, seven of them at 2880x1800, do not fit the 300 s this test has (K-X).
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> -P k7_junction_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
if(NOT DEFINED K7_FULL)
  set(K7_FULL OFF)
  if(CMAKE_HOST_APPLE)
    set(K7_FULL ON)
  endif()
endif()
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

# run(<tag> <plugin> <size> <scale> <script> [extra app arguments]): a fresh config.
function(run tag plugin size scale script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  set(frames 150)
  if(NOT K7_FULL)
    set(last 0)
    string(REGEX MATCHALL "(^|\n)[0-9]+" marks "${script}")
    foreach(m IN LISTS marks)
      string(STRIP "${m}" m)
      if(m GREATER last)
        set(last ${m})
      endif()
    endforeach()
    math(EXPR frames "${last} + 15")
  endif()
  string(TIMESTAMP t0 "%s" UTC)
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size ${size} --ui-scale ${scale} --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" --plugin ${plugin} ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  file(WRITE "${OUT}/${tag}.out" "${out}")
  string(TIMESTAMP t1 "%s" UTC)
  math(EXPR dt "${t1} - ${t0}")
  message(STATUS "# ${tag}: ${frames} frames, ${dt} s")
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
endfunction()
function(ok msg)
  message(STATUS "ok - ${msg}")
endfunction()

# counts(<prefix> <nth dump>): <prefix>_modules, _links, _zoom of that "junction dump" line.
function(counts prefix nth)
  string(REGEX MATCHALL "junction modules [0-9]+ links [0-9]+ controls [0-9]+ snaps [0-9]+ selected [0-9]+ zoom [0-9.]+ page [0-9]+ v3 [0-9]+" all "${out}")
  list(LENGTH all n)
  if(n LESS_EQUAL ${nth})
    fail("no junction dump number ${nth}")
  endif()
  list(GET all ${nth} line)
  string(REGEX MATCH "modules ([0-9]+) links ([0-9]+) .* selected ([0-9]+) zoom ([0-9.]+)" _ "${line}")
  set(${prefix}_modules ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${prefix}_links ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${prefix}_selected ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${prefix}_zoom ${CMAKE_MATCH_4} PARENT_SCOPE)
endfunction()

# undo(<prefix> <frame>): <prefix>_pos: the undo position of the "plug" dump of that frame.
function(undo prefix frame)
  if(NOT out MATCHES "plug frame ${frame}: undo ([0-9]+) of")
    fail("no plug dump at frame ${frame}")
  endif()
  set(${prefix}_pos ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()

set(type gl.patcherfx)
set(load "10 junction patch 0\n20 junction dump\n")

# ---- geometry of the loaded patch
run(geometry ${type} 1440x900 1.0 "${load}")
counts(g 0)
if(g_modules LESS 2 OR g_links LESS 2)
  fail("factory patch not loaded: ${g_modules} modules, ${g_links} links")
endif()
ok("the map shows a factory patch: ${g_modules} modules, ${g_links} cables")

# A module (its rectangle, first in the list after the two host modules) and a free pair of
# audio ports: the host input's audio output (kind 0) to the first module's sidechain or any
# audio input not yet fed is hard to name in general, so a second cable from the host input
# to the last module's first audio input is used: same two ports are refused, others added.
string(REGEX MATCHALL "module [0-9]+ at [-0-9]+ [-0-9]+ [-0-9]+ [-0-9]+" mods "${out}")
list(LENGTH mods nmods)
math(EXPR lastmod "${nmods} - 1")
list(GET mods ${lastmod} m)
string(REGEX MATCH "module ([0-9]+) at ([-0-9]+) ([-0-9]+) ([-0-9]+) ([-0-9]+)" _ "${m}")
set(id ${CMAKE_MATCH_1})
math(EXPR hx "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
math(EXPR hy "${CMAKE_MATCH_3} + 8")

# ---- 2. moving a module: one undo step; undo restores
math(EXPR hx2 "${hx} + 30")
math(EXPR hy2 "${hy} + 20")
run(move ${type} 1440x900 1.0 "${load}30 plug\n32 move ${hx} ${hy}\n36 down 0\n40 move ${hx2} ${hy2}\n44 up 0\n50 plug\n52 junction dump\n60 undo\n70 junction dump\n")
undo(m0 30)
undo(m1 50)
math(EXPR want "${m0_pos} + 1")
if(NOT m1_pos EQUAL want)
  fail("moving a module: undo position ${m0_pos} -> ${m1_pos}")
endif()
string(REGEX MATCHALL "module ${id} at [-0-9 ]+pos [-0-9.]+ [-0-9.]+" where "${out}")
list(GET where 0 p0)
list(GET where 1 p1)
list(GET where 2 p2)
if(p0 STREQUAL p1)
  fail("the module did not move: ${p1}")
endif()
string(REGEX REPLACE ".*pos " "" pos0 "${p0}")
string(REGEX REPLACE ".*pos " "" pos2 "${p2}")
if(NOT pos0 STREQUAL pos2)
  fail("undo did not restore the position: ${pos0} / ${pos2}")
endif()
ok("a module drag is one undo step, undo restores it")

# ---- 2. wiring: drag from the host input's audio port to the last module's side input
#         (free in every factory patch); one more cable, one step, undo removes it.
string(REGEX MATCH "port 1 kind 0 out 1 index 0 at ([-0-9]+) ([-0-9]+)" _ "${out}")
set(ox ${CMAKE_MATCH_1})
set(oy ${CMAKE_MATCH_2})
run(geometry2 ${type} 1440x900 1.0 "${load}")
string(REGEX MATCH "port ${id} kind 0 out 0 index 1 at ([-0-9]+) ([-0-9]+)" _ "${out}")
set(ix ${CMAKE_MATCH_1})
set(iy ${CMAKE_MATCH_2})
if(ix STREQUAL "" OR ox STREQUAL "")
  fail("ports not found")
endif()
run(wire ${type} 1440x900 1.0 "${load}30 plug\n31 junction dump\n32 move ${ox} ${oy}\n36 down 0\n40 move ${ix} ${iy}\n44 move ${ix} ${iy}\n48 up 0\n54 plug\n55 junction dump\n60 undo\n70 junction dump\n")
counts(w0 1)
counts(w1 2)
counts(w2 3)
undo(u0 30)
undo(u1 54)
math(EXPR want "${w0_links} + 1")
if(NOT w1_links EQUAL want)
  fail("dragging a cable: ${w0_links} -> ${w1_links} cables")
endif()
math(EXPR want "${u0_pos} + 1")
if(NOT u1_pos EQUAL want)
  fail("a cable: undo position ${u0_pos} -> ${u1_pos}")
endif()
if(NOT w2_links EQUAL w0_links)
  fail("undo left ${w2_links} cables, expected ${w0_links}")
endif()
ok("a dragged cable is one undo step, undo removes it")

# ---- 3. selecting and deleting a module
run(del ${type} 1440x900 1.0 "${load}30 plug\n31 junction dump\n32 move ${hx} ${hy}\n36 down 0\n38 up 0\n44 junction dump\n46 key delete\n54 plug\n55 junction dump\n60 undo\n70 junction dump\n")
counts(d0 1)
counts(ds 2)
counts(d1 3)
counts(d2 4)
undo(u0 30)
undo(u1 54)
if(NOT ds_selected EQUAL 1)
  fail("a click selected ${ds_selected} modules")
endif()
math(EXPR want "${d0_modules} - 1")
if(NOT d1_modules EQUAL want)
  fail("Delete: ${d0_modules} -> ${d1_modules} modules")
endif()
if(NOT d1_links LESS d0_links)
  fail("Delete kept the module's cables: ${d0_links} -> ${d1_links}")
endif()
math(EXPR want "${u0_pos} + 1")
if(NOT u1_pos EQUAL want)
  fail("Delete: undo position ${u0_pos} -> ${u1_pos}")
endif()
if(NOT d2_modules EQUAL d0_modules OR NOT d2_links EQUAL d0_links)
  fail("undo of Delete: ${d2_modules} modules, ${d2_links} cables")
endif()
ok("Delete removes a module and its cables as one undo step, undo restores them")

# ---- 4. zoom
run(zoom ${type} 1440x900 1.0 "${load}30 junction dump\n32 move ${hx} ${hy}\n34 wheel 3\n70 junction dump\n72 key f\n80 junction dump\n")
counts(z0 1)
counts(z1 2)
if(NOT z1_zoom GREATER z0_zoom)
  fail("the wheel did not zoom in: ${z0_zoom} -> ${z1_zoom}")
endif()
ok("the wheel zooms: ${z0_zoom} -> ${z1_zoom}")

# ---- a knob drag on the map: values travel, nothing is prepared; the largest graph stays usable
run(knobs gl.patcherfx 1440x900 1.0 "10 junction stress 8\n40 junction select 16\n50 junction dump\n")
if(NOT out MATCHES "knob 1 at ([-0-9]+) ([-0-9]+)")
  fail("no cutoff knob in the inspector")
endif()
set(kx ${CMAKE_MATCH_1})
set(ky ${CMAKE_MATCH_2})
math(EXPR ky1 "${ky} + 12")
math(EXPR ky2 "${ky} + 24")
math(EXPR ky3 "${ky} + 36")
run(knobdrag gl.patcherfx 1440x900 1.0 "10 junction stress 8\n40 junction select 16\n70 junction counts\n72 plug\n74 move ${kx} ${ky}\n78 down 0\n82 move ${kx} ${ky1}\n86 move ${kx} ${ky2}\n88 shot \"${OUT}/knob_mid_drag.ppm\"\n90 move ${kx} ${ky3}\n94 up 0\n110 junction counts\n112 plug\n")
string(REGEX MATCHALL "junction counts builds [0-9]+ values [0-9]+ unchanged [0-9]+" lines "${out}")
list(LENGTH lines nl)
if(NOT nl EQUAL 2)
  fail("no counts")
endif()
list(GET lines 0 c0)
list(GET lines 1 c1)
string(REGEX MATCH "builds ([0-9]+) values ([0-9]+)" _ "${c0}")
set(b0 ${CMAKE_MATCH_1})
set(v0 ${CMAKE_MATCH_2})
string(REGEX MATCH "builds ([0-9]+) values ([0-9]+)" _ "${c1}")
set(b1 ${CMAKE_MATCH_1})
set(v1 ${CMAKE_MATCH_2})
if(NOT b1 EQUAL b0)
  fail("a knob drag rebuilt the graph: ${b0} -> ${b1}")
endif()
if(NOT v1 GREATER v0)
  fail("a knob drag sent no values: ${v0} -> ${v1}")
endif()
undo(k0 72)
undo(k1 112)
math(EXPR want "${k0_pos} + 1")
if(NOT k1_pos EQUAL want)
  fail("a knob drag: undo position ${k0_pos} -> ${k1_pos}")
endif()
ok("a knob drag in the running app prepares nothing (builds ${b1}, value edits ${v0} -> ${v1}) and is one undo step")

run(stress gl.patcherfx 1440x900 1.0 "10 junction stress 256\n40 junction select 16\n60 junction dump\n70 junction timing\n")
if(NOT out MATCHES "junction modules 256 ")
  fail("the large graph did not load")
endif()
string(REGEX MATCH "knob 1 at ([-0-9]+) ([-0-9]+)" _ "${out}")
set(kx ${CMAKE_MATCH_1})
set(ky ${CMAKE_MATCH_2})
math(EXPR ky1 "${ky} + 12")
math(EXPR ky2 "${ky} + 24")
run(stressdrag gl.patcherfx 1440x900 1.0 "10 junction stress 256\n40 junction select 16\n60 junction timing\n62 junction counts\n64 move ${kx} ${ky}\n68 down 0\n72 move ${kx} ${ky1}\n76 move ${kx} ${ky2}\n80 up 0\n90 junction counts\n92 junction timing\n")
string(REGEX MATCHALL "junction timing body [0-9.]+ ms \\(worst [0-9.]+\\)" tim "${out}")
message(STATUS "256 modules, editor: ${tim}")
string(REGEX MATCHALL "junction counts builds [0-9]+" lines "${out}")
list(LENGTH lines nl)
if(NOT nl EQUAL 2)
  fail("no counts on the large graph")
endif()
list(GET lines 0 c0)
list(GET lines 1 c1)
if(NOT c0 STREQUAL c1)
  fail("a knob drag on the large graph rebuilt it: ${c0} / ${c1}")
endif()
ok("256 modules: a knob drag prepares nothing")

if(K7_FULL)
  # ---- looks: pointer over a port, a cable mid drag, a module mid drag, long names in the inspector
  run(hover_port ${type} 1440x900 1.0 "${load}30 move ${ox} ${oy}\n")
  run(hover_module ${type} 1440x900 1.0 "${load}30 move ${hx} ${hy}\n")
  run(drag_cable ${type} 1440x900 1.0 "${load}30 move ${ox} ${oy}\n36 down 0\n42 move ${ix} ${iy}\n")
  run(drag_cable_free ${type} 1440x900 1.0 "${load}30 move ${ox} ${oy}\n36 down 0\n42 move 700 460\n")
  run(drag_module ${type} 1440x900 1.0 "${load}30 move ${hx} ${hy}\n36 down 0\n42 move ${hx2} ${hy2}\n")
  run(labels_dark ${type} 1440x900 1.0 "${load}20 junction select ${id}\n")
  run(labels_light_200 ${type} 2880x1800 2.0 "${load}20 junction select ${id}\n" --light)
  run(labels_pos ${type} 1440x900 1.0 "${load}20 junction select ${id}\n50 junction dump\n")
  string(REGEX MATCH "knob 6 at ([-0-9]+) ([-0-9]+)" _ "${out}")
  set(lx ${CMAKE_MATCH_1})
  math(EXPR ly "${CMAKE_MATCH_2} + 42")
  run(labels_hover ${type} 1440x900 1.0 "${load}20 junction select ${id}\n50 move ${lx} ${ly}\n")

  # ---- 5. every page in both themes and at both scales (the frames are checked by eye)
  foreach(t IN ITEMS gl.patcherfx gl.patcher)
    set(n 1)
    if(t STREQUAL gl.patcher)
      set(n 3)
    endif()
    set(script "10 junction patch ${n}\n")
    run(map_dark_100_${t} ${t} 1440x900 1.0 "${script}40 move 800 300\n")
    run(map_light_100_${t} ${t} 1440x900 1.0 "${script}" --light)
    run(map_dark_200_${t} ${t} 2880x1800 2.0 "${script}")
    run(panel_dark_100_${t} ${t} 1440x900 1.0 "${script}20 junction page 1\n")
    run(inspect_dark_100_${t} ${t} 1440x900 1.0 "${script}20 junction select 16\n")
    run(inspect_light_200_${t} ${t} 2880x1800 2.0 "${script}20 junction select 17\n" --light)
    run(panel_light_200_${t} ${t} 2880x1800 2.0 "${script}20 junction page 1\n" --light)
  endforeach()
else()
  # ---- every page draws, in both themes and scales: no pointer states, no by-eye matrix
  run(map_dark_100_gl.patcherfx gl.patcherfx 1440x900 1.0 "10 junction patch 1\n40 move 800 300\n")
  run(panel_light_100_gl.patcherfx gl.patcherfx 1440x900 1.0 "10 junction patch 1\n20 junction page 1\n" --light)
  run(inspect_light_200_gl.patcherfx gl.patcherfx 2880x1800 2.0 "10 junction patch 1\n20 junction select 17\n" --light)
  run(map_dark_100_gl.patcher gl.patcher 1440x900 1.0 "10 junction patch 3\n40 move 800 300\n")
endif()
ok("screenshots in ${OUT}")
