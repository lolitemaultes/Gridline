# Gridline: crash reports with a small program: symbol files resolve a code to a function and line,
# and the watchdog gives no false alarm (busy, slow, not armed, stopped and resumed like a suspended
# machine); it does fire on real silence.
#   cmake -DPROBE=<crash_probe> -DTOOL=<crash_symbolize.py> -DPYTHON=<python3> -DOUT=<dir> -P k39_crash_probe.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{HOME} "${OUT}")

function(reports dir kind outVar)
  file(GLOB files "${OUT}/${dir}/crash-reports/${kind}-*.txt")
  set(${outVar} "${files}" PARENT_SCOPE)
endfunction()

function(probe dir)
  execute_process(COMMAND "${PROBE}" "${OUT}/${dir}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  set(rc "${rc}" PARENT_SCOPE)
endfunction()

# ---- symbols ----
probe(sym fault)
if(rc EQUAL 0)
  message(FATAL_ERROR "the probe did not crash")
endif()
reports(sym crash found)
list(LENGTH found n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "fault: ${n} reports")
endif()
get_filename_component(probeDir "${PROBE}" DIRECTORY)
get_filename_component(probeName "${PROBE}" NAME)
file(MAKE_DIRECTORY "${OUT}/symbols")
if(APPLE)
  execute_process(COMMAND dsymutil "${PROBE}" -o "${OUT}/symbols/${probeName}.dSYM" RESULT_VARIABLE drc ERROR_QUIET)
  if(NOT drc EQUAL 0)
    message(FATAL_ERROR "dsymutil failed")
  endif()
elseif(WIN32)
  get_filename_component(stem "${PROBE}" NAME_WE)
  configure_file("${PROBE}" "${OUT}/symbols/${probeName}" COPYONLY)
  if(EXISTS "${probeDir}/${stem}.pdb")
    configure_file("${probeDir}/${stem}.pdb" "${OUT}/symbols/${stem}.pdb" COPYONLY)
  endif()
else()
  configure_file("${PROBE}" "${OUT}/symbols/${probeName}" COPYONLY)
endif()
execute_process(COMMAND "${PYTHON}" "${TOOL}" "${found}" --symbols "${OUT}/symbols"
                RESULT_VARIABLE trc OUTPUT_VARIABLE resolved ERROR_VARIABLE terr)
file(WRITE "${OUT}/resolved.txt" "${resolved}\n${terr}")
if(NOT trc EQUAL 0)
  message(FATAL_ERROR "the tool failed: ${terr}")
endif()
if(NOT resolved MATCHES "probeCaller")
  message(FATAL_ERROR "the code does not resolve to the function:\n${resolved}\n${terr}")
endif()
if(NOT resolved MATCHES "crash_probe\\.cpp:[0-9]+")
  message(FATAL_ERROR "the code does not resolve to the line:\n${resolved}\n${terr}")
endif()
message(STATUS "symbols: function and line")

# Pasted with quote marks, from standard input is the same parser.
file(READ "${found}" code)
string(REGEX REPLACE "\n([^\n])" "\n> \\1" quoted "> ${code}")
file(WRITE "${OUT}/quoted.txt" "Hi, this happened:\n\n${quoted}\nthanks\n")
execute_process(COMMAND "${PYTHON}" "${TOOL}" "${OUT}/quoted.txt" --symbols "${OUT}/symbols" OUTPUT_VARIABLE resolved2 ERROR_QUIET)
if(NOT resolved2 MATCHES "probeCaller")
  message(FATAL_ERROR "a quoted paste does not resolve:\n${resolved2}")
endif()
message(STATUS "symbols: a quoted paste too")

# ---- false alarms; the probe says frozen after two seconds ----
foreach(cmd "busy;5" "beat;5" "unarmed;5")
  list(GET cmd 0 name)
  probe(fa_${name} ${cmd})
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: rc ${rc}")
  endif()
  reports(fa_${name} freeze found)
  if(found)
    message(FATAL_ERROR "${name}: a false alarm: ${found}")
  endif()
  message(STATUS "${name}: no alarm")
endforeach()

# ---- the real thing ----
probe(silent quiet 5)
reports(silent freeze found)
if(NOT found)
  message(FATAL_ERROR "quiet: real silence gave no report")
endif()
message(STATUS "quiet: real silence gives a report")

# ---- a suspended process (stopped and continued, as closest to a sleeping machine that a test can do) ----
if(UNIX)
  file(WRITE "${OUT}/stop.sh" "\"$1\" \"$2\" beat 2 &\nsleep 0\nwait $!\n\"$1\" \"$2\" busy 14 &\npid=$!\nsleep 1\nkill -STOP $pid\nsleep 6\nkill -CONT $pid\nsleep 1\nkill -STOP $pid\nsleep 6\nkill -CONT $pid\nwait $pid\n")
  execute_process(COMMAND sh "${OUT}/stop.sh" "${PROBE}" "${OUT}/stopped" RESULT_VARIABLE rc TIMEOUT 60)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "stopped: rc ${rc}")
  endif()
  reports(stopped freeze found)
  if(found)
    message(FATAL_ERROR "stopped: a false alarm")
  endif()
  message(STATUS "stopped and resumed: no alarm")
endif()
