# Gridline - K-287: clips move in the Tracks layout (logic) and the Live layout (live) as they do in
# Studio's playlist, driven by scripted input in the real app (hidden, isolated config and HOME, fixed
# frame time) on a copy of the test song. Every gesture is checked against the project's clips (track,
# start, length) and makes exactly one undo step:
#   1. with the pointer (the Select tool; Live: Draw mode off) a clip's body drags it a bar later and a
#      track down, its right edge trims it a beat, Shift+drag copies it (Tracks: Alt+drag; Studio's Select drags a box);
#   2. with the pencil, zoomed in and scrolled down a track, a clip drags a bar later and a track down;
#   3. Tracks: a press on a clip under the overlay scroller at the grid's foot moves the clip (it paged
#      the view);
#   4. Live: after a session slot launched a clip (Live mode), an arrangement clip still drags (it
#      launched instead), and a slot's clips dragged onto an empty slot move there.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -DLAYOUT=logic|live -P k287_clip_move_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
# Clip 90 on track 8, moved to the Tracks layout's lowest visible row (under the horizontal overlay
# scroller) once the geometry is known.
string(REPLACE "\"playlist\": [" "\"playlist\": [{\"id\": 90, \"length\": 1536, \"pattern\": 19, \"start\": 3072, \"track\": 8}, " demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 200" demo "${demo}")
# The clip the gestures drag (cid, at tick base on track 1): clip 47 of the test song. In Live the
# arrangement starts after the live area (cp46), where clip 47 is a session slot's clip, so the
# gestures drag clip 91 instead: a copy of the bass line after the song's last clip (track 1, bar 17),
# with free room a track down and two bars on.
set(cid 47)
set(base 1536)
if(LAYOUT STREQUAL "live")  # a live area of two scenes (the session grid's slots): bars 1 to 8; saved in the Arrangement view (N48-07)
  string(REGEX REPLACE "\"playlist\": \\[" "\"live\": {\"areaEnd\": 3072, \"view\": \"arrangement\"}, \"playlist\": [{\"id\": 91, \"length\": 768, \"pattern\": 29, \"start\": 6144, \"track\": 1}, " demo "${demo}")
  # grid2-1118: read as a version 10 file (one written by Studio, whose grid slots may hold several clips): an
  # older version moves a slot's further clips into scenes of their own when it loads (test_grid2_1118).
  string(REGEX REPLACE "\"version\": *[0-9]+" "\"version\": 10" demo "${demo}")
  set(cid 91)
  set(base 6144)
endif()
math(EXPR at1 "${base} + 384")
math(EXPR at2 "${base} + 768")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL (${LAYOUT}): ${msg}\n${out}")
endfunction()

# run <tag> <script> [args...]: the app in the layout, its stdout in `out`.
function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layoutPreset\": \"${LAYOUT}\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --layout-dev --layout ${LAYOUT} ${ARGN} --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL (${LAYOUT}) ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

# geo <prefix>: the playlist geometry of `out` (the first plgeom): <p>_x0, <p>_ppt (ticks per 1000 px
# as an integer: px per 1000 ticks), <p>_top<k>, <p>_gy1 and clip rects <p>_c<id> (x0 x1 y0 y1).
function(geo p)
  if(NOT out MATCHES "plgeom frame [0-9]+: valid 1 x0 ([-0-9]+)[.0-9]* pxPerTick ([0-9]+)\\.([0-9][0-9][0-9])")
    fail("no playlist geometry")
  endif()
  set(${p}_x0 ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(whole ${CMAKE_MATCH_2})
  string(REGEX REPLACE "^0+(.)" "\\1" f "${CMAKE_MATCH_3}")
  math(EXPR ppt "${whole} * 1000 + ${f}")
  set(${p}_ppt ${ppt} PARENT_SCOPE)
  if(NOT out MATCHES "grid [-0-9.]+ [-0-9.]+ ([-0-9]+)")
    fail("no grid bottom")
  endif()
  set(${p}_gy1 ${CMAKE_MATCH_1} PARENT_SCOPE)
  if(NOT out MATCHES "hthumb [-0-9.]+ ([-0-9]+)")
    fail("no horizontal scroller")
  endif()
  set(${p}_hthumb1 ${CMAKE_MATCH_1} PARENT_SCOPE)
  if(out MATCHES "vthumb [-0-9.]+ [-0-9.]+ x ([-0-9]+)")  # the vertical scroller: the grid's right edge
    set(${p}_vx ${CMAKE_MATCH_1} PARENT_SCOPE)
  endif()
  foreach(k 0 1 2 3 4)
    if(NOT out MATCHES "\n  track ${k} top ([-0-9]+)")
      fail("no geometry for track ${k}")
    endif()
    set(${p}_top${k} ${CMAKE_MATCH_1} PARENT_SCOPE)
  endforeach()
  foreach(id 47 53 90 91)
    if(out MATCHES "\n  clip ${id} x ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* ([-0-9]+)")
      set(${p}_c${id} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4}" PARENT_SCOPE)
    endif()
  endforeach()
endfunction()

# clipAt <frame> <id>: c_track, c_start, c_len (empty: no such clip), n (clips), undo, from that frame's dump.
function(clipAt frame id)
  if(NOT out MATCHES "dump frame ${frame}: ([0-9]+) clips, [0-9]+ selected, undo ([0-9]+)\n")
    fail("no dump at frame ${frame}")
  endif()
  set(n ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(undo ${CMAKE_MATCH_2} PARENT_SCOPE)
  string(FIND "${out}" "dump frame ${frame}:" at)
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(REGEX MATCH "\n  clip ${id} kind [0-9]+ track ([0-9]+) start ([0-9]+) len ([0-9]+)" _ "${rest}")
  set(c_track "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(c_start "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(c_len "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()

function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    fail("${what}: want ${expect}, got ${got}")
  endif()
  message(STATUS "ok - ${LAYOUT}: ${what}")
endfunction()

# drag <var> <frame> <x0> <y0> <x1> <y1>: a press, four moves and a release from <frame> (ends 16 frames on).
function(drag var f x0 y0 x1 y1)
  math(EXPR f1 "${f} + 2")
  set(s "${f} move ${x0} ${y0}\n${f1} down 0\n")
  foreach(i 1 2 3 4)
    math(EXPR fi "${f1} + 2 * ${i}")
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 4")
    math(EXPR yi "${y0} + (${y1} - ${y0}) * ${i} / 4")
    string(APPEND s "${fi} move ${xi} ${yi}\n")
  endforeach()
  math(EXPR fu "${f} + 14")
  string(APPEND s "${fu} up 0\n")
  set(${var} "${s}" PARENT_SCOPE)
endfunction()

set(pl --show playlist)
run(geo "4 typing off\n12 plgeom\n16 quit discard\n" ${pl})
geo(g)
if(NOT DEFINED g_c${cid})
  fail("clip ${cid} is not drawn")
endif()
list(GET g_c${cid} 0 x0)
list(GET g_c${cid} 1 x1)
list(GET g_c${cid} 2 y0)
list(GET g_c${cid} 3 y1)
math(EXPR bar "384 * ${g_ppt} / 1000")
math(EXPR beat "96 * ${g_ppt} / 1000")
math(EXPR xm "(${x0} + ${x1}) / 2")
math(EXPR yb "${y1} - 4")  # the body, under the title strip
if(LAYOUT STREQUAL "live")  # N47-08: in Clips the body selects time; the clip moves by its title bar
  math(EXPR yb "${y0} + 5")
endif()
math(EXPR dTrack "${g_top2} - ${g_top1}")

# ---- 1. the pointer ----
math(EXPR xe "${xm} + ${bar}")
math(EXPR ye "${yb} + ${dTrack}")
drag(d 30 ${xm} ${yb} ${xe} ${ye})
run(ptr_move "4 typing off\n6 pltool select\n20 dump\n${d}50 dump\n54 quit discard\n" ${pl})
clipAt(20 ${cid})
set(u0 ${undo})
clipAt(50 ${cid})
want("pointer: the body drags a bar later" "${c_start}" ${at1})
want("pointer: and a track down" "${c_track}" 2)
math(EXPR du "${undo} - ${u0}")
want("pointer: one undo step" "${du}" 1)

math(EXPR xr "${x1} - 2")
math(EXPR xre "${xr} - ${beat}")
drag(d 30 ${xr} ${yb} ${xre} ${yb})
run(ptr_trim "4 typing off\n6 pltool select\n20 dump\n${d}50 dump\n54 quit discard\n" ${pl})
clipAt(20 ${cid})
set(u0 ${undo})
clipAt(50 ${cid})
want("pointer: the right edge trims a beat" "${c_start}/${c_len}" "${base}/672")
math(EXPR du "${undo} - ${u0}")
want("pointer: the trim is one undo step" "${du}" 1)

math(EXPR xe "${xm} + 2 * ${bar}")
drag(d 30 ${xm} ${yb} ${xe} ${yb})
# R01-03 (K-112B): the Tracks layout copies with Alt (the reference's Option-drag; Shift adds to the selection).
set(copyMod shift)
if(LAYOUT STREQUAL "logic")
  set(copyMod alt)
endif()
run(ptr_copy "4 typing off\n6 pltool select\n20 dump\n26 mod ${copyMod} 1\n${d}46 mod ${copyMod} 0\n50 dump\n54 quit discard\n" ${pl})
clipAt(20 ${cid})
set(u0 ${undo})
set(n0 ${n})
clipAt(50 200)
want("pointer: Shift+drag (Tracks: Alt+drag) copies (the copy two bars later)" "${c_track}/${c_start}" "1/${at2}")
clipAt(50 ${cid})
want("pointer: the original stays" "${c_track}/${c_start}" "1/${base}")
math(EXPR dn "${n} - ${n0}")
# hunt-1119: Smooth drags with No overlap: the copy lands on the start of the region two bars later (the
# same length) and takes its place, as a dropped region wins its start there; the other layouts add one.
set(moreClips 1)
if(LAYOUT STREQUAL "logic")
  set(moreClips 0)
endif()
want("pointer: one clip more (Smooth: in place of the one it covers)" "${dn}" ${moreClips})
math(EXPR du "${undo} - ${u0}")
want("pointer: the copy is one undo step" "${du}" 1)

# ---- 2. the pencil, zoomed in and scrolled ----
set(pre "4 typing off\n8 move 900 ${yb}\n10 wheel -1\n")
run(zgeo "${pre}24 plgeom\n28 quit discard\n" ${pl} --zoom 1.5)
geo(z)
if(NOT DEFINED z_c${cid})
  fail("clip ${cid} is not drawn zoomed in")
endif()
list(GET z_c${cid} 0 a0)
list(GET z_c${cid} 1 a1)
list(GET z_c${cid} 2 b0)
list(GET z_c${cid} 3 b1)
math(EXPR zbar "384 * ${z_ppt} / 1000")
math(EXPR zm "(${a0} + ${a1}) / 2")
math(EXPR zy "${b1} - 4")
if(LAYOUT STREQUAL "live")
  math(EXPR zy "${b0} + 5")
endif()
math(EXPR ze "${zm} + ${zbar}")
math(EXPR zye "${zy} + (${z_top2} - ${z_top1})")
drag(d 30 ${zm} ${zy} ${ze} ${zye})
run(pen_zoom "${pre}20 dump\n${d}50 dump\n54 quit discard\n" ${pl} --zoom 1.5)
clipAt(20 ${cid})
set(u0 ${undo})
clipAt(50 ${cid})
want("pencil, zoomed and scrolled: a bar later" "${c_start}" ${at1})
want("pencil, zoomed and scrolled: a track down" "${c_track}" 2)
math(EXPR du "${undo} - ${u0}")
want("pencil, zoomed and scrolled: one undo step" "${du}" 1)

# ---- 3. Tracks: a clip under the overlay scroller ----
if(LAYOUT STREQUAL "logic")
  # The row at the grid's foot depends on which panes the layout opens with (K-112B cp40: the lower
  # pane starts closed): clip 90 moves to that row, and the geometry is read again.
  # On the scroller's rail (its last pixels), clear of the gap between rows: K-112B cp54 moved Smooth's
  # rows 8 px up (a 26 px ruler), which put the grid's last pixels on a row boundary at 1440x900; the
  # first of the rail's last pixels at least 3 px inside a row is used.
  math(EXPR rowH "${g_top1} - ${g_top0}")
  set(ry "")
  foreach(back 2 3 4 5 6)
    math(EXPR cand "${g_gy1} - ${back}")
    math(EXPR into "(${cand} - ${g_top0}) % ${rowH}")
    math(EXPR lastIn "${rowH} - 3")
    if(ry STREQUAL "" AND NOT into LESS 3 AND NOT into GREATER lastIn)
      set(ry ${cand})
    endif()
  endforeach()
  if(ry STREQUAL "")
    math(EXPR ry "${g_gy1} - 2")
  endif()
  math(EXPR footTrack "(${ry} - ${g_top0}) / ${rowH}")
  string(REPLACE "\"start\": 3072, \"track\": 8}" "\"start\": 3072, \"track\": ${footTrack}}" demo "${demo}")
  file(WRITE "${OUT}/song.gridline.json" "${demo}")
  run(geo_foot "4 typing off\n12 plgeom\n16 quit discard\n" ${pl})
  geo(g)
  if(NOT DEFINED g_c90)
    fail("clip 90 is not drawn")
  endif()
  list(GET g_c90 0 a0)
  list(GET g_c90 1 a1)
  math(EXPR rx "(${a0} + ${a1}) / 2")
  if(NOT rx GREATER g_hthumb1)  # on the bare rail: the thumb itself still scrolls
    fail("clip 90 lies under the scroller's thumb (${rx} <= ${g_hthumb1})")
  endif()
  # The drag stays clear of the grid's right edge (near it the view scrolls along, the clip with it):
  # with Smooth's wider left panes (K-112B/K-112D) the clip's middle can lie within a bar of it.
  if(DEFINED g_vx)
    math(EXPR rxmax "${g_vx} - 60 - ${bar}")
    if(rx GREATER rxmax)
      set(rx ${rxmax})
    endif()
    math(EXPR a0in "${a0} + 4")
    if(rx LESS a0in OR NOT rx GREATER g_hthumb1)
      fail("no room on clip 90 for a bar's drag inside the grid (${a0}..${a1}, grid right ${g_vx})")
    endif()
  endif()
  math(EXPR rxe "${rx} + ${bar}")
  drag(d 30 ${rx} ${ry} ${rxe} ${ry})
  run(rail "4 typing off\n20 dump\n${d}50 dump\n51 plgeom\n54 quit discard\n" ${pl})
  clipAt(20 90)
  set(u0 ${undo})
  clipAt(50 90)
  want("a clip under the bottom scroller drags a bar later" "${c_track}/${c_start}" "${footTrack}/3456")
  math(EXPR du "${undo} - ${u0}")
  want("the drag under the scroller is one undo step" "${du}" 1)
  if(NOT out MATCHES "scrollY 0.000")
    fail("the press under the scroller scrolled the view")
  endif()
  message(STATUS "ok - ${LAYOUT}: the view stays put")
endif()

# ---- 4. Live: the session grid and Live mode ----
if(LAYOUT STREQUAL "live")
  # The grid view (Tab), a slot pressed (Drums, scene 1: Live mode), back to the arrangement.
  run(grid "4 typing off\n8 key tab\n14 livegrid\n18 quit discard\n")
  foreach(cell "0 0" "1 1" "2 0")
    string(REPLACE " " ";" tk "${cell}")
    list(GET tk 0 t)
    list(GET tk 1 k)
    if(NOT out MATCHES "\n  slot ${t} ${k} x ([0-9]+)[.0-9]* y ([0-9]+)[.0-9]* clip ([0-9]+)")
      fail("no slot ${t} ${k} in the grid")
    endif()
    set(sx_${t}${k} ${CMAKE_MATCH_1})
    set(sy_${t}${k} ${CMAKE_MATCH_2})
    set(sc_${t}${k} ${CMAKE_MATCH_3})
  endforeach()
  want("slot 2 1 holds the bass line" "${sc_11}" 47)
  want("slot 3 1 is empty" "${sc_20}" 0)
  math(EXPR xe "${xm} + ${bar}")
  drag(d 40 ${xm} ${yb} ${xe} ${yb})
  run(livemode "4 typing off\n8 key tab\n14 move ${sx_00} ${sy_00}\n16 down 0\n18 up 0\n24 key tab\n30 dump\n${d}60 dump\n64 quit discard\n")
  clipAt(30 ${cid})
  set(u0 ${undo})
  clipAt(60 ${cid})
  want("Live mode: an arrangement clip drags (a slot launch doesn't take the drag)" "${c_track}/${c_start}" "1/${at1}")
  math(EXPR du "${undo} - ${u0}")
  want("Live mode: one undo step" "${du}" 1)

  # Slot 2 1 (the bass line's two clips) dragged onto the empty slot 3 1 (scene 1 of Chords).
  drag(d 30 ${sx_11} ${sy_11} ${sx_20} ${sy_20})
  run(slots "4 typing off\n8 key tab\n20 dump\n${d}50 dump\n54 quit discard\n")
  clipAt(20 47)
  set(u0 ${undo})
  clipAt(50 47)
  want("a slot dragged to another moves its clip (track, start)" "${c_track}/${c_start}" "2/0")
  clipAt(50 48)
  want("and the slot's other clip with it" "${c_track}/${c_start}" "2/768")
  math(EXPR du "${undo} - ${u0}")
  want("the slot move is one undo step" "${du}" 1)
endif()
message(STATUS "k287_clip_move_app (${LAYOUT}): all checks passed")
