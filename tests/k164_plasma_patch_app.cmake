# Plasma's Patch view in the real app: every node and connection action is one undo step, Undo
# takes it back and Redo brings it again. The actions run in order through the Patch view's own
# calls (GL_PLASMA_PATCH_DEV, plasma_patch_ui.cpp), which prints the sound's state and the undo
# position before each one:
#   0 wire Layer 1 into Filter 2 as well   1 cut that wire          2 wire Layer 1 into Send A
#   3 cut the send wire                     4 wire a filter into itself (refused)
#   5 select Layer 1                        6 Delete (it turns off)  7 add an effect to the main chain
#   8 select the effect                     9 Delete (it goes)       10 undo  11 undo  12 redo
#   13 link LFO 1 onto Layer 1's level (selects the link)            14 Delete (the link goes)
cmake_minimum_required(VERSION 3.16)
file(MAKE_DIRECTORY "${OUT}")
file(REMOVE_RECURSE "${OUT}/cfg")
file(MAKE_DIRECTORY "${OUT}/cfg")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}")
set(ENV{GL_PLASMA_VIEW} "patch")
set(ENV{GL_PLASMA_PATCH_DEV} "connect 0 11;cut 0 1;connect 0 22;cut 0 4;connect 10 10;select 0;delete;addfx 5 0;select 100;delete;undo;undo;redo;link;delete")
execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --plugin gl.plasma --size 1440x900 --frames 260 --screenshot "${OUT}/p.ppm"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
unset(ENV{GL_PLASMA_VIEW})
unset(ENV{GL_PLASMA_PATCH_DEV})
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "FAIL: gridline-app failed (${rc}):\n${out}\n${err}")
endif()

foreach(n RANGE 15)
  if(NOT err MATCHES "PLASMA_PATCH_STATE ${n} undo ([0-9]+) dest ([-0-9.e]+) bal ([-0-9.e]+) sendA ([-0-9.e]+) on ([-0-9.e]+) fx ([-0-9.e]+) links ([0-9]+)")
    message(FATAL_ERROR "FAIL: the Patch view did not run action ${n} (is it drawn?):\n${err}")
  endif()
  set(s${n}_pos ${CMAKE_MATCH_1})
  set(s${n}_bal ${CMAKE_MATCH_3})
  set(s${n}_send ${CMAKE_MATCH_4})
  set(s${n}_on ${CMAKE_MATCH_5})
  set(s${n}_fx ${CMAKE_MATCH_6})
  set(s${n}_links ${CMAKE_MATCH_7})
endforeach()

# step(<n> <message> <condition...>): action n took one undo step and left the condition true
macro(step n msg)
  math(EXPR after "${n} + 1")
  math(EXPR want "${s${n}_pos} + 1")
  if(NOT s${after}_pos EQUAL want OR NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg} (undo ${s${n}_pos} -> ${s${after}_pos}; balance ${s${after}_bal}, send A ${s${after}_send}, "
                        "Layer 1 ${s${after}_on}, effect ${s${after}_fx})\n${err}")
  endif()
  message(STATUS "ok - ${msg}")
endmacro()

if(NOT s0_bal LESS -0.99)
  message(FATAL_ERROR "FAIL: the default sound should send Layer 1 into Filter 1 only (balance ${s0_bal})")
endif()
step(0 "Patch: wiring Layer 1 into Filter 2 as well feeds both filters, one undo step" s1_bal GREATER -0.99 AND s1_bal LESS 0.99)
step(1 "Patch: cutting that wire leaves Layer 1 on Filter 1 only, one undo step" s2_bal LESS -0.99)
step(2 "Patch: wiring Layer 1 into Send A sets a send level, one undo step" s3_send GREATER 0.001)
step(3 "Patch: cutting the Send A wire takes the send away, one undo step" s4_send EQUAL 0)
if(NOT s5_pos EQUAL s4_pos OR NOT err MATCHES "PLASMA_PATCH 4 connect refused: A filter cannot feed itself")
  message(FATAL_ERROR "FAIL: a filter wired into itself should be refused and change nothing\n${err}")
endif()
message(STATUS "ok - Patch: a filter cannot be wired into itself, and the refusal changes nothing")
if(NOT s6_pos EQUAL s5_pos)
  message(FATAL_ERROR "FAIL: selecting a box should not be an undo step")
endif()
step(6 "Patch: Delete on Layer 1 turns it off, one undo step" s6_on EQUAL 1 AND s7_on EQUAL 0)
step(7 "Patch: adding an effect puts it in the main chain, one undo step" s8_fx EQUAL 5)
step(9 "Patch: Delete on the effect takes it away, one undo step" s10_fx EQUAL 0)
math(EXPR u1 "${s10_pos} - 1")
math(EXPR u2 "${s10_pos} - 2")
if(NOT s11_pos EQUAL u1 OR NOT s11_fx EQUAL 5 OR NOT s12_pos EQUAL u2 OR NOT s12_fx EQUAL 0 OR NOT s12_on EQUAL 0)
  message(FATAL_ERROR "FAIL: Undo should take the actions back one at a time (pos ${s11_pos} / ${s12_pos}, effect ${s11_fx} / ${s12_fx})\n${err}")
endif()
message(STATUS "ok - Patch: Undo takes the actions back one at a time")
if(NOT s13_pos EQUAL s11_pos OR NOT s13_fx EQUAL 5)
  message(FATAL_ERROR "FAIL: Redo should bring the effect back (pos ${s13_pos}, effect ${s13_fx})\n${err}")
endif()
message(STATUS "ok - Patch: Redo brings the last action back")
step(13 "Patch: a new link from LFO 1 is one undo step" s14_links GREATER s13_links)
step(14 "Patch: Delete on the selected link takes it away, one undo step" s15_links EQUAL s13_links)

# The layout and the pointer: the big sound (25 links), a box dragged with the pointer and read back
# from the saved data, three messy layouts each cleaned up (no overlaps, no lines through boxes, a
# better score, one undo step; a second Clean up changes nothing; Undo brings the mess back
# exactly), a movement tile's dot dragged onto a box and a control picked from the short list (one
# undo step), and a selected tile's link end dragged off onto the canvas (unlinked, one undo step).
#   0 big   1 drag Filter 1 down   2 where is it   3 messy pile   4 cleanup   5 cleanup again
#   6 undo  7 messy reversed       8 cleanup       9 undo         10 messy shuffled  11 cleanup
#   12 fit  13 fit  14 LFO 3's dot onto Layer 1     15 pick the first control
#   16 select Envelope 2  17 drag its Filter 1 link end off       (18: the state after)
set(ENV{GL_PLASMA_VIEW} "patch")
set(ENV{GL_PLASMA_PATCH_DEV} "big;drag 10 0 96;where 10;messy 0;cleanup;cleanup;undo;messy 2;cleanup;undo;messy 4;cleanup;fit;fit;linkdrag 7 0;pick 0;select 202;unlinkdrag 11")
execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --fixed-dt 16 --plugin gl.plasma --size 1440x900 --frames 420 --screenshot "${OUT}/p2.ppm"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
unset(ENV{GL_PLASMA_VIEW})
unset(ENV{GL_PLASMA_PATCH_DEV})
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "FAIL: gridline-app failed (${rc}):\n${out}\n${err}")
endif()
foreach(n RANGE 18)
  if(NOT err MATCHES "PLASMA_PATCH_STATE ${n} undo ([0-9]+) [^\n]* links ([0-9]+)")
    message(FATAL_ERROR "FAIL: the Patch view did not run layout action ${n}:\n${err}")
  endif()
  set(u${n} ${CMAKE_MATCH_1})
  set(k${n} ${CMAKE_MATCH_2})
  if(NOT err MATCHES "PLASMA_PATCH_LAYOUT ${n} saved ([0-9]+) boxes ([0-9]+) overlaps ([0-9]+) through ([0-9]+) offgrid ([0-9]+) backward ([0-9]+) crossings ([0-9]+) total ([0-9]+) sig ([0-9a-f]+)")
    message(FATAL_ERROR "FAIL: no layout line for action ${n}:\n${err}")
  endif()
  set(saved${n} ${CMAKE_MATCH_1})
  set(ov${n} ${CMAKE_MATCH_3})
  set(th${n} ${CMAKE_MATCH_4})
  set(bw${n} ${CMAKE_MATCH_6})
  set(tot${n} ${CMAKE_MATCH_8})
  set(sig${n} ${CMAKE_MATCH_9})
endforeach()
macro(one n msg)
  math(EXPR after "${n} + 1")
  math(EXPR want "${u${n}} + 1")
  if(NOT u${after} EQUAL want OR NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg} (undo ${u${n}} -> ${u${after}}, links ${k${after}}, overlaps ${ov${after}}, through ${th${after}}, total ${tot${n}} -> ${tot${after}})\n${err}")
  endif()
  message(STATUS "ok - ${msg}")
endmacro()
one(0 "Layout: the big sound loads with its 25 links, one undo step" k1 EQUAL 25 AND ov1 EQUAL 0 AND th1 EQUAL 0)
one(1 "Layout: dragging a box with the pointer moves it and saves every place, one undo step" saved2 GREATER 0 AND ov2 EQUAL 0 AND NOT sig2 STREQUAL sig1)
if(NOT err MATCHES "PLASMA_PATCH_BOX 2 10 ([-0-9.e]+) ([-0-9.e]+) saved 1")
  message(FATAL_ERROR "FAIL: the dragged box should be read back from the saved sound\n${err}")
endif()
message(STATUS "ok - Layout: the dragged box is read back from the saved sound at ${CMAKE_MATCH_1}, ${CMAKE_MATCH_2}")
foreach(m 3 7 10)
  math(EXPR c "${m} + 1")
  math(EXPR a "${m} + 2")
  if(NOT ov${c} GREATER 0 AND NOT th${c} GREATER 0 AND NOT bw${c} GREATER 0)
    message(FATAL_ERROR "FAIL: messy layout ${m} should be messy (overlaps ${ov${c}}, through ${th${c}}, backward ${bw${c}})\n${err}")
  endif()
  one(${c} "Layout: Clean up after messy layout ${m}: no overlaps, no lines through boxes, a better score, one undo step"
      ov${a} EQUAL 0 AND th${a} EQUAL 0 AND tot${a} LESS tot${c})
endforeach()
if(NOT u6 EQUAL u5 OR NOT sig6 STREQUAL sig5 OR NOT err MATCHES "PLASMA_PATCH 5 cleanup refused")
  message(FATAL_ERROR "FAIL: a second Clean up should change nothing (undo ${u5} -> ${u6})\n${err}")
endif()
message(STATUS "ok - Layout: a second Clean up changes nothing")
if(NOT sig7 STREQUAL sig4 OR NOT sig10 STREQUAL sig8)
  message(FATAL_ERROR "FAIL: Undo should bring the messy layout back exactly (${sig7} vs ${sig4}, ${sig10} vs ${sig8})\n${err}")
endif()
message(STATUS "ok - Layout: Undo brings the messy layout back exactly")
math(EXPR want "${u14} + 1")
if(NOT err MATCHES "PLASMA_PATCH 14 linkdrag ok" OR NOT u15 EQUAL u14 OR NOT u16 EQUAL want OR NOT k16 EQUAL 26)
  message(FATAL_ERROR "FAIL: dragging LFO 3's dot onto Layer 1 and picking a control should add one link, one undo step (undo ${u14} ${u15} ${u16}, links ${k16})\n${err}")
endif()
message(STATUS "ok - Link by drag: a tile's dot onto a box, a control from the short list, one undo step")
one(17 "Unlink by drag: a selected tile's link end let go on the canvas takes the link away, one undo step" k18 EQUAL 25)
