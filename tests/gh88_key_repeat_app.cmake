# Gridline: GitHub #88, a held typing-keyboard key is one note however long it is held, in the real app
# (hidden, isolated config and HOME, SDL's dummy audio driver), in all four layouts. Each check holds a
# note key: a key-down, several key repeats (as the system's auto-repeat sends them, each in a batch of
# events of its own), then the key-up, and counts the engine's live note-ons and note-offs: exactly one
# of each. Checked with the typing keyboard playing in each layout, with the piano roll in front, in the
# Tracker's pattern editor (edit mode off and on: in edit mode the repeats still move down the rows, as a
# tracker's key repeat does, but the note is auditioned once) and its Instrument screen. Each hold runs twice:
# with the system's marked repeats, and with every repeat sent as a release and a new press at once. A focus loss
# while the key is held ends the note (one note-off), and the key-up after it ends nothing more.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P gh88_key_repeat_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")

function(fail what)
  message(FATAL_ERROR "FAIL: ${what}\n${out}")
endfunction()

# layout id, the first note key, the shortcut set
foreach(run "studio;z;studio" "live;a;live" "logic;a;logic" "tracker;z;tracker")
  list(GET run 0 lay)
  list(GET run 1 key)
  list(GET run 2 keyset)
  set(dir "${OUT}/${lay}")
  file(MAKE_DIRECTORY "${dir}/cfg/gridline" "${dir}/home")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  set(ENV{GRIDLINE_CONFIG_HOME} "${dir}/cfg")
  set(ENV{HOME} "${dir}/home")
  file(WRITE "${dir}/cfg/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layout\": \"${lay}\", \"keys.profile\": \"${keyset}\"}}\n")
  configure_file("${DEMO}" "${dir}/song.gridline.json" COPYONLY)

  set(script "5 toasts clear\n6 typing on\n7 typing select \"Bass\"\n")
  set(f 12)
  set(tags "")
  macro(then line)
    string(APPEND script "${f} ${line}\n")
    math(EXPR f "${f} + 3")
  endmacro()
  # One held key: down, then held for about 1.3 seconds with the system's key repeats two frames apart (a
  # batch of events each: about 30 a second, as Windows sends them), up.
  macro(hold tag)
    string(APPEND script "${f} typing count ${tag}-before\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey ${key} down\n")
    math(EXPR f "${f} + 2")
    foreach(r RANGE 1 40)
      string(APPEND script "${f} sdlkey ${key} down repeat\n")
      math(EXPR f "${f} + 2")
    endforeach()
    string(APPEND script "${f} typing show\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey ${key} up\n")
    math(EXPR f "${f} + 3")
    string(APPEND script "${f} typing count ${tag}-after\n")
    math(EXPR f "${f} + 2")
    list(APPEND tags ${tag})
  endmacro()
  # The same hold with each repeat sent as a release and a press in the same moment (remote desktop and
  # screen sharing clients, virtual machines, key remappers, X11 plugin windows): still one note.
  macro(holdpairs tag)
    string(APPEND script "${f} typing count ${tag}-before\n")
    math(EXPR f "${f} + 1")
    string(APPEND script "${f} sdlkey ${key} down\n")
    math(EXPR f "${f} + 2")
    foreach(r RANGE 1 40)
      string(APPEND script "${f} sdlkey ${key} up\n${f} sdlkey ${key} down\n")
      math(EXPR f "${f} + 2")
    endforeach()
    string(APPEND script "${f} sdlkey ${key} up\n")
    math(EXPR f "${f} + 3")
    string(APPEND script "${f} typing count ${tag}-after\n")
    math(EXPR f "${f} + 2")
    list(APPEND tags ${tag})
  endmacro()

  hold(play)
  holdpairs(play-pairs)
  then("focus \"Piano roll\"")
  hold(pianoroll)
  holdpairs(pianoroll-pairs)
  if(lay STREQUAL "tracker")
    then("tracker focus")
    string(APPEND script "${f} tracker cursor 6 0 0 0\n${f} tracker edit off\n")
    math(EXPR f "${f} + 2")
    hold(pattern)
    holdpairs(pattern-pairs)
    string(APPEND script "${f} tracker cursor 6 0 0 0\n${f} tracker edit on\n")
    math(EXPR f "${f} + 2")
    hold(patternedit)
    then("tracker dump")
    then("tracker edit off")
    then("tracker editors open instrument \"Bass\"")
    then("tracker editors focus")
    hold(instrument)
    holdpairs(instrument-pairs)
    then("tracker editors close")
  endif()
  # The focus goes while the key is held: the note ends then, the key-up later ends nothing more.
  string(APPEND script "${f} typing count focus-before\n")
  math(EXPR f "${f} + 1")
  string(APPEND script "${f} sdlkey ${key} down\n")
  math(EXPR f "${f} + 2")
  string(APPEND script "${f} sdlkey ${key} down repeat\n")
  math(EXPR f "${f} + 2")
  string(APPEND script "${f} focuslost\n")
  math(EXPR f "${f} + 3")
  string(APPEND script "${f} typing show\n")
  math(EXPR f "${f} + 1")
  string(APPEND script "${f} focusgained\n")
  math(EXPR f "${f} + 3")
  string(APPEND script "${f} sdlkey ${key} up\n")
  math(EXPR f "${f} + 3")
  string(APPEND script "${f} typing count focus-after\n")
  math(EXPR f "${f} + 2")
  list(APPEND tags focus)

  math(EXPR frames "${f} + 4")
  file(WRITE "${dir}/input.txt" "${script}")
  execute_process(COMMAND "${APP}" "${dir}/song.gridline.json" --hidden --no-ui-sounds --size 1440x900 --layout ${lay}
                          --dev-input "${dir}/input.txt" --fixed-dt 16 --frames ${frames}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  file(WRITE "${dir}/run.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    fail("${lay}: gridline-app failed (${rc})")
  endif()
  foreach(tag IN LISTS tags)
    string(REGEX MATCH "typing count ${tag}-before on ([0-9]+) off ([0-9]+)" m "${out}")
    if(NOT m)
      fail("${lay} ${tag}: no count before")
    endif()
    set(on0 ${CMAKE_MATCH_1})
    set(off0 ${CMAKE_MATCH_2})
    string(REGEX MATCH "typing count ${tag}-after on ([0-9]+) off ([0-9]+)" m "${out}")
    if(NOT m)
      fail("${lay} ${tag}: no count after")
    endif()
    math(EXPR on "${CMAKE_MATCH_1} - ${on0}")
    math(EXPR off "${CMAKE_MATCH_2} - ${off0}")
    message(STATUS "${lay} ${tag}: ${on} note-on, ${off} note-off")
    if(NOT on EQUAL 1 OR NOT off EQUAL 1)
      fail("${lay} ${tag}: the held key made ${on} note-ons and ${off} note-offs, not one of each")
    endif()
  endforeach()
  # The focus loss ended the note while the key was still down.
  string(REGEX MATCHALL "typing notes[^\n]*" shows "${out}")
  list(GET shows -1 lastShow)
  if(NOT lastShow MATCHES "^typing notes octave")
    fail("${lay}: a note was still held after the focus went: ${lastShow}")
  endif()
  if(lay STREQUAL "tracker")
    # Edit mode: the key's repeats typed on down the rows (the cursor moved), one audition.
    string(REGEX MATCH "tracker dump frame [0-9]+:[^\n]*" d "${out}")
    if(NOT d MATCHES " cursor [0-9]+ ([0-9]+) ")
      fail("tracker: no cursor row in the dump: ${d}")
    endif()
    if(CMAKE_MATCH_1 LESS 2)
      fail("tracker: in edit mode the key repeats no longer moved down the rows: ${d}")
    endif()
  endif()
  file(REMOVE_RECURSE "${dir}")
endforeach()
file(REMOVE_RECURSE "${OUT}")
message(STATUS "GitHub #88: every held key made one note-on and one note-off in every layout")
