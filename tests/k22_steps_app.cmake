# Gridline: K-22, channel rack steps in the piano roll, driven by scripted input in the real app.
# Runs the app hidden (isolated config and HOME, fixed frame time) on a copy of the test song,
# pattern 0 ("Beat") on channel 2 ("Hat": eight rack steps, C5, velocity 70, every other step):
#   1. the piano roll shows the steps (nothing converted by looking: the rack row stays);
#   2. dragging the fifth step note (tick 96) one step right moves the channel's steps into its
#      notes: eight notes, the moved one at tick 120, no rack row left, one undo step;
#   3. undo puts the rack row back exactly and leaves no notes.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k22_steps_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
configure_file("${DEMO}" "${OUT}/song.gridline.json" COPYONLY)  # a copy: never the fixture itself

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  set(ENV{SDL_AUDIODRIVER} "dummy")
  set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --edit 0 2 --hide rack
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

set(row "70 0 70 0 70 0 70 0 70 0 70 0 70 0 70 0")
run(geo "6 lane\n7 notes\n8 rackrow\n9 quit discard\n")
if(NOT geo_out MATCHES "lane frame [0-9]+: x0 ([-0-9.]+) pxPerTick ([0-9.]+) yTop ([-0-9.]+) [^\n]* pitchY0 ([-0-9.]+) rowH ([0-9.]+)")
  message(FATAL_ERROR "FAIL: no piano roll geometry\n${geo_out}")
endif()
set(x0 ${CMAKE_MATCH_1})
set(ppt ${CMAKE_MATCH_2})
set(py0 ${CMAKE_MATCH_4})
set(rowH ${CMAKE_MATCH_5})
if(NOT geo_out MATCHES "notes frame [0-9]+: 0 notes")
  message(FATAL_ERROR "FAIL: looking at the steps must not make notes\n${geo_out}")
endif()
if(NOT geo_out MATCHES "rackrow frame [0-9]+: 8 steps, undo ([0-9]+), row ${row}\n")
  message(FATAL_ERROR "FAIL: looking at the steps must not change them\n${geo_out}")
endif()
set(undo0 ${CMAKE_MATCH_1})
message(STATUS "ok - the piano roll shows the hat's rack steps, the rack row unchanged")
foreach(v x0 py0 rowH)
  string(REGEX REPLACE "\\..*" "" ${v} "${${v}}")
endforeach()
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)$" _p "${ppt}")
set(pptInt ${CMAKE_MATCH_1})
string(REGEX REPLACE "^0+" "" pptFrac "${CMAKE_MATCH_2}")
if(pptFrac STREQUAL "")
  set(pptFrac 0)
endif()
function(xat tick out)
  math(EXPR v "${x0} + ${tick} * ${pptInt} + ${tick} * ${pptFrac} / 1000000")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
math(EXPR cy "${py0} + (127 - 60) * ${rowH} + ${rowH} / 2")
math(EXPR keyX "${x0} - 20")
xat(100 xa)   # inside the step note at 96 (its body, away from the resize edge)
xat(112 xb)
xat(124 xc)   # one step (24 ticks) right
set(drag "4 typing off\n5 move ${keyX} ${cy}\n6 down 0\n7 up 0\n10 move ${xa} ${cy}\n11 down 0\n13 move ${xb} ${cy}\n15 move ${xc} ${cy}\n17 up 0\n19 notes\n20 rackrow\n")
run(drag "${drag}22 undo\n24 rackrow\n25 notes\n27 quit discard\n")
if(NOT drag_out MATCHES "notes frame [0-9]+: 8 notes")
  message(FATAL_ERROR "FAIL: the drag should move the eight steps into the notes\n${drag_out}")
endif()
if(NOT drag_out MATCHES "note [0-9] start 120 len 24 pitch 60 vel 70")
  message(FATAL_ERROR "FAIL: the dragged step note should land one step later (tick 120)\n${drag_out}")
endif()
if(drag_out MATCHES "note [0-9] start 96 ")
  message(FATAL_ERROR "FAIL: nothing should stay at tick 96\n${drag_out}")
endif()
if(NOT drag_out MATCHES "rackrow frame [0-9]+: 0 steps, undo ([0-9]+), row\n")
  message(FATAL_ERROR "FAIL: the rack row should be gone once the steps are notes\n${drag_out}")
endif()
set(undo1 ${CMAKE_MATCH_1})
math(EXPR want "${undo0} + 1")
if(NOT undo1 EQUAL want)
  message(FATAL_ERROR "FAIL: the drag and its conversion should be one undo step (${undo0} -> ${undo1})\n${drag_out}")
endif()
if(NOT drag_out MATCHES "rackrow frame [0-9]+: 8 steps, undo ${undo0}, row ${row}\n" OR NOT drag_out MATCHES "notes frame [0-9]+: 0 notes")
  message(FATAL_ERROR "FAIL: undo should put the rack steps back exactly\n${drag_out}")
endif()
message(STATUS "ok - a drag moves the steps into the piano roll in one undo step; undo restores the rack row")
