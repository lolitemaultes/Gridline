# Gridline: compact groups on the Stage in the real app (the default; hidden,
# isolated config, scripted input, 1440x900, a fixed 16 ms frame). Places come from a first run's "stage"
# report, so the checks follow the layout:
#   1. an untouched project: every track in one group, closed: a chip about one token in size;
#   2. a click on the chip opens it; a click on the empty floor and Esc close it; Tab onto a member opens it;
#   3. a tile dragged out of the open tray to the row behind the spot (where the tray stood) stays there,
#      and the group closes up; a click on that track then reaches it, a click beside the chip reaches the
#      stage (selects nothing);
#   4. a track dragged onto the chip and held there opens the group, and dropped into the tray it joins;
#   5. on a small stage (1024x700, the tray above the chip, not over it) a track held on the chip keeps the
#      group open (it never flickers open and shut).
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> -P stage_compact_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg/gridline")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
unset(ENV{GRIDLINE_STAGE_COMPACT})  # the default: compact groups on
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
file(WRITE "${OUT}/cfg/gridline/settings.json" "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true}}")

set(SZ 1440x900)
function(run tag frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --size ${SZ} --fixed-dt 16 --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt" --show mixer --show stage
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${o}")
  endif()
  set(${tag}_out "${o}" PARENT_SCOPE)
endfunction()

# sdump(<tag> <n>): the n-th (0-based) "stage" report: s_undo s_sel s_focus s_groups, s_ids and per mixer
# index i: s_x<i> s_y<i> s_side<i> s_pan<i> s_depth<i> s_group<i>; per group k: s_gy0<k> s_gy1<k>
# s_gx0<k> s_gx1<k> (where the tray stands when open), s_open<k>, s_cx0<k> s_cy0<k> s_cx1<k> s_cy1<k> (the chip), s_gcount<k>.
function(sdump tag n)
  string(REGEX MATCHALL "stage frame [0-9]+: [^\n]*\n(  (token|group) [^\n]*\n)*" all "${${tag}_out}")
  list(LENGTH all count)
  if(count LESS_EQUAL n)
    message(FATAL_ERROR "FAIL (${tag}): no stage report ${n}. Output:\n${${tag}_out}")
  endif()
  list(GET all ${n} d)
  string(REGEX MATCH "undo ([0-9]+) sel ([-0-9,]+) focus ([-0-9]+) shown ([0-9]+) groups ([0-9]+)" _ "${d}")
  set(s_undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(s_sel "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(s_focus "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(s_groups "${CMAKE_MATCH_5}" PARENT_SCOPE)
  string(REGEX MATCHALL "token [0-9]+ [^\n]*" toks "${d}")
  set(ids "")
  foreach(p IN LISTS toks)
    string(REGEX MATCH "group ([-0-9]+)" _ "${p}")
    set(gr "${CMAKE_MATCH_1}")
    string(REGEX MATCH "token ([0-9]+) x ([-0-9.]+) y ([-0-9.]+) side ([-0-9.]+) pan ([-0-9.]+) depth ([-0-9.]+)" _ "${p}")
    set(i "${CMAKE_MATCH_1}")
    list(APPEND ids ${i})
    set(s_x${i} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_y${i} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_side${i} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(s_pan${i} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    set(s_depth${i} "${CMAKE_MATCH_6}" PARENT_SCOPE)
    set(s_group${i} "${gr}" PARENT_SCOPE)
  endforeach()
  set(s_ids "${ids}" PARENT_SCOPE)
  string(REGEX MATCHALL "group [0-9]+ count [^\n]*" grs "${d}")
  foreach(p IN LISTS grs)
    string(REGEX MATCH "group ([0-9]+) count ([0-9]+) box ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)" _ "${p}")
    set(k "${CMAKE_MATCH_1}")
    set(s_gcount${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_gx0${k} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_gy0${k} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(s_gx1${k} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    set(s_gy1${k} "${CMAKE_MATCH_6}" PARENT_SCOPE)
    string(REGEX MATCH "open ([0-9.]+) chip ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)" _ "${p}")
    set(s_open${k} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(s_cx0${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_cy0${k} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_cx1${k} "${CMAKE_MATCH_4}" PARENT_SCOPE)
    set(s_cy1${k} "${CMAKE_MATCH_5}" PARENT_SCOPE)
    string(REGEX MATCH "tray ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)" _ "${p}")
    set(s_gx0${k} "${CMAKE_MATCH_1}" PARENT_SCOPE)  # the tray's place (box is what is on screen)
    set(s_gy0${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_gx1${k} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(s_gy1${k} "${CMAKE_MATCH_4}" PARENT_SCOPE)
  endforeach()
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

macro(int var value)
  string(REGEX REPLACE "\\..*" "" ${var} "${value}")
endmacro()

# ---- 1. closed at rest ----
run(layout 16 "12 stage\n")
sdump(layout 0)
check("one group, closed (${s_groups} groups, open ${s_open0})" s_groups EQUAL 1 AND s_open0 EQUAL 0)
int(CX0 "${s_cx00}")
int(CY0 "${s_cy00}")
int(CX1 "${s_cx10}")
int(CY1 "${s_cy10}")
int(TY0 "${s_gy00}")
int(TY1 "${s_gy10}")
math(EXPR cw "${CX1} - ${CX0}")
math(EXPR chh "${CY1} - ${CY0}")
list(GET s_ids 0 first)
list(GET s_ids 1 second)
int(SIDE "${s_side${first}}")
check("the chip is about one token in size (${cw} x ${chh}, token ${SIDE})" cw LESS 80 AND chh LESS 80 AND cw GREATER_EQUAL SIDE)
math(EXPR CX "(${CX0} + ${CX1}) / 2")
math(EXPR CY "(${CY0} + ${CY1}) / 2")

# ---- 2. open and close ----
math(EXPR floorX "${CX1} + 140")
run(openclose 120 "8 move ${CX} ${CY}\n10 down 0\n11 up 0\n30 stage\n40 move ${floorX} ${CY}\n42 down 0\n43 up 0\n60 stage\n64 move ${CX} ${CY}\n66 down 0\n67 up 0\n86 stage\n88 focus Mixer\n90 key escape\n110 stage\n")
sdump(openclose 0)
check("a click on the chip opens the group (${s_open0})" s_open0 EQUAL 1)
int(MX "${s_x${first}}")  # the first member's tile in the open tray
int(MY "${s_y${first}}")
sdump(openclose 1)
check("a click on the empty floor closes it (${s_open0}, sel ${s_sel})" s_open0 EQUAL 0)
sdump(openclose 2)
check("opened again" s_open0 EQUAL 1)
sdump(openclose 3)
check("Esc closes it (${s_open0})" s_open0 EQUAL 0)
run(tab 60 "6 focus Mixer\n8 key tab\n40 stage\n")
sdump(tab 0)
check("Tab onto a member (${s_focus}) opens its group (${s_open0})" s_open0 EQUAL 1)

# ---- 3. a track placed behind the group's spot ----
math(EXPR behindY "(${TY0} + ${CY0}) / 2")  # behind the spot: under the open tray, above the chip
check("the place behind (${behindY}) is where the open tray stands (${TY0} .. ${TY1}) and above the chip" behindY GREATER TY0 AND behindY LESS TY1 AND behindY LESS CY0)
set(open "8 move ${CX} ${CY}\n10 down 0\n11 up 0\n")
set(place "${open}30 move ${MX} ${MY}\n32 down 0\n34 move ${MX} ${behindY}\n36 move ${CX} ${behindY}\n70 move ${CX} ${behindY}\n72 up 0\n")
math(EXPR besideX "${CX1} + 10")
run(behind 140 "${place}100 stage\n")
sdump(behind 0)
set(t "${first}")
int(PX "${s_x${t}}")
int(PY "${s_y${t}}")
check("the tile dragged out to the row behind stays there (depth ${s_depth${t}}, group ${s_group${t}})" s_depth${t} GREATER 0.1 AND s_group${t} EQUAL -1)
check("... where the open tray stood (y ${PY} in ${TY0} .. ${TY1})" PY GREATER TY0 AND PY LESS TY1)
check("... and the group closed up after it (${s_open0})" s_open0 EQUAL 0)
check("one undo step (${s_undo})" s_undo EQUAL 1)
# Nothing chosen first (a click on the floor), then a click on the track behind, then one just beside the chip.
run(clicks 220 "${place}100 move ${floorX} ${CY}\n102 down 0\n103 up 0\n110 move ${PX} ${PY}\n112 down 0\n113 up 0\n130 stage\n140 move ${besideX} ${CY}\n142 down 0\n143 up 0\n160 stage\n")
sdump(clicks 0)
check("a click on the track behind the group reaches it (focus ${s_focus}, want ${t})" s_focus EQUAL t AND s_open0 EQUAL 0)
sdump(clicks 1)
check("a click just beside the chip reaches the stage: nothing chosen (${s_sel}), the group stays closed" s_focus EQUAL 0 AND s_open0 EQUAL 0 AND s_undo EQUAL 1)

# ---- 4. drag to join: held on the chip it opens, dropped in the tray it joins ----
# Where the open tray stands with that track behind it (it keeps clear of the track when it can).
run(trayat 140 "${place}100 move ${CX} ${CY}\n102 down 0\n103 up 0\n130 stage\n")
sdump(trayat 0)
check("opened with a track behind it (${s_open0})" s_open0 EQUAL 1)
int(OX0 "${s_gx00}")
int(OX1 "${s_gx10}")
int(OY0 "${s_gy00}")
int(OY1 "${s_gy10}")
math(EXPR trayX "(${OX0} + ${OX1}) / 2")
math(EXPR trayY "(${OY0} + ${OY1}) / 2")
run(join 240 "${place}100 stage\n110 move ${PX} ${PY}\n112 down 0\n114 move ${PX} ${CY0}\n116 move ${CX} ${CY}\n150 move ${CX} ${CY}\n152 stage\n154 move ${trayX} ${trayY}\n170 move ${trayX} ${trayY}\n172 stage\n174 up 0\n200 stage\n")
sdump(join 1)
check("a track held on the chip during a drag opens the group (${s_open0})" s_open0 EQUAL 1)
sdump(join 2)
check("... and it stays open while the drag is over the tray (${s_open0})" s_open0 EQUAL 1)
sdump(join 3)
check("dropped into the tray it joins the group (${s_pan${t}} ${s_depth${t}}, group ${s_group${t}})" s_pan${t} EQUAL 0 AND s_depth${t} EQUAL 0 AND s_group${t} EQUAL 0 AND s_undo EQUAL 2)

# ---- 5. a small stage: the tray opens above the chip, the pointer stays on the chip ----
set(SZ 1024x700)
set(demo "4 stage compactdemo\n6 stage none\n")
run(small 20 "${demo}12 stage\n")
sdump(small 0)
string(REGEX MATCH "group 2 count 2 [^\n]*chip ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)" _ "${small_out}")
set(k0 "${CMAKE_MATCH_1}")
set(k1 "${CMAKE_MATCH_2}")
set(k2 "${CMAKE_MATCH_3}")
set(k3 "${CMAKE_MATCH_4}")
int(KX0 "${k0}")
int(KY0 "${k1}")
int(KX1 "${k2}")
int(KY1 "${k3}")
math(EXPR KX "(${KX0} + ${KX1}) / 2")
math(EXPR KY "(${KY0} + ${KY1}) / 2")
int(LX "${s_x13}")
int(LY "${s_y13}")
run(smalldrag 80 "${demo}8 move ${LX} ${LY}\n10 down 0\n12 move ${LX} ${KY}\n14 move ${KX} ${KY}\n50 stage\n60 stage\n70 stage\n")
foreach(n 0 1 2)
  sdump(smalldrag ${n})
  check("small stage: held on the chip, the group stays open (report ${n}: ${s_open2})" s_open2 EQUAL 1)
endforeach()
