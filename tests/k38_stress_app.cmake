# Gridline: a seeded stress run in the real app (hidden, isolated config and HOME, SDL's dummy audio
# driver, no plugin scan). Each seed is one run of DevStress.h: rapid edits, undo and redo, channels,
# inserts, patterns and clips added and removed, play and stop, editors opening and closing, renders
# starting and cancelling, random pointer and keys over the panels. A run passes when the app ends by
# itself with exit code 0. A failing seed replays by itself:
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> [-DSEEDS="1;2;3"] [-DFRAMES=600]
#         [-DPER_FRAME=2] [-DGROUPS=mceptrui] [-DSECONDS=280] [-DKEEP=1] -P k38_stress_app.cmake
cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED SEEDS)
  set(SEEDS 1 2)
endif()
if(NOT DEFINED FRAMES)
  set(FRAMES 300)
endif()
if(NOT DEFINED PER_FRAME)
  set(PER_FRAME 2)
endif()
if(NOT DEFINED GROUPS)
  set(GROUPS mceptrui)
endif()
if(NOT DEFINED SECONDS)
  set(SECONDS 280)
endif()
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
foreach(seed IN LISTS SEEDS)
  set(work "${OUT}/s${seed}")
  file(REMOVE_RECURSE "${work}")
  file(MAKE_DIRECTORY "${work}/home")
  set(ENV{GRIDLINE_CONFIG_HOME} "${work}/home")
  set(ENV{HOME} "${work}/home")
  configure_file("${DEMO}" "${work}/song.gridline.json" COPYONLY)
  file(WRITE "${work}/script.txt" "1 stress ${seed} ${FRAMES} ${PER_FRAME} \"${work}\" ${GROUPS} \"${work}/song.gridline.json\"\n")
  execute_process(COMMAND "${APP}" "${work}/song.gridline.json" --hidden --no-ui-sounds --size 1440x900 --dev-input "${work}/script.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${SECONDS})
  file(WRITE "${work}/run.log" "${out}\n--- stderr ---\n${err}\n")
  if(NOT rc EQUAL 0 OR NOT out MATCHES "stress done")
    string(LENGTH "${out}" n)
    if(n GREATER 1500)
      math(EXPR at "${n} - 1500")
      string(SUBSTRING "${out}" ${at} 1500 out)
    endif()
    string(SUBSTRING "${err}" 0 6000 err)
    message(FATAL_ERROR "FAIL: seed ${seed} (exit ${rc}), log ${work}/run.log\n...${out}\n${err}")
  endif()
  message(STATUS "ok - seed ${seed}: ${FRAMES} frames, ${PER_FRAME} actions per frame")
  if(NOT KEEP)
    file(REMOVE_RECURSE "${work}/out0" "${work}/out1" "${work}/out2" "${work}/out3")
  endif()
endforeach()
