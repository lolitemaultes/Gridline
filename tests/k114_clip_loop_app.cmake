# Gridline K-114 / K-82: clip edges in the real app (hidden, isolated config and HOME, fixed frame
# time), scripted input on a copy of the test song:
#   1. a plain drag of a pattern clip's right edge extends it (no loop); with Ctrl held it loops; the key
#      is read live (pressed mid-drag: loops; pressed and released again before the release: extends);
#      each drag is one undo step; a plain drag of a looping clip back to its pattern's length stops
#      the loop (live: out again in the same drag, it keeps looping), one undo step;
#   2. an audio clip's right edge stops at the end of its file; with Ctrl it loops past it;
#   3. Ctrl + left edge loops the clip and moves its loop start (it grows to the left); a plain left
#      drag cannot grow a clip that does not loop;
#   4. K-82: a clip slightly off the beat dragged back past the song's start lands on 0.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k114_clip_loop_app.cmake
cmake_minimum_required(VERSION 3.16)
# The loop key: Ctrl, Cmd on macOS. The dev input's "super" is Cmd there ("ctrl" the physical
# Ctrl key, which turns a click into a right-click).
if(CMAKE_HOST_APPLE)
  set(loopKey super)
else()
  set(loopKey ctrl)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
set(clips "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 7, \"start\": 384, \"length\": 200, \"pattern\": 0, \"gain\": 1.0}, ")
string(APPEND clips "{\"id\": 72, \"track\": 8, \"start\": 0, \"length\": 384, \"pattern\": 28}, ")
string(APPEND clips "{\"id\": 73, \"track\": 9, \"start\": 40, \"length\": 384, \"pattern\": 28}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${chan}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clips}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --show playlist
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()

run(plgeo "4 typing off\n8 plgeom\n12 quit discard\n")
foreach(id 70 72 73)
  if(NOT out MATCHES "  clip ${id} x ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* ([-0-9]+)")
    message(FATAL_ERROR "FAIL: no geometry for clip ${id}\n${out}")
  endif()
  set(x0_${id} ${CMAKE_MATCH_1})
  set(x1_${id} ${CMAKE_MATCH_2})
  math(EXPR y_${id} "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}) / 2 + 4")
endforeach()
math(EXPR barPx "${x1_72} - ${x0_72}")  # clip 72 is one bar (384 ticks)

# clip <id> at <frame> -> c_start, c_len, c_offset, c_loop, c_audioEnd; and undo_<frame>.
function(clipAt frame id)
  string(REGEX MATCH "dump frame ${frame}: [0-9]+ clips, [0-9]+ selected, undo ([0-9]+)\n(  clip [^\n]*\n)*" d "${out}")
  set(undo_${frame} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "  clip ${id} kind [^\n]*" line "${d}")
  if(NOT line MATCHES " start ([0-9]+) len ([0-9]+) offset ([0-9]+)")
    message(FATAL_ERROR "FAIL: no clip ${id} in dump ${frame}\n${out}")
  endif()
  set(c_start ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(c_len ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(c_offset ${CMAKE_MATCH_3} PARENT_SCOPE)
  if(NOT line MATCHES " audioEnd ([0-9.]+) .* loop ([01])")
    message(FATAL_ERROR "FAIL: no loop field for clip ${id} in dump ${frame}\n${out}")
  endif()
  set(c_audioEnd ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(c_loop ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()

# Right-edge drag of <id> by <px> pixels; <pre> / <mid> / <late> are extra script lines at frames 6 / 18 / 26.
function(edgeDrag tag id px pre mid late)
  math(EXPR xs "${x1_${id}} - 3")
  math(EXPR xh "${xs} + ${px} / 2")
  math(EXPR xe "${x1_${id}} + ${px} + 2")  # the pointer's tick snaps down to the grid: just past the target
  run(${tag} "4 typing off\n5 dump\n${pre}8 move ${xs} ${y_${id}}\n12 down 0\n16 move ${xh} ${y_${id}}\n${mid}22 move ${xe} ${y_${id}}\n${late}30 up 0\n34 mod ${loopKey} 0\n38 dump\n42 quit discard\n")
  clipAt(5 ${id})
  set(u0 ${undo_5})
  clipAt(38 ${id})
  set(c_len ${c_len} PARENT_SCOPE)
  set(c_loop ${c_loop} PARENT_SCOPE)
  set(c_audioEnd ${c_audioEnd} PARENT_SCOPE)
  math(EXPR steps "${undo_38} - ${u0}")
  set(steps ${steps} PARENT_SCOPE)
endfunction()

math(EXPR two "2 * ${barPx}")
# ---- 1. pattern clip ----
edgeDrag(pat_plain 72 ${two} "" "" "")
want("pattern clip, plain right-edge drag: length" "${c_len}" 1152)
want("pattern clip, plain right-edge drag: does not loop" "${c_loop}" 0)
want("pattern clip, plain right-edge drag: one undo step" "${steps}" 1)
edgeDrag(pat_ctrl 72 ${two} "6 mod ${loopKey} 1\n" "" "")
want("pattern clip, Ctrl + right-edge drag: length" "${c_len}" 1152)
want("pattern clip, Ctrl + right-edge drag: loops" "${c_loop}" 1)
want("pattern clip, Ctrl + right-edge drag: one undo step" "${steps}" 1)
edgeDrag(pat_live_on 72 ${two} "" "18 mod ${loopKey} 1\n" "")
want("pattern clip, Ctrl pressed mid-drag: loops" "${c_loop}" 1)
edgeDrag(pat_live_off 72 ${two} "" "18 mod ${loopKey} 1\n" "26 mod ${loopKey} 0\n")
want("pattern clip, Ctrl pressed and released mid-drag: extends" "${c_loop}" 0)
want("pattern clip, Ctrl pressed and released mid-drag: length" "${c_len}" 1152)

# A looping clip pulled back to its pattern's length with a plain drag stops looping; a later plain
# drag then just extends. <live>: the same drag goes out again before the release (it keeps looping).
function(unloopRun tag live)
  math(EXPR xs "${x1_72} - 3")
  math(EXPR xh "${xs} + ${barPx}")
  math(EXPR xe "${x1_72} + ${two} + 2")
  set(xn ${xe})  # 3 px inside the new edge (the bar is a fraction wider than barPx)
  math(EXPR xm "${xn} - ${barPx}")
  math(EXPR xb "${x1_72} + 2")
  set(back "68 move ${xb} ${y_72}\n")
  if(live)
    string(APPEND back "72 move ${xe} ${y_72}\n")
  endif()
  run(${tag} "4 typing off\n5 dump\n6 mod ${loopKey} 1\n8 move ${xs} ${y_72}\n12 down 0\n16 move ${xh} ${y_72}\n22 move ${xe} ${y_72}\n30 up 0\n32 mod ${loopKey} 0\n34 dump\n38 move ${xn} ${y_72}\n60 down 0\n64 move ${xm} ${y_72}\n${back}76 up 0\n80 dump\n84 move ${xs} ${y_72}\n106 down 0\n110 move ${xh} ${y_72}\n114 move ${xe} ${y_72}\n118 up 0\n122 dump\n126 quit discard\n")
  set(out "${out}" PARENT_SCOPE)
endfunction()
unloopRun(pat_unloop OFF)
clipAt(5 72)
set(u0 ${undo_5})
clipAt(34 72)
want("pattern clip, looped first: loops" "${c_loop}" 1)
set(u1 ${undo_34})
clipAt(80 72)
want("pattern clip, plain drag back to the pattern's length: length" "${c_len}" 384)
want("pattern clip, plain drag back to the pattern's length: stops looping" "${c_loop}" 0)
math(EXPR steps "${undo_80} - ${u1}")
want("pattern clip, plain drag back to the pattern's length: one undo step" "${steps}" 1)
clipAt(122 72)
want("pattern clip, then a plain extend: length" "${c_len}" 1152)
want("pattern clip, then a plain extend: does not loop" "${c_loop}" 0)
unloopRun(pat_unloop_live ON)
clipAt(80 72)
want("pattern clip, back to its length and out again in one drag: length" "${c_len}" 1152)
want("pattern clip, back to its length and out again in one drag: keeps looping" "${c_loop}" 1)

# ---- 2. audio clip ----
edgeDrag(aud_plain 70 ${two} "" "" "")
want("audio clip, plain right-edge drag: does not loop" "${c_loop}" 0)
if(c_len LESS 400 OR c_len GREATER 600)
  message(FATAL_ERROR "FAIL: audio clip, plain right-edge drag: stops at the end of its file (about 504 ticks), got ${c_len}\n${out}")
endif()
message(STATUS "ok - audio clip, plain right-edge drag stops at the end of its file (${c_len} ticks)")
edgeDrag(aud_ctrl 70 ${two} "6 mod ${loopKey} 1\n" "" "")
want("audio clip, Ctrl + right-edge drag: loops" "${c_loop}" 1)
want("audio clip, Ctrl + right-edge drag: length (its end on the beat)" "${c_len}" 960)
if(NOT c_audioEnd GREATER 0.5 OR c_audioEnd GREATER 1.5)
  message(FATAL_ERROR "FAIL: audio clip, Ctrl + drag: it loops the 200 ticks it showed (audioEnd about 0.97 s), got ${c_audioEnd}\n${out}")
endif()
message(STATUS "ok - audio clip, Ctrl + drag loops the part it showed (audioEnd ${c_audioEnd} s)")

# ---- 3. left edge ----
function(leftDrag tag id px pre)
  math(EXPR xs "${x0_${id}} + 3")
  math(EXPR xe "${xs} - ${px}")
  run(${tag} "4 typing off\n${pre}8 move ${xs} ${y_${id}}\n12 down 0\n16 move ${xe} ${y_${id}}\n22 move ${xe} ${y_${id}}\n30 up 0\n34 mod ${loopKey} 0\n38 dump\n42 quit discard\n")
  clipAt(38 ${id})
  set(c_start ${c_start} PARENT_SCOPE)
  set(c_len ${c_len} PARENT_SCOPE)
  set(c_offset ${c_offset} PARENT_SCOPE)
  set(c_loop ${c_loop} PARENT_SCOPE)
endfunction()
leftDrag(left_plain 73 ${barPx} "")
want("plain left-edge drag of a clip that does not loop: cannot grow" "${c_start}" 40)
leftDrag(left_ctrl 73 ${barPx} "6 mod ${loopKey} 1\n")
want("Ctrl + left-edge drag: grows to the song's start" "${c_start}" 0)
want("Ctrl + left-edge drag: loops" "${c_loop}" 1)
want("Ctrl + left-edge drag: the loop start wraps" "${c_offset}" 344)
want("Ctrl + left-edge drag: length" "${c_len}" 424)

# ---- 4. K-82: past the song's start, onto the beat ----
math(EXPR xm "(${x0_73} + ${x1_73}) / 2")
math(EXPR xb "${xm} - ${barPx}")
math(EXPR xh "${xm} - ${barPx} / 2")
run(wall "4 typing off\n8 move ${xm} ${y_73}\n12 down 0\n16 move ${xh} ${y_73}\n20 move ${xb} ${y_73}\n24 up 0\n30 dump\n34 quit discard\n")
clipAt(30 73)
want("K-82: a clip slightly off the beat dragged past the start lands on 0" "${c_start}" 0)
want("K-82: ... with its length" "${c_len}" 384)
message(STATUS "k114_clip_loop_app: all checks passed")
