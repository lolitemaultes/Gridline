# Gridline: the Clips and Smooth track menus' Duplicate without notes and Copy to a new pattern (hidden app
# runs, isolated config and home, fixed frame time). The fixture's Bass track (track 1) is made an
# instrument track of the Bass channel (id 25, the Bassline pattern's notes); the Drums track (track 0)
# stays a free track of pattern clips. In Clips and in Smooth, right-clicking a track's header:
#   * Duplicate without notes on Bass: one more track right after it, an instrument track of a new
#     channel of the same instrument, with no clips and no notes in any pattern; one undo step;
#   * Duplicate without notes on Drums (a free track): one more track, with no clips; one undo step;
#   * Copy to a new pattern on Bass: one more pattern holding just the Bass channel's notes, as many as
#     the Bassline pattern holds, which keeps them; one undo step.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k351_track_menu_app.cmake
cmake_minimum_required(VERSION 3.19)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
file(READ "${DEMO}" demo)
string(JSON demo SET "${demo}" tracks 1 mode "2")
string(JSON demo SET "${demo}" tracks 1 channel "25")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag layout script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  # (Clips opens the song in its arrangement, as it does a Set last saved there.)
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"clips.arrangementSets\": \"${OUT}/song_${tag}.gridline.json\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  configure_file("${OUT}/song.gridline.json" "${OUT}/song_${tag}.gridline.json" COPYONLY)
  file(WRITE "${cfg}/input.txt" "3 toasts clear\n${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song_${tag}.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --layout ${layout} --layout-dev --dev-input "${cfg}/input.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL: ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()
# The header point of the row named <name> ("plrow <i> "<name>" x y") -> hx, hy.
function(rowAt name)
  string(REGEX MATCH "plrow [0-9]+ \"${name}\" ([-0-9]+) ([-0-9]+)" m "${out}")
  if(NOT m)
    message(FATAL_ERROR "FAIL: no row \"${name}\" drawn\n${out}")
  endif()
  set(hx ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(hy ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()
# The centre of the menu row <name> from the "mixer" dump's rects -> rx, ry.
function(menuRow name)
  string(REGEX MATCH "  rect ${name} ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]*" m "${out}")
  if(NOT m)
    message(FATAL_ERROR "FAIL: the track menu drew no '${name}' row\n${out}")
  endif()
  math(EXPR x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
  set(rx ${x} PARENT_SCOPE)
  set(ry ${y} PARENT_SCOPE)
endfunction()
# A saved song: n_tracks (tracks with a name, a mode or clips), n_chans, n_pats, clips_<t> (clips on track t),
# mode_<t>, chan_<t>, type_<id> (a channel's instrument), notes_<pattern index> ("<channel>:<count> ...").
function(saved file)
  file(READ "${file}" j)
  string(JSON nt LENGTH "${j}" tracks)
  string(JSON nc LENGTH "${j}" channels)
  string(JSON np LENGTH "${j}" patterns)
  string(JSON nl LENGTH "${j}" playlist)
  set(n_chans ${nc} PARENT_SCOPE)
  set(n_pats ${np} PARENT_SCOPE)
  math(EXPR lt "${nt} - 1")
  set(used 0)
  foreach(i RANGE ${lt})
    string(JSON nm ERROR_VARIABLE e1 GET "${j}" tracks ${i} name)
    string(JSON md ERROR_VARIABLE e2 GET "${j}" tracks ${i} mode)
    string(JSON ch ERROR_VARIABLE e3 GET "${j}" tracks ${i} channel)
    if(e2)
      set(md 0)
    endif()
    if(e3)
      set(ch 0)
    endif()
    set(mode_${i} ${md} PARENT_SCOPE)
    set(chan_${i} ${ch} PARENT_SCOPE)
    set(clips_${i} 0 PARENT_SCOPE)
    set(c_${i} 0)
    if((NOT e1 AND NOT nm STREQUAL "") OR NOT md EQUAL 0)
      math(EXPR used "${i} + 1")
    endif()
  endforeach()
  math(EXPR ll "${nl} - 1")
  foreach(i RANGE ${ll})
    string(JSON t GET "${j}" playlist ${i} track)
    math(EXPR c_${t} "${c_${t}} + 1")
    set(clips_${t} ${c_${t}} PARENT_SCOPE)
    if(t GREATER_EQUAL used)
      math(EXPR used "${t} + 1")
    endif()
  endforeach()
  set(n_tracks ${used} PARENT_SCOPE)
  math(EXPR lc "${nc} - 1")
  foreach(i RANGE ${lc})
    string(JSON id GET "${j}" channels ${i} id)
    string(JSON ty GET "${j}" channels ${i} plugin type)
    set(type_${id} ${ty} PARENT_SCOPE)
  endforeach()
  math(EXPR lp "${np} - 1")
  foreach(i RANGE ${lp})
    set(desc "")
    string(JSON nn ERROR_VARIABLE e GET "${j}" patterns ${i} notes)
    if(NOT e)
      string(JSON m LENGTH "${j}" patterns ${i} notes)
      if(m GREATER 0)
        math(EXPR ml "${m} - 1")
        foreach(k RANGE ${ml})
          string(JSON key MEMBER "${j}" patterns ${i} notes ${k})
          string(JSON cnt LENGTH "${j}" patterns ${i} notes ${key})
          if(cnt GREATER 0)
            list(APPEND desc "${key}:${cnt}")
          endif()
        endforeach()
      endif()
    endif()
    set(notes_${i} "${desc}" PARENT_SCOPE)
  endforeach()
endfunction()

saved("${OUT}/song.gridline.json")
set(t0 ${n_tracks})
set(c0 ${n_chans})
set(p0 ${n_pats})
want("fixture: the Bassline pattern holds the Bass channel's notes" "${notes_2}" "25:16")
set(click "14 down 0\n15 up 0\n")
foreach(layout live logic)
  run(geo_${layout} ${layout} "10 plrows\n14 quit discard\n")
  rowAt("Bass")
  set(bx ${hx})
  set(by ${hy})
  rowAt("Drums")
  set(dx ${hx})
  set(dy ${hy})
  set(rcb "6 move ${bx} ${by}\n8 down 1\n9 up 1\n")
  set(rcd "6 move ${dx} ${dy}\n8 down 1\n9 up 1\n")
  run(menu_${layout} ${layout} "${rcb}12 mixer\n16 quit discard\n")
  menuRow("trmenu dupempty")
  set(de_x ${rx})
  set(de_y ${ry})
  menuRow("trmenu newpattern")
  set(np_x ${rx})
  set(np_y ${ry})

  # Duplicate without notes on the Bass (instrument) track.
  run(dup_${layout} ${layout}
      "${rcb}12 move ${de_x} ${de_y}\n${click}24 save \"${OUT}/dup1_${layout}.gridline.json\"\n26 undo\n30 save \"${OUT}/dup2_${layout}.gridline.json\"\n34 quit discard\n")
  saved("${OUT}/dup1_${layout}.gridline.json")
  math(EXPR t1 "${t0} + 1")
  math(EXPR cc1 "${c0} + 1")
  want("${layout}: Duplicate without notes adds a track" "${n_tracks}" "${t1}")
  want("${layout}: and a channel" "${n_chans}" "${cc1}")
  want("${layout}: the copy is an instrument track" "${mode_2}" "2")
  if(chan_2 STREQUAL "25" OR chan_2 STREQUAL "0")
    message(FATAL_ERROR "FAIL: ${layout}: the copy plays a channel of its own (got ${chan_2})")
  endif()
  want("${layout}: of the same instrument" "${type_${chan_2}}" "gl.synth")
  want("${layout}: the copy has no clips" "${clips_2}" "0")
  want("${layout}: the original keeps its clips" "${clips_1}" "6")
  want("${layout}: no pattern changed" "${notes_2}" "25:16")
  set(nc "${chan_2}")
  foreach(i RANGE 3)
    string(FIND "${notes_${i}}" "${nc}:" has)
    want("${layout}: the copy has no notes in pattern ${i}" "${has}" "-1")
  endforeach()
  saved("${OUT}/dup2_${layout}.gridline.json")
  want("${layout}: Duplicate without notes is one undo step (tracks)" "${n_tracks}" "${t0}")
  want("${layout}: Duplicate without notes is one undo step (channels)" "${n_chans}" "${c0}")

  # Duplicate without notes on the free Drums track (its menu opens at its own header).
  run(menud_${layout} ${layout} "${rcd}12 mixer\n16 quit discard\n")
  menuRow("trmenu dupempty")
  run(dupfree_${layout} ${layout}
      "${rcd}12 move ${rx} ${ry}\n${click}24 save \"${OUT}/df1_${layout}.gridline.json\"\n26 undo\n30 save \"${OUT}/df2_${layout}.gridline.json\"\n34 quit discard\n")
  saved("${OUT}/df1_${layout}.gridline.json")
  want("${layout}: Duplicate without notes on a free track adds a track" "${n_tracks}" "${t1}")
  want("${layout}: the free track's copy has no clips" "${clips_1}" "0")
  want("${layout}: the free track keeps its clips" "${clips_0}" "16")
  saved("${OUT}/df2_${layout}.gridline.json")
  want("${layout}: and is one undo step" "${n_tracks}" "${t0}")

  # Copy to a new pattern on the Bass track.
  run(newpat_${layout} ${layout}
      "${rcb}12 move ${np_x} ${np_y}\n${click}24 save \"${OUT}/np1_${layout}.gridline.json\"\n26 undo\n30 save \"${OUT}/np2_${layout}.gridline.json\"\n34 quit discard\n")
  saved("${OUT}/np1_${layout}.gridline.json")
  math(EXPR p1 "${p0} + 1")
  want("${layout}: Copy to a new pattern adds a pattern" "${n_pats}" "${p1}")
  want("${layout}: the new pattern (after Bassline) holds just the Bass notes" "${notes_3}" "25:16")
  want("${layout}: Bassline keeps its notes" "${notes_2}" "25:16")
  want("${layout}: no track or channel added" "${n_tracks} ${n_chans}" "${t0} ${c0}")
  saved("${OUT}/np2_${layout}.gridline.json")
  want("${layout}: Copy to a new pattern is one undo step" "${n_pats}" "${p0}")
endforeach()
message(STATUS "ok - Clips and Smooth")
