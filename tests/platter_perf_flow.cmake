# Gridline — J-159 / J-163: a Platter pass recorded as automation in the app, driven like a user
# through the dev input hooks (hidden, isolated config, SDL's dummy audio driver).
#   1. pattern mode: the setup is armed (new setups are), Record, Play; the decks are played from a controller (the
#      editor's GRIDLINE_PLATTER_DEVJOG hook sends DDJ-200 MIDI: play, crossfader, a hot cue,
#      an EQ kill, a jog scratch, pitch moves) and the mouse scratches deck A; Stop. The pass is
#      in the pattern as automation lanes only (J-163: no notes), sub-tick positions kept, one
#      undo step. Record a second pass: it goes into a new pattern "<setup> take 2", selected.
#      The piano roll opens on the second pass with deck A's mouse travel lane
#      (GRIDLINE_PLATTER_PASS_VIEW): <OUT>/pattern.ppm.
#   2. song mode (J-179): a pass goes into one new pattern "<setup> take 1" holding an
#      automation clip per control, placed as one pattern clip on the playlist where the pass
#      was played, as long as the pass, one undo step; the playlist draws the curves on that
#      clip: <OUT>/playlist.ppm; the same pass with the automation editor open on the pass
#      pattern's deck A wheel clip: <OUT>/automation.ppm.
# Trace lines: "platter: pass pattern ...", "platter: song pass pattern ..." (the tick's dev
# hook), "platter: rect ...".
#   cmake -DAPP=<gridline-app> -DTESTBIN=<gridline_test_platter> -DOUT=<dir> -P platter_perf_flow.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg")
file(MAKE_DIRECTORY "${OUT}/home")
execute_process(COMMAND "${TESTBIN}" writetrack "${OUT}/Deck A 120.wav" 120 RESULT_VARIABLE rc1)
execute_process(COMMAND "${TESTBIN}" writetrack "${OUT}/Deck B 100.wav" 100 RESULT_VARIABLE rc2)
if(NOT rc1 EQUAL 0 OR NOT rc2 EQUAL 0)
  message(FATAL_ERROR "FAIL: could not write the test tracks (${rc1} ${rc2})")
endif()
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/home")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
set(ENV{GRIDLINE_PLATTER_TRACE} "1")
set(ENV{GRIDLINE_PLATTER_DEMO} "${OUT}/Deck A 120.wav")
set(ENV{GRIDLINE_PLATTER_DEMO_B} "${OUT}/Deck B 100.wav")
set(ENV{GRIDLINE_PLATTER_PROFILE} "ddj200")
# One pass = the whole performance: the loop must never wrap in it (a wrap ends the pass).
# The script's waits are wall time and slow software-GL frames add to them (a loaded CI runner
# went past the 8 bars once used), so the pattern is as long as it can be: 64 bars.
set(ENV{GRIDLINE_PLATTER_BARS} "64")
set(ENV{SDL_AUDIODRIVER} "dummy")

# the controller's part (ms, status, data 1, data 2; hex bytes)
set(jog "100 90 0B 7F\n150 90 0B 00\n200 91 0B 7F\n250 91 0B 00\n400 B6 1F 20\n700 97 00 7F\n750 97 00 00\n1000 B0 0F 00\n")
string(APPEND jog "1200 90 36 7F\n")
foreach(k RANGE 0 39)
  math(EXPR ms "1220 + ${k} * 20")
  math(EXPR phase "(${k} / 8) % 2")
  if(phase EQUAL 0)
    string(APPEND jog "${ms} B0 22 46\n")
  else()
    string(APPEND jog "${ms} B0 22 3A\n")
  endif()
endforeach()
string(APPEND jog "2050 90 36 00\n2300 97 00 7F\n2350 97 00 00\n")
foreach(k RANGE 0 9)
  math(EXPR ms "2500 + ${k} * 60")
  math(EXPR v "64 + ${k} * 2")
  string(APPEND jog "${ms} B0 00 ${v}\n")
endforeach()
string(APPEND jog "3200 B0 0F 40\n3300 B6 1F 40\n")
file(WRITE "${OUT}/jog.txt" "${jog}")
set(ENV{GRIDLINE_PLATTER_DEVJOG} "${OUT}/jog.txt")

function(run tag frames script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --plugin gl.platter --size 1700x1150 --frames ${frames}
                          --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${last_out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

macro(locate out name)
  string(REGEX MATCHALL "platter: rect ${name} [0-9-]+ [0-9-]+ [0-9-]+ [0-9-]+" all_ "${out}")
  set(last_ "")
  if(all_)
    list(GET all_ -1 last_)
  endif()
  string(REGEX MATCH "platter: rect ${name} ([0-9-]+) ([0-9-]+) ([0-9-]+) ([0-9-]+)" _ "${last_}")
  check("the ${name} control is shown" CMAKE_MATCH_1 MATCHES "[0-9]")
  set(${name}_x0 "${CMAKE_MATCH_1}")
  set(${name}_y0 "${CMAKE_MATCH_2}")
  set(${name}_x1 "${CMAKE_MATCH_3}")
  set(${name}_y1 "${CMAKE_MATCH_4}")
  math(EXPR ${name}_x "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}) / 2")
  math(EXPR ${name}_y "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2")
endmacro()

# ---- where the controls are
set(ENV{GRIDLINE_PLATTER_DEVJOG} "")
run(layout 20 "2 waitfor platter-ready 300\n")
set(last_out "${layout_out}")
locate("${layout_out}" arm)
locate("${layout_out}" recas)
locate("${layout_out}" platterA)
set(ENV{GRIDLINE_PLATTER_DEVJOG} "${OUT}/jog.txt")

# A pass from frame `f`: Play, wait for the capture, a mouse scratch on deck A, let the
# controller part play out, Stop, wait for the pass to be stored. Sets `pass` and `f`.
macro(pass_script)
  math(EXPR cy "${platterA_y}")
  math(EXPR r "(${platterA_x1} - ${platterA_x0}) * 3 / 10")
  set(pass "${f} forget platter-pass\n${f} forget platter-capturing\n${f} forget platter-past-song-end\n")
  if(decks_on)  # the decks play on after Stop: the first Play click stops them (J-112), the next one plays
    string(APPEND pass "${f} sdlat play\n")
    math(EXPR f "${f} + 2")
    string(APPEND pass "${f} sdldown 0\n")
    math(EXPR f "${f} + 1")
    string(APPEND pass "${f} sdlup 0\n")
    math(EXPR f "${f} + 2")
    string(APPEND pass "${f} waitfor tick 0.3\n")
    math(EXPR f "${f} + 2")
  endif()
  set(decks_on 1)
  string(APPEND pass "${f} sdlat play\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} sdldown 0\n")
  math(EXPR f "${f} + 1")
  string(APPEND pass "${f} sdlup 0\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} transport\n${f} waitfor platter-capturing 20\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} waitfor tick 0.6\n")
  math(EXPR f "${f} + 1")
  math(EXPR mx "${platterA_x} + ${r}")
  string(APPEND pass "${f} move ${mx} ${cy}\n")
  math(EXPR f "${f} + 1")
  string(APPEND pass "${f} down 0\n")
  # back and forth along the platter's edge (vertical drags at its right side), then a flick
  foreach(k RANGE 0 47)
    math(EXPR f "${f} + 1")
    math(EXPR seg "(${k} / 12) % 2")
    math(EXPR kk "${k} % 12")
    if(seg EQUAL 0)
      math(EXPR my "${cy} - ${kk} * 6")
    else()
      math(EXPR my "${cy} - 66 + ${kk} * 6")
    endif()
    string(APPEND pass "${f} move ${mx} ${my}\n")
    math(EXPR f "${f} + 1")
    string(APPEND pass "${f} waitfor tick 0.02\n")
  endforeach()
  math(EXPR f "${f} + 1")
  string(APPEND pass "${f} up 0\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} waitfor tick 3.2\n")
  math(EXPR f "${f} + 2")
  if(past_end)  # (J-175) song mode: the pass goes on until the position is past the song end
    string(APPEND pass "${f} waitfor platter-past-song-end 60\n")
    math(EXPR f "${f} + 2")
  endif()
  string(APPEND pass "${f} sdlat stop\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} sdldown 0\n")
  math(EXPR f "${f} + 1")
  string(APPEND pass "${f} sdlup 0\n")
  math(EXPR f "${f} + 2")
  string(APPEND pass "${f} waitfor platter-pass 20\n")
  math(EXPR f "${f} + 4")
endmacro()

# ---- 1. pattern mode: arm, Record, two passes
set(past_end 0)
set(decks_on 0)
set(f 3)
set(script "2 waitfor platter-ready 300\n")  # (a new setup is armed)
math(EXPR f "${f} + 3")
string(APPEND script "${f} sdlat rec\n")
math(EXPR f "${f} + 2")
string(APPEND script "${f} sdldown 0\n")
math(EXPR f "${f} + 1")
string(APPEND script "${f} sdlup 0\n")
math(EXPR f "${f} + 2")
string(APPEND script "${f} recording\n${f} move 5 5\n")
math(EXPR f "${f} + 2")
pass_script()
string(APPEND script "${pass}")
set(ENV{GRIDLINE_PLATTER_PASS_VIEW} "rack")  # J-173: the pass pattern's automation clips as rack rows
pass_script()
string(APPEND script "${pass}${f} plugwin close\n")
math(EXPR frames "${f} + 30")
run(pattern ${frames} "${script}")
set(last_out "${pattern_out}")
check("Gridline records, the setup is armed, recording as automation" pattern_out MATCHES "recording frame [0-9]+: armed 1" AND pattern_out MATCHES "armed 1 as 0")
check("the setup captures while Gridline records and plays" pattern_out MATCHES "capturing 1")
string(REGEX MATCHALL "platter: pass pattern [^\n]*" passes "${pattern_out}")
list(LENGTH passes npass)
check("two passes recorded" npass EQUAL 2)
list(GET passes 0 p1)
list(GET passes 1 p2)
message(STATUS "${p1}")
message(STATUS "${p2}")
check("the first pass is in the selected (empty) pattern: lanes, no notes, sub-tick positions"
      p1 MATCHES "pattern \"Pattern 1\" notes 0 lanes ([3-9]|[1-9][0-9]+) fractions [1-9][0-9]* passes 1 patterns 1 selected 1")
check("the second pass goes into a new pattern, selected"
      p2 MATCHES "pattern \"[^\"]+ take 2\" notes 0 lanes ([3-9]|[1-9][0-9]+) fractions [1-9][0-9]* passes 2 patterns 2 selected 1")
check("the first pass is one undo step" p1 MATCHES "\\| Record a deck performance\\]$")
string(REGEX MATCHALL "Record a deck performance" steps2 "${p2}")
list(LENGTH steps2 nsteps2)
check("the second pass is one undo step too (the new pattern included)" p2 MATCHES "\\| Record a deck performance\\]$")
check("... and the first pass's step is still the only other one" nsteps2 EQUAL 2)
# J-173: a pattern pass is named automation clips in the pattern, as a song pass's playlist clips are
string(REGEX MATCHALL "platter: pattern pass clips \\[[^\n]*" pclips "${pattern_out}")
list(LENGTH pclips npclips)
check("each pattern pass lists its clips" npclips EQUAL 2)
list(GET pclips 1 pc2)
message(STATUS "${pc2}")
check("... named after the setup and the control" pc2 MATCHES "A position" AND pc2 MATCHES "A play")

# ---- 2. song mode (J-179): the pass goes into ONE new pattern holding its automation clips,
# placed as one pattern clip on the playlist where the pass was played
# J-175: the playlist is empty (the song is one bar long) and nothing is selected: the pass
# records on past the song end, one pass however slow the runner is (the script holds Stop
# until the position is past the song end; a song that wrapped under the pass split it there).
set(past_end 1)
set(decks_on 0)
set(f 3)
set(script "2 waitfor platter-ready 300\n")  # (a new setup is armed)
math(EXPR f "${f} + 2")
string(APPEND script "${f} move 5 5\n")
math(EXPR f "${f} + 1")
string(APPEND script "${f} key l\n")
math(EXPR f "${f} + 2")
string(APPEND script "${f} sdlat rec\n")
math(EXPR f "${f} + 2")
string(APPEND script "${f} sdldown 0\n")
math(EXPR f "${f} + 1")
string(APPEND script "${f} sdlup 0\n")
math(EXPR f "${f} + 2")
string(APPEND script "${f} move 5 5\n${f} transport\n")
math(EXPR f "${f} + 2")
pass_script()
string(APPEND script "${pass}${f} plugwin close\n")
math(EXPR f "${f} + 6")
string(APPEND script "${f} dump\n${f} plgeom\n${f} autoedit\n")
math(EXPR frames "${f} + 30")
set(ENV{GRIDLINE_PLATTER_PASS_VIEW} "playlist")
run(playlist ${frames} "${script}")
set(last_out "${playlist_out}")
check("song mode" playlist_out MATCHES "transport frame [0-9]+: pos [0-9]+ playing 0 seek [0-9]+ mode 1")
string(REGEX MATCHALL "platter: song pass pattern [^\n]*" song_passes "${playlist_out}")
list(LENGTH song_passes n_song_passes)
check("the song mode pass reaches past the song end" playlist_out MATCHES "waitfor platter-past-song-end: reached")
check("... one pass: the song does not wrap under it (J-175)" n_song_passes EQUAL 1)
string(REGEX MATCH "platter: song pass pattern [^\n]*" pc "${playlist_out}")
message(STATUS "${pc}")
# (CMake keeps nine groups: two matches)
string(REGEX MATCH "pattern \"([^\"]+)\" placed ([0-9]+) track ([0-9-]+) start ([0-9-]+) len ([0-9-]+) lanes ([0-9]+) points ([0-9]+) exact ([0-9]+) automations ([0-9]+)" _ "${pc}")
set(pass_name "${CMAKE_MATCH_1}")
set(n_placed "${CMAKE_MATCH_2}")
set(clip_track "${CMAKE_MATCH_3}")
set(clip_start "${CMAKE_MATCH_4}")
set(clip_len "${CMAKE_MATCH_5}")
set(n_lanes "${CMAKE_MATCH_6}")
set(n_exact "${CMAKE_MATCH_8}")
set(n_autos "${CMAKE_MATCH_9}")
string(REGEX MATCH "patterns-with-pass ([0-9]+) ticks ([0-9-]+) ([0-9-]+) song-end ([0-9-]+)" _ "${pc}")
set(n_patterns "${CMAKE_MATCH_1}")
set(pass_from "${CMAKE_MATCH_2}")
set(pass_to "${CMAKE_MATCH_3}")
set(song_end "${CMAKE_MATCH_4}")
check("... and the pass runs from inside the song past its end" song_end GREATER 0 AND pass_from LESS song_end AND pass_to GREATER song_end)
check("the song mode pass is one new pattern named after the setup" pass_name MATCHES " take 1$" AND n_patterns EQUAL 1)
check("... holding its automation clips (wheel, position, play at least), exact values kept" n_lanes GREATER_EQUAL 3 AND n_exact GREATER 0)
check("... and no playlist automation clips" n_autos EQUAL 0)
math(EXPR pass_len "${pass_to} - ${pass_from}")
math(EXPR len_diff "${clip_len} - ${pass_len}")
check("... placed once on the playlist, where the pass was played, as long as the pass"
      n_placed EQUAL 1 AND clip_start EQUAL pass_from AND len_diff GREATER_EQUAL -1 AND len_diff LESS_EQUAL 1 AND clip_track GREATER_EQUAL 0)
check("... as a pattern clip (the dump: kind 0, that start and length)"
      playlist_out MATCHES "clip [0-9]+ kind 0 track ${clip_track} start ${clip_start} len ${clip_len} ")
string(REGEX MATCH "platter: pass pattern \"[^\"]+ take 1\"[^\n]*" pp "${playlist_out}")
message(STATUS "${pp}")
string(REGEX MATCHALL "Record a deck performance" steps "${pp}")
list(LENGTH steps nsteps)
check("the pass (its new pattern, clips and placed clip) is one undo step" nsteps EQUAL 1)
check("... the newest one" pp MATCHES "\\| Record a deck performance\\]$")
string(REGEX MATCH "platter: pattern pass clips \\[[^\n]*" pclips "${playlist_out}")
message(STATUS "${pclips}")
check("the pass pattern's clips are named after the setup and the control" pclips MATCHES "A wheel" AND pclips MATCHES "A position" AND pclips MATCHES "A play")
# the curves on the pass pattern's playlist clip (J-173 dev geometry): deck A's wheel among them
string(REGEX MATCH "clip ([0-9]+) kind 0 track ${clip_track} start ${clip_start} " _ "${playlist_out}")
set(pass_clip "${CMAKE_MATCH_1}")
string(REGEX MATCHALL "pcurve ${pass_clip} [0-9]+ [0-9]+ x" curves "${playlist_out}")
list(LENGTH curves n_curves)
message(STATUS "curves drawn on the pass clip ${pass_clip}: ${n_curves}")
check("the playlist draws the pass's curves on its pattern clip, deck A's wheel among them"
      n_curves GREATER_EQUAL 3 AND playlist_out MATCHES "pcurve ${pass_clip} [0-9]+ 152 x")
set(ENV{GRIDLINE_PLATTER_PASS_VIEW} "automation:52")  # deck A's wheel (PWheelA)
run(automation ${frames} "${script}")
set(last_out "${automation_out}")
string(REGEX MATCHALL "platter: song pass pattern [^\n]*" song_passes "${automation_out}")
list(LENGTH song_passes n_song_passes)
check("the automation view's pass is recorded too, as one pass" n_song_passes EQUAL 1)
# J-169: the pass's dev hook ran after the pass was written (a new channel list: it once read
# the setup through a stale reference and crashed on Linux) and opened deck A's wheel clip
check("the automation editor opens on deck A's wheel clip of the pass pattern"
      automation_out MATCHES "platter: pass view automation \"[^\"]* A wheel\" points [1-9][0-9]* channel \"[^\"?]+\" pattern \"[^\"]+ take 1\"")
check("... the editor shows the pattern's clip (the wheel's target)"
      automation_out MATCHES "autoedit frame [0-9]+: open 1 automation 0 pattern [1-9][0-9]* target [0-9]+ 152")
foreach(s pattern playlist automation)
  check("screenshot ${s}.ppm written" EXISTS "${OUT}/${s}.ppm")
endforeach()
