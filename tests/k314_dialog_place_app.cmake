# Gridline - K-314 (C-01, C-03): dialogs open where they should in every layout, on a small screen.
#   At 1024x640, in each layout (Studio, Clips, Smooth, Tracker):
#     - About, Project info and Undo history, where they float, open centred in the window (they
#       opened at the top-left corner in Clips and Smooth);
#     - the Collaboration panel, docked in a side panel narrower than its form, stacks each label
#       over its field (the form wrapped a letter or two a line in the Tracker's side panel); in the
#       Tracker (K-106) it is a page of the header band instead.
#   cmake -DAPP=<gridline-app> -DDEMO=<song> -DOUT=<dir> -P k314_dialog_place_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(W 1024)
set(H 640)

foreach(L studio live logic tracker)
  foreach(D "About Gridline" "Project info" "Undo history" "Collaboration")
    string(REPLACE " " "_" tag "${L}_${D}")
    set(cfg "${OUT}/cfg_${tag}")
    file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
    file(WRITE "${cfg}/gridline/settings.json"
         "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true}}\n")
    file(WRITE "${cfg}/input.txt" "5 toasts clear\n10 layout open ${D}\n40 layout where ${D}\n41 collab panel\n44 quit discard\n")
    set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
    set(ENV{HOME} "${cfg}/home")
    configure_file("${DEMO}" "${cfg}/song.gridline.json" COPYONLY)
    execute_process(COMMAND "${APP}" "${cfg}/song.gridline.json" --hidden --layout-dev --no-ui-sounds --fixed-dt 16 --layout ${L} --size ${W}x${H}
                            --dev-input "${cfg}/input.txt"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${OUT}/${tag}.log" "${out}\n---- stderr ----\n${err}")
    if(NOT rc EQUAL 0)
      message(SEND_ERROR "FAIL: ${L} ${D}: gridline-app failed (${rc})")
      continue()
    endif()
    # K-106: in the Tracker the Collaboration panel is a page of the header band (no window of its own).
    if(L STREQUAL "tracker" AND D STREQUAL "Collaboration")
      if(NOT out MATCHES "panel open 1 tracker-page 1")
        message(SEND_ERROR "FAIL: tracker: the Collaboration page is not shown in the header band")
      else()
        message(STATUS "tracker Collaboration: the header band's page")
      endif()
      continue()
    endif()
    string(REGEX MATCH "where ${D} layout [a-z]+ drawn ([01]) docked ([01]) region [^ ]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)" m "${out}")
    if(NOT m)
      message(SEND_ERROR "FAIL: ${L} ${D}: no window report")
      continue()
    endif()
    set(drawn ${CMAKE_MATCH_1})
    set(docked ${CMAKE_MATCH_2})
    set(x ${CMAKE_MATCH_3})
    set(y ${CMAKE_MATCH_4})
    set(w ${CMAKE_MATCH_5})
    set(h ${CMAKE_MATCH_6})
    if(NOT drawn EQUAL 1)
      message(SEND_ERROR "FAIL: ${L} ${D}: not drawn")
      continue()
    endif()
    message(STATUS "${L} ${D}: docked ${docked} rect ${x} ${y} ${w} ${h}")
    if(D STREQUAL "Collaboration")
      string(REGEX MATCH "panel open 1 width ([0-9]+) stacked ([01])" m "${out}")
      if(NOT m)
        message(SEND_ERROR "FAIL: ${L}: no Collaboration panel report")
        continue()
      endif()
      set(pw ${CMAKE_MATCH_1})
      set(stacked ${CMAKE_MATCH_2})
      if(pw LESS 400 AND NOT stacked EQUAL 1)
        message(SEND_ERROR "FAIL: ${L}: the Collaboration panel is ${pw} px wide but its form is not stacked")
      elseif(pw GREATER_EQUAL 400 AND stacked EQUAL 1)
        message(SEND_ERROR "FAIL: ${L}: the Collaboration panel is ${pw} px wide and stacked")
      endif()
      if(L STREQUAL "studio" AND stacked EQUAL 1)
        message(SEND_ERROR "FAIL: studio: the floating Collaboration panel is stacked")
      endif()
      continue()
    endif()
    if(docked EQUAL 1)
      continue()  # docked in its layout's region (Undo history in Studio, Clips and the Tracker)
    endif()
    # Centred on the window's width (the dialog anchor), and not in the top-left corner.
    math(EXPR cx "${x} + ${w} / 2")
    math(EXPR dx "${cx} - ${W} / 2")
    if(dx LESS -24 OR dx GREATER 24)
      message(SEND_ERROR "FAIL: ${L} ${D}: opened at x ${x} (centre ${cx}), not centred on ${W}")
    endif()
    math(EXPR cy "${y} + ${h} / 2")
    math(EXPR dy "${cy} - ${H} / 2")
    if(dy LESS -80 OR dy GREATER 80)
      message(SEND_ERROR "FAIL: ${L} ${D}: opened at y ${y} (centre ${cy}), not centred on ${H}")
    endif()
  endforeach()
endforeach()
