# ---- 4. left edge of a clip cut at both ends ----
function(ctrlLeft tag id px back)
  math(EXPR xs "${x0_${id}} + 3")
  math(EXPR xe "${x0_${id}} - ${px}")
  set(backLine "")
  if(NOT "${back}" STREQUAL "")
    math(EXPR xb "${x0_${id}} + ${back}")
    set(backLine "26 move ${xb} ${y_${id}}\n")
  endif()
  run(${tag} "4 typing off\n5 dump\n6 mod ${loopKey} 1\n8 move ${xs} ${y_${id}}\n12 down 0\n16 move ${xe} ${y_${id}}\n20 move ${xe} ${y_${id}}\n${backLine}30 up 0\n34 mod ${loopKey} 0\n38 dump\n42 quit discard\n")
  clipAt(5 ${id})
  foreach(v start len offset)
    set(b_${v} ${c_${v}} PARENT_SCOPE)
  endforeach()
  clipAt(38 ${id})
  foreach(v start len offset loop ls ll)
    set(c_${v} ${c_${v}} PARENT_SCOPE)
  endforeach()
  set(out "${out}" PARENT_SCOPE)
endfunction()
math(EXPR beatPx "${barPx} / 4")
ctrlLeft(left_out 81 ${beatPx} "")
want("cut clip, Ctrl + left edge out a beat: start" "${c_start}" 288)
want("cut clip, Ctrl + left edge out a beat: loops its part" "${c_loop} ${c_ls} ${c_ll}" "1 96 192")
want("cut clip, Ctrl + left edge out a beat: the loop start wraps inside it" "${c_offset}" 192)
want("cut clip, Ctrl + left edge out a beat: length" "${c_len}" 288)
ctrlLeft(left_back 81 ${beatPx} -2)
want("cut clip, Ctrl + left edge out and back: the clip it was" "${c_start} ${c_len} ${c_offset} ${c_loop} ${c_ll}" "${b_start} ${b_len} ${b_offset} 0 0")

