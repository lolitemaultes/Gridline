# Gridline K-140: the loop key (Ctrl, Cmd on macOS) on a cut clip's edge, in the real app (hidden, isolated
# config and HOME, fixed frame time), scripted input on a copy of the test song:
#   1. Ctrl + right edge of a pattern clip cut short loops the part it showed (its own loop), one undo step;
#   2. dragged back to the cut point in the same drag, it is the clip it was (no loop, no own loop, same
#      length and offset); inside the cut point it is a plain, shorter clip;
#   3. the same for an audio clip and an automation clip cut short, and for two selected clips at once;
#   4. Ctrl + left edge of a clip cut at both ends loops its part and wraps the loop start; back to the cut
#      point it is the clip it was;
#   5. the loop badge by the pointer shows only where a loop-key drag of that edge loops (Ctrl held over a
#      clip's edge; not over the body, not without the key, not on the left edge of a clip at the song's
#      start), during a drag only while it loops, and goes the frame the key is released.
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P k140_cut_loop_app.cmake
cmake_minimum_required(VERSION 3.16)
if(CMAKE_HOST_APPLE)
  set(loopKey super)
else()
  set(loopKey ctrl)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
# Swing automation: a ramp over one bar.
set(autos "\"automations\": [{\"id\": 90, \"name\": \"Swing ramp\", \"color\": 3381759, \"owner\": 1, \"index\": 1, \"points\": [[0, 0.0, 0, 0], [384, 1.0, 0, 0]]}], ")
set(clips "{\"id\": 70, \"kind\": \"audio\", \"source\": 60, \"track\": 7, \"start\": 384, \"length\": 200, \"pattern\": 0, \"gain\": 1.0}, ")
string(APPEND clips "{\"id\": 80, \"track\": 8, \"start\": 0, \"length\": 192, \"pattern\": 28}, ")
string(APPEND clips "{\"id\": 81, \"track\": 9, \"start\": 384, \"length\": 192, \"offset\": 96, \"pattern\": 28}, ")
string(APPEND clips "{\"id\": 82, \"kind\": \"automation\", \"source\": 90, \"track\": 10, \"start\": 0, \"length\": 192, \"pattern\": 0}, ")
string(APPEND clips "{\"id\": 83, \"track\": 11, \"start\": 0, \"length\": 384, \"pattern\": 28}, ")
string(REPLACE "\"channels\": [" "${autos}\"channels\": [${chan}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clips}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 100" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(run tag script)
  file(REMOVE_RECURSE "${OUT}/cfg_${tag}")
  file(MAKE_DIRECTORY "${OUT}/cfg_${tag}")
  set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg_${tag}")
  set(ENV{HOME} "${OUT}/cfg_${tag}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --show playlist
                          --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()
function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    message(FATAL_ERROR "FAIL: ${what}: want ${expect}, got ${got}\n${out}")
  endif()
  message(STATUS "ok - ${what}")
endfunction()

run(plgeo "4 typing off\n8 plgeom\n12 quit discard\n")
foreach(id 70 80 81 82 83)
  if(NOT out MATCHES "  clip ${id} x ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* ([-0-9]+)")
    message(FATAL_ERROR "FAIL: no geometry for clip ${id}\n${out}")
  endif()
  set(x0_${id} ${CMAKE_MATCH_1})
  set(x1_${id} ${CMAKE_MATCH_2})
  math(EXPR y_${id} "(${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}) / 2 + 4")
endforeach()
math(EXPR barPx "(${x1_83} - ${x0_83})")  # clip 83 is one bar (384 ticks)
math(EXPR two "2 * ${barPx}")

# clip <id> in the dump of <frame> -> c_start c_len c_offset c_loop c_audioEnd c_ls c_ll c_sel; undo_<frame>.
function(clipAt frame id)
  string(REGEX MATCH "dump frame ${frame}: [0-9]+ clips, [0-9]+ selected, undo ([0-9]+)\n(  clip [^\n]*\n)*" d "${out}")
  set(undo_${frame} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "  clip ${id} kind [^\n]*" line "${d}")
  if(NOT line MATCHES " start ([0-9]+) len ([0-9]+) offset ([0-9]+)")
    message(FATAL_ERROR "FAIL: no clip ${id} in dump ${frame}\n${out}")
  endif()
  set(c_start ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(c_len ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(c_offset ${CMAKE_MATCH_3} PARENT_SCOPE)
  if(NOT line MATCHES " sel ([01]) source [0-9]+ audioEnd ([0-9.]+) .* loop ([01]) loopStart ([0-9]+) loopLength ([0-9]+)")
    message(FATAL_ERROR "FAIL: no loop fields for clip ${id} in dump ${frame}\n${out}")
  endif()
  set(c_sel ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(c_audioEnd ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(c_loop ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(c_ls ${CMAKE_MATCH_4} PARENT_SCOPE)
  set(c_ll ${CMAKE_MATCH_5} PARENT_SCOPE)
endfunction()
# The loop badge in the plgeom block of <frame> -> badge.
function(badgeAt frame)
  string(FIND "${out}" "plgeom frame ${frame}:" pos)
  if(pos LESS 0)
    message(FATAL_ERROR "FAIL: no plgeom at frame ${frame}\n${out}")
  endif()
  string(SUBSTRING "${out}" ${pos} -1 rest)
  if(NOT rest MATCHES "  loopbadge ([01])")
    message(FATAL_ERROR "FAIL: no loopbadge line at frame ${frame}\n${out}")
  endif()
  set(badge ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()

# Right-edge Ctrl drag of <id>: out by <px> pixels, then (if <back> is set) back to <back> pixels from
# the old edge before the release. Badge probes: plgeom at frame 20 (out) and 30 (back).
function(ctrlEdge tag id px back)
  math(EXPR xs "${x1_${id}} - 3")
  math(EXPR xh "${xs} + ${px} / 2")
  math(EXPR xe "${x1_${id}} + ${px} + 2")  # the pointer's tick snaps down to the grid: just past the target
  set(backLine "")
  if(NOT "${back}" STREQUAL "")
    math(EXPR xb "${x1_${id}} + ${back}")
    set(backLine "26 move ${xb} ${y_${id}}\n")
  endif()
  run(${tag} "4 typing off\n5 dump\n6 mod ${loopKey} 1\n8 move ${xs} ${y_${id}}\n10 plgeom\n12 down 0\n16 move ${xh} ${y_${id}}\n18 move ${xe} ${y_${id}}\n20 plgeom\n${backLine}30 plgeom\n34 up 0\n36 mod ${loopKey} 0\n40 dump\n44 quit discard\n")
  clipAt(5 ${id})
  set(u0 ${undo_5})
  foreach(v start len offset loop ls ll audioEnd)
    set(b_${v} ${c_${v}} PARENT_SCOPE)
  endforeach()
  clipAt(40 ${id})
  foreach(v start len offset loop ls ll audioEnd)
    set(c_${v} ${c_${v}} PARENT_SCOPE)
  endforeach()
  math(EXPR steps "${undo_40} - ${u0}")
  set(steps ${steps} PARENT_SCOPE)
  badgeAt(10)
  set(badgeHover ${badge} PARENT_SCOPE)
  badgeAt(20)
  set(badgeOut ${badge} PARENT_SCOPE)
  badgeAt(30)
  set(badgeEnd ${badge} PARENT_SCOPE)
  set(out "${out}" PARENT_SCOPE)
endfunction()

# ---- 1. a pattern clip cut short: loops the part it showed ----
ctrlEdge(pat_out 80 ${two} "")
want("cut pattern clip, Ctrl + right edge: length" "${c_len}" 960)
want("cut pattern clip, Ctrl + right edge: loops" "${c_loop}" 1)
want("cut pattern clip, Ctrl + right edge: loops from its cut point (own loop start)" "${c_ls}" 0)
want("cut pattern clip, Ctrl + right edge: loops the 192 ticks it showed" "${c_ll}" 192)
want("cut pattern clip, Ctrl + right edge: one undo step" "${steps}" 1)
want("badge: Ctrl over the right edge of a cut clip" "${badgeHover}" 1)
want("badge: during the Ctrl drag, while it loops" "${badgeOut}" 1)

# ---- 2. back to the cut point in the same drag: the clip it was ----
ctrlEdge(pat_back 80 ${two} 3)
want("cut pattern clip, out and back to the cut point: length" "${c_len}" "${b_len}")
want("cut pattern clip, out and back to the cut point: no loop" "${c_loop}" 0)
want("cut pattern clip, out and back to the cut point: no own loop" "${c_ll}" 0)
want("cut pattern clip, out and back to the cut point: offset" "${c_offset}" "${b_offset}")
want("cut pattern clip, out and back to the cut point: start" "${c_start}" "${b_start}")
want("badge: gone once the drag is back at the cut point" "${badgeEnd}" 0)
if(steps GREATER 1)
  message(FATAL_ERROR "FAIL: out and back is at most one undo step, got ${steps}\n${out}")
endif()
message(STATUS "ok - out and back: ${steps} undo step(s)")
math(EXPR inside "0 - ${barPx} / 4 - 2")
ctrlEdge(pat_inside 80 ${two} ${inside})
want("cut pattern clip, out and back inside the cut point: plain" "${c_loop}" 0)
want("cut pattern clip, out and back inside the cut point: no own loop" "${c_ll}" 0)
want("cut pattern clip, out and back inside the cut point: shorter" "${c_len}" 96)

# ---- 3. audio and automation clips cut short; two selected clips ----
ctrlEdge(aud_out 70 ${two} "")
want("cut audio clip, Ctrl + right edge: loops" "${c_loop}" 1)
want("cut audio clip, Ctrl + right edge: length" "${c_len}" 960)
if(NOT c_audioEnd GREATER 0.5 OR c_audioEnd GREATER 1.5)
  message(FATAL_ERROR "FAIL: cut audio clip: it loops the 200 ticks it showed (audioEnd about 0.97 s), got ${c_audioEnd}\n${out}")
endif()
message(STATUS "ok - cut audio clip loops the part it showed (audioEnd ${c_audioEnd} s)")
ctrlEdge(aud_back 70 ${two} 3)
want("cut audio clip, out and back: length" "${c_len}" "${b_len}")
want("cut audio clip, out and back: no loop" "${c_loop}" 0)
want("cut audio clip, out and back: its audio end as before" "${c_audioEnd}" "${b_audioEnd}")
ctrlEdge(auto_out 82 ${two} "")
want("cut automation clip, Ctrl + right edge: loops" "${c_loop}" 1)
want("cut automation clip, Ctrl + right edge: loops the 192 ticks it showed" "${c_ll}" 192)
ctrlEdge(auto_back 82 ${two} 3)
want("cut automation clip, out and back: no loop" "${c_loop}" 0)
want("cut automation clip, out and back: no own loop" "${c_ll}" 0)
want("cut automation clip, out and back: length" "${c_len}" "${b_len}")

# Two cut clips selected (a Ctrl rubber band over both), one Ctrl edge drag: both loop their own part.
math(EXPR bx0 "${x1_81} + 30")
math(EXPR by0 "${y_81}")
math(EXPR bx1 "${x1_80} - 20")
math(EXPR by1 "${y_80}")
math(EXPR xs "${x1_80} - 3")
math(EXPR xh "${xs} + ${barPx}")
math(EXPR xe "${x1_80} + ${two} + 2")
run(multi "4 typing off\n5 dump\n6 mod ${loopKey} 1\n8 move ${bx0} ${by0}\n10 down 0\n14 move ${bx1} ${by1}\n18 up 0\n20 dump\n24 move ${xs} ${y_80}\n28 down 0\n32 move ${xh} ${y_80}\n36 move ${xe} ${y_80}\n40 up 0\n42 mod ${loopKey} 0\n46 dump\n50 quit discard\n")
clipAt(20 80)
want("multi: clip 80 selected" "${c_sel}" 1)
clipAt(20 81)
want("multi: clip 81 selected" "${c_sel}" 1)
set(u1 ${undo_20})
clipAt(46 80)
want("multi: clip 80 loops its own part" "${c_loop} ${c_ls} ${c_ll}" "1 0 192")
clipAt(46 81)
want("multi: clip 81 loops its own part" "${c_loop} ${c_ls} ${c_ll}" "1 96 192")
