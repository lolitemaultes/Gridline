badgeAt(16)
want("badge: the loop key pressed over the edge: shown" "${badge}" 1)
badgeAt(22)
want("badge: over the clip's body: none" "${badge}" 0)
badgeAt(28)
want("badge: left edge of a clip at the song's start (cannot loop out): none" "${badge}" 0)
badgeAt(34)
want("badge: right edge of an uncut clip: shown" "${badge}" 1)
badgeAt(37)
want("badge: the loop key released: gone the next frame" "${badge}" 0)
