# Gridline - hunt-clips2-1119: a new Clips set used as a person uses it, in the real app (hidden, isolated
# config and HOME, the layout chosen through the real settings keys, no --layout), by pointer and key input:
#   1. a slot clicked, a sound file dropped into another slot: the dropped-in slot is the selected one (the
#      selection stayed on the slot clicked before);
#   2. a fresh set: Main is not chosen (its row was ringed before anything was clicked);
#   3. a time selection dragged on track 1, Cmd+Shift+M: the clip is made and the time selection is cleared
#      (it stayed drawn over the clip);
#   4. a scene renamed "Verse 140 BPM 3/4" by typing and launched while playing, a scene inserted under the
#      second slot: the clip pushed down shows in the next row (the grid re-cut the live area by the 3/4
#      bar and showed it two rows down);
#   5. at 960 x 600 (the least layout size, as 2x on a 1920 x 1200 screen) the browser shows its list beside
#      the places (one pane put the places over the list, which was out of sight).
#   cmake -DAPP=<gridline-app> -DOUT=<dir> -DSRC=<source dir> -P hunt1119b_clips_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
configure_file("${SRC}/assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
set(WAV "${OUT}/Take.wav")

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900 --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(ok what)
  message(STATUS "ok - ${what}")
endfunction()

# The dump printed at a frame (up to the next dump).
function(dumpAt frame)
  string(FIND "${out}" "dump frame ${frame}:" at)
  if(at LESS 0)
    fail("no dump at frame ${frame}")
  endif()
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(FIND "${rest}" "\ndump frame" next)
  if(next GREATER 0)
    string(SUBSTRING "${rest}" 0 ${next} rest)
  endif()
  set(d "${rest}" PARENT_SCOPE)
endfunction()

# ---- the script builder: S (the script), F (the next frame) ----
set(S "4 typing off\n")
set(F 8)
macro(at line)
  string(APPEND S "${F} ${line}\n")
  math(EXPR F "${F} + 1")
endmacro()
macro(wait n)
  math(EXPR F "${F} + ${n}")
endmacro()
macro(mods state)
  foreach(md ${ARGN})
    string(APPEND S "${F} mod ${md} ${state}\n")
  endforeach()
endmacro()
# A press at (x0, y0), 30 frames of moves to (x1, y1), a release; ARGN: the modifiers held.
macro(drag x0 y0 x1 y1)
  mods(1 ${ARGN})
  at("move ${x0} ${y0}")
  wait(1)  # (a hand rests on the spot a moment before it presses)
  at("down 0")
  foreach(i RANGE 1 30)
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 30")
    math(EXPR yi "${y0} + (${y1} - ${y0}) * ${i} / 30")
    at("move ${xi} ${yi}")
  endforeach()
  wait(2)
  at("up 0")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(click x y)
  mods(1 ${ARGN})
  at("move ${x} ${y}")
  wait(1)
  at("down 0")
  at("up 0")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(key k)
  mods(1 ${ARGN})
  wait(1)
  at("key ${k}")
  mods(0 ${ARGN})
  wait(4)
endmacro()
macro(check name)
  wait(4)
  set(at_${name} ${F})
  at("dump")
  at("shot \"${OUT}/${name}.ppm\"")
  wait(3)
endmacro()
macro(finish tag)
  wait(6)
  at("quit discard")
  run(${tag} "${S}")
  set(S "4 typing off\n")
  set(F 8)
endmacro()

# ---- the Arrangement's geometry (a new set opens on the clip grid; Tab shows the Arrangement) ----
run(geo "4 typing off\n8 key tab\n20 plgeom\n24 livegrid\n26 key tab\n36 livegrid\n40 quit discard\n")
if(NOT out MATCHES "plgeom frame [0-9]+: valid 1 x0 ([0-9]+)[.0-9]* pxPerTick ([0-9]+)\\.([0-9][0-9][0-9])")
  fail("no playlist geometry")
endif()
set(x0 ${CMAKE_MATCH_1})
set(whole ${CMAKE_MATCH_2})
string(REGEX REPLACE "^0+(.)" "\\1" fr "${CMAKE_MATCH_3}")
math(EXPR ppt "${whole} * 1000 + ${fr}")  # pixels per 1000 ticks
foreach(t 0 1 2 3)
  if(NOT out MATCHES "\n  track ${t} top ([0-9]+)[.0-9]* h ([0-9]+)[.0-9]* mode ([0-9]+)")
    fail("no geometry for track ${t}")
  endif()
  set(top${t} ${CMAKE_MATCH_1})
  set(mode${t} ${CMAKE_MATCH_3})
endforeach()
if(NOT mode0 EQUAL 0 OR NOT mode1 EQUAL 0 OR NOT mode2 EQUAL 1 OR NOT mode3 EQUAL 1)
  fail("a new Clips set has two MIDI tracks over two audio tracks (${mode0} ${mode1} ${mode2} ${mode3})")
endif()
if(NOT out MATCHES "grid [0-9.]+ [0-9.]+ ([0-9]+)[.0-9]* vthumb")
  fail("no grid bottom")
endif()
set(gridBottom ${CMAKE_MATCH_1})
if(NOT out MATCHES "headcol ([0-9]+)")
  fail("no header column")
endif()
set(headX ${CMAKE_MATCH_1})
foreach(t 0 1 2)
  if(NOT out MATCHES "livegrid title ${t} \"[^\"]*\" ([0-9]+) ([0-9]+)")
    fail("no clip grid column ${t}")
  endif()
  math(EXPR sx${t} "${CMAKE_MATCH_1} + 10")  # a slot's body, right of its launch cell
  set(titleY ${CMAKE_MATCH_2})
endforeach()
foreach(k 0 1)
  if(NOT out MATCHES "livegrid row ${k} y ([0-9]+)")
    fail("no clip grid row ${k}")
  endif()
  set(ry${k} ${CMAKE_MATCH_1})
endforeach()
function(xAt tick var)
  math(EXPR v "${x0} + ${tick} * ${ppt} / 1000")
  set(${var} ${v} PARENT_SCOPE)
endfunction()
math(EXPR body0 "${top0} + 30")  # in a clip's body, under its title bar
math(EXPR body1 "${top1} + 30")
math(EXPR body2 "${top2} + 30")
math(EXPR body3 "${top3} + 30")
math(EXPR mid0 "${top0} + 23")
math(EXPR mid2 "${top2} + 23")


# ================================ 1, 2 ================================
if(NOT out MATCHES "livegrid scene x ([0-9]+)")
  fail("no scene column")
endif()
math(EXPR scx "${CMAKE_MATCH_1} - 20")   # a scene's name
math(EXPR scplay "${CMAKE_MATCH_1} - 57")  # its launch triangle
check(fresh)
click(${sx0} ${ry0})
wait(4)
at("dragenter ${sx2} ${ry1} \"${WAV}\"")
foreach(i RANGE 1 8)
  at("dragmove ${sx2} ${ry1}")
endforeach()
at("drop ${sx2} ${ry1}")
wait(12)
set(at_g ${F})
at("grid2state")
wait(2)
finish(drop)
string(FIND "${out}" "grid2 frame ${at_g}:" i)
string(SUBSTRING "${out}" ${i} 600 g)
if(NOT g MATCHES "\n  selslot 2 1\n")
  fail("a sound file dropped into slot (3, 2) selects that slot")
endif()
ok("the slot a file is dropped into is the selected one")
string(FIND "${out}" "grid2 frame" i0)
string(SUBSTRING "${out}" ${i0} 600 g0)
if(NOT g0 MATCHES "\n  mainchosen 0\n")
  fail("a fresh set does not show Main chosen before anything is clicked")
endif()
ok("a fresh set has Main unchosen (no ring)")

# ================================ 3 ================================
xAt(384 bx2)
xAt(1152 bx4)
key(tab)
wait(6)
drag(${bx2} ${mid0} ${bx4} ${mid0})
key(m super shift)
wait(8)
at("plgeom")
check(made)
finish(timesel)
dumpAt(${at_made})
if(NOT d MATCHES "\n  clip [0-9]+ kind 0 track 0 start 384 len 768 ")
  fail("Cmd+Shift+M over the time selection makes the clip")
endif()
if(NOT out MATCHES "\n  timesel 0 0 tracks 0\n")
  fail("the time selection is cleared once Cmd+Shift+M made the clip")
endif()
ok("Cmd+Shift+M makes the clip and clears the time selection")

# ================================ 4 ================================
foreach(k 0 1 2)
  math(EXPR yk "${ry0} + (${ry1} - ${ry0}) * ${k}")
  click(${sx0} ${yk})
  key(m super shift)
  wait(4)
endforeach()
click(${scx} ${ry0})
key(r super)
at("text \"Verse 140 BPM 3/4\"")
wait(2)
key(enter)
key(space)
wait(20)
click(${scplay} ${ry0})
wait(120)
click(${sx0} ${ry1})
key(i super)
wait(10)
at("grid2state")
at("livegrid")
check(inserted)
key(space)
finish(scene)
string(FIND "${out}" "grid2 frame" i)
string(SUBSTRING "${out}" ${i} 300 g)
if(NOT g MATCHES "sig 3/4 songTempo 140.00 songSig 3/4 sceneLen 1536 ")
  fail("the scene named \"Verse 140 BPM 3/4\" sets 140 BPM and 3/4 when launched")
endif()
dumpAt(${at_inserted})
if(NOT d MATCHES "\n  clip ([0-9]+) kind 0 track 0 start 4608 ")
  fail("a scene inserted under the second slot pushes the third clip a scene down")
endif()
set(third ${CMAKE_MATCH_1})
if(NOT out MATCHES "\n  slot 0 3 x [0-9.]+ y [0-9.]+ clip ${third}\n")
  fail("after the 3/4 scene, the clip pushed down shows in row 4 (the scenes keep their length)")
endif()
ok("after a 3/4 scene launched, an inserted scene pushes the clip one row down, shown there")

# ================================ 5 ================================
# Analog Synth dragged from the browser's list (where the list stands at 960 x 600) onto track 1
set(S "4 typing off\n8 key tab\n20 move 110 258\n22 down 0\n")
foreach(i RANGE 1 30)
  math(EXPR fi "22 + ${i}")
  math(EXPR xi "110 + (450 - 110) * ${i} / 30")
  math(EXPR yi "258 + (157 - 258) * ${i} / 30")
  string(APPEND S "${fi} move ${xi} ${yi}\n")
endforeach()
string(APPEND S "56 up 0\n70 channels\n72 shot \"${OUT}/small.ppm\"\n76 quit discard\n")
set(cfg "${OUT}/cfg_small")
file(REMOVE_RECURSE "${cfg}")
file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
file(WRITE "${cfg}/gridline/settings.json"
     "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layout\": \"live\", \"keys.profile\": \"live\", \"ui.menuStyle\": \"live\"}}\n")
set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
set(ENV{HOME} "${cfg}/home")
file(WRITE "${OUT}/small.txt" "${S}")
execute_process(COMMAND "${APP}" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 960x600 --dev-input "${OUT}/small.txt"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
if(NOT rc EQUAL 0)
  fail("gridline-app at 960 x 600 failed (${rc})")
endif()
if(NOT out MATCHES "\n  channel [0-9]+ [^\n]* type gl\\.analog ")
  fail("at 960 x 600 an instrument is dragged from the browser's list onto track 1")
endif()
ok("at 960 x 600 the browser shows its list beside the places (an instrument dragged from it)")
