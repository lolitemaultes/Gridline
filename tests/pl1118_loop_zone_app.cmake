# Gridline - PL-1118: looping regions in the Smooth (logic) layout, driven by scripted input in the real
# app (hidden, isolated config and HOME, fixed frame time) on a copy of the test song with a pattern
# region (91, track 1) and an audio region (93, track 3) after the song's last clips:
#   1. the upper half of a region's right edge is its loop zone: the loop badge shows by the pointer
#      there, not on the lower half;
#   2. a drag from the loop zone runs the region on in repeats (it loops, as far as dragged, snapped to
#      the grid), one undo step; a drag from the lower half resizes it (no loop);
#   3. with both regions selected, a drag of the audio region's loop zone loops both, one undo step;
#   4. the L key (the region Loop) turns the selection's loop off (the repeats go) and on again (each
#      runs on to the song's end, there being no region after them).
#   5. loop2-1118: that end is on a bar line, and drawn on it: in the shot the looped region's last
#      pixel column is the one before the bar's grid line (the line is the brightest column there on
#      the empty ground below the tracks), and each loop point's divider is on its bar's grid line
#      (darker than the passes either side of it).
#   cmake -DAPP=<gridline-app> -DDEMO=<test_song.gridline.json> -DOUT=<dir> -P pl1118_loop_zone_app.cmake
cmake_minimum_required(VERSION 3.16)
set(LAYOUT logic)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{GRIDLINE_HIDE_PLUGINS} "all")
get_filename_component(src "${DEMO}" DIRECTORY)
configure_file("${src}/../../assets/sounds/classic/startup.wav" "${OUT}/Take.wav" COPYONLY)
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
set(chan "{\"color\": 5219296, \"gain\": 0.8, \"id\": 60, \"mixerTrack\": 0, \"muted\": false, \"name\": \"Take\", \"pan\": 0, \"pitch\": 0, \"plugin\": {\"type\": \"gl.sampler\", \"data\": \"${OUT}/Take.wav\", \"params\": []}}, ")
set(clips "{\"id\": 91, \"length\": 0, \"pattern\": 29, \"start\": 6144, \"track\": 1}, ")
string(APPEND clips "{\"id\": 93, \"kind\": \"audio\", \"source\": 60, \"track\": 3, \"start\": 6144, \"length\": 384, \"pattern\": 0}, ")
string(REPLACE "\"channels\": [" "\"channels\": [${chan}" demo "${demo}")
string(REPLACE "\"playlist\": [" "\"playlist\": [${clips}" demo "${demo}")
string(REGEX REPLACE "\"nextId\": *[0-9]+" "\"nextId\": 200" demo "${demo}")
file(WRITE "${OUT}/song.gridline.json" "${demo}")

function(fail msg)
  message(FATAL_ERROR "FAIL (${LAYOUT}): ${msg}\n${out}")
endfunction()

function(run tag script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.layoutChosen\": true, \"ui.layoutDev\": true, \"ui.layoutPreset\": \"${LAYOUT}\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/song.gridline.json" --hidden --no-ui-sounds --no-update-check --fixed-dt 16 --size 1440x900
                          --layout ${LAYOUT} --show playlist --zoom 0.5 --dev-input "${OUT}/${tag}.txt" ${ARGN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 120)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  set(out "${o}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "FAIL (${LAYOUT}) ${tag}: gridline-app failed (${rc}): ${err}")
  endif()
endfunction()

function(rect p id)
  if(NOT out MATCHES "\n  clip ${id} x ([-0-9]+)[.0-9]* ([-0-9]+)[.0-9]* y ([-0-9]+)[.0-9]* ([-0-9]+)")
    fail("clip ${id} is not drawn")
  endif()
  set(${p}_x0 ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${p}_x1 ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(${p}_y0 ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(${p}_y1 ${CMAKE_MATCH_4} PARENT_SCOPE)
endfunction()

# clipAt <frame> <id>: c_len, c_loop, c_start, undo.
function(clipAt frame id)
  if(NOT out MATCHES "dump frame ${frame}: ([0-9]+) clips, ([0-9]+) selected, undo ([0-9]+)\n")
    fail("no dump at frame ${frame}")
  endif()
  set(undo ${CMAKE_MATCH_3} PARENT_SCOPE)
  string(FIND "${out}" "dump frame ${frame}:" at)
  string(SUBSTRING "${out}" ${at} -1 rest)
  string(REGEX MATCH "\n  clip ${id} kind [0-9]+ track [0-9]+ start ([0-9]+) len ([0-9]+) [^\n]* loop ([01])" _ "${rest}")
  set(c_start "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(c_len "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(c_loop "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()

function(want what got expect)
  if(NOT "${got}" STREQUAL "${expect}")
    fail("${what}: want ${expect}, got ${got}")
  endif()
  message(STATUS "ok - ${LAYOUT}: ${what}")
endfunction()

# Lightness (r + 2g + b) of the image pixels [x0, x1) of row y (as k276_clip_gaps_app).
function(rowlum ppm y x0 x1)
  file(READ "${ppm}" hdr LIMIT 32)
  string(REGEX MATCH "^P6[ \n]+([0-9]+)[ \n]+([0-9]+)[ \n]+255\n" h "${hdr}")
  if(h STREQUAL "")
    fail("${ppm}: not a P6 image")
  endif()
  set(w ${CMAKE_MATCH_1})
  string(LENGTH "${h}" off)
  math(EXPR o "${off} + (${y} * ${w} + ${x0}) * 3")
  math(EXPR bytes "(${x1} - ${x0}) * 3")
  file(READ "${ppm}" hex OFFSET ${o} LIMIT ${bytes} HEX)
  string(REGEX MATCHALL "......" pix "${hex}")
  set(ls "")
  foreach(p ${pix})
    string(SUBSTRING "${p}" 0 2 r)
    string(SUBSTRING "${p}" 2 2 g)
    string(SUBSTRING "${p}" 4 2 b)
    math(EXPR l "0x${r} + 2 * 0x${g} + 0x${b}")
    list(APPEND ls ${l})
  endforeach()
  set(lums "${ls}" PARENT_SCOPE)
endfunction()

# The playlist's x of tick <t>, rounded (a grid line's column at 1x): from plgeom's x0 and pxPerTick.
function(tickcol var t)
  if(NOT out MATCHES "plgeom frame [0-9]+: valid 1 x0 (-?)([0-9]+)\\.([0-9][0-9][0-9]) pxPerTick ([0-9]+)\\.([0-9]+)")
    fail("no playlist geometry")
  endif()
  set(sg "${CMAKE_MATCH_1}")
  set(xw "${CMAKE_MATCH_2}")
  set(xf "${CMAKE_MATCH_3}")
  set(pw "${CMAKE_MATCH_4}")
  set(pf "${CMAKE_MATCH_5}")
  string(REGEX REPLACE "^0+(.)" "\\1" xf "${xf}")
  math(EXPR x0m "${xw} * 1000 + ${xf}")
  if(sg STREQUAL "-")
    math(EXPR x0m "0 - ${x0m}")
  endif()
  string(SUBSTRING "${pf}000000" 0 6 pf)
  string(REGEX REPLACE "^0+(.)" "\\1" pf "${pf}")
  math(EXPR pu "${pw} * 1000000 + ${pf}")
  math(EXPR xm "${x0m} + ${t} * ${pu} / 1000")
  math(EXPR c "(${xm} + 500) / 1000")
  set(${var} ${c} PARENT_SCOPE)
endfunction()

# drag <var> <frame> <x0> <y0> <x1>: a press, four moves along the row and a release (ends 14 frames on).
function(drag var f x0 y0 x1)
  math(EXPR f1 "${f} + 2")
  set(s "${f} move ${x0} ${y0}\n${f1} down 0\n")
  foreach(i 1 2 3 4)
    math(EXPR fi "${f1} + 2 * ${i}")
    math(EXPR xi "${x0} + (${x1} - ${x0}) * ${i} / 4")
    string(APPEND s "${fi} move ${xi} ${y0}\n")
  endforeach()
  math(EXPR fu "${f} + 14")
  string(APPEND s "${fu} up 0\n")
  set(${var} "${s}" PARENT_SCOPE)
endfunction()

run(geo "4 typing off\n6 pltool select\n12 plgeom\n16 quit discard\n")
if(NOT out MATCHES "plgeom frame [0-9]+: valid 1 x0 [-0-9.]+ pxPerTick ([0-9]+)\\.([0-9][0-9][0-9])")
  fail("no playlist geometry")
endif()
set(whole ${CMAKE_MATCH_1})
string(REGEX REPLACE "^0+(.)" "\\1" f "${CMAKE_MATCH_2}")
math(EXPR ppt "${whole} * 1000 + ${f}")
math(EXPR bar "384 * ${ppt} / 1000")
rect(p 91)
rect(q 93)
math(EXPR pex "${p_x1} - 2")             # on the right edge
math(EXPR puy "${p_y0} + (${p_y1} - ${p_y0}) / 3")      # its upper half (below the fade corner)
math(EXPR ply "${p_y1} - 4")             # its lower half
math(EXPR qex "${q_x1} - 2")
math(EXPR quy "${q_y0} + (${q_y1} - ${q_y0}) * 2 / 5")
math(EXPR pmx "(${p_x0} + ${p_x1}) / 2")
math(EXPR qmx "${q_x0} + (${q_x1} - ${q_x0}) / 3")

# ---- 1. the badge ----
run(badge "4 typing off\n6 pltool select\n30 move ${pex} ${puy}\n34 plgeom\n36 move ${pex} ${ply}\n40 plgeom\n44 quit discard\n")
if(NOT out MATCHES "plgeom frame 34:[^\n]*\n(  [^\n]*\n)*  loopbadge 1")
  fail("no loop badge over the upper half of the right edge")
endif()
string(FIND "${out}" "plgeom frame 40:" at)
string(SUBSTRING "${out}" ${at} -1 rest)
if(NOT rest MATCHES "\n  loopbadge 0")
  fail("a loop badge over the lower half of the right edge (it resizes)")
endif()
message(STATUS "ok - ${LAYOUT}: the loop badge shows on the upper half of the right edge only")

# ---- 2. a loop-zone drag, a lower-half drag ----
math(EXPR x2 "${pex} + 2 * ${bar}")
drag(d 30 ${pex} ${puy} ${x2})
run(loopdrag "4 typing off\n6 pltool select\n20 dump\n${d}50 dump\n52 plgeom\n54 shot \"${OUT}/loopdrag.ppm\"\n58 quit discard\n")
clipAt(20 91)
set(u0 ${undo})
set(len0 ${c_len})
clipAt(50 91)
math(EXPR want2 "${len0} + 768")
want("loop zone: the region loops two bars further" "${c_loop}/${c_len}" "1/${want2}")
math(EXPR du "${undo} - ${u0}")
want("loop zone: one undo step" "${du}" 1)
math(EXPR x1 "${pex} + ${bar}")
drag(d 30 ${pex} ${ply} ${x1})
run(resize "4 typing off\n6 pltool select\n20 dump\n${d}50 dump\n54 quit discard\n")
clipAt(50 91)
math(EXPR want1 "${len0} + 384")
want("lower half: a plain resize (no loop)" "${c_loop}/${c_len}" "0/${want1}")

# ---- 3. two regions at once ----
math(EXPR x2 "${qex} + 2 * ${bar}")
math(EXPR qby "${q_y0} + (${q_y1} - ${q_y0}) * 3 / 5")  # (clear of the volume handle at the bottom middle)
drag(d 50 ${qex} ${quy} ${x2})
set(sel "30 move ${pmx} ${ply}\n32 down 0\n34 up 0\n36 mod shift 1\n38 move ${qmx} ${qby}\n40 down 0\n42 up 0\n44 mod shift 0\n")
run(multi "4 typing off\n6 pltool select\n${sel}46 dump\n${d}70 dump\n72 shot \"${OUT}/multi.ppm\"\n80 key l\n86 dump\n90 key l\n96 dump\n98 plgeom\n100 shot \"${OUT}/multi_l.ppm\"\n104 quit discard\n")
clipAt(46 91)
set(u0 ${undo})
clipAt(70 93)
want("both: the audio region dragged by its loop zone loops" "${c_loop}" 1)
set(qlen ${c_len})
if(NOT qlen GREATER 384)
  fail("the audio region did not grow (${qlen})")
endif()
clipAt(70 91)
want("both: the pattern region selected with it loops too" "${c_loop}" 1)
math(EXPR plen "${len0} + 768")
want("both: ... by the same two bars" "${c_len}" "${plen}")
math(EXPR du "${undo} - ${u0}")
want("both: one undo step" "${du}" 1)
# ---- 4. the L key ----
clipAt(86 91)
want("L: the loop goes off, back to one pass" "${c_loop}/${c_len}" "0/${len0}")
clipAt(86 93)
want("L: ... the audio region too" "${c_loop}/${c_len}" "0/384")
clipAt(96 91)
math(EXPR e91 "${c_start} + ${c_len}")
want("L again: it loops" "${c_loop}" 1)
if(NOT c_len GREATER len0)
  fail("L again: the region does not run on in repeats (${c_len})")
endif()
clipAt(96 93)
want("L again: the audio region loops" "${c_loop}" 1)
math(EXPR e93 "${c_start} + ${c_len}")
want("L again: both run on to the same end (the song's)" "${e93}" "${e91}")
# ---- 5. loop2-1118: the end on the grid, and drawn on its grid line ----
math(EXPR m91 "${e91} % 384")
want("L again: the looped end is on a bar line" "${m91}" 0)
if(NOT out MATCHES "\n  view [^\n]* grid ([0-9]+)[.0-9]* ([0-9]+)[.0-9]* ([0-9]+)")
  fail("no grid rectangle")
endif()
math(EXPR gy "${CMAKE_MATCH_3} - 6")  # the empty ground below the tracks: grid lines only
rect(r 91)
tickcol(ecol ${e91})
want("drawn: the looped region's box ends on its end's grid line" "${r_x1}" "${ecol}")
math(EXPR ry "(${r_y0} + ${r_y1} * 2) / 3")  # (in its body, under the title)
set(ppm "${OUT}/multi_l.ppm")
math(EXPR a0 "${ecol} - 2")
math(EXPR a1 "${ecol} + 3")
rowlum("${ppm}" ${gy} ${a0} ${a1})
list(GET lums 2 lineL)
foreach(k 0 1 3 4)
  list(GET lums ${k} l)
  if(NOT lineL GREATER l)
    fail("pixels: column ${ecol} is not the bar's grid line on the ground (${lums})")
  endif()
endforeach()
math(EXPR b0 "${ecol} - 1")
math(EXPR b1 "${ecol} + 3")
rowlum("${ppm}" ${ry} ${b0} ${b1})
list(GET lums 0 inR)
list(GET lums 3 outR)
math(EXPR dl "${inR} - ${outR}")
if(dl LESS 0)
  math(EXPR dl "0 - ${dl}")
endif()
if(dl LESS 60)
  fail("pixels: the region's last column (${b0}) is not region (${lums})")
endif()
message(STATUS "ok - ${LAYOUT}: pixels: the last repeat ends on the bar's grid line (column ${ecol})")
# Each loop point's divider: on its bar's grid line, darker than the passes beside it.
clipAt(96 91)
math(EXPR lp "${c_start} + 768")
while(lp LESS e91)
  tickcol(lcol ${lp})
  math(EXPR c0 "${lcol} - 1")
  math(EXPR c1 "${lcol} + 2")
  rowlum("${ppm}" ${ry} ${c0} ${c1})
  list(GET lums 0 before)
  list(GET lums 1 at)
  list(GET lums 2 after)
  if(NOT (at LESS before AND at LESS after))
    fail("pixels: no divider on the loop point's grid line, column ${lcol} (${lums})")
  endif()
  rowlum("${ppm}" ${gy} ${c0} ${c1})
  list(GET lums 0 gb)
  list(GET lums 1 gl)
  list(GET lums 2 ga)
  if(NOT (gl GREATER gb AND gl GREATER ga))
    fail("pixels: column ${lcol} is not the loop point's bar line on the ground (${lums})")
  endif()
  message(STATUS "ok - ${LAYOUT}: pixels: the divider at tick ${lp} is on its bar line (column ${lcol})")
  math(EXPR lp "${lp} + 768")
endwhile()
message(STATUS "pl1118_loop_zone_app: all checks passed")
