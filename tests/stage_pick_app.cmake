# Gridline: tracks from the playlist on the Stage in the real app (hidden, isolated config, 1440x900, the
# mixer in its Stage view). The demo song gets three markers (Intro, Verse, Chorus) through the MCP tool;
# "stage pick ..." (StagePickUi.cpp devPick) runs what the menus run:
#   1. a marker area and the playlist selection resolve to mixer tracks (a later area adds the parts that
#      start there; a selected clip gives its pattern's tracks); the find changes nothing;
#   2. Spread left to right, Bring forward, Push back: one undo step each, undo puts every track back;
#   3. Move to a new room named after the marker: one undo step (the room and the move), the Stage shows
#      the new room with the tracks selected; undo takes the room away again;
#   4. Add to the stage: tracks in another room come into the room shown, in free places across the
#      front, one undo step;
#   5. the panel opens from the palette's command in each layout (Studio, Clips, Smooth, Tracker), with
#      screenshots (SHOTS).
#   cmake -DAPP=<gridline-app> -DDEMO=<demo.gridline.json> -DOUT=<dir> [-DSHOTS=<dir>] -P stage_pick_app.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
file(READ "${DEMO}" demo)  # a copy: the demo song is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
if(NOT SHOTS)  # "shot" takes a path without spaces
  set(SHOTS "/tmp/stage_pick_shots")
endif()
file(MAKE_DIRECTORY "${SHOTS}")

# run(<tag> <layout> <frames> <script>): a fresh config for each run, in that layout.
function(run tag layout frames script)
  set(cfg "${OUT}/cfg_${tag}")
  file(REMOVE_RECURSE "${cfg}")
  file(MAKE_DIRECTORY "${cfg}/gridline" "${cfg}/home")
  file(WRITE "${cfg}/gridline/settings.json"
       "{\"format\": \"gridline-settings\", \"values\": {\"ui.stage.welcomed\": true, \"ui.layoutChosen\": true, \"ui.layout\": \"${layout}\", \"keys.profile\": \"${layout}\", \"ui.menuStyle\": \"${layout}\"}}\n")
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  set(ENV{HOME} "${cfg}/home")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --no-update-check --size 1440x900 --frames ${frames}
                          --layout ${layout} --show mixer --show stage --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err TIMEOUT 180)
  file(WRITE "${OUT}/${tag}.log" "${o}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${o}")
  endif()
  set(out "${o}" PARENT_SCOPE)
endfunction()

function(check msg)
  if(NOT (${ARGN}))
    message(FATAL_ERROR "FAIL: ${msg}\n${out}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()

# pick(<n>): the n-th (0-based) "pick found" line: p_found (a list), p_clips, p_here, p_other, p_name, p_undo, p_panel.
function(pick n)
  string(REGEX MATCHALL "pick found [^\n]*" lines "${out}")
  list(LENGTH lines count)
  if(count LESS_EQUAL ${n})
    message(FATAL_ERROR "FAIL: no pick report ${n}\n${out}")
  endif()
  list(GET lines ${n} l)
  string(REGEX MATCH "pick found ([-0-9,]+) buses ([-0-9,]+) clips ([0-9]+) muted ([0-9]+) master ([0-9]+) here ([0-9]+) other ([0-9]+)" _ "${l}")
  string(REPLACE "," ";" f "${CMAKE_MATCH_1}")
  set(p_found "${f}" PARENT_SCOPE)
  set(p_clips "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(p_here "${CMAKE_MATCH_6}" PARENT_SCOPE)
  set(p_other "${CMAKE_MATCH_7}" PARENT_SCOPE)
  string(REGEX MATCH "name \\[([^]]*)\\] undo ([0-9]+) panel ([01])" _ "${l}")  # (CMake keeps nine groups)
  set(p_name "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(p_undo "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(p_panel "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()

# stagerep(<n>): the n-th "stage frame" report: s_undo, s_sel (a list), s_shown; rooms r_count, r_shown;
# per token index i: s_pan<i>, s_depth<i>.
function(stagerep n)
  string(REPLACE ";" "," text "${out}")
  string(REPLACE "stage frame " ";stage frame " all "${text}")
  math(EXPR k "${n} + 1")
  list(LENGTH all count)
  if(count LESS_EQUAL k)
    message(FATAL_ERROR "FAIL: no stage report ${n}\n${out}")
  endif()
  list(GET all ${k} d)
  string(REGEX MATCH "undo ([0-9]+) sel ([-0-9,]+) focus [-0-9]+ shown ([0-9]+)" _ "${d}")
  set(s_undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REPLACE "," ";" sl "${CMAKE_MATCH_2}")
  set(s_sel "${sl}" PARENT_SCOPE)
  set(s_shown "${CMAKE_MATCH_3}" PARENT_SCOPE)
  string(REGEX MATCH "rooms ([0-9]+) shown ([0-9]+)" _ "${d}")
  set(r_count "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(r_shown "${CMAKE_MATCH_2}" PARENT_SCOPE)
  string(REGEX MATCHALL "token [0-9]+ x [-0-9.]+ y [-0-9.]+ side [-0-9.]+ pan [-0-9.]+ depth [-0-9.]+" toks "${d}")
  foreach(p IN LISTS toks)
    string(REGEX MATCH "token ([0-9]+) x [-0-9.]+ y [-0-9.]+ side [-0-9.]+ pan ([-0-9.]+) depth ([-0-9.]+)" _ "${p}")
    set(s_pan${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(s_depth${CMAKE_MATCH_1} "${CMAKE_MATCH_3}" PARENT_SCOPE)
  endforeach()
endfunction()

# Three markers: Intro (bar 1), Verse (bar 5, where lane 2's part starts), Chorus (bar 9, lane 3's part).
set(MARK "4 mcp call add_marker {'position': 0, 'name': 'Intro'}\n5 mcp call add_marker {'position': 16, 'name': 'Verse'}\n6 mcp call add_marker {'position': 32, 'name': 'Chorus'}\n")

# ---- 1. finding ----
run(find studio 40 "${MARK}10 stage pick find area 0\n11 stage pick find area 1\n12 stage pick find area 2\n13 stage pick find area 0 2\n14 clipsel 47\n15 stage pick find sel\n16 clipsel\n17 stage pick find sel\n18 stage\n20 quit discard\n")
pick(0)
set(intro "${p_found}")
set(U0 "${p_undo}")
list(LENGTH intro nIntro)
check("the Intro area finds the tracks of its clips (${intro}, ${p_clips} clips, named ${p_name})" nIntro GREATER 0 AND p_clips GREATER 0 AND p_name STREQUAL "Intro")
pick(1)
set(verse "${p_found}")
list(LENGTH verse nVerse)
check("the Verse area adds the part that starts there (${verse} after ${intro})" nVerse GREATER nIntro)
pick(2)
set(chorus "${p_found}")
list(LENGTH chorus nChorus)
check("the Chorus area adds the third part (${chorus})" nChorus GREATER nVerse)
pick(3)
check("between Intro and Chorus: the Intro and Verse areas together (${p_found} = ${verse})" p_found STREQUAL verse)
pick(4)
set(sel "${p_found}")
list(LENGTH sel nSel)
foreach(t IN LISTS sel)
  list(FIND verse ${t} at)
  check("the selected Verse clip's track ${t} is one of the Verse area's" at GREATER -1)
endforeach()
check("a selected clip: its pattern's tracks (${sel})" nSel GREATER 0)
pick(5)
check("nothing selected: nothing found (${p_found})" p_found STREQUAL "-")
check("finding changes nothing (undo ${p_undo} = ${U0})" p_undo EQUAL U0)

# ---- 2. arranging the Verse's tracks together: one step each, undone exactly ----
run(arrange studio 70 "${MARK}10 stage\n12 stage pick spread area 1\n16 stage\n18 undo\n22 stage\n24 stage pick back area 1\n28 stage\n30 stage pick forward area 1\n34 stage\n36 undo\n37 undo\n40 stage\n44 quit discard\n")
stagerep(0)
set(U0 "${s_undo}")
list(GET verse 0 v0)
list(GET verse -1 v1)
set(pan0 "${s_pan${v0}}")
set(pan1 "${s_pan${v1}}")
set(dep0 "${s_depth${v0}}")
stagerep(1)
math(EXPR U1 "${U0} + 1")
check("Spread left to right: one undo step (${s_undo} after ${U0})" s_undo EQUAL U1)
check("spread: the Verse's tracks stand apart (${s_pan${v0}} ${s_pan${v1}})" NOT s_pan${v0} STREQUAL s_pan${v1})
list(LENGTH s_sel nS)
check("spread: they are selected on the Stage (${s_sel})" nS GREATER 0)
stagerep(2)
check("undo puts them back (${s_pan${v0}} ${s_pan${v1}} = ${pan0} ${pan1})" s_undo EQUAL U0 AND s_pan${v0} STREQUAL pan0 AND s_pan${v1} STREQUAL pan1)
stagerep(3)
check("Push back: one undo step, a row further back (${s_depth${v0}} from ${dep0})" s_undo EQUAL U1 AND s_depth${v0} GREATER dep0)
stagerep(4)
math(EXPR U2 "${U0} + 2")
check("Bring forward: one more step, back at the front (${s_depth${v0}})" s_undo EQUAL U2 AND s_depth${v0} STREQUAL dep0)
stagerep(5)
check("two undos: where they started (${s_undo})" s_undo EQUAL U0 AND s_depth${v0} STREQUAL dep0)

# ---- 3. a new room named after the marker ----
run(room studio 60 "${MARK}10 stage\n12 stage pick move new area 2\n16 stage\n17 stage pick find area 2\n18 shot \"${SHOTS}/stage-pick-new-room.ppm\"\n20 undo\n24 stage\n28 quit discard\n")
stagerep(0)
set(U0 "${s_undo}")
set(R0 "${r_count}")
stagerep(1)
math(EXPR U1 "${U0} + 1")
math(EXPR R1 "${R0} + 1")
check("Move to a new room: one undo step (${s_undo} after ${U0}), one more room (${r_count})" s_undo EQUAL U1 AND r_count EQUAL R1)
check("the Stage shows the new room (${r_shown})" r_shown EQUAL R0)
string(REGEX MATCH "room ${R0} \\[([^]]*)\\] tracks ([-0-9,]+)" _ "${out}")
check("the new room is named after the marker (${CMAKE_MATCH_1})" CMAKE_MATCH_1 STREQUAL "Chorus")
list(LENGTH s_sel nS)
check("the moved tracks are selected there (${s_sel}, ${nChorus} found)" nS EQUAL nChorus)
pick(0)
check("all of them are on the stage shown (${p_here} here, ${p_other} elsewhere)" p_here EQUAL nChorus AND p_other EQUAL 0)
stagerep(2)
check("undo: the room is gone again (${r_count})" s_undo EQUAL U0 AND r_count EQUAL R0)

# ---- 4. Add to the stage: from another room into the room shown ----
run(add studio 70 "${MARK}10 stage roomnew Other\n12 stage pick move 1 area 1\n14 stage roomshow 0\n16 stage pick find area 2\n18 stage\n20 stage pick add area 2\n24 stage\n25 stage pick find area 2\n26 shot \"${SHOTS}/stage-pick-added.ppm\"\n28 undo\n32 stage\n34 quit discard\n")
pick(0)
set(other "${p_other}")
check("before: the Verse's tracks are in the other room (${p_other})" p_other EQUAL nVerse)
stagerep(0)
set(U0 "${s_undo}")
stagerep(1)
math(EXPR U1 "${U0} + 1")
check("Add to the stage: one undo step (${s_undo} after ${U0})" s_undo EQUAL U1)
pick(1)
check("after: every track is on the stage shown (${p_here} here, ${p_other} elsewhere)" p_here EQUAL nChorus AND p_other EQUAL 0)
# The added tracks stand in distinct places (no two on one spot).
set(spots "")
foreach(t IN LISTS verse)
  list(APPEND spots "${s_pan${t}}/${s_depth${t}}")
endforeach()
set(uniq "${spots}")
list(REMOVE_DUPLICATES uniq)
list(LENGTH spots nSp)
list(LENGTH uniq nUq)
check("the added tracks stand in free places, never on one spot (${spots})" nSp EQUAL nUq)
stagerep(2)
check("undo: back in the other room (${s_undo})" s_undo EQUAL U0)

# ---- 5. the panel in every layout ----
foreach(lay studio live logic tracker)
  run(panel_${lay} ${lay} 50 "${MARK}10 clipsel 47\n12 palette run cmd:stage.fromMarkers\n30 stage pick find area 1\n32 shot \"${SHOTS}/stage-pick-panel-${lay}.ppm\"\n34 quit discard\n")
  pick(0)
  check("${lay}: the palette's command opens the panel on the Stage (${p_panel})" p_panel EQUAL 1)
endforeach()
run(menu studio 50 "${MARK}10 clipsel 47\n12 stage pick menu\n20 shot \"${SHOTS}/stage-pick-menu.ppm\"\n24 quit discard\n")
