# ---- 7. double-clicks on track headers: the name renames; elsewhere an instrument track's header shows its
# instrument; the header's controls (the "+") keep their own clicks; an ordinary track's body does nothing.
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")
function(head frame)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n(  [^\n]*\n)*  head settings ([0-9]+) renaming ([-0-9]+)" _ "${out}")
  if(CMAKE_MATCH_2 STREQUAL "")
    fail("no head line at frame ${frame}")
  endif()
  set(hset "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(hren "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()
