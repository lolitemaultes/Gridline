  run(g_${cname}_${pct} 12 "8 plgeom\n" cfg ${cname} --ui-scale ${sc})
  string(REGEX MATCH "x0 ([0-9]+)" _ "${out}")
  set(gx0 "${CMAKE_MATCH_1}")
  math(EXPR gx "${gx0} - 40")
  string(REGEX MATCH "grid [0-9.]+ [0-9.]+ ([0-9]+)" _ "${out}")
  set(gy1 "${CMAKE_MATCH_1}")  # the grid's bottom: tracks below it are not on screen
  foreach(t 1 2 3 ${T})
    track(8 ${t})
    math(EXPR gy "${ttop} + ${th} / 2")
