# ---- 6. geometry: small tracks at 100 / 150 / 200 %, large tracks; nothing overlaps the "+"
# A settings file with the track height (written by a first session, then edited).
function(heightcfg name h)
  run(mk_${name} 6 "2 quit\n" cfg ${name})
  file(READ "${OUT}/cfg_${name}/gridline/settings.json" sj)
  string(REGEX REPLACE "\"ui.playlistTrackHeight\": *[0-9.]+" "\"ui.playlistTrackHeight\": ${h}" sj "${sj}")
  file(WRITE "${OUT}/cfg_${name}/gridline/settings.json" "${sj}")
endfunction()
# Overlap checks on frame <frame> for the hovered track <t>.
function(clear frame t what)
  tplus(${frame})
  if(NOT ptrack EQUAL t)
    fail("${what}: no \"+\" on hovered track ${t} (${ptrack})")
  endif()
  track(${frame} ${t})
  math(EXPR tb "${ttop} + ${th}")
  int(y0 "${by0}")
  int(y1 "${by1}")
  int(x1 "${bx1}")
  int(x0 "${bx0}")
  check("${what}: inside the track (${y0}..${y1} in ${ttop}..${tb})" y0 GREATER_EQUAL ttop AND y1 LESS_EQUAL tb)
  check("${what}: clear of the handle (${hx1} <= ${bx0})" hx1 LESS_EQUAL bx0)
  check("${what}: clear of the mute switch (${bx1} <= ${lx0})" bx1 LESS_EQUAL lx0)
  check("${what}: clear of the mode controls (${cx1} <= ${bx0})" cx1 LESS_EQUAL bx0)
  if(nx1 GREATER 0 AND ny1 GREATER by0 AND ny0 LESS by1)  # the name on the "+"'s line
    check("${what}: clear of the name (${nx1} <= ${bx0})" nx1 LESS_EQUAL bx0)
    check("${what}: clear of the icon (${ix1} <= ${bx0})" ix1 LESS_EQUAL bx0)
  endif()
  set(ok 1 PARENT_SCOPE)
endfunction()

