# Gridline - K-12: the playlist track "+" in the real app (hidden, isolated configs, 1440x900, the playlist
# filling the window, a fixed 16 ms frame time, on a copy of the test song; tracks 4 and up are empty):
#   1. hovering an empty track's header fades the "+" in left of its mute switch; a click opens its menu;
#   2. "A rack channel" > a channel: the track plays that channel, a first pattern named after it sits on the
#      track at the view's start, it is the current pattern and the piano roll is open on that channel;
#      one undo step, and Undo restores the track, the patterns and the clips;
#   3. a favourite instrument (starred in the plugin manager settings) is listed in the menu itself: a click
#      makes a new channel of it the track's instrument (and its first pattern), one undo step;
#   4. "Start a pattern with it" off (the menu stays open, the switch is remembered): the instrument only;
#      then the "+" of that instrument track > "New pattern on this track": a clip on the track, the piano roll
#      on the track's channel with the new pattern, one undo step;
#   5. View > Track + button off: no "+" on hover; still off in the next session (settings saved at quit);
#   6. geometry: 24 px tracks at 100 / 150 / 200 % interface scale, and 120 px tracks: the "+" stays inside
#      its header and clear of the name, the drag handle, the mode controls and the mute switch.
# Screenshots (<OUT>/shots): hover and menu at 100 / 150 / 200 %, dark and light, 24 px and 120 px tracks.
#   cmake -DAPP=<gridline-app> -DDEMO=<song.gridline.json> -DOUT=<dir> -P k12_track_plus.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/shots")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")
set(ENV{HOME} "${OUT}/home")
file(MAKE_DIRECTORY "${OUT}/home")
file(READ "${DEMO}" demo)  # a copy: the fixture is never opened (or saved over) in place
file(WRITE "${OUT}/fixture.gridline.json" "${demo}")

# run(<tag> <frames> <script> [cfg <name>] [extra app args...]): a fresh config per tag unless "cfg <name>" shares one.
function(run tag frames script)
  set(args ${ARGN})
  set(cfg "${OUT}/cfg_${tag}")
  set(fresh 1)
  list(LENGTH args n)
  if(n GREATER 1)
    list(GET args 0 a0)
    if(a0 STREQUAL "cfg")
      list(GET args 1 cname)
      set(cfg "${OUT}/cfg_${cname}")
      set(fresh 0)
      list(REMOVE_AT args 0 1)
    endif()
  endif()
  if(fresh)
    file(REMOVE_RECURSE "${cfg}")
  endif()
  file(MAKE_DIRECTORY "${cfg}/gridline")
  if(DEFINED FAVS AND NOT EXISTS "${cfg}/gridline/plugin-manager.json")
    file(WRITE "${cfg}/gridline/plugin-manager.json" "{\"favourites\": [${FAVS}]}")
  endif()
  set(ENV{GRIDLINE_CONFIG_HOME} "${cfg}")
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${OUT}/fixture.gridline.json" --hidden --no-ui-sounds --fixed-dt 16 --size 1440x900 --show playlist
                          ${args} --frames ${frames} --screenshot "${OUT}/${tag}.ppm" --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  file(WRITE "${OUT}/${tag}.out" "${out}")
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(fail msg)
  message(FATAL_ERROR "FAIL: ${msg}\nOutput:\n${out}")
endfunction()
function(check msg)
  if(NOT (${ARGN}))
    fail("${msg}")
  endif()
  message(STATUS "ok - ${msg}")
endfunction()
function(int var val)
  string(REGEX REPLACE "\\..*" "" v "${val}")
  set(${var} "${v}" PARENT_SCOPE)
endfunction()

# The tplus line of frame <frame>.
function(tplus frame)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n(  [^\n]*\n)*  tplus on [^\n]*" blk "${out}")
  string(REGEX MATCH "  tplus on [^\n]*$" line "${blk}")
  if(line STREQUAL "")
    fail("no tplus line at frame ${frame}")
  endif()
  # on, track, box (4), name (4), handle (2), led (2), ctl (2), icon, menu, piano, pattern, channel, start, patterns, channels
  string(REGEX MATCHALL "-?[0-9]+(\\.[0-9]+)?" v "${line}")
  set(names on ptrack bx0 by0 bx1 by1 nx0 nx1 ny0 ny1 hx0 hx1 lx0 lx1 cx0 cx1 ix1 pmenu piano pcur pchan pstart npat nchan)
  set(i 0)
  foreach(name ${names})
    list(GET v ${i} x)
    set(${name} "${x}")
    set(${name} "${x}" PARENT_SCOPE)
    math(EXPR i "${i} + 1")
  endforeach()
  int(a "${bx0}")
  int(b "${bx1}")
  int(c "${by0}")
  int(d "${by1}")
  math(EXPR pcx "(${a} + ${b}) / 2")
  math(EXPR pcy "(${c} + ${d}) / 2")
  set(pcx "${pcx}" PARENT_SCOPE)
  set(pcy "${pcy}" PARENT_SCOPE)
endfunction()
# Menu row <key> of frame <frame>: rx ry (0 0 when not listed).
function(tprow frame key)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n(  [^\n]*\n)*  tprow ${key} x ([0-9.]+) y ([0-9.]+)" _ "${out}")
  set(rx 0 PARENT_SCOPE)
  set(ry 0 PARENT_SCOPE)
  if(NOT CMAKE_MATCH_2 STREQUAL "")
    int(x "${CMAKE_MATCH_2}")
    int(y "${CMAKE_MATCH_3}")
    set(rx "${x}" PARENT_SCOPE)
    set(ry "${y}" PARENT_SCOPE)
  endif()
endfunction()
# Track <t> of frame <frame>: top, height, mode, channel, plugin type, name.
function(track frame t)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n(  [^\n]*\n)*  track ${t} top ([-0-9.]+) h ([0-9.]+) mode ([0-9]) channel ([0-9]+) type ([^ ]+) fx ([0-9]+) name \"([^\"]*)\"" _ "${out}")
  if(CMAKE_MATCH_2 STREQUAL "")
    fail("no track ${t} at frame ${frame}")
  endif()
  int(top "${CMAKE_MATCH_2}")
  int(h "${CMAKE_MATCH_3}")
  set(ttop "${top}" PARENT_SCOPE)
  set(th "${h}" PARENT_SCOPE)
  set(tmode "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(tchan "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(ttype "${CMAKE_MATCH_6}" PARENT_SCOPE)
  set(tname "${CMAKE_MATCH_8}" PARENT_SCOPE)
endfunction()
# The undo position of frame <frame>.
function(undopos frame)
  string(REGEX MATCH "plgeom frame ${frame}: [^\n]*\n  plus [-0-9.]+ [-0-9.]+ droptrack [-0-9]+ patterns [0-9]+ current [0-9]+ undo ([0-9]+) \"([^\"]*)\"" _ "${out}")
  set(undo "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(ulabel "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()
# Clips of pattern <pattern> on track <t> in the dump of frame <frame>: count and the first one's start.
function(clipson frame t pattern)
  string(REGEX MATCH "dump frame ${frame}: [^\n]*\n(  clip [^\n]*\n)*" blk "${out}")
  string(REGEX MATCHALL "clip [0-9]+ kind 0 track ${t} start ([0-9]+) [^\n]* pattern ${pattern} " hits "${blk}")
  list(LENGTH hits n)
  set(nclips "${n}" PARENT_SCOPE)
  set(cstart -1 PARENT_SCOPE)
  if(n GREATER 0)
    list(GET hits 0 h0)
    string(REGEX MATCH "start ([0-9]+)" _ "${h0}")
    set(cstart "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endif()
endfunction()

