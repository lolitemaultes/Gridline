# Gridline - K-73, in the real app (hidden, isolated config, HOME and cache, dummy audio): a first scan
# of a large plugin collection (1836 plugins in VST3, VST2 and CLAP, like a reported one) never holds up
# the interface and ends by itself. The plugins are fake files and the scanner is a stand-in
# (fake_plugin_scanner): some plugins hang, crash, are slow, are not plugins, or hold 120 plugins each
# (VST 2 shells that take longer than the scan timeout). The plugin manager is open and the browser
# lists every installed plugin, as a user watching the scan would have it; both redraw every frame.
# Then an unchanged rescan, which must be quick, and the same with the plugins cached at startup.
#   cmake -DAPP=<gridline-app> -DSCANNER=<fake_plugin_scanner> -DDEMO=<song> -DOUT=<dir> -P k73_scan_stress_app.cmake
cmake_minimum_required(VERSION 3.18)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}/cfg/gridline" "${OUT}/tmp")
set(ENV{GRIDLINE_CONFIG_HOME} "${OUT}/cfg")
set(ENV{HOME} "${OUT}/cfg")
set(ENV{XDG_CACHE_HOME} "${OUT}/xdgcache")
set(ENV{GRIDLINE_CACHE_DIR} "${OUT}/cache")
set(ENV{TMPDIR} "${OUT}/tmp")
set(ENV{SDL_AUDIODRIVER} "dummy")
set(ENV{GRIDLINE_NO_PLUGIN_SCAN} "1")  # the script starts the scan it watches
set(ENV{GRIDLINE_SCAN_TIMEOUT} "3")    # a hung plugin is given up after 3 s (60 s in use)
set(ENV{VST_PATH} "")
set(ENV{VST3_PATH} "")
set(ENV{CLAP_PATH} "")
set(ENV{LV2_PATH} "")
set(ENV{GRIDLINE_BROWSER_EXPAND} "Installed,Instruments · Stress Test Audio,Effects · Stress Test Audio")
# Every frame but the longest stays under FRAME_LIMIT; the longest under OUTLIER_LIMIT. A shared CI
# runner (software rendering, other tests beside it) now and then holds up one frame on its own; the
# interface waiting for the scan shows on many frames, or for seconds (the scan timeout is 3 s here).
if(NOT FRAME_LIMIT)
  set(FRAME_LIMIT 150)
endif()
if(NOT OUTLIER_LIMIT)
  set(OUTLIER_LIMIT 1000)
endif()

# The plugin folders: only these are searched (no default folders, no other formats).
set(root "${OUT}/plugins")
if(WIN32)
  set(vst2ext "dll")
elseif(APPLE)
  set(vst2ext "vst")
else()
  set(vst2ext "so")
endif()
# name -> a plugin of each kind; the rest ordinary. 1836 in all: 700 VST3, 600 VST2, 536 CLAP.
function(fake_plugin path bundle)
  if(bundle)
    file(MAKE_DIRECTORY "${path}/Contents")
  else()
    file(WRITE "${path}" "fake")
  endif()
endfunction()
set(special hang crash slow junk)
foreach(fmt vst3 vst2 clap)
  if(fmt STREQUAL "vst3")
    set(n 699)
    set(ext "vst3")
    set(bundle ON)
  elseif(fmt STREQUAL "vst2")
    set(n 599)
    set(ext "${vst2ext}")
    set(bundle ${APPLE})
  else()
    set(n 535)
    set(ext "clap")
    set(bundle ${APPLE})
  endif()
  foreach(i RANGE ${n})
    math(EXPR vendor "${i} % 23")
    set(name "plug${i}")
    math(EXPR k "${i} % 97")
    if(k EQUAL 5)
      set(name "hang${i}")
    elseif(k EQUAL 11)
      set(name "crash${i}")
    elseif(k EQUAL 17)
      set(name "slow${i}")
    elseif(k EQUAL 29 OR k EQUAL 31 OR k EQUAL 37)
      set(name "junk${i}")
    elseif(k EQUAL 41)
      set(name "inst${i}")
    endif()
    if(fmt STREQUAL "vst2" AND (i EQUAL 100 OR i EQUAL 300))
      set(name "shell${i}")
    endif()
    fake_plugin("${root}/${fmt}/vendor${vendor}/${name}.${ext}" "${bundle}")
  endforeach()
endforeach()
set(prefs "{\"version\": 1, \"extraFolders\": [], \"noDefaultFolders\": [\"vst3\", \"vst2\", \"clap\", \"lv2\"], \"disabledFormats\": [\"lv2\", \"au\"], ")
string(APPEND prefs "\"formatFolders\": {\"vst3\": [\"${root}/vst3\"], \"vst2\": [\"${root}/vst2\"], \"clap\": [\"${root}/clap\"]}}")
file(WRITE "${OUT}/cfg/gridline/plugin-manager.json" "${prefs}")

function(run_app tag script)
  file(WRITE "${OUT}/${tag}.txt" "${script}")
  execute_process(COMMAND "${APP}" "${DEMO}" --hidden --no-ui-sounds --no-update-check --size 1440x900 --show plugins --dev-input "${OUT}/${tag}.txt"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
  file(WRITE "${OUT}/${tag}.out" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "gridline-app failed (${rc}): ${err}\n${out}")
  endif()
  string(REGEX MATCHALL "scan running [0-9]+ done [0-9]+ total [0-9]+ active [0-9]+ searching [0-9]+ failed [0-9]+ classes [0-9]+ longest-frame [0-9.]+ ms average-frame [0-9.]+ ms frames [0-9]+ second-frame [0-9.]+ ms" lines "${out}")
  set(lines "${lines}" PARENT_SCOPE)
endfunction()

# Fails when the frames of a scan state were too long (see FRAME_LIMIT above).
function(check_frames what line)
  string(REGEX REPLACE ".*longest-frame ([0-9.]+) ms.*" "\\1" l "${line}")
  string(REGEX REPLACE ".*second-frame ([0-9.]+) ms.*" "\\1" n "${line}")
  string(REGEX REPLACE ".*average-frame ([0-9.]+) ms.*" "\\1" v "${line}")
  if(n GREATER ${FRAME_LIMIT} OR l GREATER ${OUTLIER_LIMIT})
    message(FATAL_ERROR "FAIL: ${what}: frames took ${l} and ${n} ms (average ${v} ms; limits ${OUTLIER_LIMIT} ms for one frame, ${FRAME_LIMIT} ms for the others)")
  endif()
  message(STATUS "ok - ${what}: frames stay short: longest ${l} ms, next ${n} ms, average ${v} ms")
endfunction()

# 1. The first scan of everything, then an unchanged rescan, in one run.
run_app(first "20 scan state\n30 forget scan-idle\n30 scan start \"${SCANNER}\"\n31 scan state\n32 waitfor scan-idle 500\n34 scan state\n40 forget scan-idle\n40 scan start \"${SCANNER}\"\n41 scan state\n42 waitfor scan-idle 120\n44 scan state\n46 quit discard\n")
list(LENGTH lines n)
if(NOT n EQUAL 7)
  message(FATAL_ERROR "FAIL: seven scan states expected (each scan command prints one), got ${n}: ${lines}")
endif()
list(GET lines 1 asked)
list(GET lines 3 scanned)
list(GET lines 6 again)
message(STATUS "start:   ${asked}")
message(STATUS "scanned: ${scanned}")
message(STATUS "again:   ${again}")
if(NOT scanned MATCHES "^scan running 0 done 1836 total 1836 ")
  message(FATAL_ERROR "FAIL: the scan should end by itself with all 1836 plugins: ${scanned}")
endif()
message(STATUS "ok - the scan of 1836 plugins ends by itself")
# 99 fail (hung, crashed, not plugins: 5 in 97 of each format); the shells and the slow ones do not.
# Listed: 1737 plugins, the two shells with 120 each (1975).
string(REGEX REPLACE ".* failed ([0-9]+) .*" "\\1" failed "${scanned}")
string(REGEX REPLACE ".* classes ([0-9]+) .*" "\\1" classes "${scanned}")
message(STATUS "failed ${failed}, plugins listed ${classes}")
if(NOT failed EQUAL 99)
  message(FATAL_ERROR "FAIL: the hung, crashed and junk plugins should be listed as failed (${failed})")
endif()
if(NOT classes EQUAL 1975)
  message(FATAL_ERROR "FAIL: every plugin, the shells' 120 each included, should be listed (${classes})")
endif()
message(STATUS "ok - hung, crashed and broken plugins are blacklisted; shells that take longer than the timeout are listed")
check_frames("during the scan" "${scanned}")
if(NOT again MATCHES "^scan running 0 done 0 total 0 ")
  message(FATAL_ERROR "FAIL: an unchanged rescan should scan nothing: ${again}")
endif()
message(STATUS "ok - an unchanged rescan scans nothing")
check_frames("the unchanged rescan" "${again}")

# 2. A start with all of them cached: the frames with the full lists stay short.
run_app(cached "20 scan state\n60 scan state\n62 quit discard\n")
list(LENGTH lines n)
if(NOT n EQUAL 2)
  message(FATAL_ERROR "FAIL: two scan states expected, got ${n}: ${lines}")
endif()
list(GET lines 1 idle)
message(STATUS "cached:  ${idle}")
check_frames("with every plugin cached" "${idle}")
